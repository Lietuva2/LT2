@using Framework.Mvc.Strings
@using Globalization.Resources.Shared
@using Web.Helpers
@model string
@{ var text = (Model ?? string.Empty).FilterHtmlToWhitelist(); }
@{ var len = 500;
   if (text.Length > len)
   {
       var plain = text.GetPlainText(firstParagraphOnly:false);
       len = len + text.Length - plain.Length;
   }}
<div class="text_expandable richtext">
    @if (text.Length > len)
    {
        var pair = Html.GetExpandableTextPair(text, len);
        if (pair.Second == null)
        {
            @Html.Raw(pair.First)
        }
        else
        {
            @Html.Raw(pair.First)<span class="text_expanded_hide">...</span><span class="text_expanded_show richtext">@Html.Raw(pair.Second)</span><span class="text_expanded_link"> <a href="javascript:void(0};">@SharedStrings.More</a></span>
        }
    }
    else
    {
        @Html.Raw(text)
    }
</div>
