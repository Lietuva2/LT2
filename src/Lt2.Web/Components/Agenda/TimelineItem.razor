@using Lt2.Api.Contracts.Agenda
@using Lt2.Api.Contracts.Appeals
@using Lt2.Api.Contracts.Me
@using Lt2.Web.Client.Appeals
@using Lt2.Web.Client.Organisations
@inject IStringLocalizer<PageText> T
@inject IStringLocalizer<AppealUi> U
@inject Formats F

@* One planned bill in the front page's timeline (design 8.7) and the agenda page's (8.11.1): the same row on both (owner,
   2026-11-19: "the front page and the agenda's rows look the same, one component"). Number, stage and title (the way to
   the bill's details); both sides with the counts for accounts older than 30 days, the bar and the threshold; the
   organisations with a public statement on it as names with their stance (an unconfirmed one keeps "Nepatvirtinta"; the
   full label is on the bill's page and the profile), ordered as on the bill's page and never counted; and, on a bill whose
   record is open, "Prašau balsuoti" with "už" and "prieš" ("Taking a side in the row"), with no line saying nobody took
   part yet beside them (owner, 2026-11-19: "minimise non-essential texts"). A visitor's two are links to sign in that come
   back to the bill's page; a member's side column is an island (MyAgendaSide) that takes the side in the row, and the mark
   under the title is another (MyAgendaMark), both filled in the browser and keyed by the row's place, so a day grown
   in place ("Rodyti daugiau") keeps each island on its own row and starts those of the rows added; everything here is public and the same for everyone. A closed record
   says "Niekas nedalyvavo" when nobody did; a closed or hidden record and a bill the open data does not know yet have no
   sides to take; the last shows what the agenda says and its source.

   The list of bills (/projektai, owner 2026-11-23) has the same row, under no day: its place is the bill's number and its
   anchor "bill-{number}"; what only the list says (the planned date, the participants and arguments, the latest activity)
   comes as Tags and Details, built by the list.

   The numbers stand in the side column of every row, under the word "Dalyviai" (RecordFigures); a closed row has no link to
   the bill (owner, 2026-11-23: the title and the number tag lead there). *@
<li class="tl-item" id="@RowId">
    <div class="tl-item__main">
        <span class="row">
            @if (Item.Title is not null)
            {
                <a class="tag tag--ink num" href="@BillPath">@Item.Number</a>
            }
            else
            {
                <span class="tag tag--ink num">@Item.Number</span>
            }
            @if (Item.Stage is { } stage)
            {
                <span class="tag">@F.Stage(stage)</span>
            }
            @if (Item.SetByModerator)
            {
                <span class="tag">@T["Agenda.ByModerator"]</span>
            }
            @Tags
        </span>
        @if (Item.Title is { } title)
        {
            <a class="tl-item__title" href="@BillPath">@title</a>
        }
        else
        {
            <span class="small">@T["Agenda.NoTitle"]</span>
        }
        @Details
        @if (Item.Organisations.Count > 0)
        {
            <p class="small org-line" id="agenda-organisations-@Item.Number">
                <span class="label">@U["Agenda.Organisations"]</span>
                @foreach (var org in Item.Organisations)
                {
                    <span class="org-item"><span class="@OrganisationWords.StanceClass(org.Stance)">@U["Agenda.Stance." + org.Stance]</span> <span class="org-item__name"><a href="@OrganisationWords.ProfilePath(org.Slug)">@org.Name</a>@if (org.Label.ConfirmedBy is null)
                        {
                            @(" ")<OrgLabel Label="org.Label" />
                        }</span></span>
                }
            </p>
        }
        @if (Member && Item.Title is not null)
        {
            <MyAgendaMark @key="Place" Number="@Item.Number" Numbers="Numbers" Place="@Place" @rendermode="InteractiveWebAssembly" />
        }
    </div>
    @if (Member && Item.Record is { Status: BillRecordStatuses.Open } open)
    {
        <MyAgendaSide @key="Place" Number="@Item.Number" Numbers="Numbers" Place="@Place" Record="open" @rendermode="InteractiveWebAssembly" />
    }
    else
    {
        <div class="tl-item__side">
            @if (Item.Record is not { } record)
            {
                @if (Item.SourceUrl is { } source && source.StartsWith("https://", StringComparison.Ordinal))
                {
                    <a class="small" href="@source" rel="external">@T["Agenda.ToSource"]</a>
                }
            }
            else if (record.Status == BillRecordStatuses.Rejected)
            {
                <span class="small">@T["Agenda.TakingPartClosed"]</span>
            }
            else
            {
                <RecordFigures Record="record" HideNobody="@(record.Status == BillRecordStatuses.Open)" Id="@Place" />
                @if (record.Status != BillRecordStatuses.Closed)
                {
                    @* A visitor: the sides lead to signing in and back to the bill's page (design 6.9), where the side is taken. *@
                    <div class="tl-ask">
                        <span class="small">@U["Agenda.Ask"]</span>
                        <div class="tl-ask__sides sides">
                            @foreach (var side in Sides.All)
                            {
                                <a class="btn btn--@side cta" id="home-@side-@Place" href="@SignInHref" aria-label="@U.Format("Agenda.Ask." + side, Item.Number)">@U[side == Sides.For ? "Agenda.For" : "Agenda.Against"]</a>
                            }
                        </div>
                    </div>
                }
            }
        </div>
    }
</li>

@code {
    [Parameter, EditorRequired] public AgendaItemResponse Item { get; set; } = default!;

    /// <summary>
    /// The sitting day the row is under: part of its id, since a bill may be planned on more than one day. None in the list of
    /// bills, which has no day bands: the row's place is then the bill's number.
    /// </summary>
    [Parameter] public DateOnly? Day { get; set; }

    /// <summary>More tags after the stage, in the list the planned date ("Planuojama …"); none when not given.</summary>
    [Parameter] public RenderFragment? Tags { get; set; }

    /// <summary>More lines under the title, in the list the participants and arguments and the latest activity; none when not given.</summary>
    [Parameter] public RenderFragment? Details { get; set; }

    /// <summary>Rendered for a signed-in member: the mark and the side column become islands. The same HTML for every member.</summary>
    [Parameter] public bool Member { get; set; }

    /// <summary>Every bill the page shows, for the members' islands to ask about in one request.</summary>
    [Parameter] public IReadOnlyList<string> Numbers { get; set; } = [];


    private string BillPath => "/seimas/" + Uri.EscapeDataString(Item.Number);

    private string SignInHref => LandingPath.SignInLink(BillPath);

    private string Place => Day is { } day ? Display.Day(day) + "-" + Item.Number : Item.Number;

    private string RowId => Day is { } day ? Lt2.Web.Client.Agenda.AgendaPaging.PlannedRowId(day, Item.Number) : "bill-" + Item.Number;
}
