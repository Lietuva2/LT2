@using Lt2.Api.Contracts.Agenda
@inject IStringLocalizer<PageText> T
@inject IStringLocalizer<Lt2.Web.Components.Appeals.AppealText> A

@* A bill's public numbers in the front page's timeline (design 8.7): both sides with the count for accounts older than 30
   days in brackets, the bar and the threshold; a bill nobody took part in says so. The page explains the brackets and
   says the numbers are not a representative poll right under the timeline. For a member, "nobody yet" is said by the
   member's island (MyAgendaMark, part "nobody"): the page's agenda is up to a minute old, so a member who has just taken
   a side must not read that nobody has; before the island has loaded, and for everyone else, the line is the same. *@
@if (Record.Counts.For + Record.Counts.Against == 0)
{
    @if (Member && Record.Status != "closed")
    {
        <MyAgendaMark Number="@Number" Numbers="Numbers" Place="@Place" Part="nobody" @rendermode="InteractiveWebAssembly" />
    }
    else
    {
        <span class="small">@T[Record.Status == "closed" ? "Agenda.NobodyClosed" : "Agenda.Nobody"]</span>
    }
}
else
{
    <span class="small num">
        <span class="choice choice--for">@T["Agenda.For"]</span> @Display.Number(Record.Counts.For) (@Display.Number(Record.Counts.ForOlderThan30Days))
        · <span class="choice choice--against">@T["Agenda.Against"]</span> @Display.Number(Record.Counts.Against) (@Display.Number(Record.Counts.AgainstOlderThan30Days))
    </span>
    <SplitBar For="Record.Counts.For" Against="Record.Counts.Against" Abstain="0" Small="true" />
    <span class="small num"><b>@Display.Number(Record.Threshold.Participants)</b> @A.Format("Threshold.Progress", Display.Number(Record.Threshold.Value))@(Record.Threshold.Reached ? " · " + T["Home.Reached"] : "")</span>
}

@code {
    [Parameter, EditorRequired] public AgendaRecordResponse Record { get; set; } = default!;

    /// <summary>Rendered for a signed-in member: "nobody yet" becomes the member's island (the same for every member).</summary>
    [Parameter] public bool Member { get; set; }

    [Parameter] public string Number { get; set; } = "";

    [Parameter] public IReadOnlyList<string> Numbers { get; set; } = [];

    /// <summary>The row's place, for the island's ids (see MyAgendaMark).</summary>
    [Parameter] public string Place { get; set; } = "";
}
