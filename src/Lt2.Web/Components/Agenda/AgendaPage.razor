@page "/darbotvarke"
@using Lt2.Api.Contracts.Agenda
@using Lt2.Web.Client.Agenda
@inject IAgendaApi Api
@inject Lt2.Api.Contracts.Digests.IDigestsApi Digests
@inject IStringLocalizer<PageText> T
@inject IStringLocalizer<Lt2.Web.Components.Appeals.AppealText> A
@inject Formats F

@* The agenda (design 8.11.1): public, server-rendered, readable without JavaScript. What the Seimas plans to consider, by
   day, earliest first, from the lrs.lt agenda (10–12 days ahead, changes often: "Planuojama …", never a countdown), and
   the stage votes of the last seven days. The rows are the front page's (TimelineItem, VotedItem; owner, 2026-11-19: they
   look the same, one component): a coming bill offers "Prašau balsuoti" in its row, a visitor's sides lead to signing in
   and back to the bill, a member's mark and side column are islands filled in the browser from their own answer
   (MyAgendaState), so the server renders the same page for every member and nothing per person is in it. Without the
   front page's "Jūsų projektai" and greeting. Read from the front page's copy, kept a minute (FrontPageAgenda through
   IAgendaApi). *@
<PageTitle>@T["Agenda.Title"] · Lietuva 2.0</PageTitle>
<LinkPreview Title="@T["Agenda.Title"]" Description="@T["Preview.Agenda"]" />

<div class="stack">
    <h1>@T["Agenda.Title"]</h1>
    <ProjectTabs Current="ProjectTab.Agenda" />
    <p class="lead">@T["Agenda.Lead"]</p>
    <AuthorizeView>
        <Authorized>
            <Lt2.Web.Client.Components.NeedsScript />
        </Authorized>
    </AuthorizeView>
</div>

<section class="sheet stack" aria-labelledby="h-coming" id="agenda-coming">
    <h2 id="h-coming">@T["Agenda.Coming"]</h2>
    <p class="small" id="agenda-source">
        @* An explicit space: Razor drops the white space between the sentences. *@
        @T["Agenda.Source"]@(" ")
        @if (_agenda?.AgendaReadAt is { } readAt)
        {
            @T.Format("Agenda.ReadAt", Display.DayTime(readAt))
        }
        else
        {
            @T["Agenda.NeverRead"]
        }
        @if (_agenda?.AgendaSourceUrl is { } source && source.StartsWith("https://", StringComparison.Ordinal))
        {
            @(" ")<a href="@source" rel="external">@T["Agenda.SourceLink"]</a>
        }
    </p>
    @if (_agenda is null || _agenda.Days.Count == 0)
    {
        <p id="agenda-none">@T["Agenda.NonePlanned"]</p>
    }
    else
    {
        <AuthorizeView>
            <Authorized>@Coming(true)</Authorized>
            <NotAuthorized>@Coming(false)</NotAuthorized>
        </AuthorizeView>
    }
</section>

<section class="sheet stack" aria-labelledby="h-recent" id="agenda-recent">
    <h2 id="h-recent">@T["Agenda.Recent"]</h2>
    @if (_agenda is null || _agenda.RecentVotes.Count == 0)
    {
        <p id="agenda-no-recent">@T["Agenda.NoRecent"]</p>
    }
    else
    {
        <AuthorizeView>
            <Authorized>@Recent(true)</Authorized>
            <NotAuthorized>@Recent(false)</NotAuthorized>
        </AuthorizeView>
    }
    @* Design 8.18: the long form of this list, also when the last seven days had no vote. *@
    <p class="tl-older" id="agenda-votes-older"><a href="@Lt2.Web.Client.Parliament.VoteHistory.Path">@T["Agenda.Older"]</a></p>
</section>

@* Design 8.15: "riba" repeats in the rows, so what it is is said once, beside the list's note (a hint). *@
<p class="small" id="agenda-older-note">@T["Agenda.OlderNote"]@if (_threshold is { } threshold)
    {
        @(" · ")<Lt2.Web.Client.Components.Hint Id="threshold-what" Text="@A["Threshold.What"]" Answer="@(A["Threshold.Meaning"] + " " + A.Format("Threshold.NowList", Display.Number(threshold)))" More="/metodika#riba" />
    }@* Design 8.18, "The majority": what the voted rows' chip means, once beside the list. *@@(" · ")<MajorityHint /></p>
<p class="note note--quiet" id="not-a-poll">@A["NotAPoll"]</p>

@code {
    private AgendaResponse? _agenda;

    /// <summary>The threshold that holds now for a bill without its own (a runtime setting), for the hint beside the list.</summary>
    private int? _threshold;

    /// <summary>The planned days shown grown, with the known rows each shows (<c>?diena=2026-11-24:60</c>), for the links.</summary>
    private IReadOnlyDictionary<DateOnly, int> _planned = new Dictionary<DateOnly, int>();

    /// <summary>The voted days shown grown (<c>?balsuota=</c>).</summary>
    private IReadOnlyDictionary<DateOnly, int> _voted = new Dictionary<DateOnly, int>();

    /// <summary>Each planned day with its rows as the page cuts them.</summary>
    private List<(DateOnly Day, AgendaDayView<AgendaItemResponse> View)> _coming = [];

    /// <summary>Each voted day, newest first, with its rows as the page cuts them.</summary>
    private List<(DateOnly Day, AgendaDayView<AgendaVoteResponse> View)> _recent = [];

    /// <summary>
    /// The bills of the rows shown, each once, for a member's islands to ask about (<c>/me/bills</c>, in requests of
    /// <see cref="Lt2.Api.Contracts.Me.MyBillsQuery.MaxNumbers"/>; more with a day grown).
    /// </summary>
    private IReadOnlyList<string> _numbers = [];

    [SupplyParameterFromQuery(Name = AgendaPaging.PlannedParameter)] public string[]? Planned { get; set; }

    [SupplyParameterFromQuery(Name = AgendaPaging.VotedParameter)] public string[]? Voted { get; set; }

    protected override async Task OnParametersSetAsync()
    {
        var planned = AgendaPaging.Read(Planned);
        var voted = AgendaPaging.Read(Voted);
        _agenda = (await Api.GetAgendaAsync()).Value;
        _threshold = (await Digests.GetRulesAsync()).Value?.ThresholdDefault;

        // Owner, 2026-11-18: one block per sitting day with its date, weekday and count; the first ten rows of a day in the
        // agenda's order (AgendaRules). Owner, 2026-11-19: then the shared "Rodyti daugiau", 50 more a click by the address
        // (AgendaPaging, ?diena=2026-11-24:60), landing on the first row added: the served page holds only the rows it shows.
        _coming = (_agenda?.Days ?? [])
            .Select(d => (d.Date, Cut(d.Items, i => i.Title is not null, planned.GetValueOrDefault(d.Date))))
            .ToList();
        _recent = (_agenda?.RecentVotes ?? []).GroupBy(v => Display.DayOf(v.HeldAt))
            .Select(g => (g.Key, Cut(g.ToList(), _ => true, voted.GetValueOrDefault(g.Key))))
            .ToList();
        _planned = AgendaPaging.Grown(_coming.Select(d => (d.Day, d.View.Shown.Count)), AgendaRules.PagePerDay);
        _voted = AgendaPaging.Grown(_recent.Select(d => (d.Day, d.View.Shown.Count)), AgendaRules.PagePerDay);
        _numbers = AgendaRules.Asked(
            _coming.SelectMany(d => d.View.Shown.Select(i => i.Number)).Concat(_recent.SelectMany(d => d.View.Shown.Select(v => v.Number))));
    }

    /// <summary>A day cut for this page: its first ten known rows, or as many as the address asks.</summary>
    private static AgendaDayView<TRow> Cut<TRow>(IReadOnlyList<TRow> rows, Func<TRow, bool> known, int asked) =>
        AgendaRules.Day(rows, known, AgendaRules.ShownKnown(AgendaRules.PagePerDay, asked, rows.Count(known)));

    private RenderFragment Coming(bool member) => __builder =>
    {
        foreach (var (day, view) in _coming)
        {
            <PlannedDay Page="AgendaPaging.Agenda" Day="day" View="view" First="AgendaRules.PagePerDay" Planned="_planned" Voted="_voted" Member="member" Numbers="_numbers" />
        }
    };

    private RenderFragment Recent(bool member) => __builder =>
    {
        // By day, newest first, each in the agenda's order, grown as the planned days.
        foreach (var (day, view) in _recent)
        {
            <VotedDay Page="AgendaPaging.Agenda" Day="day" View="view" First="AgendaRules.PagePerDay" Planned="_planned" Voted="_voted" Member="member" Numbers="_numbers" />
        }
    };
}
