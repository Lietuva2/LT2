@using Lt2.Api.Contracts.Agenda
@inject IStringLocalizer<PageText> T

@* A bill's public numbers in an agenda row (design 8.11.1, 8.12.5): both sides with the count for accounts older than 30
   days in brackets, and the progress to the threshold; a bill nobody took part in says so. Each links to the bill's page.
   The page around it says the numbers are not a representative poll. *@
@if (Appeal.Status == "rejected")
{
    <span class="small">@T["Agenda.TakingPartClosed"]</span>
    <a class="small" href="@BillPath">@T["Agenda.ToBill"]</a>
}
else if (Appeal.Counts.For + Appeal.Counts.Against == 0)
{
    <span class="small">@T[Appeal.Status == "closed" ? "Agenda.NobodyClosed" : "Agenda.Nobody"]</span>
    <a class="small" href="@BillPath">@T[Appeal.Status == "closed" ? "Agenda.ToBill" : "Agenda.TakePart"]</a>
}
else
{
    <span class="small num">
        <span class="choice choice--for">@T["Agenda.For"]</span> @Display.Number(Appeal.Counts.For) (@Display.Number(Appeal.Counts.ForOlderThan30Days))
        · <span class="choice choice--against">@T["Agenda.Against"]</span> @Display.Number(Appeal.Counts.Against) (@Display.Number(Appeal.Counts.AgainstOlderThan30Days))
    </span>
    <span class="small num">@T.Format("Agenda.Threshold", Display.Number(Appeal.Threshold.Participants), Display.Number(Appeal.Threshold.Value))</span>
    <a class="small" href="@BillPath">@T[Appeal.Status == "closed" ? "Agenda.ToClosedAppeal" : "Agenda.ToAppeal"]</a>
}

@code {
    [Parameter, EditorRequired] public AgendaAppealResponse Appeal { get; set; } = default!;

    [Parameter, EditorRequired] public string Number { get; set; } = "";

    private string BillPath => "/seimas/" + Uri.EscapeDataString(Number);
}
