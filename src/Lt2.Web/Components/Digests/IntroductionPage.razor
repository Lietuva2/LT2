@page "/suvestines/pristatymas"
@using Lt2.Api.Contracts.Digests
@inject IDigestsApi Digests
@inject IStringLocalizer<AppealText> T

@* Design 8.19.5: the introduction letter as it was sent to MPs, with its date and signer, and the earlier versions. Public and
   server-rendered; never who wrote it on the site or to whom it went. *@
<PageTitle>@T["Intro.Title"] · Lietuva 2.0</PageTitle>
<LinkPreview Title="@T["Intro.Title"]" />

<div class="stack">
    <ol class="crumbs">
        <li><a href="/suvestines">@T["Digests.Title"]</a></li>
        <li>@T["Intro.Title"]</li>
    </ol>
    <p class="label">@T["Digests.Label"]</p>
    <h1>@T["Intro.Title"]</h1>
    @if (_letters is not { Count: > 0 })
    {
        <p class="lead" id="intro-none">@T["Intro.None"]</p>
    }
    else
    {
        <p class="lead">@T["Intro.Lead"]</p>
    }
</div>

@if (_letters is { Count: > 0 } letters)
{
    var current = letters[0];
    <article class="sheet stack" aria-labelledby="intro-subject" id="intro-current">
        <p class="small num" id="intro-sent">@T.Format("Intro.Sent", current.SentAt is { } at ? Display.Day(at) : "")</p>
        <h2 id="intro-subject">@current.Subject</h2>
        <Lt2.Web.Client.Components.TypedText Text="@current.Text" />
        <p id="intro-signer"><b>@current.SignerName</b><br />@current.SignerRole</p>
        @if (letters.Count > 1)
        {
            <details class="more stack stack--tight" id="intro-earlier">
                <summary class="linkish small">@T["Intro.Earlier"]</summary>
                @* Owner, 2026-11-18: newest first, each version with what its text changed against the one before it
                   (TextChanges), the oldest whole; the letter in force opens the list with its changes. *@
                <div class="sheet--quiet stack stack--tight" id="intro-changes-@current.Version">
                    <p class="small num">@T.Format("Intro.Current", current.SentAt is { } currentAt ? Display.Day(currentAt) : "")</p>
                    <Lt2.Web.Client.Components.TextChanges Old="@letters[1].Text" New="@current.Text" />
                </div>
                @for (var i = 1; i < letters.Count; i++)
                {
                    var letter = letters[i];
                    <div class="sheet--quiet stack stack--tight" id="intro-version-@letter.Version">
                        <p class="small num">@T.Format("Intro.Sent", letter.SentAt is { } sentAt ? Display.Day(sentAt) : "")</p>
                        <h3>@letter.Subject</h3>
                        <Lt2.Web.Client.Components.TextChanges Old="@(i + 1 < letters.Count ? letters[i + 1].Text : null)" New="@letter.Text" />
                        <p><b>@letter.SignerName</b><br />@letter.SignerRole</p>
                    </div>
                }
            </details>
        }
    </article>
}

@code {
    private IReadOnlyList<IntroductionLetterResponse>? _letters;

    protected override async Task OnInitializedAsync() => _letters = (await Digests.GetIntroductionAsync()).Value;
}
