@page "/suvestines"
@page "/suvestines/{Date}"
@using Lt2.Api.Contracts.Digests
@inject IDigestsApi Digests
@inject IStringLocalizer<AppealText> T
@inject IStringLocalizer<Lt2.Web.Client.Appeals.AppealUi> U
@inject Formats F
@inject NavigationManager Navigation
@inject IStringLocalizer<Lt2.Web.Components.PageText> P

@* The public record of the summaries (design 8.7, design/ui/suvestines.html): the frozen numbers and arguments, both
   sides, the 30-day counts and the surge note, without MP-specific figures and without any person. In M2a every summary
   is a dry run: made, published here, never sent. *@
@if (_runs is { Count: > 0 } runs)
{
    <PageTitle>@(Single is { } one ? RunTitle(one) : T["Digests.Title"] + " " + (Date ?? "")) · Lietuva 2.0</PageTitle>
    @* Design 8.22.5: the summaries' public copy; never the numbers in the preview. *@
    <LinkPreview Title="@(Single is { } shared ? RunTitle(shared) : (T["Digests.Title"] + " " + (Date ?? "")).Trim())" Description="@P["Preview.Digest"]" />
    <div class="stack">
        <ol class="crumbs">
            <li><a href="/suvestines">@T["Digests.Title"]</a></li>
            @if (Date is not null)
            {
                <li>@Date</li>
            }
        </ol>
        <p class="label">@T["Digests.Label"]</p>
        @* Owner, 2026-11-17: a day with one summary has one title, its kind and date; a day with several keeps the day's title
           and a heading per summary. *@
        <h1 id="@(Single is { } single ? "h-" + single.Id : null)">@(Date is null ? T["Digests.Title"] : Single is { } only ? RunTitle(only) : T.Format("Digests.Of", F.Date(runs[0].RunDate)))</h1>
        @if (Date is null)
        {
            <ProjectTabs Current="ProjectTab.Digests" />
        }
        <p class="lead">@T["Digests.Lead"]</p>
        @if (_rules?.Sending is null or "off")
        {
            <p class="note" id="dry-run">@T["Digests.DryRun"]</p>
        }
    </div>

    <div class="cols">
        <div class="stack stack--loose">
            @foreach (var run in Date is null ? runs.Take(1) : runs)
            {
                <section class="stack" aria-labelledby="h-@run.Id" id="run-@run.Id">
                    @if (Single is null)
                    {
                        <h2 id="h-@run.Id">@RunTitle(run)</h2>
                    }
                    @* Design 8.19.2: what happened to it, in one line under the date; never which MPs. *@
                    <p class="small num" id="run-status-@run.Id">@StatusLine(run)</p>
                    @if (run.Status == "cancelled" && run.Statement is { } statement)
                    {
                        <p class="small" id="run-statement-@run.Id">@T.Format("Digests.Statement", statement)</p>
                    }
                    <div class="row">
                        <span class="tag num">@T.Format("Digests.Items", Display.Number(run.Items.Count))</span>
                        @if (Date is null)
                        {
                            <a href="/suvestines/@Display.Day(run.RunDate)">@T["Digests.Open"]</a>
                        }
                    </div>
                    @foreach (var item in ItemsOf(run))
                    {
                        <section class="sheet stack" aria-label="@item.BillNumber" id="@DigestRoutes.ItemAnchor(run.Id, item.BillNumber)">
                            <div class="row">
                                <span class="tag tag--ink num">@item.BillNumber</span>
                                @if (item.Stage is { } stage)
                                {
                                    <span class="tag">@F.Stage(stage)</span>
                                }
                                @if (item.PlannedDate is { } planned)
                                {
                                    <span class="tag">@T.Format("Planned", F.T["Month." + planned.Month], planned.Day)</span>
                                }
                            </div>
                            <h3><a href="/seimas/@Uri.EscapeDataString(item.BillNumber)">@item.BillTitle</a></h3>
                            <div class="pair pair--keep">
                                <div class="figure figure--for figure--m">
                                    <span class="label">@U["Sides.for"]</span>
                                    <span class="figure__num">@Display.Number(item.For)</span>
                                    <span class="small num">@U.Format("Sides.Older", Display.Number(item.ForOlderThan30Days))</span>
                                </div>
                                <div class="figure figure--against figure--m">
                                    <span class="label">@U["Sides.against"]</span>
                                    <span class="figure__num">@Display.Number(item.Against)</span>
                                    <span class="small num">@U.Format("Sides.Older", Display.Number(item.AgainstOlderThan30Days))</span>
                                </div>
                            </div>
                            <SplitBar For="item.For" Against="item.Against" Abstain="0" Small="true" />
                            @if (item.SurgeSharePercent is { } share)
                            {
                                <p class="note">@U.Format("Surge.Note", Display.Number(item.SurgeWindowHours), Display.Number(share))</p>
                            }
                            <div class="pair">
                                @foreach (var side in new[] { "for", "against" })
                                {
                                    <div class="stack stack--tight">
                                        <h4><span class="choice choice--@side">@T["Digests.Side." + side]</span></h4>
                                        @if (!item.Reasons.Any(r => r.Side == side))
                                        {
                                            <p class="small">@T["Digests.NoReasons"]</p>
                                        }
                                        @foreach (var (reason, n) in item.Reasons.Where(r => r.Side == side).Select((r, i) => (r, i + 1)))
                                        {
                                            var anchor = DigestRoutes.ReasonAnchor(run.Id, item.BillNumber, side, n);
                                            @* Design 8.2, 8.19.3 (owner, 2026-11-16): a long argument shows its beginning and "Rodyti daugiau";
                                               the MPs' email shows the same beginning and links here, "Visas argumentas", by this anchor. *@
                                            <div class="said" id="@anchor">
                                                <Lt2.Web.Client.Components.LongText Text="@reason.Text" BubbleClass="bubble bubble--people bubble--nameless voice" Id="@(anchor + "-more")" />
                                                <div class="said__by"><span class="num">@T.Format("Digests.Endorsed", Display.Number(reason.Endorsements))</span></div>
                                            </div>
                                        }
                                    </div>
                                }
                            </div>
                        </section>
                    }
                </section>
            }
        </div>

        <aside class="stack">
            @* Design 8.15: who would receive a summary, when and what goes in are on the methodology page. *@
            <p><a href="/metodika#suvestiniu-taisykles" id="digest-how">@T["Digests.HowLink"]</a></p>
            <p><a href="@DigestRoutes.IntroductionPage" id="digest-introduction">@T["Digests.IntroductionLink"]</a></p>
            @if (Date is null && runs.Count > 1)
            {
                <section class="stack stack--tight" aria-labelledby="h-earlier">
                    <h3 id="h-earlier">@T["Digests.Earlier"]</h3>
                    <ul class="rows">
                        @foreach (var run in runs.Skip(1))
                        {
                            <li><div class="rows__main"><a href="/suvestines/@Display.Day(run.RunDate)" class="num">@Display.Day(run.RunDate)</a><span class="small">@T["Digests.Kind." + run.Kind] · @T.Format("Digests.Items", Display.Number(run.Items.Count))</span></div></li>
                        }
                    </ul>
                </section>
            }
            <p class="note note--quiet" id="not-a-poll">@T["NotAPoll"]</p>
        </aside>
    </div>
}
else
{
    <PageTitle>@T["Digests.Title"] · Lietuva 2.0</PageTitle>
    <LinkPreview Title="@T["Digests.Title"]" Description="@P["Preview.Digest"]" />
    <div class="stack">
        <h1>@T["Digests.Title"]</h1>
        @if (Date is null)
        {
            <ProjectTabs Current="ProjectTab.Digests" />
        }
        <p class="lead" id="no-digests">@T["Digests.None"]</p>
        @* Design 8.15: before the first summary too, what summaries are and who would get them is one click away. *@
        <p><a href="/metodika#suvestiniu-taisykles" id="digest-how">@T["Digests.HowLink"]</a></p>
        <p><a href="@DigestRoutes.IntroductionPage" id="digest-introduction">@T["Digests.IntroductionLink"]</a></p>
        <p class="note note--quiet">@T["NotAPoll"]</p>
    </div>
}

@code {
    private IReadOnlyList<DigestRunResponse>? _runs;
    private DigestRulesResponse? _rules;

    [Parameter] public string? Date { get; set; }

    /// <summary>
    /// A bill's number from its page's link (<see cref="DigestRoutes.PageAt"/>, owner 2026-11-17): on a date's page, the day's
    /// summaries holding it come first and its item is first in each, so it stands under the title with nothing scrolled.
    /// </summary>
    [SupplyParameterFromQuery(Name = DigestRoutes.BillParameter)] public string? Bill { get; set; }

    /// <summary>The day's only summary on a date's page, which then has one title; null on the list or a day with several.</summary>
    private DigestRunResponse? Single => Date is not null && _runs is { Count: 1 } runs ? runs[0] : null;

    /// <summary>"Savaitinė suvestinė · 2026 m. lapkričio 16 d."</summary>
    private string RunTitle(DigestRunResponse run) => T["Digests.Kind." + run.Kind] + " · " + F.Date(run.RunDate);

    private bool Holds(DigestRunResponse run) =>
        Bill is { } number && run.Items.Any(i => string.Equals(i.BillNumber, number, StringComparison.OrdinalIgnoreCase));

    /// <summary>The run's items, the linked bill's first (an ordered sort is stable: the rest keep their order).</summary>
    private IEnumerable<DigestItemResponse> ItemsOf(DigestRunResponse run) =>
        Date is not null && Holds(run) ? run.Items.OrderBy(i => string.Equals(i.BillNumber, Bill, StringComparison.OrdinalIgnoreCase) ? 0 : 1) : run.Items;

    /// <summary>The public copy's one line (design 8.19.2): a dry run, sent to how many and when, or declined.</summary>
    private string StatusLine(DigestRunResponse run) => run.Status switch
    {
        "sent" => T.Format("Digests.Line.sent", Display.Number(run.SentCount), run.SentAt is { } at ? Display.DayTime(at) : ""),
        "cancelled" => T["Digests.Line.cancelled"],
        _ => T["Digests.Line.dry-run"],
    };

    protected override async Task OnParametersSetAsync()
    {
        _rules ??= (await Digests.GetRulesAsync()).Value;
        if (Date is null)
        {
            _runs = (await Digests.GetDigestsAsync()).Value;
            return;
        }

        if (!DateOnly.TryParseExact(Date, "yyyy-MM-dd", System.Globalization.CultureInfo.InvariantCulture, System.Globalization.DateTimeStyles.None, out var day))
        {
            Navigation.NotFound();
            return;
        }

        _runs = (await Digests.GetDigestAsync(day)).Value;
        if (_runs is not { Count: > 0 })
        {
            Navigation.NotFound();
            return;
        }

        if (Bill is not null)
        {
            _runs = _runs.OrderBy(r => Holds(r) ? 0 : 1).ToList();
        }
    }
}