<!DOCTYPE html>
<html lang="lt">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="color-scheme" content="light dark" />
    <base href="/" />
    <link rel="icon" type="image/svg+xml" href="@Assets["favicon.svg"]" />
    <link rel="stylesheet" href="@Assets["fonts/fonts.css"]" />
    <link rel="stylesheet" href="@Assets["css/lt2.css"]" />
    @* Not deferred: a stored theme choice applies before the first paint (design/ui/README.md). *@
    <script src="@Assets["js/lt2-theme.js"]"></script>
    <HeadOutlet />
</head>
<body>
    @* Shown by js/lt2-navigation.js while an enhanced navigation waits for the next page (design 8.21). *@
    <div class="nav-progress" id="nav-progress" aria-hidden="true"></div>
    <Routes />
    <div id="blazor-error-ui" role="alert">
        @T["Error.Ui"] <a href="" class="reload">@T["Error.Reload"]</a>
    </div>
    <script src="@Assets["js/lt2-logo-spin.js"]" defer></script>
    <script src="@Assets["js/lt2-feedback.js"]" defer></script>
    <script src="@Assets["js/lt2-account.js"]" defer></script>
    @* Before Blazor starts: a link's invitation code leaves the address bar before anything reads the address (design 8.11.5). *@
    <script src="@Assets["js/lt2-invitation.js"]"></script>
    <script src="@Assets["_framework/blazor.web.js"]"></script>
    <script src="@Assets["js/lt2-theme-blazor.js"]"></script>
    <script src="@Assets["js/lt2-disclosures.js"]"></script>
    <script src="@Assets["js/lt2-switch.js"]"></script>
    <script src="@Assets["js/lt2-return.js"]"></script>
    <script src="@Assets["js/lt2-navigation.js"]"></script>
    <script src="@Assets["js/lt2-hints.js"]" defer></script>
    <script src="@Assets["js/lt2-dates.js"]" defer></script>
    <script src="@Assets["js/lt2-cards.js"]" defer></script>
    <script src="@Assets["js/lt2-menus.js"]" defer></script>
</body>
</html>

@code {
    [Inject]
    private IStringLocalizer<PageText> T { get; set; } = default!;
}
