@page "/projektai"
@page "/projektai/uzdaryti"
@using Lt2.Api.Contracts.Agenda
@using Lt2.Api.Contracts.Appeals
@using Lt2.Web.Client.Appeals
@inject Lt2.Web.Services.Islands Islands
@inject IStringLocalizer<Lt2.Web.Components.PageText> P
@inject IAppealsApi Appeals
@inject IStringLocalizer<AppealText> T
@inject Formats F
@inject NavigationManager Navigation

@* The bills people can take part on (design 8.12.5, GET /appeals), server-rendered and readable without JavaScript: every
   active bill, by activity (participants plus published arguments plus followers; no row shows the followers) unless sorted by planned date or by the latest activity
   (owner, 2026-11-17: those three orders; in the last each row says "Paskutinė veikla …"). The search is a plain form with the box "Planuojami per 14 dienų", applied with
   "Rodyti" (owner, 2026-11-21); the order (keeping the search and the filter), the closed view and "Rodyti daugiau" are
   plain links. The closed view is its own address, /projektai/uzdaryti (owner, 2026-11-23), the same page; every address the
   page builds stays on the view it is on, and no query parameter chooses the view. Each row is the agenda's (TimelineItem, owner 2026-11-23) with the number of arguments added to its participants'
   line in the right column (owner, 2026-11-23). Nothing
   stands under the list: what the numbers are and what "riba" is are said on the bill's page and the methodology (owner,
   2026-11-21). *@
<PageTitle>@T["List.Title"] · Lietuva 2.0</PageTitle>
<LinkPreview Title="@T["List.Title"]" Description="@P["Preview.Projects"]" />

@* Design 8.16.5, 8.21 (owner, 2026-11-21): the list's sheet has no heading of its own, so the tab row of "Seimas" stays at
   the top of the screen while the list scrolls past; the heading above it, the views of the tab ("Darbotvarkė",
   "Aktyvūs", "Uždaryti"), the lead and the search scroll away. *@
<SeimasHead Current="SeimasTab.Projects" />
<div class="stack page-head__rest">
    <ProjectViews Current="@(Closed ? ProjectView.Closed : ProjectView.Active)" />
    <p class="lead">@(Closed ? T["List.Lead.Closed"] : T["List.Lead.Active"])</p>
    <AuthorizeView>
        <Authorized>
            <Lt2.Web.Client.Components.NeedsScript />
        </Authorized>
    </AuthorizeView>
    <form class="filters" method="get" action="@Base" role="search" id="bill-search">
        @if (!Closed && Sort != "aktyvumas")
        {
            <input type="hidden" name="rikiuoti" value="@Sort" />
        }
        <div class="field">
            <label for="q">@T["List.Search"]</label>
            <input class="input" id="q" name="q" type="search" value="@Q" autocomplete="off" />
        </div>
        @if (!Closed)
        {
            @* Owner, 2026-11-21: the filter is a box in the search form, right above "Rodyti", applied with it. *@
            <label class="check small"><input type="checkbox" id="planned-only" name="planuojami" value="taip" checked="@Planned" /><span>@T["List.Planned"]</span></label>
        }
        @* "Tik mano": a member's own bills instead of the list (design 8.12.5); an island, so nothing of any member is in this page. *@
        <MineOnlyBox @rendermode="Islands.Mode" />
        <div class="row">
            <button class="btn" type="submit">@T["List.SearchButton"]</button>
            @if (Filtered)
            {
                <a href="@Base">@T["List.Clear"]</a>
            }
        </div>
    </form>
</div>

@if (!Closed)
{
    <p class="small" id="sort">
        @T["List.Sort"]@(" ")
        @for (var i = 0; i < SortNames.Length; i++)
        {
            var name = SortNames[i];
            @if (i > 0)
            {
                @(" · ")
            }
            @if (name == Sort)
            {
                <b aria-current="true" id="sort-@name">@T["List.Sort." + name]</b>
            }
            else
            {
                <a href="@Link(null, name, Planned)" id="sort-@name">@T["List.Sort." + name]</a>
            }
        }
    </p>
}

@* "Mano projektai" while "Tik mano" is ticked; the list below and its order line are then hidden by CSS (lt2.css). *@
<MineBills @rendermode="Islands.Mode" />

@if (_page is { } page)
{
    <div class="sheet stack" id="appeal-results">
        <p class="small num" role="status" id="found">@T.Format("List.Found", Display.Number(page.Total))</p>
        @if (_other > 0)
        {
            @* A search says what it found in the other view too (owner, 2026-11-23): one line, shown only when the other view
               has a match; the order and the filter belong to the active view and are not carried over. *@
            <p class="small num" id="@(Closed ? "other-active" : "other-closed")"><a href="@OtherLink()">@T.Format(Closed ? "List.OtherActive" : "List.OtherClosed", Display.Number(_other))</a></p>
        }
        @if (page.Items.Count == 0)
        {
            <p id="no-appeals">@T[Closed ? "List.EmptyClosed" : "List.Empty"]</p>
        }
        else
        {
            @* Owner, 2026-11-23: each row is the agenda's and the front page's (TimelineItem): number and stage, title, the
               organisations, both sides' figures with the bar and the threshold, "Prašau balsuoti" for a visitor (links to sign
               in and back) and, for a member, the islands of their own mark and side column, filled in the browser; the same
               HTML for every member (as AgendaPage). A closed record has no sides to take. What only this list says comes as
               the row's Tags and Details. *@
            <ul class="tl-items" id="appeals">
                <AuthorizeView>
                    <Authorized>@Rows(true)</Authorized>
                    <NotAuthorized>@Rows(false)</NotAuthorized>
                </AuthorizeView>
            </ul>
            @* Owner, 2026-11-18: the list grows in place by the address (as 8.18). *@
            <Lt2.Web.Client.Components.ShowMore Id="more" StatusId="shown" Shown="_offset + Math.Min(_shown, page.Items.Count)" Total="page.Total"
                Href="@(BillListPaging.More(_shown, _offset, page.Total) is { } more ? Link(From, Sort, Planned, more) : null)">
                @if (BillListPaging.Further(_shown, _offset, page.Total) is { } further)
                {
                    <a href="@Link(further.ToString(System.Globalization.CultureInfo.InvariantCulture), Sort, Planned)" id="further">@T["List.Further"]</a>
                }
            </Lt2.Web.Client.Components.ShowMore>
        }
    </div>
}


@code {
    private BillListResponse? _page;

    /// <summary>
    /// The bills of the rows shown, each once, for a member's islands to ask about in one request (<c>/me/bills</c>, in requests of
    /// <see cref="Lt2.Api.Contracts.Me.MyBillsQuery.MaxNumbers"/>); "Rodyti daugiau" adds rows whose islands start in place.
    /// </summary>
    private IReadOnlyList<string> _numbers = [];

    private RenderFragment Rows(bool member) => __builder =>
    {
        foreach (var item in _page!.Items.Take(_shown))
        {
            <TimelineItem @key="item.Bill.Number" Item="AsRow(item)" Member="member" Numbers="_numbers">
                <Tags>
                    @if (item.Planned is { } plan)
                    {
                        <span class="tag">@T.Format("Planned", F.T["Month." + plan.Date.Month], plan.Date.Day)</span>
                    }
                </Tags>
                <Details>
                    @if (Sort == "naujausia" && item.LastActivityAt is { } last)
                    {
                        @* Owner, 2026-11-17: in this order each row says when the bill last saw activity. *@
                        <span class="small num" id="last-@item.Bill.Number">@T.Format("List.LastActivity", Display.DayTime(last))</span>
                    }
                </Details>
            </TimelineItem>
        }
    };

    /// <summary>The list's item as the shared row takes it: the stage is the planned item's, the figures the record's public numbers.</summary>
    private static AgendaItemResponse AsRow(BillListItemResponse item) => new(
        item.Bill.Number, item.Bill.Title, item.Planned?.Stage, item.Planned?.SetByModerator ?? false, item.Planned?.SourceUrl,
        new AgendaRecordResponse(item.Id, item.Status, item.Counts, item.Threshold) { Summary = item.Summary, Arguments = item.Arguments }, item.Organisations, item.Bill.PlainTitle);

    [SupplyParameterFromQuery(Name = "q")] public string? Q { get; set; }

    [SupplyParameterFromQuery(Name = "planuojami")] public string? PlannedFlag { get; set; }

    [SupplyParameterFromQuery(Name = "nuo")] public string? From { get; set; }

    [SupplyParameterFromQuery(Name = "rikiuoti")] public string? SortParameter { get; set; }

    /// <summary>How many bills the page shows (owner, 2026-11-18: "Rodyti daugiau" grows the list in place).</summary>
    [SupplyParameterFromQuery(Name = "rodyti")] public string? Show { get; set; }

    /// <summary>How many bills the same query finds in the other view (0 without a query).</summary>
    private int _other;

    private int _shown = BillListPaging.First;
    private int _offset;

    /// <summary>
    /// The orders on the page (design 8.12.5; owner, 2026-11-17: activity, planned date and the latest activity), in Lithuanian
    /// in the address; the first is the default, and any other value (an old <c>dalyviai</c> or <c>argumentai</c>) falls back to it.
    /// </summary>
    private static readonly string[] SortNames = ["aktyvumas", "data", "naujausia"];

    private static readonly Dictionary<string, string> ApiSorts = new()
    {
        ["aktyvumas"] = "activity", ["data"] = "planned", ["naujausia"] = "latest",
    };

    private string Sort => SortParameter is { } s && ApiSorts.ContainsKey(s) ? s : "aktyvumas";

    /// <summary>
    /// The page is the closed view (owner, 2026-11-23): decided by the address, <c>/projektai/uzdaryti</c> against <c>/projektai</c>;
    /// no query parameter chooses it. Set with the parameters, so a move between the views by enhanced navigation re-reads it.
    /// </summary>
    private bool Closed { get; set; }

    /// <summary>The address of the view the page is: every link and the search form stay on it.</summary>
    private string Base => Closed ? MenuSections.ClosedProjectsPath : MenuSections.ProjectsPath;

    private bool Planned => !Closed && PlannedFlag == "taip";

    private bool Filtered => !string.IsNullOrWhiteSpace(Q) || Planned;


    protected override async Task OnParametersSetAsync()
    {
        Closed = string.Equals(new Uri(Navigation.Uri).AbsolutePath.TrimEnd('/'), MenuSections.ClosedProjectsPath, StringComparison.OrdinalIgnoreCase);
        _shown = BillListPaging.Shown(Show);
        _offset = BillListPaging.Offset(From);
        _page = (await Appeals.GetAppealsAsync(Q, Planned, Closed, From, Closed ? null : ApiSorts[Sort], _shown)).Value;
        _other = string.IsNullOrWhiteSpace(Q)
            ? 0
            : (await Appeals.GetAppealsAsync(Q, false, !Closed, null, null, 1)).Value?.Total ?? 0;
        _numbers = AgendaRules.Asked((_page?.Items ?? []).Take(_shown).Select(i => i.Bill.Number));
    }

    /// <summary>The same search in the other view: only the search is carried, not the order or the filter.</summary>
    private string OtherLink() => (Closed ? MenuSections.ProjectsPath : MenuSections.ClosedProjectsPath) + "?q=" + Uri.EscapeDataString(Q!.Trim());

    /// <summary>The same search and view, with the given page (none = the first), order, filter and length (none = the first 20).</summary>
    private string Link(string? next, string sort, bool planned, int? shown = null)
    {
        var query = new List<string>();
        if (!Closed && sort != "aktyvumas")
        {
            query.Add("rikiuoti=" + sort);
        }

        if (!string.IsNullOrWhiteSpace(Q))
        {
            query.Add("q=" + Uri.EscapeDataString(Q.Trim()));
        }

        if (!Closed && planned)
        {
            query.Add("planuojami=taip");
        }

        if (next is not null)
        {
            query.Add("nuo=" + Uri.EscapeDataString(next));
        }

        if (shown is { } n && n != BillListPaging.First)
        {
            query.Add("rodyti=" + n.ToString(System.Globalization.CultureInfo.InvariantCulture));
        }

        return query.Count == 0 ? Base : Base + "?" + string.Join("&", query);
    }
}
