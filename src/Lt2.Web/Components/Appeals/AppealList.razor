@page "/projektai"
@using Lt2.Api.Contracts.Appeals
@using Lt2.Web.Client.Appeals
@inject IStringLocalizer<Lt2.Web.Components.PageText> P
@inject IAppealsApi Appeals
@inject Lt2.Api.Contracts.Digests.IDigestsApi Digests
@inject IStringLocalizer<AppealText> T
@inject Formats F

@* The bills people can take part on (design 8.12.5, GET /appeals), server-rendered and readable without JavaScript: every
   active bill, by activity (participants plus published arguments) unless sorted by planned date or by the latest activity
   (owner, 2026-11-17: those three orders; in the last each row says "Paskutinė veikla …"). The search is a plain form; the order, the filter "Planuojami per 14 dienų" (a link that applies at
   once, keeping the search), the closed tab and "Rodyti daugiau" are plain links. Each row shows its participants and
   arguments, and the sides' numbers beside its bar. *@
<PageTitle>@T["List.Title"] · Lietuva 2.0</PageTitle>
<LinkPreview Title="@T["List.Title"]" Description="@P["Preview.Projects"]" />

<div class="stack">
    <p class="label">Lietuva 2.0</p>
    <h1>@T["List.Title"]</h1>
    <ProjectTabs Current="ProjectTab.Bills" />
    <p class="lead">@T["List.Lead"]</p>
    <nav class="row tabs" aria-label="@T["List.Tabs"]">
        @if (Closed)
        {
            <a href="/projektai" id="tab-active">@T["List.Tab.Active"]</a>
            <b aria-current="page" id="tab-closed">@T["List.Tab.Closed"]</b>
        }
        else
        {
            <b aria-current="page" id="tab-active">@T["List.Tab.Active"]</b>
            <a href="/projektai?skirtukas=uzdaryti" id="tab-closed">@T["List.Tab.Closed"]</a>
        }
    </nav>
    <form class="filters" method="get" action="/projektai" role="search" id="bill-search">
        @if (Closed)
        {
            <input type="hidden" name="skirtukas" value="uzdaryti" />
        }
        else
        {
            @if (Sort != "aktyvumas")
            {
                <input type="hidden" name="rikiuoti" value="@Sort" />
            }
            @if (Planned)
            {
                <input type="hidden" name="planuojami" value="taip" />
            }
        }
        <div class="field">
            <label for="q">@T["List.Search"]</label>
            <input class="input" id="q" name="q" type="search" value="@Q" autocomplete="off" />
        </div>
        <div class="row">
            <button class="btn" type="submit">@T["List.SearchButton"]</button>
            @if (Filtered)
            {
                <a href="@(Closed ? "/projektai?skirtukas=uzdaryti" : "/projektai")">@T["List.Clear"]</a>
            }
        </div>
    </form>
</div>

@if (!Closed)
{
    @* Owner, 2026-11-17: the filter is a link that applies at once (no script), on the ground above the list with the order. *@
    <p class="small"><a class="toggle-link" href="@Link(null, Sort, !Planned)" id="planned" aria-current="@(Planned ? "true" : null)">@T["List.Planned"]</a></p>
    <p class="small" id="sort">
        @T["List.Sort"]@(" ")
        @for (var i = 0; i < SortNames.Length; i++)
        {
            var name = SortNames[i];
            @if (i > 0)
            {
                @(" · ")
            }
            @if (name == Sort)
            {
                <b aria-current="true" id="sort-@name">@T["List.Sort." + name]</b>
            }
            else
            {
                <a href="@Link(null, name, Planned)" id="sort-@name">@T["List.Sort." + name]</a>
            }
        }
    </p>
}

@if (_page is { } page)
{
    <div class="sheet stack" id="appeal-results">
        <p class="small num" role="status" id="found">@T.Format("List.Found", Display.Number(page.Total))</p>
        @if (page.Items.Count == 0)
        {
            <p id="no-appeals">@T[Closed ? "List.EmptyClosed" : "List.Empty"]</p>
        }
        else
        {
            <ul class="rows" id="appeals">
                @foreach (var item in page.Items.Take(_shown))
                {
                    <li id="bill-@item.Bill.Number" @key="item.Bill.Number">
                        <div class="rows__main">
                            <a href="/seimas/@Uri.EscapeDataString(item.Bill.Number)"><b>@item.Bill.Title</b></a>
                            <span class="small num">
                                @item.Bill.Number@(" · ")
                                @if (item.Counts.For + item.Counts.Against + item.Arguments == 0)
                                {
                                    @T["List.Nobody"]
                                }
                                else
                                {
                                    @T.Format("List.Activity", Display.Number(item.Counts.For + item.Counts.Against), Display.Number(item.Arguments))
                                }
                            </span>
                            @if (item.Counts.For + item.Counts.Against > 0)
                            {
                                <span class="small num">@T.Format("List.Limit", Display.Number(item.Threshold.Value))</span>
                            }
                            @if (item.Planned is { } plan)
                            {
                                <span class="small">@T.Format("Planned", F.T["Month." + plan.Date.Month], plan.Date.Day)</span>
                            }
                            @if (Sort == "naujausia" && item.LastActivityAt is { } last)
                            {
                                @* Owner, 2026-11-17: in this order each row says when the bill last saw activity. *@
                                <span class="small num" id="last-@item.Bill.Number">@T.Format("List.LastActivity", Display.DayTime(last))</span>
                            }
                        </div>
                        <div class="rows__side">
                            @if (item.Counts.For + item.Counts.Against > 0)
                            {
                                @* Owner, 2026-11-17: the sides' numbers beside the bar, not in the text line. *@
                                <span class="small num" id="counts-@item.Bill.Number">@T.Format("List.Counts", Display.Number(item.Counts.For), Display.Number(item.Counts.ForOlderThan30Days), Display.Number(item.Counts.Against), Display.Number(item.Counts.AgainstOlderThan30Days))</span>
                            }
                            <SplitBar For="item.Counts.For" Against="item.Counts.Against" Abstain="0" Small="true" />
                        </div>
                    </li>
                }
            </ul>
            @* Design 8.15: "riba" repeats in the rows, so what it is is said once, beside the list (a hint). *@
            <p class="small" id="older-note">@T["List.OlderNote"]@if (_threshold is { } threshold)
                {
                    @(" · ")<Lt2.Web.Client.Components.Hint Id="threshold-what" Text="@T["Threshold.What"]" Answer="@(T["Threshold.Meaning"] + " " + T.Format("Threshold.NowList", Display.Number(threshold)))" More="/metodika#riba" />
                }</p>
            @* Owner, 2026-11-18: the list grows in place by the address, landing on the first bill added (as 8.18). *@
            <div class="row">
                <p class="small num" role="status" id="shown">@F.T.Format("Ballots.Shown", Display.Number(_offset + Math.Min(_shown, page.Items.Count)), Display.Number(page.Total))</p>
                @if (BillListPaging.More(_shown, _offset, page.Total) is { } more && page.Items.Count > _shown)
                {
                    <a class="btn btn--plain" href="@(Link(From, Sort, Planned, more) + "#bill-" + page.Items[_shown].Bill.Number)" id="more">@T["List.More"]</a>
                }
                @if (BillListPaging.Further(_shown, _offset, page.Total) is { } further)
                {
                    <a class="btn btn--plain" href="@Link(further.ToString(System.Globalization.CultureInfo.InvariantCulture), Sort, Planned)" id="further">@T["List.Further"]</a>
                }
            </div>
        }
    </div>
}

<p class="note note--quiet" id="not-a-poll">@T["NotAPoll"]</p>

@code {
    private BillListResponse? _page;

    [SupplyParameterFromQuery(Name = "q")] public string? Q { get; set; }

    [SupplyParameterFromQuery(Name = "planuojami")] public string? PlannedFlag { get; set; }

    [SupplyParameterFromQuery(Name = "skirtukas")] public string? Tab { get; set; }

    [SupplyParameterFromQuery(Name = "nuo")] public string? From { get; set; }

    [SupplyParameterFromQuery(Name = "rikiuoti")] public string? SortParameter { get; set; }

    /// <summary>How many bills the page shows (owner, 2026-11-18: "Rodyti daugiau" grows the list in place).</summary>
    [SupplyParameterFromQuery(Name = "rodyti")] public string? Show { get; set; }

    private int _shown = BillListPaging.First;
    private int _offset;

    /// <summary>
    /// The orders on the page (design 8.12.5; owner, 2026-11-17: activity, planned date and the latest activity), in Lithuanian
    /// in the address; the first is the default, and any other value (an old <c>dalyviai</c> or <c>argumentai</c>) falls back to it.
    /// </summary>
    private static readonly string[] SortNames = ["aktyvumas", "data", "naujausia"];

    private static readonly Dictionary<string, string> ApiSorts = new()
    {
        ["aktyvumas"] = "activity", ["data"] = "planned", ["naujausia"] = "latest",
    };

    private string Sort => SortParameter is { } s && ApiSorts.ContainsKey(s) ? s : "aktyvumas";

    private bool Closed => Tab == "uzdaryti";

    private bool Planned => !Closed && PlannedFlag == "taip";

    private bool Filtered => !string.IsNullOrWhiteSpace(Q) || Planned;

    /// <summary>The threshold that holds now for a bill without its own (a runtime setting), for the hint beside the list.</summary>
    private int? _threshold;

    protected override async Task OnParametersSetAsync()
    {
        _shown = BillListPaging.Shown(Show);
        _offset = BillListPaging.Offset(From);
        _page = (await Appeals.GetAppealsAsync(Q, Planned, Closed, From, Closed ? null : ApiSorts[Sort], BillListPaging.Asked(_shown))).Value;
        _threshold = (await Digests.GetRulesAsync()).Value?.ThresholdDefault;
    }

    /// <summary>The same search and tab, with the given page (none = the first), order, filter and length (none = the first 20).</summary>
    private string Link(string? next, string sort, bool planned, int? shown = null)
    {
        var query = new List<string>();
        if (!Closed && sort != "aktyvumas")
        {
            query.Add("rikiuoti=" + sort);
        }

        if (!string.IsNullOrWhiteSpace(Q))
        {
            query.Add("q=" + Uri.EscapeDataString(Q.Trim()));
        }

        if (!Closed && planned)
        {
            query.Add("planuojami=taip");
        }

        if (Closed)
        {
            query.Add("skirtukas=uzdaryti");
        }

        if (next is not null)
        {
            query.Add("nuo=" + Uri.EscapeDataString(next));
        }

        if (shown is { } n && n != BillListPaging.First)
        {
            query.Add("rodyti=" + n.ToString(System.Globalization.CultureInfo.InvariantCulture));
        }

        return query.Count == 0 ? "/projektai" : "/projektai?" + string.Join("&", query);
    }
}
