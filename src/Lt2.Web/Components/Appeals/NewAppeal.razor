@page "/kreipimaisi/naujas"
@using Lt2.Api.Contracts.Parliament
@inject IParliamentApi Parliament
@inject IStringLocalizer<AppealText> T

@* Opening an appeal starts by choosing the bill (design 8.1): a plain GET search over the bills in the parliament data.
   Each bill's page shows its appeal, or the form to open one. *@
<PageTitle>@T["New.Title"] · Lietuva 2.0</PageTitle>

<div class="stack">
    <ol class="crumbs">
        <li><a href="/kreipimaisi">@T["Nav.Appeals"]</a></li>
        <li>@T["New.Crumb"]</li>
    </ol>
    <h1>@T["New.Title"]</h1>
    <p class="lead">@T["New.Lead"]</p>
</div>

<form class="filters" method="get" action="/kreipimaisi/naujas">
    <div class="field">
        <label for="bill-q">@T["New.Search"]</label>
        <input class="input" id="bill-q" name="q" value="@Q" />
    </div>
    <button class="btn btn--plain" type="submit">@T["New.SearchButton"]</button>
</form>

@if (_bills is { } bills)
{
    @if (bills.Items.Count == 0)
    {
        <p>@T["New.None"]</p>
    }
    else
    {
        <ul class="rows" id="bills">
            @foreach (var bill in bills.Items)
            {
                <li>
                    <div class="rows__main">
                        <a href="/seimas/@Uri.EscapeDataString(bill.Number)/kreipimasis"><b>@bill.Title</b></a>
                        <span class="small num">@bill.Number</span>
                    </div>
                </li>
            }
        </ul>
    }
}

@code {
    private BillListResponse? _bills;

    [SupplyParameterFromQuery(Name = "q")] public string? Q { get; set; }

    protected override async Task OnParametersSetAsync() => _bills = (await Parliament.GetBillsAsync(Q)).Value;
}
