@inherits LayoutComponentBase
@inject IStringLocalizer<PageText> T
@inject IStringLocalizer<Lt2.Web.Client.UiText> U
@inject Lt2.Api.Contracts.Meta.IMetaApi Meta
@inject IStringLocalizer<Lt2.Web.Components.Feedback.FeedbackText> F
@inject IConfiguration Configuration
@inject NavigationManager Navigation

@* Design 8.21: the menu is the logo, "Projektai" (a dropdown with its three tabs; current on them and everything under
   them; owner, 2026-11-17), "Seimo nariai", "Statistika" (design 8.26, owner 2026-11-17), and "Prisijungti" or the account
   item; one line from 360 px up. What has no place there is in the footer. *@
<header class="page top">
    <a class="top__brand" href="/"><Logo /><span class="top__name">Lietuva 2.0</span></a>
    <nav class="top__nav" aria-label="@T["Nav.Label"]">
        @* Like the account item: a disclosure that opens without script; js/lt2-account.js closes it on Escape, a press
           outside and focus leaving. *@
        <details class="drop" id="projects-menu" data-nav-menu>
            <summary class="drop__toggle" id="nav-projects" aria-current="@(MenuSections.InProjects(Path) ? "true" : null)">@T["Nav.Appeals"]</summary>
            <div class="drop__panel drop__panel--start">
                <ul class="drop__links">
                    @foreach (var (_, path, key) in MenuSections.Tabs)
                    {
                        <li><a href="@path" id="@("nav-tab-" + path.TrimStart('/'))" aria-current="@("/" + Path == path ? "page" : null)">@U[key]</a></li>
                    }
                </ul>
            </div>
        </details>
        <a href="/seimo-nariai" id="nav-mps" aria-current="@Current(MenuSections.InMps(Path), "seimo-nariai")">@T["Nav.Mps"]</a>
        <a href="@MenuSections.Statistics" id="nav-statistics" aria-current="@(MenuSections.InStatistics(Path) ? "page" : null)">@T["Nav.Statistics"]</a>
        <AuthorizeView>
            <Authorized>
                <AccountMenu />
            </Authorized>
            <NotAuthorized>
                <a href="/prisijungti" id="nav-sign-in" aria-current="@Current(Path == "prisijungti", "prisijungti")">@T["Nav.SignIn"]</a>
            </NotAuthorized>
        </AuthorizeView>
    </nav>
</header>

@if (_parliamentDataInvented)
{
    <div class="page"><p class="note" role="note" id="invented-data">@T["Notice.InventedParliament"]</p></div>
}

<AuthorizeView>
    <Authorized>
        @* Design 8.5.1 (owner, 2026-11-17): an account whose address is an MP's official address, profile not taken over, is
           told on every page, with the way to take it over. The served markup is the same for every member and hidden;
           js/lt2-account.js reads the account's own GET /api/v1/me once per page load and shows it, with the MP's name, only
           when the answer has mpOffer, never on the take-over page nor on the screen that holds the offer itself. *@
        <div class="page" id="mp-offer-notice" data-mp-offer-notice data-skip="@($"{Lt2.Api.Contracts.Mps.MpRoutes.TakeoverPage} {Lt2.SharedKernel.AccountScreens.Taking}")" hidden>
            <p class="note" role="note"><span data-mp-offer-text data-format="@T["Notice.MpOffer"]"></span>@(" ")<a href="@Lt2.SharedKernel.AccountScreens.MpOffer" id="mp-offer-notice-link">@T["Notice.MpOfferLink"]</a></p>
        </div>
    </Authorized>
</AuthorizeView>

<main class="page stack stack--loose">
    @Body
    @if (OnSignInPage && Configuration.ModeratorContact() is { } contact)
    {
        @* Design 8.10: on the sign-in and registration page, a way out for whoever cannot sign in. *@
        <p class="small" id="cannot-sign-in">@F["CannotSignIn"] <a href="mailto:@contact">@contact</a></p>
    }
</main>

@* Design 8.21, 8.22: on every page, the token pages opened from emails included; plain links, no script. *@
<footer class="page foot stack">
    <nav class="foot__groups" aria-label="@T["Footer.Label"]" id="footer-links">
        <section class="foot__group" aria-labelledby="foot-about">
            <h2 class="label" id="foot-about">@T["Footer.About"]</h2>
            <ul>
                <li><a href="/metodika" id="foot-methodology">@T["Footer.Methodology"]</a></li>
                <li><a href="/moderavimo-taisykles" id="foot-moderation-rules">@T["Footer.ModerationRules"]</a></li>
                <li><a href="/taisykles" id="foot-terms">@T["Footer.Terms"]</a></li>
                <li><a href="/privatumas" id="foot-privacy">@T["Footer.Privacy"]</a></li>
            </ul>
        </section>
        <section class="foot__group" aria-labelledby="foot-take-part">
            <h2 class="label" id="foot-take-part">@T["Footer.TakePart"]</h2>
            <ul>
                <li><a href="/organizacijos" id="foot-organisations">@T["Footer.Organisations"]</a></li>
                <li><a href="/atsiliepimai" id="foot-feedback">@T["Footer.Feedback"]</a></li>
            </ul>
        </section>
    </nav>
    @* The theme switch (lt2-theme.js): hidden until the script shows it, so absent without script; kept across enhanced
       navigation. *@
    <p><button class="mark" type="button" id="theme-switch" data-theme-switch data-permanent hidden></button></p>
    <p>@T["Footer.Line"]</p>
</footer>

<FeedbackBalloon />

@code {
    private bool _parliamentDataInvented;

    /// <summary>The page's path without the leading <c>/</c>, query or fragment.</summary>
    private string Path => Navigation.ToBaseRelativePath(Navigation.Uri).Split('?', '#')[0].TrimEnd('/');

    private bool OnSignInPage => Path == "prisijungti";

    /// <summary><c>page</c> on the item's own page, <c>true</c> on a page under it, nothing elsewhere.</summary>
    private string? Current(bool inSection, string own) => !inSection ? null : Path == own ? "page" : "true";

    [CascadingParameter] public HttpContext? HttpContext { get; set; }

    // Read before the page renders (InventedDataNotice): an error or a re-executed "not found" page does not wait for an
    // asynchronous read here. The read below is only for a render without that answer.
    protected override async Task OnInitializedAsync() =>
        _parliamentDataInvented = InventedDataNotice.Of(HttpContext) ?? (await Meta.GetImportsAsync()).Value?.ParliamentDataInvented == true;
}
