@inject IStringLocalizer<FeedbackText> T

@* Design 8.10: a round speech-balloon button at the bottom corner of every page, a <details> disclosure, so it opens and
   closes without JavaScript (lt2-feedback.js adds Escape). The panel's heading says what it is: not a live chat. After
   the form in it was sent, the page comes back with the panel open on the thanks. *@
<details class="feedback" id="feedback" open="@IsOpen">
    <summary class="feedback__button" aria-label="@T["Button"]" title="@T["Button"]">
        <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
            <path fill="currentColor" d="M12 3C6.5 3 2 6.6 2 11c0 2.4 1.3 4.5 3.4 6L4.6 21l4.3-2.4c1 .3 2 .4 3.1.4 5.5 0 10-3.6 10-8s-4.5-8-10-8Z" />
        </svg>
    </summary>
    <section class="feedback__panel stack stack--tight" aria-labelledby="feedback-title">
        <h2 id="feedback-title">@T["Title"]</h2>
        <p class="small">@T["NotChat"]</p>
        <FeedbackContent Scope="panel" />
    </section>
</details>

@code {
    [CascadingParameter] private HttpContext? HttpContext { get; set; }

    /// <summary>Open after this panel's form was posted, so the person sees the outcome where they wrote.</summary>
    private bool IsOpen =>
        HttpContext?.Request is { Method: "POST", HasFormContentType: true } request
        && request.Form["_handler"].ToString().StartsWith("[panel]", StringComparison.Ordinal);
}
