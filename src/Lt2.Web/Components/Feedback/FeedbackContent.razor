@inject IStringLocalizer<FeedbackText> T
@inject IConfiguration Configuration

@* Design 8.10: what the balloon's panel and /atsiliepimai hold. A member gets the form; a visitor the moderators' contact
   address. Both get the GitHub issues link (configuration; nothing when unset), with the plain note that an issue there
   is public. A link only: nothing is sent to GitHub. *@
<AuthorizeView>
    <Authorized Context="auth">
        <FormMappingScope Name="@Scope">
            <FeedbackForm Scope="@Scope" />
        </FormMappingScope>
    </Authorized>
    <NotAuthorized>
        <p>@T["Visitor"]</p>
        @if (Contact is { } contact)
        {
            <p id="feedback-contact-@Scope">@T["CannotSignIn"] <a href="mailto:@contact">@contact</a></p>
        }
    </NotAuthorized>
</AuthorizeView>
@if (IssuesUrl is { } issues)
{
    @* Design 8.15: reporting on GitHub, and that it is public there, one click away. *@
    <details class="more stack stack--tight" id="feedback-issues-@Scope">
        <summary class="linkish small">@T["IssuesMore"]</summary>
        <p class="small">@T["Issues"] <a href="@issues" rel="external noreferrer">@T["IssuesLink"]</a>. @T["IssuesPublic"]</p>
    </details>
}

@code {
    [Parameter, EditorRequired] public string Scope { get; set; } = "panel";

    private string? Contact => Configuration.ModeratorContact();

    private string? IssuesUrl =>
        Configuration["Feedback:IssuesUrl"] is { Length: > 0 } url && Uri.TryCreate(url, UriKind.Absolute, out var parsed) && parsed.Scheme == Uri.UriSchemeHttps ? url : null;
}
