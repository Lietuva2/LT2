@page "/seimas/balsavimai"
@using Lt2.Api.Contracts.Parliament
@using Lt2.Api.Contracts.Meta
@using Lt2.Web.Client.Parliament
@inject IParliamentApi Api
@inject IMetaApi Meta
@inject Formats F
@inject IStringLocalizer<Lt2.Web.Components.Appeals.AppealText> A

@* Design 8.18: the history of the Seimas's votes, the long form of the start page's "Balsuota", the tab "Balsavimai" of "Seimas" (also reached
   by the links "Ankstesni balsavimai" of the start page). Public, server-rendered, the same for everyone: no island, no script, nothing about the caller and no
   participants' numbers in the rows (today's numbers beside an old vote would read as what people asked then). The state
   is the address (VoteHistory reads it); the controls are one GET form on the ground above the list's sheet (8.16). The
   votes are read and counted a part at a time by the API (GET /api/v1/votes), never all loaded. *@
<PageTitle>@F.T["Votes.Title"] · Lietuva 2.0</PageTitle>
<LinkPreview Title="@F.T["Votes.Title"]" />

@* Design 8.16.5, 8.21: this page is the tab "Balsavimai" of "Seimas"; the list's sheet has no heading of its own, so the tab row
   (the marked tab says where the reader is, as on the other tab pages) stays at the top of the screen while the list scrolls
   past; the heading "Seimas" above it, the lead and the form scroll away. *@
<SeimasHead Current="SeimasTab.Votes" />
<div class="stack page-head__rest">
    <p class="lead">@F.T["Votes.Lead"]</p>
    <form class="filters" method="get" action="@VoteHistory.Path" role="search" id="votes-search">
        <div class="field">
            <label for="votes-q">@A["List.Search"]</label>
            <input class="input" id="votes-q" name="q" type="search" value="@_state.Query" maxlength="@VoteListQuery.MaxQueryLength" autocomplete="off" />
        </div>
        <div class="field">
            <label for="votes-kind">@F.T["Votes.Kind"]</label>
            <select class="input" id="votes-kind" name="kas">
                @foreach (var (slug, apiKind) in VoteHistory.Kinds)
                {
                    <option value="@slug" selected="@(slug == _state.Kind)">@F.T["Votes.Kind." + apiKind]</option>
                }
            </select>
        </div>
        <div class="field">
            <label for="votes-to">@F.T["Votes.Until"]</label>
            <div class="date-row">
                <input class="input num" id="votes-to" name="iki" type="text" inputmode="numeric" autocomplete="off" pattern="@Display.DatePattern"
                       placeholder="@Display.DateExample" value="@(_state.Until is { } until ? Display.Day(until) : null)" />
                <DatePick InputId="votes-to" />
            </div>
        </div>
        <div class="row">
            <button class="btn" type="submit">@F.T["Mps.Show"]</button>
            @if (_state.Filtered)
            {
                <a href="@VoteHistory.Path" id="votes-clear">@F.T["Ballots.Clear"]</a>
            }
        </div>
    </form>
</div>

<div class="sheet stack" id="@VoteHistory.ListId">
    @if (_items.Count == 0)
    {
        @if (_state.Filtered)
        {
            <p id="votes-none">@F.T["Votes.None"] <a href="@VoteHistory.Path">@F.T["Ballots.Clear"]</a></p>
        }
        else
        {
            <p id="votes-none">@F.T["Bill.NoVotes"]</p>
        }
    }
    else
    {
        @foreach (var day in VoteHistory.Days(_items))
        {
            <section class="tl-day tl-past" aria-label="@F.Date(day.Day)" id="day-@Display.Day(day.Day)">
                <div class="tl-date"><span class="label">@F.T.Format("Votes.Year", day.Day.Year)</span><b>@F.DayMonth(day.Day)</b><span class="small">@F.Weekday(day.Day)</span></div>
                <ul class="tl-items">
                    @foreach (var row in day.Rows)
                    {
                        var vote = row.Vote.Summary.Vote;
                        var (title, wording) = Describe(row.Vote);
                        <li class="tl-item" id="@VoteHistory.Row(row.Number)">
                            <VotedItemMain Number="@vote.Bill?.Number" Title="@title" VoteId="vote.Id" Stage="@vote.Stage" Kind="@vote.Kind" Wording="@wording"
                                           OfficialNote="@row.Vote.Summary.OfficialNote" />
                            <div class="tl-item__side">
                                <VotedItemResult IsConsensus="vote.IsConsensus" HasResult="vote.HasResult" Totals="row.Vote.Summary.Totals" />
                            </div>
                        </li>
                    }
                </ul>
            </section>
        }
        @* The shared "show more" (owner, 2026-11-19): lands on the first row added, so the reader goes on where they stopped (as the
           ballot list, 8.17); then "Senesni balsavimai" once the page is full. *@
        <Lt2.Web.Client.Components.ShowMore Id="votes-more" StatusId="votes-shown" Shown="_items.Count" Total="_total" Href="@VoteHistory.More(_state, _items.Count, _total)">
            @if (VoteHistory.Older(_state, _items, _total) is { } older)
            {
                <a href="@older" id="votes-older">@F.T["Votes.Older"]</a>
            }
        </Lt2.Web.Client.Components.ShowMore>
        @* Design 8.15, 8.18 "The majority": what the rows' chip means, once beside the list. *@
        <p class="small"><MajorityHint /></p>
    }
</div>

<SourceLine UpdatedAt="@_updatedAt" />

@code {
    private VoteHistoryState _state = VoteHistory.Read(null, null, null, null);
    private IReadOnlyList<VoteListItem> _items = [];
    private int _total;
    private DateTimeOffset? _updatedAt;

    [SupplyParameterFromQuery(Name = "q")] public string? Query { get; set; }

    [SupplyParameterFromQuery(Name = "kas")] public string? Kind { get; set; }

    [SupplyParameterFromQuery(Name = "iki")] public string? Until { get; set; }

    [SupplyParameterFromQuery(Name = "rodyti")] public string? Show { get; set; }

    protected override async Task OnParametersSetAsync()
    {
        _state = VoteHistory.Read(Query, Kind, Until, Show);
        var page = (await Api.GetVotesAsync(_state.Query, _state.ApiKind, _state.Until, _state.Shown)).Value;
        _items = page?.Items ?? [];
        _total = page?.Total ?? 0;
        _updatedAt = (await Meta.GetImportsAsync()).Value?.Sources.FirstOrDefault()?.LastSuccessAt;
    }

    /// <summary>
    /// The row's title and the line under it: the bill's title, with the wording for a vote that is not a stage result;
    /// without a bill, the agenda item's title and the wording, said once when they say the same (as the vote's page).
    /// </summary>
    private static (string Title, string? Wording) Describe(VoteListItem item)
    {
        var vote = item.Summary.Vote;
        if (vote.Bill is { } bill)
        {
            return (bill.Title, vote.Kind == VoteKinds.StageResult || string.IsNullOrWhiteSpace(vote.Wording) ? null : vote.Wording);
        }

        return VotePage.Heading(item.AgendaItemTitle, vote.Wording);
    }
}
