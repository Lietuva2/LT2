@page "/frakcijos/{Slug}"
@page "/komitetai/{Slug}"
@using Lt2.Api.Contracts.Parliament
@using Lt2.Api.Contracts.Meta
@inject IParliamentApi Api
@inject IMetaApi Meta
@inject Formats F
@inject NavigationManager Navigation

@if (_body is { } b)
{
    <PageTitle>@b.Body.Name · Lietuva 2.0</PageTitle>
    <LinkPreview Title="@b.Body.Name" />
    <div class="stack">
        <ol class="crumbs">
            <li><a href="/seimo-nariai">@F.T["Mps.Title"]</a></li>
        </ol>
        <p class="label">@F.T[$"Body.{b.Body.Kind}"]</p>
        <h1>@b.Body.Name</h1>
        <p class="small num">@b.Term.Name · @F.T.Format("Body.Count", Display.Number(b.Body.Members))</p>
    </div>

    <div class="cols">
        <div class="stack stack--loose">
            @if (IsFaction)
            {
                <section class="sheet stack" aria-labelledby="h-positions">
                    <div class="row list-head"><h2 id="h-positions">@F.T["Body.Positions"]</h2></div>
                    @if (b.RecentVotes.Count == 0)
                    {
                        <p>@F.T["Body.NoPositions"]</p>
                    }
                    else
                    {
                        <ul class="rows">
                            @foreach (var v in b.RecentVotes)
                            {
                                <VoteRow Vote="v.Vote">
                                    <span class="@Formats.ChoiceClass(v.Split.Position)">@F.Position(v.Split.Position)</span>
                                    <span class="small num">@F.Counts(v.Split.For, v.Split.Against, v.Split.Abstain)</span>
                                </VoteRow>
                            }
                        </ul>
                    }
                </section>
            }
            <section class="sheet stack" aria-labelledby="h-members">
                <div class="row list-head"><h2 id="h-members">@F.T["Body.Members"]</h2></div>
                <MemberRows Members="b.Members.Where(m => m.Current).ToList()" />
            </section>
        </div>
        <aside class="stack">
            @if (b.Members.Any(m => !m.Current))
            {
                <section class="sheet stack stack--tight" aria-labelledby="h-former">
                    <div class="row list-head"><h3 id="h-former">@F.T["Body.FormerMembers"]</h3></div>
                    <MemberRows Members="b.Members.Where(m => !m.Current).ToList()" />
                </section>
            }
            <SourceLine UpdatedAt="@_updatedAt" />
        </aside>
    </div>
}

@code {
    private BodyResponse? _body;
    private DateTimeOffset? _updatedAt;

    [Parameter] public string Slug { get; set; } = "";

    private bool IsFaction => Navigation.ToBaseRelativePath(Navigation.Uri).StartsWith("frakcijos/", StringComparison.Ordinal);

    protected override async Task OnInitializedAsync()
    {
        _body = IsFaction ? (await Api.GetFactionAsync(Slug)).Value : (await Api.GetCommitteeAsync(Slug)).Value;
        if (_body is null)
        {
            Navigation.NotFound();
            return;
        }

        _updatedAt = (await Meta.GetImportsAsync()).Value?.Sources.FirstOrDefault()?.LastSuccessAt;
    }
}
