@page "/seimas/{Number}"
@using Lt2.Api.Contracts.Appeals
@using Lt2.Api.Contracts.Digests
@using Lt2.Api.Contracts.Parliament
@using Lt2.Api.Contracts.Meta
@using Lt2.Web.Client.Appeals
@using Lt2.Web.Client.Organisations
@inject IParliamentApi Api
@inject IMetaApi Meta
@inject IAppealsApi Appeals
@inject IDigestsApi Digests
@inject Lt2.Api.Contracts.Comments.ICommentsApi Comments
@inject Lt2.Api.Contracts.Follows.IFollowsApi Follows
@inject Formats F
@inject NavigationManager Navigation
@inject IConfiguration Configuration
@inject IStringLocalizer<Lt2.Web.Components.Appeals.AppealText> A
@inject IStringLocalizer<AppealUi> U
@inject IStringLocalizer<Lt2.Web.Components.PageText> P
@inject IHttpContextAccessor Http
@inject Microsoft.AspNetCore.Authorization.IAuthorizationService Authorization

@* The bill and the record are one page (design 8.12.1), server-rendered and readable without JavaScript. The header: the
   way back ("Projektai / Įstatymo projektas XVP-0412"), the title and one line with the stage tags, "Planuojama …", "Sekti"
   and "Sekėjai: n". Beside the side column: what the bill is about (8.13) with its label; both sides with the counts for
   accounts older than 30 days, "not a poll" and the threshold and the share line, with a switch to the Seimas's own latest
   stage result when there is one (the seat map of its ballots read only when the switch is first turned to it); the decision
   of a bill closed as rejected or withdrawn. The
   side column: the stages ("Iš kur ši data?" and a participant's "Data neteisinga?" under them), the summaries that held the
   bill (8.7). Then at the page's full width (owner, 2026-11-17): MPs' responses and organisations' statements, each only
   when there is one, then the arguments; then the Seimas votes. The side column is last in the page's order (owner,
   2026-11-18): on a phone it follows the votes, on a wide screen it stands beside the main column. Every active bill is
   open at once: before anyone has taken part the same controls show zero counts and one line saying so. A finished bill nobody took part in shows the bill only; one whose record a
   moderator hid says that taking part is closed, with the statement. Taking a side, the arguments and the moderators'
   panel are WebAssembly islands. Nothing here tells who took part first. *@
@if (_bill is { } b)
{
    <PageTitle>@b.Number · @(PlainTitle ?? b.Title) · Lietuva 2.0</PageTitle>
    @* Design 8.22.5 (owner, 2026-11-27): the image is the bill's title card, drawn when first asked for (Previews/BillPreviewImages). *@
    var preview = Lt2.Web.Previews.BillPreview.Of(b, _record, F, P);
    <LinkPreview Title="@($"{b.Number} · {preview.Title}")" Description="@PreviewText(b)" Type="article" Path="@($"/seimas/{Uri.EscapeDataString(b.Number)}")"
                 DrawnImage="@preview.Path" ImageAlt="@preview.Alt(P)" />
    @* Owner, 2026-11-18 (option A): the header stands one step (--sp-4) above the page's first part, the parts below it a
       loose stack apart as on every page (.stack--snug, design 8.12.1). *@
    <div class="stack stack--snug">
        <div class="stack">
            @* Owner, 2026-11-17: the kind and the number in the way back, no label line of their own. *@
            <ol class="crumbs">
                <li><a href="/projektai">@A["Nav.Appeals"]</a></li>
                <li>@F.T["Bill.Label"] <span class="num">@b.Number</span></li>
            </ol>
            <h1>@(PlainTitle ?? b.Title)</h1>
            @if (PlainTitle is not null)
            {
                @* Design 8.13.1: the readable title is the heading; the official title and the label of the title's source follow. *@
                <p class="small bill-official" id="official-title">@A.Format("What.OfficialTitle", b.Title)</p>
                <p class="fine" id="title-source">
                    @if (PlainSource is DescriptionSources.AiDraft or DescriptionSources.Ai)
                    {
                        <span class="tag">@A["What.Source." + PlainSource]</span>
                    }
                    else
                    {
                        @A["What.Source.moderator"]
                    }
                </p>
            }
            <Lt2.Web.Client.Components.NeedsScript />
            @* Owner, 2026-11-17: one compact line under the title: the stage tags, then "Sekti" and "Sekėjai: n" (design 8.11.2:
               how many follow, apart from the sides' figures, kept current by the button). *@
            <div class="row follow-line">
                <p class="row" id="bill-planned">
                    @if (b.Planned is { } plan)
                    {
                        @if (plan.Stage is { } plannedStage)
                        {
                            <span class="tag">@F.Stage(plannedStage)</span>
                        }
                        <span class="tag" id="planned">@A.Format("Bill.Planned", F.Date(plan.Date))</span>
                    }
                    else if (LastStage(b) is { } done)
                    {
                        <span class="tag" id="last-stage">@F.Stage(done)</span>
                    }
                    @if (_record?.Status == BillRecordStatuses.Closed)
                    {
                        <span class="tag" id="appeal-status">@A["Status.closed"]</span>
                    }
                </p>
                <FollowButton Kind="@FollowButton.Bill" Key="@b.Number" Followers="_followers" @rendermode="InteractiveWebAssembly" />
            </div>
        </div>

        @* Owner, 2026-11-18: the side column is the page's last part (only the data source line follows it), so on a phone it
           comes after the votes; on a wide screen .bill-body places it back in the right column beside the main column, and
           every other part spans both columns below them (design 8.12.1). *@
        <div class="@(HasAside ? "bill-body" : "stack stack--loose")">
            @if (_record is { Status: BillRecordStatuses.Rejected } hidden)
            {
                @* Design 8.12.3: taking part is closed by the moderators; sides and arguments are kept unseen. *@
                <section class="sheet stack stack--tight" id="taking-part-closed" aria-labelledby="h-closed-by-moderators">
                    <h2 id="h-closed-by-moderators">@A["Hidden.Heading"]</h2>
                    <p>@A["Hidden.Lead"]</p>
                    @if (!string.IsNullOrWhiteSpace(hidden.HiddenStatement))
                    {
                        <p class="small" id="hidden-statement">@A.Format("Hidden.Statement", hidden.HiddenStatement)</p>
                    }
                </section>
            }
            else if (_record is { } a)
            {
                <div class="stack stack--loose bill-body__main">
                    <section class="sheet stack" aria-labelledby="h-what" id="about">
                        <h2 id="h-what">@A["What.Heading"]</h2>
                        @if (a.Description.Length > 0)
                        {
                            @* Design 8.2, "A text's layout": paragraphs and lists. *@
                            <Lt2.Web.Client.Components.TypedText Text="@a.Description" />
                            @* Design 8.13: always beside it the label, the day it was made, the official text it was made from
                               when known, its history, and "Pranešti apie klaidą". *@
                            <p class="fine" id="description-source">
                                @if (a.DescriptionSource is DescriptionSources.AiDraft or DescriptionSources.Ai)
                                {
                                    <span class="tag" id="ai-label">@A["What.Source." + a.DescriptionSource]</span>
                                }
                                else
                                {
                                    @A["What.Source.moderator"]
                                }
                                @if (a.DescriptionAt is { } madeAt)
                                {
                                    @(" · ")<span id="description-made">@A.Format("What.MadeOn", F.Date(madeAt))</span>
                                }
                                @if (a.DescriptionUrl is { } from)
                                {
                                    @(" · ")<Lt2.Web.Client.Components.OfficialLink Href="@from" Id="description-from">@A["What.MadeFrom"]</Lt2.Web.Client.Components.OfficialLink>
                                }
                                @(" · ")<a href="/seimas/@Uri.EscapeDataString(b.Number)/istorija">@A["History.Link"]</a>
                                @if (b.ESeimasUrl is { } link && link != a.DescriptionUrl)
                                {
                                    @(" · ")<Lt2.Web.Client.Components.OfficialLink Href="@link">@A["What.ESeimas"]</Lt2.Web.Client.Components.OfficialLink>
                                }
                            </p>
                            @if (a.Id is { } describedRecord)
                            {
                                <ReportDescription RecordId="describedRecord" Contact="@Contact" @rendermode="InteractiveWebAssembly" />
                            }
                        }
                        else
                        {
                            <p id="no-description">@A["What.None"]</p>
                            @if (b.ESeimasUrl is { } link)
                            {
                                <p class="fine"><Lt2.Web.Client.Components.OfficialLink Href="@link">@A["What.ESeimas"]</Lt2.Web.Client.Components.OfficialLink></p>
                            }
                        }
                    </section>

                    @* Design 8.12.1 (owner, 2026-11-23): a bill the Seimas has voted a stage of has a switch at the top of this sheet,
                       "Lietuva 2.0 naudotojai | Seimas", each with its "už : prieš"; the participants' part is shown at first, also on
                       a closed bill. Two radio inputs and their labels, the panels shown by CSS (:has), so it works without script;
                       both panels are in the served HTML, which holds no ballot: the Seimas panel's seat map is an island that
                       reads the vote only when its radio is first checked. A bill without such a vote has no switch. *@
                    <section class="sheet sheet--cut stack" aria-labelledby="h-sides" id="sides">
                        @if (SeimasResult(b) is { } seimas)
                        {
                            <div class="view-switch stack">
                                <div class="views views--wide" id="sides-switch" role="radiogroup" aria-label="@A["Sides.Switch"]">
                                    <input type="radio" class="visually-hidden" name="sides-view" id="view-public" checked />
                                    <label for="view-public">@A["Sides.View.Public"] · <SideScore Number="@b.Number" Counts="a.Counts" @rendermode="InteractiveWebAssembly" /></label>
                                    <input type="radio" class="visually-hidden" name="sides-view" id="view-seimas" />
                                    <label for="view-seimas">@A["Sides.View.Seimas"]@SeimasScore(seimas)</label>
                                </div>
                                <div class="stack" id="public-panel">
                                    @PublicSides(b, a)
                                </div>
                                <div class="stack" id="seimas-panel">
                                    @SeimasSide(b, seimas)
                                </div>
                            </div>
                        }
                        else
                        {
                            @PublicSides(b, a)
                        }
                    </section>

                    @if (a is { Status: BillRecordStatuses.Closed, ClosedReason: ClosingReasons.Rejected or ClosingReasons.Withdrawn, ClosedDecidedOn: { } decidedOn })
                    {
                        @* Design 8.1 step 6 (owner, 2026-11-19): a moderator recorded that the Seimas rejected the bill or its
                           initiators withdrew it, which the open data does not say: what happened, the day and the source on lrs.lt,
                           where a vote-closed record shows the Seimas result. No vote, so no MPs' ballots. *@
                        <section class="sheet stack" aria-labelledby="h-result" id="seimas-result">
                            <h2 id="h-result">@A[a.ClosedReason == ClosingReasons.Withdrawn ? "Closed.Heading.withdrawn" : "Closed.Heading"]</h2>
                            <p id="closed-decision">@A.Format("Closed.Decision." + a.ClosedReason, Display.Day(decidedOn))@if (a.ClosedSourceUrl is { } closedSource)
                                {
                                    @(" ")<Lt2.Web.Client.Components.OfficialLink Href="@closedSource" Id="closed-source">@A["Closed.Source"]</Lt2.Web.Client.Components.OfficialLink>
                                }</p>
                        </section>
                    }
                </div>

                @* Owner, 2026-11-17: the texts run at the page's full width below the top part, so each side's column has room and an
                   opened "Aptarimas" stays in its own column. MPs' responses first (design 8.5.6; server-rendered, the same for
                   everyone), then organisations' statements (8.14.14; never counted), each only when there is something to show, then
                   the members' arguments, always (they hold "Parašyti argumentą"). *@
                @* Design 8.11.8: what is new since the reader's last visit, on the ground above the texts; empty in the served HTML. *@
                <WhatsNew Number="@b.Number" @rendermode="InteractiveWebAssembly" />
                <BillResponses Number="@b.Number" Moderator="_moderator" Linked="_linked" />
                <OrganisationPositions Number="@b.Number" Contact="@Contact" Moderator="_moderator" Linked="_linked" @rendermode="InteractiveWebAssembly" />
                <RecordReasons Number="@b.Number" Contact="@Contact" Moderator="_moderator" Linked="_linked" LinkedReason="_linkedReason" @rendermode="InteractiveWebAssembly" />
            }
            else if (_record is null)
            {
                @* A finished bill nobody took part in shows the bill only, and the MPs' responses written while it was open. *@
                <WhatsNew Number="@b.Number" @rendermode="InteractiveWebAssembly" />
                <BillResponses Number="@b.Number" Linked="_linked" />
            }

            @if (_record is null or { Status: BillRecordStatuses.Rejected })
            {
                @* No side column (a hidden record, or a finished bill nobody took part in): the stages stand full-width here. *@
                @StagesSheet(b, inAside: false)
            }

            @if (_moderator && _record is null)
            {
                @* Owner, 2026-11-26: a finished bill nobody took part in can be described too (it is on the start page's
                   votes); the panel offers only "Rašyti aprašymą", and saving it gives the bill a closed record. *@
                <RecordModerationPanel Number="@b.Number" ESeimasUrl="@b.ESeimasUrl" @rendermode="InteractiveWebAssembly" />
            }

            <section class="sheet stack" aria-labelledby="h-votes">
                <div class="row list-head"><h2 id="h-votes">@F.T["Bill.Votes"]</h2></div>
                @if (b.Votes.Count == 0)
                {
                    <p>@F.T["Bill.NoVotes"]</p>
                }
                else
                {
                    <VoteTimeline Votes="b.Votes.Reverse().Select(v => new VoteListItem(v, b.Title)).ToList()" OnBillPage="true" />
                    @* Design 8.18, "The majority": what the rows' chip means, once beside the list. *@
                    <p class="small"><MajorityHint Id="hint-votes-majority" /></p>
                }
            </section>

            @if (HasAside)
            {
                <aside class="stack bill-body__aside">
                    @* Design 8.12.1 (owner, 2026-11-16): the stages are the side column's first sheet, the same for everyone, with a
                       participant's "Data neteisinga?" under them (owner, 2026-11-17); the moderators' panels follow, then the
                       summaries. Last in the page's order (owner, 2026-11-18): on a phone it follows the votes. *@
                    @StagesSheet(b, inAside: true)

                    @if (_moderator)
                    {
                        <RecordModerationPanel Number="@b.Number" ESeimasUrl="@b.ESeimasUrl" @rendermode="InteractiveWebAssembly" />
                        <StatementModerationPanel Number="@b.Number" @rendermode="InteractiveWebAssembly" />
                    }

                    <section class="sheet stack stack--tight" aria-labelledby="h-digests" id="digests">
                        <div class="row list-head"><h3 id="h-digests">@A["Digests.OnAppeal.Heading"]</h3></div>
                        @if (_digests.Count == 0)
                        {
                            <p class="small" id="no-digests">@A["Digests.OnAppeal.None"]</p>
                        }
                        else
                        {
                            <ul class="rows">
                                @foreach (var d in _digests)
                                {
                                    <li>
                                        <div class="rows__main">
                                            <span><a href="@DigestRoutes.PageAt(d.RunDate, d.RunId, d.Item.BillNumber)" class="num">@Display.Day(d.RunDate)</a> · <span class="small">@A["Digests.Kind." + d.Kind]</span> · <span class="small" id="digest-status-@d.RunId">@A["Digests.Short." + d.Status]</span></span>
                                            <span class="small num">
                                                <span class="choice choice--for">@A["Digests.Side.for"]</span> @Display.Number(d.Item.For) (@Display.Number(d.Item.ForOlderThan30Days))
                                                · <span class="choice choice--against">@A["Digests.Side.against"]</span> @Display.Number(d.Item.Against) (@Display.Number(d.Item.AgainstOlderThan30Days))
                                            </span>
                                        </div>
                                    </li>
                                }
                            </ul>
                            <p class="fine">@A["Digests.OnAppeal.Frozen"]</p>
                        }
                        <p class="fine">@(_sending == "off" ? A["Digests.DryRun"] + " " : "")<a href="/suvestines">@A["Digests.OnAppeal.All"]</a></p>
                    </section>
                </aside>
            }

            @* The data source line closes the page on every width; with a side column it follows it, since the stages are
               Seimas data too. *@
            <SourceLine UpdatedAt="@_updatedAt" />
        </div>
    </div>
}

@code {
    private static readonly string[] Stages = [BillStages.Presentation, BillStages.Consideration, BillStages.Adoption];
    private BillResponse? _bill;
    private BillRecordResponse? _record;
    private int _followers;
    private DateTimeOffset? _updatedAt;
    private IReadOnlyList<RecordDigestResponse> _digests = [];

    /// <summary>The day the next summary holding the bill goes, read once its threshold is reached (design 8.12.2); none known: null.</summary>
    private DateOnly? _nextDigest;

    /// <summary>The newest summary that went with the bill (sent or a dry run; a declined one did not go).</summary>
    private RecordDigestResponse? LastGone => _digests.Where(d => d.Status is DigestRunStatuses.Sent or DigestRunStatuses.DryRun).MaxBy(d => d.RunDate);

    /// <summary>Sending as it is now (design 8.19.1): the summaries part says nothing is sent only while that is so.</summary>
    private string _sending = "off";

    /// <summary>A moderator or an administrator in a staff-passkey session: the arguments then carry the queue's actions.</summary>
    private bool _moderator;

    /// <summary>
    /// The page has the side column (design 8.12.1): a record that is shown, open or closed. A finished bill nobody took part
    /// in and a record the moderators hid have none; their stages stand full-width above the votes.
    /// </summary>
    private bool HasAside => _record is not null and not { Status: BillRecordStatuses.Rejected };

    [Parameter] public string Number { get; set; } = "";

    /// <summary>A link to one comment (design 8.23.6): <c>?komentaras={id}</c>, made by <c>BillTextLinks.ToComment</c>.</summary>
    [SupplyParameterFromQuery(Name = Lt2.Api.Contracts.Comments.BillTextLinks.CommentParameter)] public string? LinkedComment { get; set; }

    /// <summary>A link to one argument (design 8.12.1): <c>?argumentas={id}</c>, made by <c>BillTextLinks.ToReason</c>.</summary>
    [SupplyParameterFromQuery(Name = Lt2.Api.Contracts.Comments.BillTextLinks.ReasonParameter)] public string? LinkedArgument { get; set; }

    /// <summary>
    /// The linked comment's place, resolved once here and handed to the parts (the islands get it as a parameter, so they start
    /// in the same state): null for none, and for a comment not shown or on another bill, whatever the reason; the page then
    /// renders as usual and says nothing about it.
    /// </summary>
    private Lt2.Api.Contracts.Comments.CommentPlaceResponse? _linked;

    /// <summary>The linked argument, when the address names one (the arguments' island shows it only if it is shown).</summary>
    private Guid? _linkedReason;

    /// <summary>Where visitors without a session may write to the moderators (configuration, not a promise in code).</summary>
    private string? Contact => Configuration.ModeratorContact();

    protected override async Task OnInitializedAsync()
    {
        _bill = (await Api.GetBillAsync(Number)).Value;
        if (_bill is null)
        {
            Navigation.NotFound();
            return;
        }

        _updatedAt = (await Meta.GetImportsAsync()).Value?.Sources.FirstOrDefault()?.LastSuccessAt;
        _followers = (await Follows.GetBillFollowersAsync(_bill.Number)).Value?.Followers ?? 0;

        // The empty open state for an active bill nobody took part in; nothing for a finished one (the bill only).
        _record = (await Appeals.GetRecordAsync(_bill.Number)).Value;
        if (_record is { Id: not null, Status: BillRecordStatuses.Open or BillRecordStatuses.Closed })
        {
            _digests = (await Digests.GetRecordDigestsAsync(_bill.Number)).Value ?? [];
            _sending = (await Digests.GetRulesAsync()).Value?.Sending ?? "off";
            if (_record is { Status: BillRecordStatuses.Open, Threshold.Reached: true })
            {
                _nextDigest = (await Digests.GetRecordNextDigestAsync(_bill.Number)).Value?.Day;
            }
        }

        // Owner, 2026-11-19 (design 8.3, 8.12.3): the moderators' panel and "Moderuoti" on an open record and on a closed one,
        // where only what applies there is offered ("Atšaukti uždarymą" among it); owner, 2026-11-26: the panel also on a
        // finished bill nobody took part in, to describe it.
        if (_record is null or { Status: BillRecordStatuses.Open or BillRecordStatuses.Closed } && Http.HttpContext is { } http && http.User.Identity?.IsAuthenticated == true)
        {
            _moderator = (await Authorization.AuthorizeAsync(http.User, http, Lt2.Web.Security.Policies.Moderator)).Succeeded;
        }

        // Design 8.23.6, 8.12.1: a link to a comment or an argument lands on it.
        if (Lt2.Api.Contracts.Comments.BillTextLinks.Parse(LinkedComment) is { } commentId
            && (await Comments.GetPlaceAsync(commentId)).Value is { } place
            && string.Equals(place.BillNumber, _bill.Number, StringComparison.OrdinalIgnoreCase))
        {
            _linked = place;
        }

        _linkedReason = Lt2.Api.Contracts.Comments.BillTextLinks.Parse(LinkedArgument);
    }

    /// <summary>
    /// The sheet's first part, the participants' (design 8.12.1): both sides' counts, the side buttons, "not a poll" and the
    /// threshold. The sheet as it is without a switch, and the switch's "Lietuva 2.0 naudotojai" panel.
    /// </summary>
    private RenderFragment PublicSides(BillResponse b, BillRecordResponse a) =>
        @<text>
            <h2 id="h-sides">@A["Sides.Heading"]</h2>
            @* The counts, the surge note and the threshold's progress are islands: a side taken on the page shows in
               them at once, without reloading the page (owner, 2026-11-17). A closed record's note, worded here,
               stands between the counts and the surge note. *@
            <SideFigures Number="@b.Number" Status="@a.Status" Counts="a.Counts" Surge="a.Surge"
                         Frozen="@(a.Status == BillRecordStatuses.Closed && a.ClosedAt is { } closedAt ? A.Format(a.ClosingVoteId is null ? "Closed.Frozen.Ended" : "Closed.Frozen", F.Date(closedAt)) : null)"
                         @rendermode="InteractiveWebAssembly" />
            @if (a.Status == BillRecordStatuses.Open)
            {
                <SidePicker Number="@b.Number" @rendermode="InteractiveWebAssembly" />
            }
            @* Owner, 2026-11-18: "not a representative poll" right under the counts and the side buttons, in the
               same sheet on every width (it stood at the side column's end, which on a phone is the page's end). *@
            <p class="note note--quiet" id="not-a-poll">@A["NotAPoll"]</p>

            <div class="stack stack--tight" id="threshold">
                @* Owner, 2026-11-23: the hint is an "i" beside the heading "Riba" it explains (design 8.15, the icon hint). *@
                <div class="row hint-head">
                    <h3 id="h-reach">@A["Threshold.Heading"]</h3>
                    <Lt2.Web.Client.Components.Hint Id="threshold-what" Icon="true" Text="@A["Threshold.What"]" Answer="@ThresholdAnswer(a.Threshold)" More="/metodika#threshold" />
                </div>
                <ThresholdProgress Number="@b.Number" Threshold="a.Threshold" Status="@a.Status" NextDay="_nextDigest" Trial="@(_sending == "off")"
                                   LastDay="@LastGone?.RunDate" LastSent="@(LastGone?.Status == DigestRunStatuses.Sent)" @rendermode="InteractiveWebAssembly" />
                @* Design 8.15: what the threshold is and what it does, in place (the hint beside the heading), with the number
                   that holds now for this bill; the rest on the methodology page. A bill's own threshold stays said here with
                   the moderator's statement (design 8.12). *@
                @if (a.Threshold.SetBy == ThresholdSetters.Moderator)
                {
                    <p class="small" id="threshold-set-by">@A["Threshold.SetBy.moderator"]</p>
                }
                @if (a.Threshold.Note is { } thresholdNote)
                {
                    <p class="small" id="threshold-note">@A.Format("Threshold.Note", thresholdNote)</p>
                }
                @if (a.Status == BillRecordStatuses.Open)
                {
                    <ShareLine Number="@b.Number" Path="@($"/seimas/{Uri.EscapeDataString(b.Number)}")" ToGo="@ToGo(a.Threshold)" @rendermode="InteractiveWebAssembly" />
                }
            </div>
        </text>;

    /// <summary>
    /// The switch's "Seimas" panel (design 8.12.1, 8.18): the bill's latest stage result as the Seimas voted it, from the
    /// votes the page already has. The majority of those who voted, the totals with their bar and the Seimas's own note,
    /// the vote's page and the list of votes; the seat map follows once the switch is turned to it (an island that reads
    /// the vote then, never on page load). A consensus vote has no numbers and no ballots, and one with no result yet says so.
    /// </summary>
    private RenderFragment SeimasSide(BillResponse b, VoteSummaryResponse result) =>
        @<text>
            <h2 id="h-seimas">@A["Sides.Seimas.Heading"]</h2>
            <p class="small">@F.Stage(result.Vote.Stage) · @F.Date(result.Vote.HeldAt) · <a href="@VoteLinks.Page(result.Vote.Id)" id="seimas-vote-page">@A["Closed.VotePage"]</a></p>
            @if (result.Vote.IsConsensus)
            {
                <p><VoteMajorityTag IsConsensus="true" /> <span class="small">@F.T["Consensus.NoVotes"]</span></p>
            }
            else if (!result.Vote.HasResult)
            {
                <p>@F.T["NoResult"]</p>
            }
            else
            {
                @* Design 8.18, "The majority": the majority of those who voted, with what it is one click away. *@
                <p class="row result-line"><VoteMajorityTag HasResult="result.Vote.HasResult" For="result.Totals.For" Against="result.Totals.Against" Abstain="result.Totals.Abstain" /><MajorityHint Id="hint-seimas-majority" Icon="true" /></p>
                <div class="totals">
                    <div class="figure figure--for figure--m"><span class="label">@F.Choice(BallotChoices.For)</span><span class="figure__num">@Display.Number(result.Totals.For)</span></div>
                    <div class="figure figure--against figure--m"><span class="label">@F.Choice(BallotChoices.Against)</span><span class="figure__num">@Display.Number(result.Totals.Against)</span></div>
                    <div class="figure figure--m"><span class="label">@F.Choice(BallotChoices.Abstain)</span><span class="figure__num">@Display.Number(result.Totals.Abstain)</span></div>
                </div>
                <SplitBar For="result.Totals.For" Against="result.Totals.Against" Abstain="result.Totals.Abstain" />
                @if (result.OfficialNote is { } officialNote)
                {
                    <p class="note note--quiet" id="seimas-note">@officialNote</p>
                }
            }
            <p class="small">
                @if (result.Vote is { HasResult: true, IsConsensus: false })
                {
                    @* Design 8.17: the list of each MP's ballot lives only on the vote's page. *@
                    <a href="@(VoteLinks.Page(result.Vote.Id))#ballots" id="each-mp">@A["Closed.EachMp"]</a>@(" · ")
                }
                <a href="/seimas/@Uri.EscapeDataString(b.Number)#h-votes" id="all-votes">@F.T["Bill.Votes"]</a>
            </p>
            @if (result.Vote is { HasResult: true, IsConsensus: false })
            {
                <Lt2.Web.Client.Parliament.SeimasSeatMap VoteId="result.Vote.Id" @rendermode="InteractiveWebAssembly" />
            }
        </text>;

    /// <summary>
    /// The bill's latest stage result by day (the switch's Seimas side), none when the Seimas has voted no stage of it
    /// (design 8.12.1): then the sheet has no switch.
    /// </summary>
    private static VoteSummaryResponse? SeimasResult(BillResponse b) =>
        b.Votes.Where(v => v.Vote.Kind == VoteKinds.StageResult).MaxBy(v => v.Vote.HeldAt);

    /// <summary>
    /// What the "Seimas" segment says after its name: " · 93 : 7" (for : against), " · bendru sutarimu" for a consensus
    /// vote, nothing for a vote without a result.
    /// </summary>
    private string SeimasScore(VoteSummaryResponse result) =>
        result.Vote.IsConsensus ? " · " + A["Sides.View.Consensus"]
        : result.Vote.HasResult ? $" · {Display.Number(result.Totals.For)} : {Display.Number(result.Totals.Against)}"
        : "";

    /// <summary>
    /// "Stadijos Seime" (design 8.12.1): each stage's result from the open data, or "dar nebalsuota"; the stage a planned
    /// date is for shows "Planuojama {date}" instead, and the date's source ("Iš kur ši data?") stands under the stages
    /// (owner, 2026-11-18). One sheet: in the side column (a heading of the column's level) or, without one, full-width;
    /// only the full-width one carries the e-seimas link, the side column's page having it in "Apie ką projektas".
    /// </summary>
    private RenderFragment StagesSheet(BillResponse b, bool inAside) =>
        @<section class="sheet stack @(inAside ? "stack--tight" : "")" aria-labelledby="h-stages" id="stages">
            @if (inAside)
            {
                <h3 id="h-stages">@F.T["Bill.Stages"]</h3>
            }
            else
            {
                <h2 id="h-stages">@F.T["Bill.Stages"]</h2>
            }
            <ol class="stages">
                @foreach (var stage in Stages)
                {
                    var result = b.Votes.LastOrDefault(v => v.Vote.Kind == VoteKinds.StageResult && v.Vote.Stage == stage);
                    <li class="stage @(result is null ? "stage--next" : "")" id="stage-@stage">
                        <span class="label">@F.Stage(stage)</span>
                        @if (result is null && PlannedStage(b) == stage && b.Planned is { } plan)
                        {
                            <span class="small num" id="stage-planned">@A.Format("Bill.Planned", F.Date(plan.Date))</span>
                        }
                        else if (result is null)
                        {
                            <span class="small">@F.T["Bill.NotYet"]</span>
                        }
                        else if (result.Vote.IsConsensus)
                        {
                            <a href="@VoteLinks.Page(result.Vote.Id)">@F.T["Consensus.Tag"]</a>
                            <span class="small num">@F.Date(result.Vote.HeldAt)</span>
                        }
                        else
                        {
                            <b class="num"><a href="@VoteLinks.Page(result.Vote.Id)">@Display.Number(result.Totals.For) : @Display.Number(result.Totals.Against)</a></b>
                            <span class="small num">@F.Date(result.Vote.HeldAt)</span>
                        }
                    </li>
                }
            </ol>
            @if (b.Planned is { } source)
            {
                @* Design 8.4, 8.15 (owner, 2026-11-16; under the stages since 2026-11-18, option A): where the planned date
                   comes from, under the stages that show it: one hint, and the agenda page it was read from (only an https
                   address; the local stand-in's is not). A moderator's date says so instead. *@
                <p class="small" id="planned-source">
                    <Lt2.Web.Client.Components.Hint Id="planned-from" Text="@A["Planned.Hint"]"
                        Answer="@(source.SetByModerator ? A["Planned.Answer.moderator"] : A["Planned.Answer.agenda"])" More="/metodika#planned-dates" />
                    @if (!source.SetByModerator && b.PlannedAgendaUrl is { } agendaPage && agendaPage.StartsWith("https://", StringComparison.Ordinal))
                    {
                        @(" · ")<Lt2.Web.Client.Components.OfficialLink Href="@agendaPage" Id="planned-agenda">@A["Planned.AgendaLink"]</Lt2.Web.Client.Components.OfficialLink>
                    }
                </p>
            }
            @if (inAside && b.Planned is not null && _record is { Status: BillRecordStatuses.Open })
            {
                @* Design 8.4, 8.12.1 (owner, 2026-11-17): "Data neteisinga?" beside the planned stage's date it reports, for
                   participants only, and only while a date is shown. *@
                <DateFlagForm Number="@b.Number" @rendermode="InteractiveWebAssembly" />
            }
            @if (!inAside && b.ESeimasUrl is { } documents)
            {
                @* Design 8.12.1 (owner, 2026-11-18): the bill's e-seimas address once on the page. With a side column the
                   page has "Apie ką projektas", whose small line always carries it ("Projekto tekstas e. seime", or
                   "Oficialus tekstas, iš kurio parengta" when that is the same address); without one (a hidden record, a
                   finished bill nobody took part in) this sheet does. *@
                <p class="fine"><Lt2.Web.Client.Components.OfficialLink Href="@documents">@F.T["Bill.ESeimas"]</Lt2.Web.Client.Components.OfficialLink></p>
            }
        </section>;

    /// <summary>
    /// The stage a planned date is for: the one the agenda or the moderator names, else the first stage not voted on yet;
    /// none when that stage already has a result.
    /// </summary>
    private static string? PlannedStage(BillResponse b)
    {
        if (b.Planned is null)
        {
            return null;
        }

        var voted = b.Votes.Where(v => v.Vote.Kind == VoteKinds.StageResult).Select(v => v.Vote.Stage).ToHashSet();
        var stage = b.Planned.Stage ?? Stages.FirstOrDefault(s => !voted.Contains(s));
        return stage is not null && !voted.Contains(stage) ? stage : null;
    }

    /// <summary>The latest stage the Seimas voted on, shown when nothing is planned.</summary>
    internal static string? LastStage(BillResponse bill) =>
        bill.Votes.LastOrDefault(v => v.Vote.Kind == VoteKinds.StageResult)?.Vote.Stage;

    /// <summary>
    /// The link preview's text (design 8.22.5): the description whoever wrote it, unless a report about it is open (owner,
    /// 2026-11-26), otherwise the title with one sentence of what the page is; never the counts, which need "not a
    /// representative poll" beside them.
    /// </summary>
    private string PreviewText(BillResponse b) =>
        _record is { Status: BillRecordStatuses.Open or BillRecordStatuses.Closed, DescriptionReported: false } r && r.Description.Length > 0
            ? r.Description
            : P.Format(_record?.Status switch { BillRecordStatuses.Open => "Preview.Bill.Open", BillRecordStatuses.Closed => "Preview.Bill.Closed", _ => "Preview.Bill.Other" }, b.Title);

    /// <summary>The bill's readable title (design 8.13.1) when its record is open or closed and has one.</summary>
    private string? PlainTitle => _record is { Status: BillRecordStatuses.Open or BillRecordStatuses.Closed, PlainTitle: { Length: > 0 } title } ? title : null;

    private string PlainSource => _record?.DescriptionSource ?? DescriptionSources.Moderator;

    private static int ToGo(ThresholdResponse t) => ShareLine.MissingOf(t);

    /// <summary>"Kas yra riba?": what the threshold is and does, then the number that holds now for this bill (design 8.15).</summary>
    private string ThresholdAnswer(ThresholdResponse t) =>
        A["Threshold.Meaning"] + " " + A.Format(t.SetBy == ThresholdSetters.Moderator ? "Threshold.NowOwn" : "Threshold.Now", Display.Number(t.Value));
}
