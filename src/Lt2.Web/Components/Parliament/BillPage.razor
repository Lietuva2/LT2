@page "/seimas/{Number}"
@using Lt2.Api.Contracts.Appeals
@using Lt2.Api.Contracts.Digests
@using Lt2.Api.Contracts.Parliament
@using Lt2.Api.Contracts.Meta
@using Lt2.Web.Client.Appeals
@using Lt2.Web.Client.Organisations
@inject IParliamentApi Api
@inject IMetaApi Meta
@inject IAppealsApi Appeals
@inject IDigestsApi Digests
@inject Formats F
@inject NavigationManager Navigation
@inject IConfiguration Configuration
@inject IStringLocalizer<Lt2.Web.Components.Appeals.AppealText> A
@inject IHttpContextAccessor Http
@inject Microsoft.AspNetCore.Authorization.IAuthorizationService Authorization

@* The bill and the appeal are one page (design 8.12.1), server-rendered and readable without JavaScript: number, title,
   stage and "Planuojama …"; what the bill is about (8.13) with its label; both sides with the counts for accounts older
   than 30 days, the threshold and the share line; the arguments; the summaries that held the bill (8.7); the Seimas votes.
   Every active bill is open at once: before anyone has taken part the same controls show zero counts and one line saying
   so. A finished bill nobody took part in shows the bill only; one whose record a moderator hid says that taking part is
   closed, with the statement. Taking a side, the arguments and the moderators' panel are WebAssembly islands. Nothing
   here tells who took part first. *@
@if (_bill is { } b)
{
    <PageTitle>@b.Number · @b.Title · Lietuva 2.0</PageTitle>
    <div class="stack">
        <ol class="crumbs">
            <li><a href="/projektai">@A["Nav.Appeals"]</a></li>
            <li>@b.Number</li>
        </ol>
        <p class="label num">@F.T["Bill.Label"] · @b.Number</p>
        <h1>@b.Title</h1>
        <p class="row" id="bill-planned">
            @if (b.Planned is { } plan)
            {
                @if (plan.Stage is { } plannedStage)
                {
                    <span class="tag">@F.Stage(plannedStage)</span>
                }
                <span class="tag" id="planned">@A.Format("Bill.Planned", F.Date(plan.Date))</span>
            }
            else if (LastStage(b) is { } done)
            {
                <span class="tag" id="last-stage">@F.Stage(done)</span>
            }
            @if (_appeal?.Status == "closed")
            {
                <span class="tag" id="appeal-status">@A["Status.closed"]</span>
            }
        </p>
        <Lt2.Web.Client.Components.NeedsScript />
        <FollowButton Kind="bill" Key="@b.Number" @rendermode="InteractiveWebAssembly" />
    </div>

    @if (_appeal is { Status: "rejected" } hidden)
    {
        @* Design 8.12.3: taking part is closed by the moderators; sides and arguments are kept unseen. *@
        <section class="sheet stack stack--tight" id="taking-part-closed" aria-labelledby="h-closed-by-moderators">
            <h2 id="h-closed-by-moderators">@A["Hidden.Heading"]</h2>
            <p>@A["Hidden.Lead"]</p>
            @if (!string.IsNullOrWhiteSpace(hidden.HiddenStatement))
            {
                <p class="small" id="hidden-statement">@A.Format("Hidden.Statement", hidden.HiddenStatement)</p>
            }
        </section>
    }
    else if (_appeal is { } a)
    {
        <div class="cols">
            <div class="stack stack--loose">
                <section class="stack" aria-labelledby="h-what" id="about">
                    <h2 id="h-what">@A["What.Heading"]</h2>
                    @if (a.Description.Length > 0)
                    {
                        @foreach (var paragraph in a.Description.Split('\n', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries))
                        {
                            <p>@paragraph</p>
                        }
                        @* Design 8.13: always beside it the label, the day it was made, the official text it was made from
                           when known, its history, and "Pranešti apie klaidą". *@
                        <p class="fine" id="description-source">
                            @if (a.DescriptionSource is "ai-draft" or "ai")
                            {
                                <span class="tag" id="ai-label">@A["What.Source." + a.DescriptionSource]</span>
                            }
                            else if (a.DescriptionSource == "initiator")
                            {
                                @A.Format("What.Source.initiator", a.DescriptionAuthor ?? A["Anonymous"])
                            }
                            else
                            {
                                @A["What.Source.moderator"]
                            }
                            @if (a.DescriptionAt is { } madeAt)
                            {
                                @(" · ")<span id="description-made">@A.Format("What.MadeOn", F.Date(madeAt))</span>
                            }
                            @if (a.DescriptionUrl is { } from)
                            {
                                @(" · ")<a href="@from" rel="external" id="description-from">@A["What.MadeFrom"]</a>
                            }
                            @(" · ")<a href="/seimas/@Uri.EscapeDataString(b.Number)/istorija">@A["History.Link"]</a>
                            @if (b.ESeimasUrl is { } link && link != a.DescriptionUrl)
                            {
                                @(" · ")<a href="@link" rel="external">@A["What.ESeimas"]</a>
                            }
                        </p>
                        @if (a.Id is { } describedRecord)
                        {
                            <ReportAppeal AppealId="describedRecord" Contact="@Contact" @rendermode="InteractiveWebAssembly" />
                        }
                    }
                    else
                    {
                        <p id="no-description">@A["What.None"]</p>
                        @if (b.ESeimasUrl is { } link)
                        {
                            <p class="fine"><a href="@link" rel="external">@A["What.ESeimas"]</a></p>
                        }
                    }
                </section>

                <section class="sheet sheet--cut stack" aria-labelledby="h-sides" id="sides">
                    <h2 id="h-sides">@A["Sides.Heading"]</h2>
                    <div class="pair pair--keep">
                        <div class="figure figure--for" id="count-for">
                            <span class="label">@A["Sides.for"]</span>
                            <span class="figure__num">@Display.Number(a.Counts.For)</span>
                            <span class="small num">@A.Format("Sides.Older", Display.Number(a.Counts.ForOlderThan30Days))</span>
                        </div>
                        <div class="figure figure--against" id="count-against">
                            <span class="label">@A["Sides.against"]</span>
                            <span class="figure__num">@Display.Number(a.Counts.Against)</span>
                            <span class="small num">@A.Format("Sides.Older", Display.Number(a.Counts.AgainstOlderThan30Days))</span>
                        </div>
                    </div>
                    <SplitBar For="a.Counts.For" Against="a.Counts.Against" Abstain="0" />
                    @if (a.Status == "open" && a.Counts.For + a.Counts.Against == 0)
                    {
                        <p class="small" id="nobody-yet">@A["Sides.Nobody"]</p>
                    }
                    @if (a.Status == "closed" && a.ClosedAt is { } closedAt)
                    {
                        <p class="small" id="frozen-note">@A.Format("Closed.Frozen", F.Date(closedAt))</p>
                    }
                    @if (a.Surge is { } surge)
                    {
                        <p class="note" id="surge-note">@A.Format("Surge.Note", Display.Number(surge.WindowHours), Display.Number(surge.SharePercent))</p>
                    }
                    @if (a.Status == "open")
                    {
                        <SidePicker Number="@b.Number" @rendermode="InteractiveWebAssembly" />
                    }

                    <div class="stack stack--tight" id="threshold">
                        <h3 id="h-reach">@A["Threshold.Heading"]</h3>
                        <div class="ruler" role="img" aria-label="@A.Format("Threshold.Aria", Display.Number(a.Threshold.Participants), Display.Number(a.Threshold.Value))">
                            <svg viewBox="0 0 1000 10" preserveAspectRatio="none" aria-hidden="true"><rect class="ruler__bar" x="0" y="0" height="10" width="@RulerWidth(a.Threshold)" /></svg>
                        </div>
                        <p class="num"><b>@Display.Number(a.Threshold.Participants)</b> @A.Format("Threshold.Progress", Display.Number(a.Threshold.Value))</p>
                        @* Design 8.15: what the threshold is, one click away on the methodology page; a bill's own threshold
                           stays said here with the moderator's statement (design 8.12). *@
                        <p class="small"><a href="/metodika#riba" id="threshold-what">@A["Threshold.What"]</a></p>
                        @if (a.Threshold.SetBy == "moderator")
                        {
                            <p class="small" id="threshold-set-by">@A["Threshold.SetBy.moderator"]</p>
                        }
                        @if (a.Threshold.Note is { } thresholdNote)
                        {
                            <p class="small" id="threshold-note">@A.Format("Threshold.Note", thresholdNote)</p>
                        }
                        @if (a.Status == "open")
                        {
                            <ShareLine Path="@($"/seimas/{Uri.EscapeDataString(b.Number)}")" ToGo="@ToGo(a.Threshold)" @rendermode="InteractiveWebAssembly" />
                        }
                    </div>
                </section>

                @if (_closingVote is { } vote)
                {
                    <section class="stack" aria-labelledby="h-result" id="seimas-result">
                        <h2 id="h-result">@A["Closed.Heading"]</h2>
                        <p class="small">@F.Stage(vote.Summary.Vote.Stage) · @F.Date(vote.Summary.Vote.HeldAt) · <a href="/seimas/balsavimai/@vote.Summary.Vote.Id">@A["Closed.VotePage"]</a></p>
                        @if (vote.Summary.Vote.IsConsensus)
                        {
                            <p>@F.T["Consensus.Tag"]</p>
                        }
                        else
                        {
                            <div class="totals">
                                <div class="figure figure--for figure--m"><span class="label">@F.Choice("for")</span><span class="figure__num">@Display.Number(vote.Summary.Totals.For)</span></div>
                                <div class="figure figure--against figure--m"><span class="label">@F.Choice("against")</span><span class="figure__num">@Display.Number(vote.Summary.Totals.Against)</span></div>
                                <div class="figure figure--m"><span class="label">@F.Choice("abstain")</span><span class="figure__num">@Display.Number(vote.Summary.Totals.Abstain)</span></div>
                            </div>
                            @if (vote.Summary.OfficialNote is { } officialNote)
                            {
                                <p class="note note--quiet">@officialNote</p>
                            }
                            <SeatMap Ballots="vote.Ballots" />
                            <details class="more stack stack--tight">
                                <summary class="linkish small">@A["Closed.EachMp"]</summary>
                                <ul class="rows">
                                    @foreach (var ballot in vote.Ballots.OrderBy(x => x.Mp.LastName, StringComparer.Create(new System.Globalization.CultureInfo("lt-LT"), false)))
                                    {
                                        <li>
                                            <div class="rows__main"><a href="/p/@ballot.Mp.Slug">@ballot.Mp.FirstName @ballot.Mp.LastName</a><span class="small">@ballot.FactionLabel</span></div>
                                            <div class="rows__side"><span class="@Formats.ChoiceClass(ballot.Choice)">@F.Choice(ballot.Choice)</span></div>
                                        </li>
                                    }
                                </ul>
                            </details>
                        }
                    </section>
                }

                <AppealReasons Number="@b.Number" Contact="@Contact" Moderator="_moderator" @rendermode="InteractiveWebAssembly" />

                @* Design 8.14.14: organisations' statements, after the arguments; never counted. *@
                <OrganisationPositions Number="@b.Number" Contact="@Contact" @rendermode="InteractiveWebAssembly" />
            </div>

            <aside class="stack">
                @if (_moderator)
                {
                    <AppealModerationPanel Number="@b.Number" ESeimasUrl="@b.ESeimasUrl" @rendermode="InteractiveWebAssembly" />
                    <StatementModerationPanel Number="@b.Number" @rendermode="InteractiveWebAssembly" />
                }

                <section class="stack stack--tight" aria-labelledby="h-digests" id="digests">
                    <h3 id="h-digests">@A["Digests.OnAppeal.Heading"]</h3>
                    @if (_digests.Count == 0)
                    {
                        <p class="small" id="no-digests">@A["Digests.OnAppeal.None"]</p>
                    }
                    else
                    {
                        <ul class="rows">
                            @foreach (var d in _digests)
                            {
                                <li>
                                    <div class="rows__main">
                                        <span><a href="@DigestRoutes.PageAt(d.RunDate, d.RunId, d.Item.BillNumber)" class="num">@Display.Day(d.RunDate)</a> · <span class="small">@A["Digests.Kind." + d.Kind]</span></span>
                                        <span class="small num">
                                            <span class="choice choice--for">@A["Digests.Side.for"]</span> @Display.Number(d.Item.For) (@Display.Number(d.Item.ForOlderThan30Days))
                                            · <span class="choice choice--against">@A["Digests.Side.against"]</span> @Display.Number(d.Item.Against) (@Display.Number(d.Item.AgainstOlderThan30Days))
                                        </span>
                                    </div>
                                </li>
                            }
                        </ul>
                        <p class="fine">@A["Digests.OnAppeal.Frozen"]</p>
                    }
                    <p class="fine">@A["Digests.DryRun"]@(" ")<a href="/suvestines">@A["Digests.OnAppeal.All"]</a></p>
                </section>

                @if (a.Status == "open")
                {
                    <DateFlagForm Number="@b.Number" @rendermode="InteractiveWebAssembly" />
                }

                <p class="note note--quiet" id="not-a-poll">@A["NotAPoll"]</p>
            </aside>
        </div>
    }

    <section class="stack" aria-labelledby="h-stages">
        <h2 id="h-stages">@F.T["Bill.Stages"]</h2>
        <ol class="stages">
            @foreach (var stage in Stages)
            {
                var result = b.Votes.LastOrDefault(v => v.Vote.Kind == "stage-result" && v.Vote.Stage == stage);
                <li class="stage @(result is null ? "stage--next" : "")">
                    <span class="label">@F.Stage(stage)</span>
                    @if (result is null)
                    {
                        <span class="small">@F.T["Bill.NotYet"]</span>
                    }
                    else if (result.Vote.IsConsensus)
                    {
                        <a href="/seimas/balsavimai/@result.Vote.Id">@F.T["Consensus.Tag"]</a>
                        <span class="small num">@F.Date(result.Vote.HeldAt)</span>
                    }
                    else
                    {
                        <b class="num"><a href="/seimas/balsavimai/@result.Vote.Id">@Display.Number(result.Totals.For) : @Display.Number(result.Totals.Against)</a></b>
                        <span class="small num">@F.Date(result.Vote.HeldAt)</span>
                    }
                </li>
            }
        </ol>
        @if (b.Planned is { SetByModerator: true })
        {
            <p class="fine">@A["Planned.ByModerator"]</p>
        }
        else if (b.Planned?.SourceUrl is { } plannedSource)
        {
            <p class="fine"><a href="@plannedSource" rel="external">@A["Planned.Source"]</a></p>
        }
        @if (b.ESeimasUrl is { } documents)
        {
            <p class="fine"><a href="@documents" rel="external">@F.T["Bill.ESeimas"]</a></p>
        }
    </section>

    <section class="stack" aria-labelledby="h-votes">
        <h2 id="h-votes">@F.T["Bill.Votes"]</h2>
        @if (b.Votes.Count == 0)
        {
            <p>@F.T["Bill.NoVotes"]</p>
        }
        else
        {
            <ul class="rows">
                @foreach (var v in b.Votes.Reverse())
                {
                    <VoteRow Vote="v.Vote">
                        <VoteResultSide Vote="v" />
                    </VoteRow>
                }
            </ul>
        }
    </section>

    <SourceLine UpdatedAt="@_updatedAt" />
}

@code {
    private static readonly string[] Stages = ["presentation", "consideration", "adoption"];
    private BillResponse? _bill;
    private AppealResponse? _appeal;
    private DateTimeOffset? _updatedAt;
    private VoteResponse? _closingVote;
    private IReadOnlyList<AppealDigestResponse> _digests = [];

    /// <summary>A moderator or an administrator in a staff-passkey session: the arguments then carry the queue's actions.</summary>
    private bool _moderator;

    [Parameter] public string Number { get; set; } = "";

    /// <summary>Where visitors without a session may write to the moderators (configuration, not a promise in code).</summary>
    private string? Contact => Configuration.ModeratorContact();

    protected override async Task OnInitializedAsync()
    {
        _bill = (await Api.GetBillAsync(Number)).Value;
        if (_bill is null)
        {
            Navigation.NotFound();
            return;
        }

        _updatedAt = (await Meta.GetImportsAsync()).Value?.Sources.FirstOrDefault()?.LastSuccessAt;

        // The empty open state for an active bill nobody took part in; nothing for a finished one (the bill only).
        _appeal = (await Appeals.GetAppealAsync(_bill.Number)).Value;
        if (_appeal is { Id: not null, Status: "open" or "closed" })
        {
            _digests = (await Digests.GetAppealDigestsAsync(_bill.Number)).Value ?? [];
        }

        if (_appeal is { Status: "open" } && Http.HttpContext is { } http && http.User.Identity?.IsAuthenticated == true)
        {
            _moderator = (await Authorization.AuthorizeAsync(http.User, http, Lt2.Web.Security.Policies.Moderator)).Succeeded;
        }

        if (_appeal?.ClosingVoteId is { } voteId)
        {
            _closingVote = (await Api.GetVoteAsync(voteId)).Value;
        }
    }

    /// <summary>The latest stage the Seimas voted on, shown when nothing is planned.</summary>
    private static string? LastStage(BillResponse bill) =>
        bill.Votes.LastOrDefault(v => v.Vote.Kind == "stage-result")?.Vote.Stage;

    private static int ToGo(ThresholdResponse t) => Math.Max(0, t.Value - t.Participants);

    private static string RulerWidth(ThresholdResponse t) =>
        (t.Value <= 0 ? 1000 : Math.Min(1000.0, 1000.0 * t.Participants / t.Value)).ToString("0.#", System.Globalization.CultureInfo.InvariantCulture);
}
