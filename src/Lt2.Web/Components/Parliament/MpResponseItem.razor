@using Lt2.Api.Contracts.Mps
@inject Formats F

@* One MP's response (design 8.5.5, 8.5.6), the same on the bill's page and on the profile: on the bill's page the MP's name
   (linking to the profile) and faction, on the profile the bill; always the one mark "Seimo narys arba jo biuras", never who
   wrote it. Published: the stance, the text, the dates ("Keista" with its date) and, after the adoption vote, the MP's
   ballot beside it as a second fact ("Atsakė: … Balsavo: …"), never compared. Withdrawn: "Atsakymas atsiimtas" with the date.
   Hidden: "Atsakymas paslėptas moderatorių" and the moderator's statement. Earlier versions behind "Ankstesnės versijos", each with
   what it changed (owner, 2026-11-18).
   The line right above the bubble is always the name, where the bubble's tail points (owner, 2026-11-18; design 8.16.3):
   on the profile the bill heads the item, then the stance as a small line above the name, then the name ("Nauja" beside
   it), the bubble, and under it the faction, the mark and the dates. *@
<article class="said said--mp" aria-label="@Label">
    @if (Bill is { } bill)
    {
        <p class="row statement__bill">
            <a class="tag tag--ink num" href="/seimas/@Uri.EscapeDataString(bill.Number)">@bill.Number</a>
            <a class="statement__name" href="/seimas/@Uri.EscapeDataString(bill.Number)">@bill.Title</a>
        </p>
    }
    @if (Response.Status is not ("hidden" or "withdrawn"))
    {
        <p class="said__side"><span class="@StanceClass(Response.Stance)">@F.T["Responses.Stance." + Response.Stance]</span></p>
    }
    <p class="row statement__who">
        @if (Mp is { } mp)
        {
            @if (mp.Slug.Length > 0)
            {
                <a class="statement__name" href="/p/@mp.Slug">@mp.FirstName @mp.LastName</a>
            }
            else
            {
                <b class="statement__name">@mp.FirstName @mp.LastName</b>
            }
        }
        else if (AuthorName is { } name)
        {
            <b class="statement__name">@name</b>
        }
        @Mark
    </p>
    @switch (Response.Status)
    {
        case "hidden":
            <p class="note note--quiet">@F.T["Responses.Hidden"]</p>
            @if (Response.HiddenStatement is { } why)
            {
                <p class="small">@F.T.Format("Responses.HiddenWhy", why)</p>
            }
            break;
        case "withdrawn":
            <p class="row"><span class="tag">@F.T["Responses.Withdrawn"]</span> <span class="small num">@Display.Day(Response.WithdrawnAt ?? Response.PublishedAt)</span></p>
            break;
        default:
            @* Design 8.5.6 (owner, 2026-11-16): a response longer than about 1 500 characters shows its beginning and "Rodyti
               daugiau" (no script); the moderators' queue shows it whole (ResponseModerationView). *@
            <Lt2.Web.Client.Components.LongText Text="@(Response.Text ?? "")" BubbleClass="bubble bubble--mp voice"
                Shown="Lt2.Web.Client.TextExcerpt.StatementShown" Margin="Lt2.Web.Client.TextExcerpt.StatementMargin" Id="@($"{IdPrefix}response-more")" />
            break;
    }
    <div class="said__by statement__meta">
        @if (Mp is { } who)
        {
            <span>@(who.Faction ?? F.T["Vote.NoFaction"])</span>
        }
        <span class="tag">@F.T["Responses.Mark"]</span>
        @if (Response.Status != "hidden")
        {
            <span class="small num"><span class="nowrap">@F.T.Format("Responses.Published", Display.Day(Response.PublishedAt))</span>@if (Response.EditedAt is { } edited) {<text> · </text><span class="nowrap">@F.T.Format("Responses.Edited", Display.Day(edited))</span>}</span>
        }
    </div>
    @if (ChildContent is not null)
    {
        @* The action row (design 8.16.1): "Aptarimas (n)" and "⋯" on the bill's page, as under every text. *@
        <div class="act" id="@(IdPrefix)actions">@ChildContent</div>
    }
    @if (Response.Status == "published" && Response.Vote is { } vote)
    {
        @* Design 8.5.5: two facts side by side, without a word of judgement; nothing anywhere adds them up. *@
        <p class="small" id="@(IdPrefix)vote">@F.T.Format("Responses.Answered", F.T["Responses.Will." + Response.Stance], F.T["Responses.Ballot." + vote.Ballot])
            <a href="/seimas/balsavimai/@vote.VoteId">@F.T["Responses.VotePage"]</a></p>
    }
    @if (Response.Status != "hidden" && Response.Earlier.Count > 0)
    {
        <details class="more stack stack--tight">
            <summary class="linkish small">@F.T.Format("Responses.Earlier", Display.Number(Response.Earlier.Count))</summary>
            @* Owner, 2026-11-18: newest first, each version with what it changed against the one before it (TextChanges) and the
               text before the change one click away, the oldest whole; a published response's own text opens the list with its
               changes, so the last edit shows too, and a withdrawn one's withdrawal does, its text struck through, so the text
               withdrawn is there whole too. *@
            <ul class="stack stack--tight">
                @if (Response.Status == "published")
                {
                    <li class="stack stack--tight" id="@(IdPrefix)response-current">
                        <p class="row small"><span class="@StanceClass(Response.Stance)">@F.T["Responses.Stance." + Response.Stance]</span>
                            <span class="num">@F.T.Format("Responses.VersionCurrent", Display.Day(Response.EditedAt ?? Response.PublishedAt))</span></p>
                        <Lt2.Web.Client.Components.TextChanges Old="@Response.Earlier[0].Text" New="@Response.Text" Class="voice typed" />
                    </li>
                }
                else if (Response.Status == "withdrawn")
                {
                    <li class="stack stack--tight" id="@(IdPrefix)response-withdrawal">
                        <p class="row small"><span class="num">@F.T.Format("Responses.Withdrawal", Display.Day(Response.WithdrawnAt ?? Response.Earlier[0].ReplacedAt))</span></p>
                        <Lt2.Web.Client.Components.TextChanges Old="@Response.Earlier[0].Text" New="@null" Class="voice typed" />
                    </li>
                }
                @for (var i = 0; i < Response.Earlier.Count; i++)
                {
                    var v = Response.Earlier[i];
                    <li class="stack stack--tight">
                        <p class="row small"><span class="@StanceClass(v.Stance)">@F.T["Responses.Stance." + v.Stance]</span>
                            <span class="num">@(v.Withdrawn ? F.T.Format("Responses.VersionWithdrawn", Display.Day(v.WrittenAt), Display.Day(v.ReplacedAt)) : F.T.Format("Responses.VersionDates", Display.Day(v.WrittenAt), Display.Day(v.ReplacedAt)))</span></p>
                        <Lt2.Web.Client.Components.TextChanges Old="@(i + 1 < Response.Earlier.Count ? Response.Earlier[i + 1].Text : null)" New="@v.Text" Class="voice typed" />
                    </li>
                }
            </ul>
        </details>
    }
</article>

@code {
    [Parameter, EditorRequired] public MpResponseResponse Response { get; set; } = default!;

    /// <summary>On the bill's page: the MP who answered.</summary>
    [Parameter] public MpResponderResponse? Mp { get; set; }

    /// <summary>On the profile: the bill answered.</summary>
    [Parameter] public Lt2.Api.Contracts.Appeals.BillRefResponse? Bill { get; set; }

    /// <summary>On the profile: the MP's name, shown (not linked) right above the bubble, where its tail points.</summary>
    [Parameter] public string? AuthorName { get; set; }

    /// <summary>On the bill's page: "Nauja" beside a response the reader has not seen (design 8.11.8), an island.</summary>
    [Parameter] public RenderFragment? Mark { get; set; }

    /// <summary>The start of the item's own element ids, unique on the page.</summary>
    [Parameter] public string IdPrefix { get; set; } = "";

    /// <summary>The action row under the response (design 8.16.1): on the bill's page the discussion and "⋯", both islands.</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }

    private string Label => Mp is { } mp ? $"{mp.FirstName} {mp.LastName}" : Bill?.Number ?? F.T["Responses.Mark"];

    private static string StanceClass(string? stance) => stance switch
    {
        "for" => "choice choice--for",
        "against" => "choice choice--against",
        _ => "choice choice--remarks",
    };
}
