@page "/seimas/balsavimai/{Id:long}"
@using Lt2.Api.Contracts.Parliament
@using Lt2.Api.Contracts.Meta
@inject IParliamentApi Api
@inject IMetaApi Meta
@inject Formats F
@inject IStringLocalizer<Lt2.Web.Components.Appeals.AppealText> A
@inject NavigationManager Navigation
@inject IHttpContextAccessor Http
@inject Microsoft.AspNetCore.Authorization.IAuthorizationService Authorization

@if (_vote is { } v)
{
    var vote = v.Summary.Vote;
    var totals = v.Summary.Totals;
    var (heading, wording) = Heading(vote.Bill?.Title ?? v.AgendaItemTitle, vote.Wording);
    @* Design 8.13.1: a bill's readable title leads, as in the lists that link here; the official title follows it. The link
       preview carries it too, whoever wrote it (owner, 2026-11-26). *@
    var plainTitle = vote.Bill?.PlainTitle;
    var lead = plainTitle is null || wording is not null ? wording : heading == vote.Bill!.Title.Trim() ? null : heading;
    <PageTitle>@F.T["Vote.Label"] · @(plainTitle ?? heading) · Lietuva 2.0</PageTitle>
    <LinkPreview Title="@($"{F.T["Vote.Label"]} · {plainTitle ?? heading}")" />

    <div class="stack">
        @* Design 8.18: up to the history of votes, then the vote's bill. *@
        <ol class="crumbs">
            <li><a href="@Lt2.Web.Client.Parliament.VoteHistory.Path" id="to-vote-history">@F.T["Votes.Title"]</a></li>
            @if (vote.Bill is { } bill)
            {
                <li><a href="/seimas/@bill.Number">@bill.Number</a></li>
            }
        </ol>
        @* Design 7.2: a classification a moderator corrected says so beside the stage, never who. *@
        <p class="label num">@string.Join(" · ", Label(vote))@if (v.ClassificationCorrected)
            {<text> · </text><Lt2.Web.Client.Components.Hint Id="classification-corrected" Text="@F.T["Vote.Corrected"]" Answer="@F.T["Vote.Corrected.Answer"]" More="/metodika#stages" />}</p>
        <h1>@(plainTitle ?? heading)</h1>
        @if (plainTitle is not null)
        {
            <p class="small bill-official" id="official-title">@A.Format("What.OfficialTitle", vote.Bill!.Title)</p>
        }
        @if (_moderator)
        {
            <Lt2.Web.Client.Components.NeedsScript />
        }
        @if (lead is not null)
        {
            <p class="lead">@lead</p>
        }
    </div>

    @* Design 7.2 and 8.18 (owner, 2026-11-23): as the bill's page has its side column, a moderator's part (correcting the
       vote's classification) stands beside the main column on a wide screen and is the page's last part on a phone. Nobody
       else has a side column; then the page is one stack, as before. The ballots span both columns below the main one. *@
    <div class="@(_moderator ? "bill-body" : "stack stack--loose")">
        <div class="stack stack--loose bill-body__main">
            <section class="sheet sheet--cut stack" aria-labelledby="h-result">
                <h2 id="h-result" class="visually-hidden">@F.T["Vote.Result"]</h2>
                @if (vote.IsConsensus)
                {
                    <p><VoteMajorityTag IsConsensus="true" /></p>
                    <p>@F.T["Vote.ConsensusText"]</p>
                }
                else if (!vote.HasResult)
                {
                    <p>@F.T["NoResult"]</p>
                }
                else
                {
                    @* Design 8.18, "The majority": the majority of those who voted, with what it is one click away. *@
                    <p class="row result-line" id="vote-majority"><VoteMajorityTag For="totals.For" Against="totals.Against" Abstain="totals.Abstain" /><MajorityHint Icon="true" /></p>
                    <div class="totals">
                        <div class="figure figure--m figure--for"><span class="label">@F.Choice(BallotChoices.For)</span><span class="figure__num">@Display.Number(totals.For)</span></div>
                        <div class="figure figure--m figure--against"><span class="label">@F.Choice(BallotChoices.Against)</span><span class="figure__num">@Display.Number(totals.Against)</span></div>
                        <div class="figure figure--m"><span class="label">@F.Choice(BallotChoices.Abstain)</span><span class="figure__num">@Display.Number(totals.Abstain)</span></div>
                    </div>
                    <SplitBar For="totals.For" Against="totals.Against" Abstain="totals.Abstain" />
                    @if (totals.Voted is { } voted)
                    {
                        <p class="small num">@(totals.Seats is { } seats ? F.T.Format("Vote.Voted", Display.Number(voted), Display.Number(seats)) : F.T.Format("Vote.VotedOnly", Display.Number(voted)))</p>
                    }
                    @if (v.Summary.OfficialNote is { } note)
                    {
                        <p class="note" role="note" id="official-note">@F.T["Vote.Note"] @note</p>
                    }
                }
                <SourceLine UpdatedAt="@_updatedAt" />
            </section>

            @if (v.Ballots.Count > 0)
            {
                <section class="sheet stack" aria-labelledby="h-seats">
                    <h2 id="h-seats">@F.T["Vote.SeatMap"]</h2>
                    <SeatMap Ballots="v.Ballots" />
                </section>

                <section class="sheet stack" aria-labelledby="h-factions">
                    <div class="row list-head"><h2 id="h-factions">@F.T["Vote.Factions"]</h2></div>
                    <div class="table-wrap">
                        <table class="table">
                            <thead><tr><th scope="col">@F.T["Vote.FactionColumn"]</th><th scope="col">@F.T["Vote.PositionColumn"]</th><th scope="col">@F.T["Vote.CountsColumn"]</th></tr></thead>
                            <tbody>
                                @foreach (var f in v.Factions)
                                {
                                    <tr>
                                        <td>@if (f.Faction is { } body) { <a href="/frakcijos/@body.Slug">@body.Name</a> } else { @f.Label }</td>
                                        <td>@F.Position(f.Position)</td>
                                        <td class="num">@F.Counts(f.For, f.Against, f.Abstain)</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </section>
            }
        </div>

        @if (v.Ballots.Count > 0)
        {
            <VoteBallots VoteId="vote.Id" Ballots="v.Ballots" Factions="v.Factions" />
        }

        @if (_moderator)
        {
            <aside class="stack bill-body__aside" aria-label="@F.T["Vote.Moderation"]">
                <Lt2.Web.Client.Parliament.VoteModerationPanel VoteId="vote.Id" @rendermode="InteractiveWebAssembly" />
            </aside>
        }
    </div>

    <p class="small">@if (!SameText(heading, v.AgendaItemTitle)) { @F.T["Vote.Item"]<text>: </text>@v.AgendaItemTitle<text> · </text> }@F.T["Vote.Sitting"]: <span class="num">@F.Time(v.SittingStartsAt)</span></p>
}

@code {
    private VoteResponse? _vote;
    private DateTimeOffset? _updatedAt;
    private bool _moderator;

    [Parameter] public long Id { get; set; }

    protected override async Task OnInitializedAsync()
    {
        _vote = (await Api.GetVoteAsync(Id)).Value;
        if (_vote is null)
        {
            Navigation.NotFound();
            return;
        }

        _updatedAt = (await Meta.GetImportsAsync()).Value?.Sources.FirstOrDefault()?.LastSuccessAt;
        if (Http.HttpContext is { } http && http.User.Identity?.IsAuthenticated == true)
        {
            _moderator = (await Authorization.AuthorizeAsync(http.User, http, Lt2.Web.Security.Policies.Moderator)).Succeeded;
        }
    }

    /// <summary>
    /// The heading and the line under it. When they say the same thing, or one is the start of the other (a procedural
    /// vote: "Dėl posėdžio darbotvarkės" / "Dėl posėdžio darbotvarkės patvirtinimo"), the fuller one is shown once.
    /// </summary>
    internal static (string Heading, string? Wording) Heading(string title, string? wording)
    {
        if (string.IsNullOrWhiteSpace(wording))
        {
            return (title, null);
        }

        var a = title.Trim();
        var b = wording.Trim();
        return a.StartsWith(b, StringComparison.CurrentCultureIgnoreCase) ? (a, null)
            : b.StartsWith(a, StringComparison.CurrentCultureIgnoreCase) ? (b, null)
            : (a, b);
    }

    private static bool SameText(string heading, string other) =>
        heading.Trim().StartsWith(other.Trim(), StringComparison.CurrentCultureIgnoreCase);

    private IEnumerable<string> Label(VoteLink vote)
    {
        yield return F.T["Vote.Label"];
        if (vote.Stage is { } stage)
        {
            yield return F.Stage(stage);
        }

        if (vote.Kind != VoteKinds.StageResult)
        {
            yield return F.Kind(vote.Kind);
        }

        yield return F.Time(vote.HeldAt);
    }
}
