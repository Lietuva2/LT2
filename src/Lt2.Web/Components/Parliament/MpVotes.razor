@page "/p/{Slug}/balsavimai"
@using Lt2.Api.Contracts.Parliament
@using Lt2.Api.Contracts.Meta
@using Lt2.Web.Client.Parliament
@using Lt2.Web.Components.Agenda
@inject IParliamentApi Api
@inject IMetaApi Meta
@inject Formats F
@inject NavigationManager Navigation

@if (_mp is { } p && _votes is { } votes)
{
    <PageTitle>@F.T.Format("Mp.Votes.Title", $"{p.Mp.FirstName} {p.Mp.LastName}") · Lietuva 2.0</PageTitle>
    <LinkPreview Title="@F.T.Format("Mp.Votes.Title", $"{p.Mp.FirstName} {p.Mp.LastName}")" />
    @* Design 8.16.5 (owner, 2026-11-21): the list's sheet has no heading of its own, so the page's title stays at the top of
       the screen while the list scrolls past, the days' dates just under it; the way back above it scrolls away. *@
    <ol class="crumbs">
        <li><a href="/seimo-nariai">@F.T["Mps.Title"]</a></li>
        <li><a href="/p/@p.Mp.Slug">@p.Mp.FirstName @p.Mp.LastName</a></li>
    </ol>
    <div class="page-head" id="page-head">
        <h1>@F.T.Format("Mp.Votes.Title", $"{p.Mp.FirstName} {p.Mp.LastName}")</h1>
    </div>

    @* Owner, 2026-11-18: by day, as the history of votes (design 8.18): the first fifty, then "Rodyti daugiau" in place by the
       address, landing on the first vote added; once the page holds 300, "Ankstesni balsavimai" goes on from there. *@
    <div class="sheet stack" id="mp-votes">
        @if (votes.Items.Count == 0)
        {
            <p>@F.T["Mp.NoVotes"]</p>
        }
        else
        {
            @foreach (var day in MpVotePaging.Days(votes.Items))
            {
                <section class="tl-day tl-past" aria-label="@F.Date(day.Day)" id="diena-@Display.Day(day.Day)">
                    <TimelineDate Label="@F.T.Format("Votes.Year", day.Day.Year)" Day="day.Day" />
                    <div class="tl-rows">
                        <MpVoteRows Votes="day.Rows.Select(r => r.Vote).ToList()" First="day.Rows[0].Number" ShowDate="false" />
                    </div>
                </section>
            }
            @* The shared "show more" (owner, 2026-11-19); the votes come by a cursor without a total, so no "Rodoma N iš M". *@
            <Lt2.Web.Client.Components.ShowMore Id="mp-votes-more" Shown="votes.Items.Count"
                Href="@(MpVotePaging.More(_shown, votes.NextCursor is not null) is { } more ? Address(Cursor, more) + "#" + MpVotePaging.Row(_shown + 1) : null)" />
        }
    </div>

    <p class="row">
        <a href="/p/@p.Mp.Slug">@F.T["Mp.Votes.Back"]</a>
        @if (MpVotePaging.Older(_shown, votes.NextCursor) is { } next)
        {
            <a href="@Address(next, null)" id="mp-votes-older">@F.T["Mp.Votes.Older"]</a>
        }
    </p>
    <SourceLine UpdatedAt="@_updatedAt" />
}

@code {
    private MpProfileResponse? _mp;
    private MpVotesResponse? _votes;
    private DateTimeOffset? _updatedAt;
    private int _shown = MpVotePaging.First;

    [Parameter] public string Slug { get; set; } = "";

    [SupplyParameterFromQuery(Name = "nuo")] public string? Cursor { get; set; }

    [SupplyParameterFromQuery(Name = "rodyti")] public string? Show { get; set; }

    /// <summary>This page's address from <paramref name="cursor"/> with <paramref name="shown"/> votes (defaults left out).</summary>
    private string Address(string? cursor, int? shown)
    {
        var parts = new List<string>();
        if (!string.IsNullOrEmpty(cursor))
        {
            parts.Add("nuo=" + Uri.EscapeDataString(cursor));
        }

        if (shown is { } n && n != MpVotePaging.First)
        {
            parts.Add("rodyti=" + n.ToString(System.Globalization.CultureInfo.InvariantCulture));
        }

        var path = "/p/" + Uri.EscapeDataString(Slug) + "/balsavimai";
        return parts.Count == 0 ? path : path + "?" + string.Join("&", parts);
    }

    protected override async Task OnParametersSetAsync()
    {
        _shown = MpVotePaging.Shown(Show);
        _mp = (await Api.GetMpAsync(Slug)).Value;
        _votes = (await Api.GetMpVotesAsync(Slug, Cursor, _shown)).Value;
        if (_mp is null || _votes is null)
        {
            Navigation.NotFound();
            return;
        }

        _updatedAt = (await Meta.GetImportsAsync()).Value?.Sources.FirstOrDefault()?.LastSuccessAt;
    }
}
