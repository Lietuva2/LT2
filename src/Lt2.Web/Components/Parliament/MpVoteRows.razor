@using Lt2.Api.Contracts.Parliament
@inject Formats F

@* An MP's votes: the choice (or "approved by consensus", without numbers) and how the MP's faction voted. *@
<ul class="rows">
    @for (var i = 0; i < Votes.Count; i++)
    {
        var v = Votes[i];
        <VoteRow Vote="v.Vote" Id="@(First is { } first ? Lt2.Web.Client.Parliament.MpVotePaging.Row(first + i) : null)" ShowDate="ShowDate">
            @if (v.Vote.IsConsensus)
            {
                <span class="tag">@F.T["Consensus.Tag"]</span>
                <span class="small">@F.T["Consensus.NoVotes"]</span>
            }
            else if (v.Choice is null)
            {
                <span class="small">@F.T["NoResult"]</span>
            }
            else
            {
                <span class="@Formats.ChoiceClass(v.Choice)">@F.Choice(v.Choice)</span>
                @if (v.Faction is { } split)
                {
                    <FactionSplitText Split="split" />
                }
            }
        </VoteRow>
    }
</ul>

@code {
    [Parameter, EditorRequired] public IReadOnlyList<MpVoteResponse> Votes { get; set; } = [];

    /// <summary>The place of the first row in the whole list, for the rows' ids (an MP's votes page); none: no ids.</summary>
    [Parameter] public int? First { get; set; }

    /// <summary>False under a day's head, which says the date.</summary>
    [Parameter] public bool ShowDate { get; set; } = true;
}
