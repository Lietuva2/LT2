@page "/metodika"
@using Lt2.Api.Contracts.Meta
@inject IMetaApi Meta
@inject Lt2.Api.Contracts.Digests.IDigestsApi Digests
@inject Lt2.Api.Contracts.Appeals.IAppealsApi Appeals
@inject IStringLocalizer<Lt2.Web.Components.Appeals.AppealText> A
@inject Formats F

<PageTitle>@F.T["Method.Title"] · Lietuva 2.0</PageTitle>

<section class="stack" aria-labelledby="method-title">
    <h1 id="method-title">@F.T["Method.Title"]</h1>
    <p class="lead">@F.T["Method.Lead"]</p>
</section>

<div class="stack stack--loose">
    <section class="stack" aria-labelledby="m-source" id="saltinis">
        <h2 id="m-source">@F.T["Method.Source"]</h2>
        <p>@F.T["Method.Source.1"]</p>
        <p>@F.T["Method.Source.2"]</p>
        <p class="num">@(_lastSuccess is { } at ? F.T.Format("Method.Source.Last", F.Time(at)) : F.T["Method.Source.Never"])</p>
        <SourceLine UpdatedAt="@_lastSuccess" HideMethodology="true" />
    </section>

    <section class="stack" aria-labelledby="m-participation" id="dalyvavimas">
        <h2 id="m-participation">@F.T["Method.Participation"]</h2>
        <p>@F.T["Method.Participation.1"]</p>
        <p>@F.T["Method.Participation.2"]</p>
        <p>@F.T["Method.Participation.3"]</p>
    </section>

    <section class="stack" aria-labelledby="m-faction" id="kaip-frakcija">
        <h2 id="m-faction">@F.T["Method.WithFaction"]</h2>
        <p>@F.T["Method.WithFaction.1"]</p>
        <p>@F.T["Method.WithFaction.2"]</p>
        <p id="absence-rule">@F.T["Method.WithFaction.Absence"]</p>
        <p id="mixed-group-rule">@F.T["Method.WithFaction.MixedGroup"]</p>
        <p>@F.T["Method.WithFaction.3"]</p>
    </section>

    <section class="stack" aria-labelledby="m-notes">
        <h2 id="m-notes">@F.T["Method.Notes"]</h2>
        <p>@F.T["Method.Notes.1"]</p>
        <p>@F.T["Method.Notes.2"]</p>
    </section>

    <section class="stack" aria-labelledby="m-stages">
        <h2 id="m-stages">@F.T["Method.Classification"]</h2>
        <p>@F.T["Method.Classification.1"]</p>
    </section>

    @* Design 8.15: why a planned date moves and how a wrong one is corrected (was beside every planned date). *@
    <section class="stack" aria-labelledby="m-dates" id="planuojamos-datos">
        <h2 id="m-dates">@A["Method.Dates"]</h2>
        <p>@A["Method.Dates.1"]</p>
    </section>

    @if (_rules is { } r)
    {
        @* Design 8.4: the rules that decide what MPs would receive, with their current values (runtime settings). *@
        <section class="stack" aria-labelledby="m-digests" id="suvestiniu-taisykles">
            <h2 id="m-digests">@A["Method.Digests"]</h2>
            <p>@A["Method.Digests.Lead"]</p>
            <dl class="facts" id="digest-rules">
                <dt id="riba">@A["Method.Digests.Threshold"]</dt><dd class="num">@A.Format("Method.Digests.ThresholdValue", Display.Number(r.ThresholdDefault), Display.Number(r.ThresholdMinimum))</dd>
                <dt>@A["Method.Digests.Weekly"]</dt><dd class="num">@(r.Weekly == "off" ? A["Method.Digests.Off"] : A.Format("Method.Digests.WeeklyValue", r.Weekly))</dd>
                <dt>@A["Method.Digests.Notable"]</dt><dd class="num">@A.Format("Method.Digests.NotableValue", Display.Number((int)Math.Round(r.NotableChange * 100)))</dd>
                <dt>@A["Method.Digests.BeforeVote"]</dt><dd class="num">@(r.BeforeVote == "off" ? A["Method.Digests.Off"] : A.Format("Method.Digests.BeforeVoteValue", r.BeforeVote))</dd>
                <dt>@A["Method.Digests.Ceiling"]</dt><dd class="num">@A.Format("Method.Digests.CeilingValue", Display.Number(r.MaxPerWeek))</dd>
                <dt>@A["Method.Digests.Counts"]</dt><dd class="num">@A.Format("Method.Digests.CountsValue", Display.Number(r.OlderThanDays))</dd>
                <dt>@A["Method.Digests.Reasons"]</dt><dd class="num">@A.Format("Method.Digests.ReasonsValue", Display.Number(r.ReasonsPerSide))</dd>
                <dt>@A["Method.Digests.Surge"]</dt><dd class="num">@A.Format("Method.Digests.SurgeValue", Display.Number((int)Math.Round(r.SurgeMinimumShare * 100)), Display.Number(r.SurgeWindowHours), Display.Number(r.SurgeMinimumAccounts))</dd>
                <dt>@A["Method.Digests.Groups"]</dt><dd class="num">@A.Format("Method.Digests.GroupsValue", Display.Number(r.GroupMinimum))</dd>
                @* Design 8.15: who would receive a summary and what its public copy holds (were on the summaries page). *@
                <dt id="kas-gautu">@A["Digests.Who"]</dt><dd>@A["Digests.WhoValue"]</dd>
                <dt id="viesa-kopija">@A["Method.Digests.PublicCopy"]</dt><dd>@A["Method.Digests.PublicCopyValue"]</dd>
            </dl>
            <p>@A["Method.Digests.NotSent"] <a href="/suvestines">@A["Digests.Title"]</a> · <a href="/moderavimo-taisykles">@A["Rules.Title"]</a></p>
        </section>
    }

    @* Design 8.15: what is public and what is not, said once here; the screens say only the short part where one acts. *@
    <section class="stack" aria-labelledby="m-privacy" id="privatumas">
        <h2 id="m-privacy">@A["Method.Privacy"]</h2>
        <p>@A["Method.Privacy.1"]</p>
    </section>

    @* Design 8.2 (decided 2026-11-13): an argument is its author's own deliberate publication; no positions consent. *@
    <section class="stack" aria-labelledby="m-reasons" id="argumentai">
        <h2 id="m-reasons">@A["Method.Reasons"]</h2>
        <p>@A["Method.Reasons.1"]</p>
    </section>

    @* Design 8.13: how descriptions are made, what the labels mean, how to report an error. The paragraph on AI summaries
       is shown only while the summary job can make them, so nothing promises a summary otherwise. *@
    <section class="stack" aria-labelledby="m-descriptions" id="aprasymai">
        <h2 id="m-descriptions">@A["Method.Descriptions"]</h2>
        <p>@A["Method.Descriptions.1"]</p>
        <h3 id="m-description-labels">@A["Method.Descriptions.Labels"]</h3>
        <dl class="facts" id="description-labels">
            <dt>@A["What.Source.ai"]</dt><dd>@A["Method.Descriptions.ai"]</dd>
            <dt>@A["What.Source.ai-draft"]</dt><dd>@A["Method.Descriptions.ai-draft"]</dd>
            <dt>@A["What.Source.moderator"]</dt><dd>@A["Method.Descriptions.moderator"]</dd>
            <dt>@A["Method.Descriptions.InitiatorLabel"]</dt><dd>@A["Method.Descriptions.initiator"]</dd>
        </dl>
        @if (_limits is { AiSummaries: true })
        {
            <p id="ai-summaries">@A["Method.Descriptions.Job"]</p>
        }
        @* Design 8.13 (decided 2026-11-14): the page names both public prompts, the moderator's draft's and the job's. *@
        <p id="ai-prompts">@A.Format("Method.Descriptions.Prompts", DraftPrompt, SummaryPrompt)</p>
        <p id="report-description">@A["Method.Descriptions.Report"]</p>
        <p>@A["Method.Descriptions.NotSent"]</p>
    </section>

    @* Design 8.14.9, 8.14.14: what an organisation's statement is, that it is not counted, what "Patvirtinta" means and does
       not, and that nothing is paid for. *@
    <section class="stack" aria-labelledby="m-organisations" id="organizacijos">
        <h2 id="m-organisations">@A["Method.Organisations"]</h2>
        <p>@A["Method.Organisations.1"]</p>
        <p id="organisations-private">@A["Method.Organisations.Private"]</p>
        <p id="statements-not-counted">@A["Method.Organisations.2"]</p>
        <h3 id="m-organisation-labels">@A["Method.Organisations.Labels"]</h3>
        <dl class="facts" id="organisation-labels">
            <dt>@A["Method.Organisations.Label.none"]</dt><dd>@A["Method.Organisations.Means.none"]</dd>
            <dt>@A["Method.Organisations.Label.domain"]</dt><dd>@A["Method.Organisations.Means.domain"]</dd>
            <dt>@A["Method.Organisations.Label.moderator"]</dt><dd>@A["Method.Organisations.Means.moderator"]</dd>
        </dl>
        <p>@A["Method.Organisations.3"]</p>
        <p id="nothing-paid">@A["Method.Organisations.4"]</p>
        <p><a href="/organizacijos">@A["Method.Organisations.List"]</a> · <a href="/moderavimo-taisykles#Organisations">@A["Rules.Title"]</a></p>
    </section>

    @if (_limits is { } l)
    {
        @* Design 8.2: the per-person limits are runtime settings; 0 means no limit (the default), said in words. *@
        <section class="stack" aria-labelledby="m-limits" id="ribos-zmogui">
            <h2 id="m-limits">@A["Method.Limits"]</h2>
            <dl class="facts" id="person-limits">
                <dt>@A["Method.Limits.Reasons"]</dt><dd class="num">@(l.ReasonsPerPerson == 0 ? A["Method.Limits.None"] : A.Format("Method.Limits.ReasonsValue", Display.Number(l.ReasonsPerPerson)))</dd>
                <dt>@A["Method.Limits.Endorsements"]</dt><dd class="num">@(l.EndorsementsPerPerson == 0 ? A["Method.Limits.None"] : A.Format("Method.Limits.EndorsementsValue", Display.Number(l.EndorsementsPerPerson)))</dd>
            </dl>
            <p>@A["Method.Limits.Note"]</p>
        </section>
    }

    <section class="stack" aria-labelledby="m-not">
        <h2 id="m-not">@F.T["Method.Not"]</h2>
        <p>@F.T["Method.Not.1"]</p>
    </section>
</div>

@code {
    /// <summary>The public prompts in the repository (design 8.11.4, 8.13), as the Appeals module embeds them.</summary>
    private const string DraftPrompt = "src/Modules/Lt2.Appeals/Ai/description-draft.prompt.md";
    private const string SummaryPrompt = "src/Modules/Lt2.Appeals/Ai/description-summary.prompt.md";

    private DateTimeOffset? _lastSuccess;
    private Lt2.Api.Contracts.Digests.DigestRulesResponse? _rules;
    private Lt2.Api.Contracts.Appeals.AppealRulesResponse? _limits;

    protected override async Task OnInitializedAsync()
    {
        _lastSuccess = (await Meta.GetImportsAsync()).Value?.Sources.FirstOrDefault()?.LastSuccessAt;
        _rules = (await Digests.GetRulesAsync()).Value;
        _limits = (await Appeals.GetRulesAsync()).Value;
    }
}
