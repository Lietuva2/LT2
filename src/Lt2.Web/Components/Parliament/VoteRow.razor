@using Lt2.Api.Contracts.Parliament
@inject Formats F

@* One vote in a list: what it was about, bill, stage and date; the side column is the caller's. *@
<li id="@Id">
    <div class="rows__main">
        @if (Vote.Bill is { } bill)
        {
            @* Design 8.13.1: the bill's readable title leads, with the official title under it. *@
            <Lt2.Web.Client.Components.BillTitleLink Href="@VoteLinks.Page(Vote.Id)" Title="@bill.Title" PlainTitle="@bill.PlainTitle" />
        }
        else
        {
            <a href="@VoteLinks.Page(Vote.Id)">@Vote.Wording</a>
        }
        <span class="small num">@string.Join(" · ", Facts())</span>
    </div>
    <div class="rows__side">
        @ChildContent
    </div>
</li>

@code {
    [Parameter, EditorRequired] public VoteLink Vote { get; set; } = default!;

    [Parameter] public RenderFragment? ChildContent { get; set; }

    /// <summary>The row's id, where a link lands; none when not given.</summary>
    [Parameter] public string? Id { get; set; }

    /// <summary>False under a day's head, which says the date (an MP's votes by day).</summary>
    [Parameter] public bool ShowDate { get; set; } = true;

    private IEnumerable<string> Facts()
    {
        if (Vote.Bill is { } bill)
        {
            yield return bill.Number;
        }

        yield return Vote.Stage is { } stage ? F.Stage(stage).ToLowerInvariant() : F.Kind(Vote.Kind).ToLowerInvariant();
        if (Vote.Kind == VoteKinds.Amendment)
        {
            yield return F.Kind(Vote.Kind).ToLowerInvariant();
        }

        if (ShowDate)
        {
            yield return F.Date(Vote.HeldAt);
        }
    }
}
