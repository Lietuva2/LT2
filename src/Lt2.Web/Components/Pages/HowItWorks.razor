@inject IStringLocalizer<Lt2.Web.Components.Appeals.AppealText> A
@inject IStringLocalizer<Lt2.Web.Client.Appeals.AppealUi> U

@* "Kaip tai veikia" (design 8.7): four numbered steps and the link to what stays private. The same
   texts on the visitor's front page and at the top of the methodology page (/metodika#kaip-tai-veikia), where a member's
   "Kaip tai veikia" link leads. The one place where the short-texts rule of 8.15 does not apply. The fourth step's texts
   are the client's (AppealUi), shared with the new member's start on the front page (design 8.28.3, MyStart). *@
<section class="stack home-how" aria-labelledby="@($"{IdPrefix}how-title")" id="@Id">
    <h2 id="@($"{IdPrefix}how-title")">@A["HowItWorks.Title"]</h2>
    <ol class="intro-steps">
        @for (var step = 1; step <= 4; step++)
        {
            var texts = step == 4 ? (IStringLocalizer)U : A;
            <li><h3>@texts[$"HowItWorks.{step}.Title"]</h3><p>@texts[$"HowItWorks.{step}.Text"]@(step == 4 && Sending == "off" ? " " + U["HowItWorks.4.Trial"] : "")</p></li>
        }
    </ol>
    <p><a href="/metodika#privatumas">@A["HowItWorks.PrivacyLink"]</a></p>
</section>

@code {
    /// <summary>The section's id: the methodology's anchor there, none needed on the front page.</summary>
    [Parameter] public string? Id { get; set; }

    /// <summary>Keeps the heading's id unique where the page has other headings of its own.</summary>
    [Parameter] public string IdPrefix { get; set; } = "";

    /// <summary>Sending as it is now (design 8.19.1): step 4 says that nothing is sent only while that is so.</summary>
    [Parameter] public string Sending { get; set; } = "off";
}
