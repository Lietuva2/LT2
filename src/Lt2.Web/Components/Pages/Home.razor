@page "/"
@using Lt2.Api.Contracts.Agenda
@using Lt2.Web.Client.Agenda
@using Lt2.Web.Client.Appeals
@using Lt2.Web.Client.Parliament
@using Lt2.Web.Components.Agenda
@inject IStringLocalizer<PageText> T
@inject IStringLocalizer<AppealUi> U
@inject Lt2.Web.Services.FrontPageAgenda Agenda
@inject Lt2.Api.Contracts.Digests.IDigestsApi Digests
@inject Formats F
@inject Lt2.Api.Contracts.Meta.IMetaApi Meta

@* The front page (design 8.7, reworked 2026-11-15: variant A, with the member's panel of variant C; the mockup is in
   design/ui/pradzia.html and pradzia-narys.html). The page is the agenda with what a person can do about it, built from the one public agenda
   answer kept in memory for a minute (FrontPageAgenda). A visitor first gets the introduction ("Kaip tai veikia") and
   the links to register or sign in, never a form; a member gets the greeting, the new member's start (design 8.28.3) and
   "Jūsų projektai". Everything that
   is a member's own (the panel, the marks and actions in the rows) is an island filled in the browser from their own
   answers, so the server renders the same page for every member and nothing per person is in it. *@
<PageTitle>Lietuva 2.0</PageTitle>
@* Design 8.22.5: the site's name and its lead sentence (the default description). *@
<LinkPreview Title="Lietuva 2.0" Path="/" />

<AuthorizeView>
    <Authorized>
        @* Design 8.28.3: the greeting ("Sveiki" as served, completed in the browser) and, for a member who has never taken a
           side, the start on the ground between the greeting and the agenda, both from the member's own answer. *@
        <MyStart Numbers="_numbers" Sending="@_sending" @rendermode="InteractiveWebAssembly" />
        <MyAgendaPanel Numbers="_numbers" @rendermode="InteractiveWebAssembly" />
    </Authorized>
    <NotAuthorized>
        @* Owner, 2026-11-17: the headline is what the site does (the header already names it), and under it the trial note
           with its links, in a column a line of text wide, so the note has the same edges as the invented-data notice above
           the page; the turning logo stands in the space to the right of that column, across both rows. On a phone the small
           logo stands beside the headline and the note goes under both. *@
        <div class="home-head @(_invented != Lt2.Web.Components.Layout.InventedData.None ? "home-head--notice" : "")" id="home-head">
            @if (_invented != Lt2.Web.Components.Layout.InventedData.None)
            {
                @* The layout leaves the invented-data notice to this head on the visitor's front page (owner, 2026-11-17), so the
                   logo is centred between the menu and the rule above "Kaip tai veikia", the notice included. *@
                <p class="note" role="note" id="invented-data">@(_invented == Lt2.Web.Components.Layout.InventedData.Parliament ? T["Notice.InventedParliament"] : T["Notice.InventedMembers"])</p>
            }
            <lt2-logo-spin period="14"></lt2-logo-spin>
            <h1 id="home-title">@T["Home.Lead"]</h1>
            <div class="stack stack--tight home-head__signin" id="home-sign-in">
                <p class="note">@T["Home.Trial"]</p>
                <p class="small">@T["Home.HaveCode"] <a href="/prisijungti?registruotis=true" id="home-register">@T["Home.Register"]</a> · @T["Home.HaveAccount"] <a href="/prisijungti" id="home-sign-in-link">@T["Home.SignIn"]</a></p>
            </div>
        </div>
        <HowItWorks Sending="@_sending" />
    </NotAuthorized>
</AuthorizeView>

@* The agenda is the page's content (design 8.16), in two lists, each on a sheet of its own (owner, 2026-11-21): the planned
   days run forward and the voted days back, so each has its heading, with its long form linked beside it. The heading row
   stays at the top of the screen while its sheet scrolls past (.list-head, design 8.16.5). Nothing stands under the lists:
   what the numbers are is said on the bill's page and the methodology. The page has no block of its own about
   organisations (owner, 2026-11-16): the footer links to them and a member registers one from the account page. *@
<section class="sheet stack home-agenda" aria-labelledby="h-home-coming" id="home-coming">
    <div class="row list-head">
        <h2 id="h-home-coming">@T["Home.Coming"]</h2>
        <a href="/darbotvarke" id="home-agenda-all">@T["Agenda.All"]</a>
    </div>
    <p class="small" id="home-agenda-source">
        @T["Agenda.Source"]@(" ")@(_agenda?.AgendaReadAt is { } readAt ? T.Format("Agenda.ReadAt", Display.DayTime(readAt)) : T["Agenda.NeverRead"])
    </p>
    @if (_coming.Count == 0)
    {
        <p id="home-none-planned">@T["Agenda.NonePlanned"]</p>
    }
    <AuthorizeView>
        <Authorized>@Coming(true)</Authorized>
        <NotAuthorized>@Coming(false)</NotAuthorized>
    </AuthorizeView>
</section>

@* Design 8.18: the long form of this list beside its heading, also when the last seven days had no vote. *@
<section class="sheet stack" aria-labelledby="h-home-recent" id="home-recent">
    <div class="row list-head">
        <h2 id="h-home-recent">@T["Home.Recent"]</h2>
        <a href="@VoteHistory.Path" id="home-votes-older">@T["Agenda.Older"]</a>
    </div>
    @if (_voted.Count == 0)
    {
        <p id="home-no-recent">@T["Agenda.NoRecent"]</p>
    }
    <AuthorizeView>
        <Authorized>@Recent(true)</Authorized>
        <NotAuthorized>@Recent(false)</NotAuthorized>
    </AuthorizeView>
</section>

@if (_sending == "off")
{
    @* Design 8.15, 8.19.1: "nothing is sent" stays inline while it is true. *@
    <AuthorizeView>
        <Authorized>
            <p class="note" id="home-trial-summaries">@T["Home.TrialSummaries"]</p>
        </Authorized>
    </AuthorizeView>
}

@code {
    private AgendaResponse? _agenda;

    /// <summary>The next sitting days the page shows, each cut to its first rows (design 8.7, owner 2026-11-18).</summary>
    private List<(DateOnly Day, AgendaDayView<AgendaItemResponse> View)> _coming = [];

    /// <summary>The last voting days the page shows, each cut to its first rows.</summary>
    private List<(DateOnly Day, AgendaDayView<AgendaVoteResponse> View)> _voted = [];

    /// <summary>The planned days shown grown, with the known rows each shows (<c>?diena=2026-11-24:15</c>), for the links.</summary>
    private IReadOnlyDictionary<DateOnly, int> _grownPlanned = new Dictionary<DateOnly, int>();

    /// <summary>The voted days shown grown (<c>?balsuota=</c>).</summary>
    private IReadOnlyDictionary<DateOnly, int> _grownVoted = new Dictionary<DateOnly, int>();

    /// <summary>The bills of the rows shown, for the members' islands to ask about (each once; in requests of thirty).</summary>
    private IReadOnlyList<string> _numbers = [];

    /// <summary>Sending as it is now (design 8.19.1); the trial note says nothing is sent only while that is so.</summary>
    private string _sending = "off";

    /// <summary>The parliament data is invented: the visitor's head carries the notice (the layout leaves it out here).</summary>
    private Lt2.Web.Components.Layout.InventedData _invented;

    [CascadingParameter] public HttpContext? HttpContext { get; set; }

    [SupplyParameterFromQuery(Name = AgendaPaging.PlannedParameter)] public string[]? Planned { get; set; }

    [SupplyParameterFromQuery(Name = AgendaPaging.VotedParameter)] public string[]? Voted { get; set; }

    protected override async Task OnParametersSetAsync()
    {
        _invented = await Lt2.Web.Components.Layout.InventedDataNotice.ReadAsync(HttpContext, Meta);
        _agenda = await Agenda.ReadAsync(CancellationToken.None);
        _sending = (await Digests.GetRulesAsync()).Value?.Sending ?? "off";
        var planned = AgendaPaging.Read(Planned);
        var voted = AgendaPaging.Read(Voted);
        // Owner, 2026-11-18: the next two sitting days and the last two voting days, five rows of each in the agenda's order
        // (AgendaRules); the rows not shown are not rendered. Owner, 2026-11-19: under a longer day the shared "Rodyti
        // daugiau" adds 50 in place by the address (AgendaPaging.Front, ?diena=2026-11-24:55), as on the agenda page. A
        // bill the open data does not know yet is counted in its day and listed (one folded line) once every known row shows.
        _coming = _agenda.Days.Take(AgendaRules.FrontDays)
            .Select(d => (d.Date, Cut(d.Items, i => i.Title is not null, planned.GetValueOrDefault(d.Date))))
            .ToList();
        _voted = _agenda.RecentVotes.GroupBy(v => Display.DayOf(v.HeldAt)).OrderByDescending(g => g.Key).Take(AgendaRules.FrontDays)
            .Select(g => (g.Key, Cut(g.ToList(), _ => true, voted.GetValueOrDefault(g.Key))))
            .ToList();
        _grownPlanned = AgendaPaging.Grown(_coming.Select(d => (d.Day, d.View.Shown.Count)), AgendaRules.FrontPerDay);
        _grownVoted = AgendaPaging.Grown(_voted.Select(d => (d.Day, d.View.Shown.Count)), AgendaRules.FrontPerDay);
        _numbers = AgendaRules.Asked(
            _coming.SelectMany(d => d.View.Shown.Select(i => i.Number)).Concat(_voted.SelectMany(d => d.View.Shown.Select(v => v.Number))));
    }

    /// <summary>A day cut for the front page: its first five known rows, or as many as the address asks.</summary>
    private static AgendaDayView<TRow> Cut<TRow>(IReadOnlyList<TRow> rows, Func<TRow, bool> known, int asked) =>
        AgendaRules.Day(rows, known, AgendaRules.ShownKnown(AgendaRules.FrontPerDay, asked, rows.Count(known)));

    private RenderFragment Coming(bool member) => __builder =>
    {
        foreach (var (day, view) in _coming)
        {
            <PlannedDay Page="AgendaPaging.Front" Day="day" View="view" First="AgendaRules.FrontPerDay" Planned="_grownPlanned" Voted="_grownVoted" Member="member" Numbers="_numbers" />
        }
    };

    private RenderFragment Recent(bool member) => __builder =>
    {
        foreach (var (day, view) in _voted)
        {
            <VotedDay Page="AgendaPaging.Front" Day="day" View="view" First="AgendaRules.FrontPerDay" Planned="_grownPlanned" Voted="_grownVoted" Member="member" Numbers="_numbers" />
        }
    };
}