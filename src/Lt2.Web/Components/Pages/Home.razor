@page "/"
@inject IStringLocalizer<PageText> T

<PageTitle>Lietuva 2.0</PageTitle>

<section class="stack" aria-labelledby="home-title">
    <p class="label">@T["Home.Eyebrow"]</p>
    <h1 id="home-title">Lietuva 2.0</h1>
    <p class="lead">@T["Home.Kicker"]</p>
    <p>@T["Home.Lede"]</p>
    <p class="note">@T["Home.Trial"]</p>
    <div class="row">
        <AuthorizeView>
            <Authorized>
                <a class="btn" href="/sveiki">@T["Home.ToAccount"]</a>
            </Authorized>
            <NotAuthorized>
                <a class="btn" href="/prisijungti">@T["Home.SignIn"]</a>
                <a class="btn btn--plain" href="/prisijungti?registruotis=true">@T["Home.Register"]</a>
            </NotAuthorized>
        </AuthorizeView>
    </div>
</section>
