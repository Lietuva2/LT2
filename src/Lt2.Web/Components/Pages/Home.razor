@page "/"
@using Lt2.Api.Contracts.Agenda
@using Lt2.Web.Client.Appeals
@inject IStringLocalizer<PageText> T
@inject IStringLocalizer<Lt2.Web.Components.Appeals.AppealText> A
@inject IStringLocalizer<AppealUi> U
@inject Lt2.Web.Services.FrontPageAgenda Agenda
@inject Lt2.Api.Contracts.Digests.IDigestsApi Digests
@inject Formats F

@* The front page (design 8.7, reworked 2026-11-15: variant A, with the member's panel of variant C; the mockup is in
   design/ui/pradzia.html and pradzia-narys.html). The page is the agenda with what a person can do about it, built from the one public agenda
   answer kept in memory for a minute (FrontPageAgenda). A visitor first gets the introduction ("Kaip tai veikia") and
   the links to register or sign in, never a form; a member gets "Sveiki sugrįžę" and "Jūsų projektai". Everything that
   is a member's own (the panel, the marks and actions in the rows) is an island filled in the browser from their own
   answers, so the server renders the same page for every member and nothing per person is in it. *@
<PageTitle>Lietuva 2.0</PageTitle>

<AuthorizeView>
    <Authorized>
        <div class="stack stack--tight" id="home-welcome">
            <h1 id="home-title" class="home-h1-s">@T["Home.Welcome"]</h1>
            <p class="small"><a href="/metodika#kaip-tai-veikia" id="home-how-link">@T["Home.HowLink"]</a> · <a href="/sveiki">@T["Nav.Account"]</a></p>
            <Lt2.Web.Client.Components.NeedsScript />
        </div>
        <MyAgendaPanel Bills="_panel" Numbers="_numbers" @rendermode="InteractiveWebAssembly" />
    </Authorized>
    <NotAuthorized>
        <div class="home-head" id="home-head">
            <lt2-logo-spin period="14"></lt2-logo-spin>
            <div class="stack stack--tight">
                <h1 id="home-title">Lietuva 2.0</h1>
                <p class="lead">@T["Home.Lead"]</p>
            </div>
            <div class="stack stack--tight home-head__signin" id="home-sign-in">
                <p class="note">@T["Home.Trial"]</p>
                <p class="small">@T["Home.HaveCode"] <a href="/prisijungti?registruotis=true" id="home-register">@T["Home.Register"]</a> · @T["Home.HaveAccount"] <a href="/prisijungti" id="home-sign-in-link">@T["Home.SignIn"]</a></p>
            </div>
        </div>
        <HowItWorks />
    </NotAuthorized>
</AuthorizeView>

@* The agenda is the page's content, so it is on a sheet; the two notes that explain its numbers sit on it, under the
   timeline. "Organizacijos" below is a plain block on the ground (design 8.16). *@
<section class="sheet stack home-agenda" aria-labelledby="h-home-coming" id="home-coming">
    <div class="row">
        <h2 id="h-home-coming">@T["Home.Coming"]</h2>
        <a href="/darbotvarke">@T["Agenda.All"]</a>
    </div>
    <p class="small" id="home-agenda-source">
        @T["Agenda.Source"]@(" ")@(_agenda?.AgendaReadAt is { } readAt ? T.Format("Agenda.ReadAt", Display.DayTime(readAt)) : T["Agenda.NeverRead"])
    </p>
    @if (_coming.Count == 0)
    {
        <p id="home-none-planned">@T["Agenda.NonePlanned"]</p>
    }
    <AuthorizeView>
        <Authorized>@Timeline(true)</Authorized>
        <NotAuthorized>@Timeline(false)</NotAuthorized>
    </AuthorizeView>
    @* Design 8.15: "riba" repeats in the rows, so what it is is said once, beside the note under the timeline (a hint, as on
       /darbotvarke); none per row. The number is the runtime setting, read with the page through the settings' own short
       cache, not kept in the front page's copy of the agenda. *@
    <p class="small" id="home-older-note">@T["Agenda.OlderNote"]@if (_threshold is { } threshold)
        {
            @(" · ")<Lt2.Web.Client.Components.Hint Id="threshold-what" Text="@A["Threshold.What"]" Answer="@(A["Threshold.Meaning"] + " " + A.Format("Threshold.NowList", Display.Number(threshold)))" More="/metodika#riba" />
        }</p>
    <p class="note note--quiet" id="not-a-poll">@A["NotAPoll"]</p>
</section>

<section class="stack stack--tight" aria-labelledby="h-home-organisations" id="home-organisations">
    <h2 id="h-home-organisations">@T["Home.Organisations"]</h2>
    <p>@T["Home.OrganisationsText"]</p>
    <p class="row"><a href="/organizacijos">@T["Home.OrganisationsList"]</a> <a href="/organizacijos/nauja">@T["Home.OrganisationsRegister"]</a></p>
</section>

<p class="row" id="home-more"><a href="/projektai">@T["Home.AllAppeals"]</a> <a href="/suvestines">@T["Home.Digests"]</a> <a href="/seimo-nariai">@T["Nav.Mps"]</a></p>

<AuthorizeView>
    <Authorized>
        <p class="note" id="home-trial-summaries">@T["Home.TrialSummaries"]</p>
    </Authorized>
</AuthorizeView>

@code {
    /// <summary>At most eight coming planned items in all, kept in their days (design 8.11.1, 8.7).</summary>
    private const int ComingShown = 8;

    private AgendaResponse? _agenda;
    private List<AgendaDayResponse> _coming = [];
    private List<IGrouping<DateOnly, AgendaVoteResponse>> _voted = [];
    private List<MyAgendaBill> _panel = [];
    private List<string> _numbers = [];

    /// <summary>The threshold that holds now for a bill without its own (a runtime setting), for the hint under the timeline.</summary>
    private int? _threshold;

    protected override async Task OnInitializedAsync()
    {
        _agenda = await Agenda.ReadAsync(CancellationToken.None);
        _threshold = (await Digests.GetRulesAsync()).Value?.ThresholdDefault;
        var left = ComingShown;
        foreach (var day in _agenda.Days)
        {
            if (left <= 0)
            {
                break;
            }

            var items = day.Items.Take(left).ToList();
            left -= items.Count;
            _coming.Add(day with { Items = items });
        }

        _voted = _agenda.RecentVotes.GroupBy(v => Display.DayOf(v.HeldAt)).OrderByDescending(g => g.Key).ToList();

        // The member's panel lists, of these public bills, those that are theirs; the islands learn which in the browser.
        var lastVotes = _agenda.RecentVotes.GroupBy(v => v.Number, StringComparer.Ordinal)
            .ToDictionary(g => g.Key, g => g.OrderByDescending(v => v.HeldAt).First(), StringComparer.Ordinal);
        foreach (var (day, item) in _coming.SelectMany(d => d.Items.Select(i => (d.Date, i))))
        {
            if (item.Title is { } title && _panel.All(p => p.Number != item.Number))
            {
                _panel.Add(new MyAgendaBill(item.Number, title, F.DayMonth(day), LastVote(lastVotes.GetValueOrDefault(item.Number))));
            }
        }

        foreach (var vote in _agenda.RecentVotes.OrderByDescending(v => v.HeldAt))
        {
            if (_panel.All(p => p.Number != vote.Number))
            {
                _panel.Add(new MyAgendaBill(vote.Number, vote.Title, null, LastVote(vote)));
            }
        }

        _numbers = _panel.Select(p => p.Number).Take(Lt2.Api.Contracts.Me.MyBillsQuery.MaxNumbers).ToList();
    }

    /// <summary>"svarstymas, lapkričio 13 d.: už 69 · prieš 31 · susilaikė 18", or the consensus mark.</summary>
    private string? LastVote(AgendaVoteResponse? vote) => vote is null
        ? null
        : F.Stage(vote.Stage).ToLowerInvariant() + ", " + F.DayMonth(Display.DayOf(vote.HeldAt)) + ": "
            + (vote.IsConsensus ? F.T["Consensus.Tag"].Value : T.Format("Agenda.Result", Display.Number(vote.Totals.For), Display.Number(vote.Totals.Against), Display.Number(vote.Totals.Abstain)));

    private RenderFragment Timeline(bool member) => __builder =>
    {
        foreach (var day in _coming)
        {
            <section class="tl-day" aria-label="@($"{T["Agenda.Planned"]} {F.DayMonth(day.Date)}")" id="home-day-@Display.Day(day.Date)">
                <div class="tl-date"><span class="label">@T["Agenda.Planned"]</span><b>@F.DayMonth(day.Date)</b><span class="small">@F.Weekday(day.Date)</span></div>
                <ul class="tl-items">
                    @foreach (var item in day.Items)
                    {
                        <TimelineItem Item="item" Day="day.Date" Member="member" Numbers="_numbers" />
                    }
                </ul>
            </section>
        }

        foreach (var day in _voted)
        {
            <section class="tl-day tl-past" aria-label="@($"{T["Agenda.Voted"]} {F.DayMonth(day.Key)}")" id="home-voted-@Display.Day(day.Key)">
                <div class="tl-date"><span class="label">@T["Agenda.Voted"]</span><b>@F.DayMonth(day.Key)</b><span class="small">@F.Weekday(day.Key)</span></div>
                <ul class="tl-items">
                    @foreach (var v in day)
                    {
                        <li class="tl-item" id="recent-@v.VoteId">
                            <VotedItemMain Number="@v.Number" Title="@v.Title" Stage="@v.Stage" IsConsensus="v.IsConsensus" Totals="v.Totals" OfficialNote="@v.OfficialNote">
                                @if (member)
                                {
                                    <MyAgendaMark Number="@v.Number" Numbers="_numbers" Place="@($"voted-{v.VoteId}")" @rendermode="InteractiveWebAssembly" />
                                }
                            </VotedItemMain>
                            @if (member && v.Record is { Status: "open", Counts: { For: 0, Against: 0 } } nobodyYet)
                            {
                                @* "Nobody yet" is left out in the browser for a member who has just taken a side (the page's
                                   agenda is up to a minute old); the votes' rows offer no sides (design 8.7). *@
                                <MyAgendaSide Number="@v.Number" Numbers="_numbers" Place="@($"voted-{v.VoteId}")" Record="nobodyYet" VoteId="v.VoteId" @rendermode="InteractiveWebAssembly" />
                            }
                            else
                            {
                                <div class="tl-item__side">
                                    @if (v.Record is { Status: not "rejected" } record)
                                    {
                                        <RecordFigures Record="record" Id="@($"voted-{v.VoteId}")" />
                                    }
                                    <a class="btn btn--plain cta" href="/seimas/balsavimai/@v.VoteId">@U["Agenda.Action.Votes"]</a>
                                </div>
                            }
                        </li>
                    }
                </ul>
            </section>
        }

        // Design 8.18: the long form of "Balsuota", under the last voted day, also when the last seven days had none.
        <p class="tl-older" id="home-votes-older"><a href="@Lt2.Web.Client.Parliament.VoteHistory.Path">@T["Agenda.Older"]</a></p>
    };
}
