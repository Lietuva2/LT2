@page "/statistika"
@using System.Globalization
@using Lt2.Api.Contracts.Analytics
@using Lt2.Api.Contracts.Meta
@using Lt2.Web.Client.Analytics
@inject IStringLocalizer<Lt2.Web.Components.PageText> P
@inject IAnalyticsApi Api
@inject IMetaApi Meta
@inject IStringLocalizer<AnalyticsText> T
@inject IStringLocalizer<Lt2.Web.Components.Appeals.AppealText> A
@inject IStringLocalizer<Lt2.Web.Client.Appeals.AppealUi> U
@inject Formats F

@* Design 8.26: the statistics page, "Statistika" in the main menu (owner, 2026-11-17; it was "Analitika", the fourth tab under
   "Projektai", at /seimas/analitika). Public, server-rendered, the same for everyone and readable without JavaScript. The
   period and the accounts counted are one GET form on the ground (8.16) and apply to the whole page; the list of closed
   bills has its own GET form on the ground above its sheet (owner, 2026-11-18: dates, search, result, the Seimas's
   majority, the order), which changes only the list. Each bill is a row in HTML: its title, a track drawn as SVG with the
   two shares and the line at 50 %, and the exact numbers written under it, so nothing needs hover. The list grows in place
   by the address (?rodyti=). The numbers are a kept copy, at most an hour old (8.26.6), and the page says when they were
   counted. Nothing about the caller, apart from the island at the end, which a visitor sees as the sign-in link and a
   member's browser fills with the member's own comparison (8.26.4). *@
<PageTitle>@T["Title"] · Lietuva 2.0</PageTitle>
<LinkPreview Title="@T["Title"]" Description="@P["Preview.Statistics"]" />

<div class="stack">
    <h1>@T["Title"]</h1>
    <NeedsScript />
    <p class="lead">@T["Lead"]</p>
    <form class="filters" method="get" action="@AnalyticsList.Path" id="analytics-filters">
        <div class="field">
            <label for="analytics-metai">@T["Filter.Period"]</label>
            <select class="input" id="analytics-metai" name="metai">
                <option value="" selected="@(_data?.Year is null)">@TermLabel</option>
                @foreach (var year in _data?.Years ?? [])
                {
                    <option value="@year.ToString(CultureInfo.InvariantCulture)" selected="@(_data?.Year == year)">@T.Format("Filter.Year", year.ToString(CultureInfo.InvariantCulture))</option>
                }
            </select>
        </div>
        <div class="field">
            <label for="analytics-paskyros">@T["Filter.Accounts"]</label>
            <select class="input" id="analytics-paskyros" name="paskyros">
                <option value="" selected="@(!_state.Older)">@T["Filter.AllAccounts"]</option>
                <option value="@AnalyticsList.OlderValue" selected="@_state.Older">@T["Filter.OlderAccounts"]</option>
            </select>
        </div>
        @* The list's filters stay as they are when the period or the accounts change. *@
        @foreach (var (name, value) in ListHidden)
        {
            <input type="hidden" name="@name" value="@value" />
        }
        <div class="row">
            <button class="btn" type="submit">@T["Filter.Show"]</button>
        </div>
    </form>
</div>

@if (_data is { } d)
{
    var figures = d.Figures;
    <section class="sheet stack" aria-labelledby="h-figures" id="analytics-figures">
        <h2 id="h-figures" class="visually-hidden">@T["Figures.Title"]</h2>
        <div class="analytics-figures">
            <div class="figure figure--m" id="figure-taken-part">
                <span class="label">@T["Figures.TakenPart"]</span>
                <span class="figure__num">@Display.Number(figures.BillsTakenPart)</span>
                <span class="small num">@T.Format("Figures.TakenPartOf", Display.Number(figures.BillsDiscussed))</span>
            </div>
            <div class="figure figure--m" id="figure-positions">
                <span class="label">@T["Figures.Positions"]</span>
                <span class="figure__num">@Display.Number(figures.Positions)</span>
                <span class="small">@T["Figures.PositionsSub"]</span>
            </div>
            <div class="figure figure--m" id="figure-agreed">
                <span class="label">@T["Figures.Agreed"]</span>
                @if (figures.Compared == 0)
                {
                    <span class="small" id="figure-agreed-none">@T["Figures.AgreedNone"]</span>
                }
                else
                {
                    @if (Display.Percent(figures.AgreedShare) is { } share)
                    {
                        <span class="figure__num">@share</span>
                    }
                    <span class="small num">
                        @T.Format("Figures.AgreedOf", Display.Number(figures.Agreed), Display.Number(figures.Compared))
                        @if (figures.AgreedShare is null)
                        {
                            @(" · ")<span class="tag" id="figure-agreed-small">@T["SmallSample"]</span>
                        }
                    </span>
                }
            </div>
            <div class="figure figure--m" id="figure-mps">
                <span class="label">@T["Figures.Mps"]</span>
                <span class="figure__num">@Display.Number(figures.MpsTakenOver)</span>
                <span class="small num">@MpsOf(figures.MpsSitting)</span>
            </div>
        </div>
        <p class="small" id="analytics-not-a-poll">
            @A["NotAPoll"]@(" ")
            <Lt2.Web.Client.Components.Hint Id="hint-small-sample" Text="@T["SmallSample"]" Answer="@T.Format("SmallSample.Answer", Display.Number(d.SmallSample))" />
        </p>
        <p class="small num" id="analytics-counted-at">@T.Format("CountedAt", Display.DayTime(d.CountedAt))</p>
    </section>

    <div class="stack" id="@AnalyticsList.Anchor">
        <h2 id="h-compare">@T["Compare.Title"]</h2>
        <p class="small" id="compare-lead">@T["Compare.Lead"]</p>
        @if (d.BillsClosed > 0)
        {
            <form class="filters" method="get" action="@(AnalyticsList.Path + "#" + AnalyticsList.Anchor)" role="search" id="compare-filters">
                @if (_state.Year is { } chosenYear)
                {
                    <input type="hidden" name="metai" value="@chosenYear.ToString(CultureInfo.InvariantCulture)" />
                }
                @if (_state.Older)
                {
                    <input type="hidden" name="paskyros" value="@AnalyticsList.OlderValue" />
                }
                <div class="filters__pair">
                    @foreach (var (name, label, value, invalid) in DayFields)
                    {
                        var id = "compare-" + name;
                        <div class="field @(invalid ? "field--error" : null)">
                            <label for="@id">@T[label]</label>
                            <p class="field__hint" id="@(id + "-hint")">@U.Format("Date.Hint", Display.DateExample)</p>
                            <input class="input num" id="@id" name="@name" type="text" inputmode="numeric" autocomplete="off"
                                   pattern="@Display.DatePattern" placeholder="@Display.DateExample" value="@value" aria-invalid="@(invalid ? "true" : null)"
                                   aria-describedby="@(id + "-hint" + (invalid ? " " + id + "-error" : ""))" />
                            @if (invalid)
                            {
                                <p class="field__error" id="@(id + "-error")">@U.Format("Date.Invalid", Display.DateExample)</p>
                            }
                        </div>
                    }
                </div>
                <div class="field">
                    <label for="compare-q">@A["List.Search"]</label>
                    <input class="input" id="compare-q" name="q" type="search" value="@_state.Query" maxlength="@AnalyticsBillQuery.MaxSearchLength" autocomplete="off" />
                </div>
                <div class="field">
                    <label for="compare-rezultatas">@T["Filter.Result"]</label>
                    <select class="input" id="compare-rezultatas" name="rezultatas">
                        <option value="" selected="@(_state.Result == "")">@T["Filter.AllBills"]</option>
                        @foreach (var (slug, _) in AnalyticsList.Results)
                        {
                            <option value="@slug" selected="@(slug == _state.Result)">@T["Filter.Result." + slug]</option>
                        }
                    </select>
                </div>
                <div class="field">
                    <label for="compare-dauguma">@T["Compare.Majority"]</label>
                    <select class="input" id="compare-dauguma" name="dauguma">
                        <option value="" selected="@(_state.Majority == "")">@T["Filter.AllBills"]</option>
                        @foreach (var (slug, _) in AnalyticsList.Majorities)
                        {
                            <option value="@slug" selected="@(slug == _state.Majority)">@T["Filter.Majority." + slug]</option>
                        }
                    </select>
                </div>
                <div class="field">
                    <label for="compare-rikiuoti">@T["Filter.Sort"]</label>
                    <select class="input" id="compare-rikiuoti" name="rikiuoti">
                        <option value="" selected="@(_state.Sort == "")">@T["Filter.Sort.Latest"]</option>
                        @foreach (var (slug, _) in AnalyticsList.Sorts)
                        {
                            <option value="@slug" selected="@(slug == _state.Sort)">@T["Filter.Sort." + slug]</option>
                        }
                    </select>
                </div>
                <div class="row">
                    <button class="btn" type="submit">@T["Filter.Show"]</button>
                    @if (_state.Filtered)
                    {
                        <a href="@AnalyticsList.Cleared(_state, AnalyticsList.Anchor)" id="compare-clear">@F.T["Ballots.Clear"]</a>
                    }
                </div>
            </form>
            @if (_state.Reversed)
            {
                <p class="note" id="compare-reversed">@T["Filter.Reversed"]</p>
            }
        }
        <section class="sheet stack" aria-labelledby="h-compare" id="compare-list">
            @if (d.BillsClosed == 0)
            {
                <p id="compare-empty">@T["Compare.Empty"]</p>
            }
            else if (d.Bills.Count == 0)
            {
                <p id="compare-none">@T["Compare.NoneFound"] <a href="@AnalyticsList.Cleared(_state, AnalyticsList.Anchor)">@F.T["Ballots.Clear"]</a></p>
            }
            else
            {
                var shown = d.Bills.Take(_state.Shown).ToList();
                <p class="small row" id="compare-key">
                    <span class="key key--seimas">@T["Compare.Seimas"]</span>
                    <span class="key key--members">@T["Compare.Members"]</span>
                    <span>@T["Compare.Half"]</span>
                </p>
                <div class="cmp-scale small num" aria-hidden="true"><span>0&nbsp;%</span><span>50&nbsp;%</span><span>100&nbsp;%</span></div>
                <ol class="cmp-list" id="compare-rows">
                    @foreach (var bill in shown)
                    {
                        <li class="cmp" id="@AnalyticsList.Row(bill.Number)" @key="bill.Number">
                            <div class="cmp__head">
                                <a href="/seimas/@Uri.EscapeDataString(bill.Number)"><b>@bill.Title</b></a>
                                <span class="small num">@bill.Number · @Display.Day(bill.VotedAt)</span>
                            </div>
                            <div class="cmp__track-wrap">
                                <svg class="cmp__track" aria-hidden="true" focusable="false">
                                    <line class="cmp__axis" x1="0" x2="100%" y1="50%" y2="50%" />
                                    <line class="cmp__half" x1="50%" x2="50%" y1="0" y2="100%" />
                                    @if (bill.SeimasShareFor is { } seimasLine && bill.MembersShareFor is { } membersLine)
                                    {
                                        <line class="cmp__gap" x1="@AnalyticsFormat.Position(seimasLine)" x2="@AnalyticsFormat.Position(membersLine)" y1="50%" y2="50%" />
                                    }
                                    @if (bill.SeimasShareFor is { } seimas)
                                    {
                                        <rect class="cmp__seimas" x="@AnalyticsFormat.Position(seimas)" y="50%" width="11" height="11" transform="translate(-5.5 -5.5)" />
                                    }
                                    @if (bill.MembersShareFor is { } members)
                                    {
                                        <circle class="cmp__members" cx="@AnalyticsFormat.Position(members)" cy="50%" r="6" />
                                    }
                                </svg>
                            </div>
                            <p class="small num cmp__figures">
                                <span class="key key--seimas"><a href="/seimas/balsavimai/@bill.VoteId">@SeimasLine(bill)</a></span>
                                <span class="key key--members">
                                    @if (AnalyticsFormat.Share(bill.MembersShareFor) is { } membersShare)
                                    {
                                        @T.Format("Row.Members", membersShare, Display.Number(bill.MembersFor + bill.MembersAgainst))
                                    }
                                    else
                                    {
                                        @T.Format("Row.MembersCounts", Display.Number(bill.MembersFor), Display.Number(bill.MembersAgainst))@(" ")<span class="tag">@T["SmallSample"]</span>
                                    }
                                </span>
                                @if (AnalyticsFormat.Points(bill.Difference) is { } points)
                                {
                                    <span id="@("difference-" + bill.Number)">@T.Format("Row.Difference", points)</span>
                                }
                            </p>
                            <p class="small cmp__meta">
                                @if (MajorityWord(bill) is { } majority)
                                {
                                    <span>@T.Format("Row.Majority", majority)</span>
                                }
                                @if (bill.Agreed is { } agreed)
                                {
                                    <span class="tag" id="@("result-" + bill.Number)">@T[agreed ? "Row.Agreed" : "Row.Differed"]</span>
                                }
                                @if (bill.OfficialNote is { } note)
                                {
                                    <span id="@($"note-{bill.Number}")">@note</span>
                                }
                            </p>
                        </li>
                    }
                </ol>
                <div class="row">
                    <p class="small num" role="status" id="compare-shown">@F.T.Format("Ballots.Shown", Display.Number(shown.Count), Display.Number(d.BillsFound))</p>
                    @* Design 8.15: what "balsavusiųjų dauguma" means, once beside the list. *@
                    <p class="small"><Lt2.Web.Client.Components.Hint Id="hint-majority" Text="@T["Majority.Hint"]" Answer="@T["Majority.Answer"]" /></p>
                    @if (AnalyticsList.More(_state, d.BillsFound, d.Bills.Count > shown.Count ? d.Bills[shown.Count].Number : null) is { } more)
                    {
                        @* Lands on the first row added, so the reader goes on where they stopped (as the history of votes, 8.18). *@
                        <a class="btn btn--plain" href="@more" id="compare-more">@F.T["Ballots.More"]</a>
                    }
                </div>
            }
            <p class="small">@A["NotAPoll"]</p>
        </section>
    </div>

    <section class="sheet stack" aria-labelledby="h-unity" id="frakciju-vieningumas">
        <h2 id="h-unity">@T["Unity.Title"]</h2>
        <p class="small">
            @T["Unity.Lead"]@(" ")
            <Lt2.Web.Client.Components.Hint Id="hint-faction-position" Text="@T["Unity.Hint"]" Answer="@T["Unity.Answer"]" More="/metodika#kaip-frakcija" />
        </p>
        @if (d.Factions.Count == 0)
        {
            <p id="unity-none">@T["Unity.None"]</p>
        }
        else
        {
            <ul class="unity">
                @foreach (var faction in d.Factions)
                {
                    <li class="stack stack--tight" id="@($"unity-{faction.Slug}")" @key="faction.Slug">
                        <div class="row unity__head">
                            <a href="/frakcijos/@Uri.EscapeDataString(faction.Slug)">@faction.Name</a>
                            <span class="small num">@T.Format("Unity.Seats", Display.Number(faction.Seats))</span>
                            @if (Display.Percent(faction.Share) is { } share)
                            {
                                <b class="num unity__share">@share</b>
                            }
                            else if (faction.SmallSample && faction.VotesWithPosition > 0)
                            {
                                <span class="tag unity__share">@T["SmallSample"]</span>
                            }
                        </div>
                        @if (faction.Share is { } value)
                        {
                            <svg class="meter" viewBox="0 0 1000 10" preserveAspectRatio="none" aria-hidden="true">
                                <rect class="meter__fill" x="0" y="0" width="@Px(1000 * value)" height="10" />
                            </svg>
                        }
                        else if (faction.VotesWithPosition == 0)
                        {
                            <span class="small">@T["Unity.NoPosition"]</span>
                        }
                        <span class="small num">@T.Format("Unity.Votes", Display.Number(faction.VotesWithPosition), Display.Number(faction.FreeVotes))</span>
                        @if (faction.MostSplit.Count > 0)
                        {
                            <details class="more stack stack--tight" id="@($"split-{faction.Slug}")">
                                <summary class="linkish small">@T["Unity.Split"]</summary>
                                <ul class="stack stack--tight">
                                    @foreach (var vote in faction.MostSplit)
                                    {
                                        <li class="small">
                                            <a href="/seimas/balsavimai/@vote.VoteId">@(vote.BillNumber is { } number ? number + " " : "")@vote.Title</a>
                                            <span class="num">@Display.Day(vote.HeldAt)@(vote.Stage is { } stage ? " · " + F.Stage(stage) : "")</span>
                                            <span class="num">· @F.Position(vote.Position) · @T.Format("Unity.Counts", Display.Number(vote.For), Display.Number(vote.Against), Display.Number(vote.Abstain))</span>
                                        </li>
                                    }
                                </ul>
                            </details>
                        }
                    </li>
                }
            </ul>
        }
    </section>
}

<section class="sheet stack" aria-labelledby="h-mine" id="kas-balsuoja-kaip-jus">
    <h2 id="h-mine">@T["Mine.Title"]</h2>
    <p class="small">@T["Mine.Lead"]</p>
    <MyAgreement @rendermode="InteractiveWebAssembly" />
</section>

<SourceLine UpdatedAt="@_updatedAt" />

@code {
    /// <summary>The page's address.</summary>
    public const string Path = MenuSections.Statistics;

    private AnalyticsResponse? _data;
    private DateTimeOffset? _updatedAt;
    private AnalyticsListState _state = AnalyticsList.Read(null, null, null, null, null, null, null, null, null);

    [SupplyParameterFromQuery(Name = "metai")] public string? Year { get; set; }

    [SupplyParameterFromQuery(Name = "paskyros")] public string? Accounts { get; set; }

    [SupplyParameterFromQuery(Name = "nuo")] public string? From { get; set; }

    [SupplyParameterFromQuery(Name = "iki")] public string? To { get; set; }

    [SupplyParameterFromQuery(Name = "q")] public string? Query { get; set; }

    [SupplyParameterFromQuery(Name = "rezultatas")] public string? Result { get; set; }

    [SupplyParameterFromQuery(Name = "dauguma")] public string? Majority { get; set; }

    [SupplyParameterFromQuery(Name = "rikiuoti")] public string? Sort { get; set; }

    [SupplyParameterFromQuery(Name = "rodyti")] public string? Show { get; set; }

    /// <summary>The whole term by its name ("2024–2028 m. kadencija"), or "Visa kadencija" without one.</summary>
    private string TermLabel => string.IsNullOrEmpty(_data?.TermName) ? T["Filter.Term"] : _data.TermName;

    /// <summary>The two day fields of the list's form: the name in the address, the label, the value as typed, and whether it is not a date.</summary>
    private IEnumerable<(string Name, string Label, string? Value, bool Invalid)> DayFields =>
    [
        ("nuo", "Filter.From", _state.From, _state.FromInvalid),
        ("iki", "Filter.To", _state.To, _state.ToInvalid),
    ];

    /// <summary>The list's filters as hidden fields of the period's form, so changing the period keeps them (the length starts again).</summary>
    private IEnumerable<(string Name, string Value)> ListHidden
    {
        get
        {
            var query = AnalyticsList.Query(_state);
            if (query.From is { } from)
            {
                yield return ("nuo", Display.Day(from));
            }

            if (query.To is { } to)
            {
                yield return ("iki", Display.Day(to));
            }

            if (_state.Query is { } q)
            {
                yield return ("q", q);
            }

            foreach (var (name, value) in new[] { ("rezultatas", _state.Result), ("dauguma", _state.Majority), ("rikiuoti", _state.Sort) })
            {
                if (value != "")
                {
                    yield return (name, value);
                }
            }
        }
    }

    protected override async Task OnParametersSetAsync()
    {
        _state = AnalyticsList.Read(Year, Accounts, From, To, Query, Result, Majority, Sort, Show);
        _data = (await Api.GetAsync(_state.Year, _state.Older, AnalyticsList.Query(_state))).Value;
        _updatedAt = (await Meta.GetImportsAsync()).Value?.Sources.FirstOrDefault()?.LastSuccessAt;
    }

    private static string Px(decimal value) => value.ToString("0.#", CultureInfo.InvariantCulture);

    /// <summary>The Seimas's part of a row: its share "for", "pritarta bendru sutarimu", or that the vote has no result.</summary>
    private string SeimasLine(BillComparisonResponse bill) =>
        bill.IsConsensus ? T["Row.Consensus"]
        : AnalyticsFormat.Share(bill.SeimasShareFor) is { } share ? T.Format("Row.Seimas", share)
        : T["Row.NoResult"];

    /// <summary>The Seimas's majority of those who voted in the design's words (8.26.2), without quotes; null without numbers.</summary>
    private string? MajorityWord(BillComparisonResponse bill) => bill.SeimasMajority switch
    {
        Lt2.SharedKernel.SeimasMajorities.For => T["Compare.MajorityFor"].Value,
        Lt2.SharedKernel.SeimasMajorities.Against => T["Compare.MajorityAgainst"].Value,
        Lt2.SharedKernel.SeimasMajorities.None => T["Compare.MajorityNone"].Value,
        _ => null,
    };

    /// <summary>"iš 141 Seimo nario", "iš 13 Seimo narių": the genitive after "iš" is singular after 1, 21, 31 … (not 11).</summary>
    private string MpsOf(int sitting) =>
        T.Format(Lt2.SharedKernel.LithuanianCounts.Pick(sitting, "Figures.MpsOf.One", "Figures.MpsOf.Many", "Figures.MpsOf.Many"), Display.Number(sitting));
}
