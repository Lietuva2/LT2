@page "/statistika"
@using System.Globalization
@using Lt2.Api.Contracts.Analytics
@using Lt2.Api.Contracts.Meta
@using Lt2.Web.Client.Analytics
@inject IStringLocalizer<Lt2.Web.Components.PageText> P
@inject IAnalyticsApi Api
@inject IMetaApi Meta
@inject IStringLocalizer<AnalyticsText> T
@inject IStringLocalizer<Lt2.Web.Components.Appeals.AppealText> A
@inject IStringLocalizer<Lt2.Web.Client.Appeals.AppealUi> U
@inject Formats F

@* Design 8.26: the statistics page, "Statistika" in the main menu (owner, 2026-11-17; it was "Analitika", the fourth tab under
   "Projektai", at /seimas/analitika). Public, server-rendered, the same for everyone and readable without JavaScript. The
   period and the accounts counted are one GET form on the ground (8.16) and apply to the whole page; the closed bills
   have their own GET form on the ground above their sheet, closed in a details until one of its fields is set (owner,
   2026-11-18 and 2026-11-19: dates, search, result, the Seimas's majority, the order), which changes only the plot and
   the table. The plot is one SVG drawn here (owner, 2026-11-19: back from a list of rows, with the bills' titles), a
   <title> per mark, and the table of the same bills one click away; both grow in place by the address (?rodyti=).
   The numbers are a kept copy, at most an hour old (8.26.6), and the page says when they were
   counted. Nothing about the caller, apart from the island at the end, which a visitor sees as the sign-in link and a
   member's browser fills with the member's own comparison (8.26.4). *@
<PageTitle>@T["Title"] · Lietuva 2.0</PageTitle>
<LinkPreview Title="@T["Title"]" Description="@P["Preview.Statistics"]" />

<div class="stack">
    <h1>@T["Title"]</h1>
    <NeedsScript />
    <p class="lead">@T["Lead"]</p>
    <form class="filters" method="get" action="@AnalyticsList.Path" id="analytics-filters">
        <div class="field">
            <label for="analytics-year">@T["Filter.Period"]</label>
            <select class="input" id="analytics-year" name="metai">
                <option value="" selected="@(_data?.Year is null)">@TermLabel</option>
                @foreach (var year in _data?.Years ?? [])
                {
                    <option value="@year.ToString(CultureInfo.InvariantCulture)" selected="@(_data?.Year == year)">@T.Format("Filter.Year", year.ToString(CultureInfo.InvariantCulture))</option>
                }
            </select>
        </div>
        <div class="field">
            <label for="analytics-accounts">@T["Filter.Accounts"]</label>
            <select class="input" id="analytics-accounts" name="paskyros">
                <option value="" selected="@(!_state.Older)">@T["Filter.AllAccounts"]</option>
                <option value="@AnalyticsList.OlderValue" selected="@_state.Older">@T["Filter.OlderAccounts"]</option>
            </select>
        </div>
        @* The list's filters stay as they are when the period or the accounts change. *@
        @foreach (var (name, value) in ListHidden)
        {
            <input type="hidden" name="@name" value="@value" />
        }
        <div class="row">
            <button class="btn" type="submit">@T["Filter.Show"]</button>
        </div>
    </form>
</div>

@if (_data is { } d)
{
    var figures = d.Figures;
    <section class="sheet stack" aria-labelledby="h-figures" id="analytics-figures">
        <h2 id="h-figures" class="visually-hidden">@T["Figures.Title"]</h2>
        <div class="analytics-figures">
            <div class="figure figure--m" id="figure-taken-part">
                <span class="label">@T["Figures.TakenPart"]</span>
                <span class="figure__num">@Display.Number(figures.BillsTakenPart)</span>
                <span class="small num">@T.Format("Figures.TakenPartOf", Display.Number(figures.BillsDiscussed))</span>
            </div>
            <div class="figure figure--m" id="figure-positions">
                <span class="label">@T["Figures.Positions"]</span>
                <span class="figure__num">@Display.Number(figures.Positions)</span>
                <span class="small">@T["Figures.PositionsSub"]</span>
            </div>
            <div class="figure figure--m" id="figure-agreed">
                <span class="label">@T["Figures.Agreed"]</span>
                @if (figures.Compared == 0)
                {
                    <span class="small" id="figure-agreed-none">@T["Figures.AgreedNone"]</span>
                }
                else
                {
                    @if (Display.Percent(figures.AgreedShare) is { } share)
                    {
                        <span class="figure__num">@share</span>
                    }
                    <span class="small num">
                        @T.Format("Figures.AgreedOf", Display.Number(figures.Agreed), Display.Number(figures.Compared))
                        @if (figures.AgreedShare is null)
                        {
                            @(" · ")<span class="tag" id="figure-agreed-small">@T["SmallSample"]</span>
                        }
                    </span>
                }
            </div>
            <div class="figure figure--m" id="figure-mps">
                <span class="label">@T["Figures.Mps"]</span>
                <span class="figure__num">@Display.Number(figures.MpsTakenOver)</span>
                <span class="small num">@MpsOf(figures.MpsSitting)</span>
            </div>
        </div>
        <p class="small" id="analytics-not-a-poll">
            @A["NotAPoll"]@(" ")
            <Lt2.Web.Client.Components.Hint Id="hint-small-sample" Text="@T["SmallSample"]" Answer="@T.Format("SmallSample.Answer", Display.Number(d.SmallSample))" />
        </p>
        <p class="small num" id="analytics-counted-at">@T.Format("CountedAt", Display.DayTime(d.CountedAt))</p>
    </section>

    <div class="stack" id="@AnalyticsList.Anchor">
        @* Design 8.16.5 (owner, 2026-11-21): the comparison's heading stands on the ground above its filters and its sheet,
           and stays at the top of the screen until the sheet has scrolled past; the lead and the filters scroll away. *@
        <h2 class="ground-head" id="h-compare">@T["Compare.Title"]</h2>
        <p class="small" id="compare-lead">@T["Compare.Lead"]</p>
        @if (d.BillsClosed > 0)
        {
            @* Closed at first (owner, 2026-11-19); open while any of its fields is set, so the reader sees what applies. *@
            <details class="more stack stack--tight" id="compare-filters-box" open="@_state.Filtered">
                <summary class="linkish small" id="compare-filters-toggle">@(_state.Active == 0 ? T["Filter.Toggle"] : T.Format("Filter.ToggleCount", Display.Number(_state.Active)))</summary>
                <form class="filters" method="get" action="@AnalyticsList.Path" data-enhance role="search" id="compare-filters">
                    @if (_state.Year is { } chosenYear)
                    {
                        <input type="hidden" name="metai" value="@chosenYear.ToString(CultureInfo.InvariantCulture)" />
                    }
                    @if (_state.Older)
                    {
                        <input type="hidden" name="paskyros" value="@AnalyticsList.OlderValue" />
                    }
                    <div class="filters__pair">
                        @foreach (var (id, name, label, value, invalid) in DayFields)
                        {
                            <div class="field @(invalid ? "field--error" : null)">
                                <label for="@id">@T[label]</label>
                                <div class="date-row">
                                    <input class="input num" id="@id" name="@name" type="text" inputmode="numeric" autocomplete="off"
                                           pattern="@Display.DatePattern" placeholder="@Display.DateExample" value="@value" aria-invalid="@(invalid ? "true" : null)"
                                           aria-describedby="@(invalid ? id + "-error" : null)" />
                                    <DatePick InputId="@id" />
                                </div>
                                @if (invalid)
                                {
                                    <p class="field__error" id="@(id + "-error")">@U.Format("Date.Invalid", Display.DateExample)</p>
                                }
                            </div>
                        }
                    </div>
                    <div class="field">
                        <label for="compare-q">@A["List.Search"]</label>
                        <input class="input" id="compare-q" name="q" type="search" value="@_state.Query" maxlength="@AnalyticsBillQuery.MaxSearchLength" autocomplete="off" />
                    </div>
                    <div class="field">
                        <label for="compare-outcome">@T["Filter.Result"]</label>
                        <select class="input" id="compare-outcome" name="rezultatas">
                            <option value="" selected="@(_state.Result == "")">@T["Filter.AllBills"]</option>
                            @foreach (var (slug, apiValue) in AnalyticsList.Results)
                            {
                                <option value="@slug" selected="@(slug == _state.Result)">@T["Filter.Result." + apiValue]</option>
                            }
                        </select>
                    </div>
                    <div class="field">
                        <label for="compare-majority">@T["Compare.Majority"]</label>
                        <select class="input" id="compare-majority" name="dauguma">
                            <option value="" selected="@(_state.Majority == "")">@T["Filter.AllBills"]</option>
                            @foreach (var (slug, apiValue) in AnalyticsList.Majorities)
                            {
                                <option value="@slug" selected="@(slug == _state.Majority)">@T["Filter.Majority." + apiValue]</option>
                            }
                        </select>
                    </div>
                    <div class="field">
                        <label for="compare-sort">@T["Filter.Sort"]</label>
                        <select class="input" id="compare-sort" name="rikiuoti">
                            <option value="" selected="@(_state.Sort == "")">@T["Filter.Sort.Latest"]</option>
                            @foreach (var (slug, apiValue) in AnalyticsList.Sorts)
                            {
                                <option value="@slug" selected="@(slug == _state.Sort)">@T["Filter.Sort." + apiValue]</option>
                            }
                        </select>
                    </div>
                    <div class="row">
                        <button class="btn" type="submit">@T["Filter.Show"]</button>
                        @if (_state.Filtered)
                        {
                            <a href="@AnalyticsList.Cleared(_state)" id="compare-clear">@F.T["Ballots.Clear"]</a>
                        }
                    </div>
                </form>
            </details>
            @if (_state.Reversed)
            {
                <p class="note" id="compare-reversed">@T["Filter.Reversed"]</p>
            }
        }
        <section class="sheet stack" aria-labelledby="h-compare" id="compare-list">
            @if (d.BillsClosed == 0)
            {
                <p id="compare-empty">@T["Compare.Empty"]</p>
            }
            else if (d.Bills.Count == 0)
            {
                <p id="compare-none">@T["Compare.NoneFound"] <a href="@AnalyticsList.Cleared(_state)">@F.T["Ballots.Clear"]</a></p>
            }
            else
            {
                var shown = d.Bills.Take(_state.Shown).ToList();
                var dots = shown.Where(InPlot).ToList();
                if (dots.Count == 0)
                {
                    <p id="compare-plot-none">@T.Format("Compare.PlotNone", Display.Number(d.SmallSample))</p>
                }
                else
                {
                    <p class="small row" id="compare-key">
                        <span class="key key--seimas">@T["Compare.Seimas"]</span>
                        <span class="key key--members">@T["Compare.Members"]</span>
                        <span>@T["Compare.Half"]</span>
                    </p>
                    @* One plot (owner, 2026-11-19): per bill a row, a label column on the left (the number, the title under it cut by CSS with
                       an ellipsis, the whole as one link with the full "number title" as its name and tooltip) and the marks on the same
                       row to the right, on one 0–100 % axis shared by every row. Each row's track is an SVG laid over its cell, so the row
                       is as tall as its two text lines and the grid lines join from row to row; places are per cent of the track's width,
                       so the plot fits any screen without scrolling. Exact numbers: each mark's <title>, the track's name and the table. *@
                    <div class="dotplot" role="group" aria-label="@T["Compare.Aria"]" id="compare-plot">
                        <ol class="dotplot__rows">
                            @foreach (var bill in dots)
                            {
                                var seimas = bill.SeimasShareFor!.Value;
                                var members = bill.MembersShareFor!.Value;
                                var full = bill.Number + " " + bill.Title;
                                var seimasText = T.Format("Compare.DotSeimas", full, AnalyticsFormat.Share(seimas));
                                var membersText = T.Format("Compare.DotMembers", full, AnalyticsFormat.Share(members), Display.Number(bill.MembersFor + bill.MembersAgainst));
                                <li class="dotplot__row" id="@AnalyticsList.Row(bill.Number)" @key="bill.Number">
                                    <a class="dotplot__label" href="/seimas/@Uri.EscapeDataString(bill.Number)" title="@full" aria-label="@full">
                                        <span class="dotplot__num num">@bill.Number</span>
                                        <span class="dotplot__title">@bill.Title</span>
                                    </a>
                                    <div class="dotplot__track">
                                        <svg role="img" aria-label="@(seimasText + "; " + membersText)">
                                            @foreach (var tick in Ticks)
                                            {
                                                var x = tick.ToString(CultureInfo.InvariantCulture) + "%";
                                                <line class="@(tick == 50 ? "dotplot__half" : "dotplot__axis")" x1="@x" x2="@x" y1="0" y2="100%" />
                                            }
                                            <line class="dotplot__gap" x1="@AnalyticsFormat.Position(seimas)" x2="@AnalyticsFormat.Position(members)" y1="50%" y2="50%" />
                                            <rect class="dotplot__seimas" x="@AnalyticsFormat.Position(seimas)" y="50%" width="11" height="11" transform="translate(-5.5 -5.5)"><title>@seimasText</title></rect>
                                            <circle class="dotplot__members" cx="@AnalyticsFormat.Position(members)" cy="50%" r="6"><title>@membersText</title></circle>
                                        </svg>
                                    </div>
                                </li>
                            }
                        </ol>
                        @* The axis's words under the tracks only, not under the labels. *@
                        <div class="dotplot__row dotplot__row--axis" aria-hidden="true">
                            <span></span>
                            <div class="dotplot__track">
                                <svg>
                                    @foreach (var tick in Ticks)
                                    {
                                        @SvgText(tick is 25 or 75 ? "dotplot__tick dotplot__tick--minor" : "dotplot__tick", tick.ToString(CultureInfo.InvariantCulture) + "%", "14", tick == 0 ? "start" : tick == 100 ? "end" : "middle", tick.ToString(CultureInfo.InvariantCulture) + " %")
                                    }
                                </svg>
                            </div>
                        </div>
                    </div>
                    <p class="small" id="compare-plot-note">@T.Format("Compare.PlotNote", Display.Number(d.SmallSample))</p>
                }
                @* The shared "show more" grows the plot and table in place. *@
                <Lt2.Web.Client.Components.ShowMore Id="compare-more" StatusId="compare-shown" Shown="shown.Count" Total="d.BillsFound"
                    Href="@AnalyticsList.More(_state, d.BillsFound)" />
                @* The same bills as the plot, every one of them, with the exact numbers; open at once when the plot has none. *@
                <details class="more stack stack--tight" id="compare-table" open="@(dots.Count == 0)">
                    <summary class="linkish small">@T["Compare.Table"]</summary>
                    <div class="table-wrap">
                        <table class="table analytics-table">
                            <thead>
                                <tr>
                                    <th scope="col">@T["Compare.Number"]</th>
                                    <th scope="col">@T["Compare.Bill"]</th>
                                    <th scope="col">@T["Compare.SeimasFor"]</th>
                                    <th scope="col">@T["Compare.MembersFor"]</th>
                                    <th scope="col">@T["Compare.Difference"]</th>
                                    <th scope="col">@T["Compare.Majority"]</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var bill in shown)
                                {
                                    <tr id="@($"row-{bill.Number}")" @key="bill.Number">
                                        <td class="num analytics-table__number">@bill.Number <span class="small">@Display.Day(bill.VotedAt)</span></td>
                                        <td class="analytics-table__title"><a href="/seimas/@Uri.EscapeDataString(bill.Number)">@bill.Title</a></td>
                                        <td class="num" data-label="@T["Compare.SeimasFor"]">
                                            <a href="/seimas/balsavimai/@bill.VoteId">@SeimasShare(bill)</a>
                                            @if (bill.OfficialNote is { } note)
                                            {
                                                <span class="small" id="@($"note-{bill.Number}")">@note</span>
                                            }
                                        </td>
                                        <td class="num analytics-table__figure" data-label="@T["Compare.MembersFor"]">
                                            @if (AnalyticsFormat.Share(bill.MembersShareFor) is { } share)
                                            {
                                                @T.Format("Compare.MembersShare", share, Display.Number(bill.MembersFor + bill.MembersAgainst))
                                            }
                                            else
                                            {
                                                @T.Format("Compare.Counts", Display.Number(bill.MembersFor), Display.Number(bill.MembersAgainst))@(" ")<span class="tag">@T["SmallSample"]</span>
                                            }
                                        </td>
                                        <td class="num analytics-table__figure" data-label="@T["Compare.Difference"]" id="@("difference-" + bill.Number)">@(AnalyticsFormat.Difference(bill.Difference) ?? "–")</td>
                                        <td data-label="@T["Compare.Majority"]">
                                            @(MajorityWord(bill) ?? T["Compare.NoResult"])
                                            @if (bill.Agreed is { } agreed)
                                            {
                                                @(" ")<span class="tag" id="@("result-" + bill.Number)">@T[agreed ? "Compare.Agreed" : "Compare.Differed"]</span>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                    @* Design 8.15: what "balsavusiųjų dauguma" means, once beside the table. *@
                    <p class="small"><Lt2.Web.Client.Components.Hint Id="hint-majority" Text="@T["Majority.Hint"]" Answer="@T["Majority.Answer"]" /></p>
                </details>
            }
            <p class="small">@A["NotAPoll"]</p>
        </section>
    </div>

    <section class="sheet stack" aria-labelledby="h-unity" id="faction-unity">
        <div class="row list-head"><h2 id="h-unity">@T["Unity.Title"]</h2></div>
        <p class="small">
            @T["Unity.Lead"]@(" ")
            <Lt2.Web.Client.Components.Hint Id="hint-faction-position" Text="@T["Unity.Hint"]" Answer="@T["Unity.Answer"]" More="/metodika#faction-alignment" />
        </p>
        @if (d.Factions.Count == 0)
        {
            <p id="unity-none">@T["Unity.None"]</p>
        }
        else
        {
            <ul class="unity">
                @foreach (var faction in d.Factions)
                {
                    <li class="stack stack--tight" id="@($"unity-{faction.Slug}")" @key="faction.Slug">
                        <div class="row unity__head">
                            <a href="/frakcijos/@Uri.EscapeDataString(faction.Slug)">@faction.Name</a>
                            <span class="small num">@T.Format("Unity.Seats", Display.Number(faction.Seats))</span>
                            @if (Display.Percent(faction.Share) is { } share)
                            {
                                <b class="num unity__share">@share</b>
                            }
                            else if (faction.SmallSample && faction.VotesWithPosition > 0)
                            {
                                <span class="tag unity__share">@T["SmallSample"]</span>
                            }
                        </div>
                        @if (faction.Share is { } value)
                        {
                            <svg class="meter" viewBox="0 0 1000 10" preserveAspectRatio="none" aria-hidden="true">
                                <rect class="meter__fill" x="0" y="0" width="@Px(1000 * value)" height="10" />
                            </svg>
                        }
                        else if (faction.VotesWithPosition == 0)
                        {
                            <span class="small">@T["Unity.NoPosition"]</span>
                        }
                        <span class="small num">@T.Format("Unity.Votes", Display.Number(faction.VotesWithPosition), Display.Number(faction.FreeVotes))</span>
                        @if (faction.MostSplit.Count > 0)
                        {
                            <details class="more stack stack--tight" id="@($"split-{faction.Slug}")">
                                <summary class="linkish small">@T["Unity.Split"]</summary>
                                <ul class="stack stack--tight">
                                    @foreach (var vote in faction.MostSplit)
                                    {
                                        <li class="small">
                                            <a href="/seimas/balsavimai/@vote.VoteId">@(vote.BillNumber is { } number ? number + " " : "")@vote.Title</a>
                                            <span class="num">@Display.Day(vote.HeldAt)@(vote.Stage is { } stage ? " · " + F.Stage(stage) : "")</span>
                                            <span class="num">· @F.Position(vote.Position) · @T.Format("Unity.Counts", Display.Number(vote.For), Display.Number(vote.Against), Display.Number(vote.Abstain))</span>
                                        </li>
                                    }
                                </ul>
                            </details>
                        }
                    </li>
                }
            </ul>
        }
    </section>
}

<section class="sheet stack" aria-labelledby="h-mine" id="my-agreement">
    <div class="row list-head"><h2 id="h-mine">@T["Mine.Title"]</h2></div>
    <p class="small">@T["Mine.Lead"]</p>
    <MyAgreement @rendermode="InteractiveWebAssembly" />
</section>

<SourceLine UpdatedAt="@_updatedAt" />

@code {
    /// <summary>The page's address.</summary>
    public const string Path = MenuSections.Statistics;

    private AnalyticsResponse? _data;
    private DateTimeOffset? _updatedAt;
    private AnalyticsListState _state = AnalyticsList.Read(null, null, null, null, null, null, null, null, null);

    [SupplyParameterFromQuery(Name = "metai")] public string? Year { get; set; }

    [SupplyParameterFromQuery(Name = "paskyros")] public string? Accounts { get; set; }

    [SupplyParameterFromQuery(Name = "nuo")] public string? From { get; set; }

    [SupplyParameterFromQuery(Name = "iki")] public string? To { get; set; }

    [SupplyParameterFromQuery(Name = "q")] public string? Query { get; set; }

    [SupplyParameterFromQuery(Name = "rezultatas")] public string? Result { get; set; }

    [SupplyParameterFromQuery(Name = "dauguma")] public string? Majority { get; set; }

    [SupplyParameterFromQuery(Name = "rikiuoti")] public string? Sort { get; set; }

    [SupplyParameterFromQuery(Name = "rodyti")] public string? Show { get; set; }

    /// <summary>The whole term by its name ("2024–2028 m. kadencija"), or "Visa kadencija" without one.</summary>
    private string TermLabel => string.IsNullOrEmpty(_data?.TermName) ? T["Filter.Term"] : _data.TermName;

    /// <summary>The two day fields of the list's form: the id, the name in the address, the label, the value as typed, and whether it is not a date.</summary>
    private IEnumerable<(string Id, string Name, string Label, string? Value, bool Invalid)> DayFields =>
    [
        ("compare-from", "nuo", "Filter.From", _state.From, _state.FromInvalid),
        ("compare-to", "iki", "Filter.To", _state.To, _state.ToInvalid),
    ];

    /// <summary>The list's filters as hidden fields of the period's form, so changing the period keeps them (the length starts again).</summary>
    private IEnumerable<(string Name, string Value)> ListHidden
    {
        get
        {
            var query = AnalyticsList.Query(_state);
            if (query.From is { } from)
            {
                yield return ("nuo", Display.Day(from));
            }

            if (query.To is { } to)
            {
                yield return ("iki", Display.Day(to));
            }

            if (_state.Query is { } q)
            {
                yield return ("q", q);
            }

            foreach (var (name, value) in new[] { ("rezultatas", _state.Result), ("dauguma", _state.Majority), ("rikiuoti", _state.Sort) })
            {
                if (value != "")
                {
                    yield return (name, value);
                }
            }
        }
    }

    protected override async Task OnParametersSetAsync()
    {
        _state = AnalyticsList.Read(Year, Accounts, From, To, Query, Result, Majority, Sort, Show);
        _data = (await Api.GetAsync(_state.Year, _state.Older, AnalyticsList.Query(_state))).Value;
        _updatedAt = (await Meta.GetImportsAsync()).Value?.Sources.FirstOrDefault()?.LastSuccessAt;
    }

    /// <summary>The plot's axis, in per cent of the track's width; the line at 50 % is the majority's.</summary>
    private static readonly int[] Ticks = [0, 25, 50, 75, 100];

    private static string Px(decimal value) => value.ToString("0.#", CultureInfo.InvariantCulture);

    /// <summary>A bill stands in the plot when both shares are shown: from 20 positions and a vote with numbers (no consensus).</summary>
    private static bool InPlot(BillComparisonResponse bill) => bill.SeimasShareFor is not null && bill.MembersShareFor is not null;

    /// <summary>An SVG <c>text</c> element (Razor reads a literal one inside a loop as its own tag); the content is encoded.</summary>
    private static MarkupString SvgText(string cssClass, string x, string y, string anchor, string content) =>
        new($"<text class=\"{cssClass}\" x=\"{x}\" y=\"{y}\" text-anchor=\"{anchor}\">{System.Net.WebUtility.HtmlEncode(content)}</text>");

    /// <summary>The Seimas's share "for" in the table, "pritarta bendru sutarimu", or that the vote has no result.</summary>
    private string SeimasShare(BillComparisonResponse bill) =>
        bill.IsConsensus ? T["Compare.Consensus"] : AnalyticsFormat.Share(bill.SeimasShareFor) ?? T["Compare.NoResult"];

    /// <summary>The Seimas's majority of those who voted in the design's words (8.26.2), without quotes; null without numbers.</summary>
    private string? MajorityWord(BillComparisonResponse bill) => bill.SeimasMajority switch
    {
        Lt2.SharedKernel.SeimasMajorities.For => T["Compare.MajorityFor"].Value,
        Lt2.SharedKernel.SeimasMajorities.Against => T["Compare.MajorityAgainst"].Value,
        Lt2.SharedKernel.SeimasMajorities.None => T["Compare.MajorityNone"].Value,
        _ => null,
    };

    /// <summary>"iš 141 Seimo nario", "iš 13 Seimo narių": the genitive after "iš" is singular after 1, 21, 31 … (not 11).</summary>
    private string MpsOf(int sitting) =>
        T.Format(Lt2.SharedKernel.LithuanianCounts.Pick(sitting, "Figures.MpsOf.One", "Figures.MpsOf.Many", "Figures.MpsOf.Many"), Display.Number(sitting));
}
