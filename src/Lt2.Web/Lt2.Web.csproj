<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <RootNamespace>Lt2.Web</RootNamespace>
    <UserSecretsId>lt2-web-local</UserSecretsId>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.Server" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
    <PackageReference Include="FluentValidation.DependencyInjectionExtensions" />
    <PackageReference Include="Hangfire.AspNetCore" />
    <PackageReference Include="Hangfire.PostgreSql" />
    <!-- Design 8.22.5: a vote's link-preview image, drawn on request. The Linux library without dependencies, as the
         chiselled image has no fontconfig; the fonts come from the assembly (Previews/Fonts). -->
    <PackageReference Include="SkiaSharp" />
    <PackageReference Include="SkiaSharp.NativeAssets.Linux.NoDependencies" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Lt2.Api.Contracts\Lt2.Api.Contracts.csproj" />
    <ProjectReference Include="..\Lt2.Hosting\Lt2.Hosting.csproj" />
    <ProjectReference Include="..\Lt2.Jobs\Lt2.Jobs.csproj" />
    <ProjectReference Include="..\Lt2.SharedKernel\Lt2.SharedKernel.csproj" />
    <ProjectReference Include="..\Lt2.Web.Client\Lt2.Web.Client.csproj" />
    <ProjectReference Include="..\Modules\Lt2.Identity\Lt2.Identity.csproj" />
    <ProjectReference Include="..\Modules\Lt2.Parliament\Lt2.Parliament.csproj" />
    <ProjectReference Include="..\Modules\Lt2.Appeals\Lt2.Appeals.csproj" />
    <ProjectReference Include="..\Modules\Lt2.Notifications\Lt2.Notifications.csproj" />
    <ProjectReference Include="..\Modules\Lt2.Audit\Lt2.Audit.csproj" />
    <ProjectReference Include="..\Modules\Lt2.Usage\Lt2.Usage.csproj" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="Previews\Fonts\*.ttf;Previews\Fonts\OFL-*.txt" LogicalName="Lt2.Web.Previews.Fonts.%(Filename)%(Extension)" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Lt2.IntegrationTests" />
    <Using Include="Microsoft.AspNetCore.Http.HttpResults" />
  </ItemGroup>
  <!-- The code classes seen twice (Lt2.SharedKernel and Lt2.Api.Contracts) mean the contracts' copy. -->
  <Import Project="..\Lt2.Api.Contracts\CodeAliases.props" />
</Project>
