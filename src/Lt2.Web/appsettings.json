{
  "ConnectionStrings": {
    "Lt2": "Host=localhost;Port=5432;Database=lt2;Username=lt2_app"
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "Microsoft.AspNetCore.Hosting.Diagnostics": "Warning"
      }
    }
  },
  "ReverseProxy": {
    "TrustForwardedHeaders": false
  },
  "RateLimits": {
    "CodeRequest": { "PermitLimit": 10, "WindowSeconds": 900 },
    "Registration": { "PermitLimit": 20, "WindowSeconds": 3600 },
    "SignIn": { "PermitLimit": 30, "WindowSeconds": 900 }
  },
  "AllowedHosts": "*"
}
