@using Lt2.Api.Contracts.Appeals
@using Lt2.Web.Client.Appeals
@inherits InteractiveBase<AppealUi>

@* "⋯" under an MP's response (design 8.16.1; reports as for statements, 8.5.5): "Pranešti" in the menu; a member's report
   form opens below the action row, a visitor is told how to report. An island of its own in the server-rendered part: its
   trigger, menu and form are direct children of the row. *@
<MoreMenu Id="@MenuId">
    @if (_signedIn)
    {
        <button type="button" class="menu__item" id="report-response-@ResponseId.ToString("N")" disabled="@Locked" popovertarget="@MoreMenu.MenuOf(MenuId)" popovertargetaction="hide"
                @onclick="() => _open = !_open">@L["Report.Open"]</button>
    }
    else
    {
        <VisitorReport Contact="@Contact" />
    }
</MoreMenu>
@if (_open)
{
    <div class="act__panel"><ReportForm TargetKind="response" TargetId="ResponseId" OnClose="() => _open = false" /></div>
}

@code {
    private bool _signedIn;
    private bool _open;

    [Parameter, EditorRequired] public Guid ResponseId { get; set; }

    [Parameter] public string? Contact { get; set; }

    private string MenuId => "more-response-" + ResponseId.ToString("N");

    protected override async Task OnInitializedAsync() =>
        _signedIn = await IsSignedInAsync();
}
