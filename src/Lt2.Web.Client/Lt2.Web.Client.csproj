<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">
  <PropertyGroup>
    <RootNamespace>Lt2.Web.Client</RootNamespace>
    <NoDefaultLaunchSettingsFile>true</NoDefaultLaunchSettingsFile>
    <StaticWebAssetProjectMode>Default</StaticWebAssetProjectMode>
    <BlazorWebAssemblyLoadAllGlobalizationData>true</BlazorWebAssemblyLoadAllGlobalizationData>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.Authentication" />
    <PackageReference Include="Microsoft.Extensions.Localization" />
    <PackageReference Include="Microsoft.Extensions.Http" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Lt2.Api.Contracts\Lt2.Api.Contracts.csproj" />
  </ItemGroup>
  <PropertyGroup>
    <DefineConstants>$(DefineConstants);LT2_CLIENT</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <!-- One definition of how a member's text is cut (design 8.2, owner 2026-11-16), shared with the MPs' email: the file
         lives in SharedKernel, which the browser may not reference, and compiles here in the namespace Lt2.Web.Client. -->
    <Compile Include="..\Lt2.SharedKernel\TextExcerpt.cs" Link="Texts\TextExcerpt.cs" />
    <!-- The account screens' addresses (design 8.21), shared with the links in emails in the same way. -->
    <Compile Include="..\Lt2.SharedKernel\AccountScreens.cs" Link="Texts\AccountScreens.cs" />
  </ItemGroup>
  <ItemGroup>
    <!-- The API clients (de)serialise the contract types by reflection. Publishing trims unused members, which removed
         their constructors and broke every call from the browser; keep the whole (small) contracts assembly. -->
    <TrimmerRootAssembly Include="Lt2.Api.Contracts" />
  </ItemGroup>
</Project>
