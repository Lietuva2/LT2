@using Lt2.Api.Contracts.Organisations
@inherits InteractiveBase
@inject IOrganisationModerationApi Moderation

@* "Atkurti" for a blocked organisation (lifts the block) or a hidden statement (design 8.14.14): its own field, a required
   statement sent to the organisation's representatives, one sentence on what it does; the confirmation stays. *@
<div class="stack stack--tight" id="org-restore-@Id">
    @if (!_open)
    {
        @if (_done is null)
        {
            <div class="row">
                <button type="button" class="btn btn--plain" id="org-restore-open-@Id" disabled="@(Locked || !Allowed)" @onclick="() => _open = true">@L["Hidden.Restore"]</button>
            </div>
        }
    }
    else
    {
        <form class="sheet stack stack--tight" @onsubmit="RestoreAsync" novalidate aria-labelledby="org-restore-title-@Id">
            <h4 id="org-restore-title-@Id">@L["Hidden.Restore"]</h4>
            <p class="small">@L["OrgMod.Restore.Sentence." + Kind]</p>
            <div class="field @(Errors.ContainsKey("statement") ? "field--error" : "")">
                <label for="org-restore-statement-@Id">@L["OrgMod.Statement"]</label>
                <textarea class="textarea" id="org-restore-statement-@Id" maxlength="@AppealLimits.StatementMaxLength" @bind="_statement" disabled="@Locked"></textarea>
                <FieldError Errors="Errors" Field="statement" />
            </div>
            <div class="row">
                <button type="submit" class="btn" id="org-restore-submit-@Id" disabled="@Locked">@L["Hidden.Restore"]</button>
                <button type="button" class="btn btn--plain" disabled="@Locked" @onclick="() => _open = false">@L["Cancel"]</button>
            </div>
        </form>
    }
    <Messages Message="@Message" Info="@(Info ?? _done)" />
</div>

@code {
    private bool _open;
    private string _statement = "";
    private string? _done;

    [Parameter, EditorRequired] public Guid Id { get; set; }

    /// <summary><c>organisation</c> or <c>statement</c>.</summary>
    [Parameter, EditorRequired] public string Kind { get; set; } = "";

    [Parameter] public bool Allowed { get; set; } = true;

    private Task RestoreAsync() => RunAsync(async () =>
    {
        var request = new StatementRequest { Statement = _statement };
        var result = Kind == "organisation" ? await Moderation.UnblockAsync(Id, request) : await Moderation.RestoreStatementAsync(Id, request);
        if (!result.IsSuccess)
        {
            Show(result.Problem, "statement");
            return;
        }

        _open = false;
        _done = L["Hidden.Restored"];
    });
}
