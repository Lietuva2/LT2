@using Lt2.Api.Contracts.Organisations
@inherits InteractiveBase<AppealUi>
@inject IOrganisationModerationApi Moderation

@* Blocked organisations and hidden statements on the moderators' list of hidden items (design 8.14.14), with who did it,
   when and why, and "Atkurti": lifting a block brings back exactly the statements that were shown; a hidden statement comes
   back while its bill takes statements. Organisations kept out of summaries (8.14.9) are listed with their undo. *@
@if (Items is { } items)
{
    <section class="stack" aria-labelledby="h-hidden-organisations" id="hidden-organisations">
        <h2 id="h-hidden-organisations">@L["OrgMod.Hidden.Organisations"]</h2>
        @if (items.Organisations.Count == 0)
        {
            <p class="small">@L["Hidden.None"]</p>
        }
        @foreach (var org in items.Organisations)
        {
            <article class="sheet stack stack--tight" id="hidden-organisation-@org.Id" aria-labelledby="ho-@org.Id" @key="org.Id">
                <h3 id="ho-@org.Id"><a href="@OrganisationWords.ProfilePath(org.Slug)">@org.Name</a></h3>
                <p class="small num">@ModerationWords.Hidden(L, org.BlockedAt, org.BlockedBy)</p>
                @if (org.Statement is { } statement)
                {
                    <p class="small">@L.Format("Hidden.Why", statement)</p>
                }
                <RestoreForm Id="org.Id" IdPrefix="org-restore" Sentence="@L["OrgMod.Restore.Sentence.organisation"]" StatementLabel="@L["OrgMod.Statement"]"
                             Restore="request => Moderation.UnblockAsync(org.Id, request)" />
            </article>
        }
    </section>

    @* Design 8.14.9: organisations kept out of summaries to MPs, shown on the site as before, with "Vėl įtraukti į suvestines". *@
    @if (items.KeptOut is { Count: > 0 } keptOut)
    {
        <section class="stack" aria-labelledby="h-kept-out-organisations" id="kept-out-organisations">
            <h2 id="h-kept-out-organisations">@L["OrgMod.Hidden.KeptOut"]</h2>
            <p class="small">@L["OrgMod.Hidden.KeptOutLead"]</p>
            @foreach (var org in keptOut)
            {
                <article class="sheet stack stack--tight" id="kept-out-organisation-@org.Id" aria-labelledby="hko-@org.Id" @key="org.Id">
                    <h3 id="hko-@org.Id"><a href="@OrganisationWords.ProfilePath(org.Slug)">@org.Name</a></h3>
                    <p class="small num">@ModerationWords.Hidden(L, org.KeptOutAt, org.KeptOutBy)</p>
                    @if (org.Statement is { } statement)
                    {
                        <p class="small">@L.Format("Hidden.Why", statement)</p>
                    }
                    <RestoreForm Id="org.Id" IdPrefix="org-keep-in" Sentence="@L["OrgMod.Sentence.keep-in"]" StatementLabel="@L["OrgMod.Statement"]"
                                 Label="@L["OrgMod.Action.keep-in"]" Done="@L["OrgMod.Done.keep-in"]"
                                 Restore="request => Moderation.ReturnToSummariesAsync(org.Id, request)" />
                </article>
            }
        </section>
    }

    <section class="stack" aria-labelledby="h-hidden-statements" id="hidden-statements">
        <h2 id="h-hidden-statements">@L["OrgMod.Hidden.Statements"]</h2>
        @if (items.Statements.Count == 0)
        {
            <p class="small">@L["Hidden.None"]</p>
        }
        @foreach (var s in items.Statements)
        {
            <article class="sheet stack stack--tight" id="hidden-statement-@s.Id" aria-label="@L["Org.Statement"]" @key="s.Id">
                <div class="row">
                    <span class="tag tag--ink num">@s.Bill.Number</span>
                    <b>@s.OrganisationName</b>
                    <span class="@OrganisationWords.StanceClass(s.Stance)">@L["Org.Stance." + s.Stance]</span>
                </div>
                <TypedText Text="@s.Text" Class="voice typed" />
                <p class="small num">@ModerationWords.Hidden(L, s.HiddenAt, s.HiddenBy)</p>
                @if (s.Statement is { } statement)
                {
                    <p class="small">@L.Format("Hidden.Why", statement)</p>
                }
                @if (!s.Restorable)
                {
                    <p class="note note--quiet">@L["OrgMod.Hidden.NotOpen"]</p>
                }
                <RestoreForm Id="s.Id" IdPrefix="org-restore" Sentence="@L["OrgMod.Restore.Sentence.statement"]" StatementLabel="@L["OrgMod.Statement"]"
                             Allowed="s.Restorable" Restore="request => Moderation.RestoreStatementAsync(s.Id, request)" />
            </article>
        }
    </section>
}

@code {
    [PersistentState] public HiddenOrganisationsResponse? Items { get; set; }

    /// <summary>
    /// Asked for only in the browser: while the page prerenders, its other lists ask the server too, and the staff check
    /// they all make shares one database context per request.
    /// </summary>
    protected override async Task OnInitializedAsync()
    {
        if (RendererInfo.IsInteractive)
        {
            Items ??= (await Moderation.GetHiddenAsync()).Value;
        }
    }
}
