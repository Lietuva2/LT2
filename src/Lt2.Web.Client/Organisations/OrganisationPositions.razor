@using Lt2.Api.Contracts.Organisations
@using Lt2.Api.Contracts.Comments
@using Lt2.Web.Client.Comments
@inherits InteractiveBase<AppealUi>
@implements IDisposable
@inject ICommentsApi CommentsApi
@inject IOrganisationsApi Organisations
@inject Lt2.Web.Client.Appeals.MyBillState BillState
@inject IAppealsApi Appeals

@* "Organizacijų pozicijos" on the bill's page (design 8.14.3, 8.14.14), after the MPs' responses and before the arguments
   (owner, 2026-11-17), and only when there is something to show: a statement, or for a representative their organisation's
   way to publish one. For and against side by side (both, an empty side included, once there is a statement), remarks
   below, each in the order published; the section says statements are not counted. Prerendered from the public, cacheable
   answer, so it reads without JavaScript. A representative's controls come from the caller's own answer
   (GET …/organisations/mine), asked for only for a signed-in member; nothing in the public markup tells who represents an
   organisation or ties a member's own side to it. *@
@if (Shown)
{
    <section class="sheet stack" aria-labelledby="h-organisations" id="organisations">
        <h2 id="h-organisations">@L["Org.Section.Title"]</h2>
        <p class="small" id="organisations-not-counted">@L["Org.Section.NotCounted"] <a href="/organizacijos">@L["Org.Section.All"]</a></p>
        @if (Statements is { } statements)
        {
            <div class="pair pair--reasons">
                @foreach (var stance in Sides)
                {
                    var items = statements.Items.Where(i => i.Statement.Stance == stance).ToList();
                    <div class="stack" id="organisations-@stance">
                        <h3><span class="choice choice--@stance">@L["Org.Stance." + stance]</span></h3>
                        @if (items.Count == 0)
                        {
                            <p class="small">@L["Org.Section.None"]</p>
                        }
                        @foreach (var item in items)
                        {
                            <StatementView @key="item.Statement.Id" Statement="item.Statement" Name="@item.Name" Slug="@item.Slug" Label="item.Label" ShowStance="false" Actions="@Actions(item.Statement)" />
                        }
                    </div>
                }
            </div>
            var remarks = statements.Items.Where(i => i.Statement.Stance == "remarks").ToList();
            @if (remarks.Count > 0)
            {
                <div class="stack" id="organisations-remarks">
                    <h3><span class="choice choice--remarks">@L["Org.Stance.remarks"]</span></h3>
                    @foreach (var item in remarks)
                    {
                        <StatementView @key="item.Statement.Id" Statement="item.Statement" Name="@item.Name" Slug="@item.Slug" Label="item.Label" ShowStance="false" Actions="@Actions(item.Statement)" />
                    }
                </div>
            }
            @if (!statements.Open && statements.Items.Count > 0)
            {
                <p class="fine" id="organisations-frozen">@L["Org.Section.Frozen"]</p>
            }
        }

        @if (_signedIn && Mine is { } mine)
        {
            @if (mine.Count == 0)
            {
                <p class="small" id="organisations-register"><a href="/organizacijos/nauja">@L["Org.Section.Register"]</a></p>
            }
            @foreach (var org in mine)
            {
                <div class="sheet sheet--quiet stack stack--tight" id="my-organisation-@org.Slug" aria-label="@org.Name" @key="org.Slug">
                    <p class="row"><b>@L.Format("Org.Mine.Title", org.Name)</b> <OrgLabel Label="org.Label" /></p>
                    <p class="fine">@L["Org.Mine.Private"]</p>
                    @if (org.Statement is { } own)
                    {
                        <p class="row small">
                            <span class="@OrganisationWords.StanceClass(own.Stance)">@L["Org.Stance." + own.Stance]</span>
                            <span class="tag" id="my-statement-status-@org.Slug">@L["Org.Status." + own.Status]</span>
                        </p>
                    }
                    @if (org.Refusal is { } refusal)
                    {
                        <p class="note note--quiet" id="refusal-@org.Slug">@L["Org.Refusal." + refusal]</p>
                    }
                    else if (org.Statement is not { Status: "hidden" })
                    {
                        @if (_editing != org.Slug)
                        {
                            <div class="row">
                                <button class="btn btn--plain" type="button" id="statement-open-@org.Slug" disabled="@Locked" @onclick="() => StartAsync(org)">
                                    @(org.Statement is null ? L["Org.Form.Publish"] : L["Org.Form.Change"])
                                </button>
                                @if (org.Statement is not null)
                                {
                                    <button class="linkish small" type="button" id="statement-withdraw-@org.Slug" disabled="@Locked" @onclick="() => _withdrawing = _withdrawing == org.Slug ? null : org.Slug">@L["Org.Form.Withdraw"]</button>
                                }
                            </div>
                            @if (_withdrawing == org.Slug)
                            {
                                <div class="row" role="group" aria-label="@L["Org.Form.Withdraw"]">
                                    <p class="small">@L["Org.Form.WithdrawConfirm"]</p>
                                    <button class="btn" type="button" id="statement-withdraw-confirm-@org.Slug" disabled="@Locked" @onclick="() => WithdrawAsync(org.Slug)">@L["Org.Form.WithdrawYes"]</button>
                                    <button class="btn btn--plain" type="button" disabled="@Locked" @onclick="() => _withdrawing = null">@L["Cancel"]</button>
                                </div>
                            }
                        }
                        else
                        {
                            <form class="stack" @onsubmit="() => SaveAsync(org.Slug)" novalidate id="statement-form-@org.Slug" aria-labelledby="statement-form-title-@org.Slug">
                                <h3 id="statement-form-title-@org.Slug">@L.Format("Org.Form.Title", org.Name)</h3>
                                <p class="small">@L["Org.Form.Lead"]</p>
                                @* The joined buttons of a stance (owner, 2026-11-17; design 8.16): "Pastabos" neutral. *@
                                <fieldset class="switch-field field stack stack--tight @ErrorClass("stance")">
                                    <legend>@L["Org.Form.Stance"]</legend>
                                    <div class="switch switch--stack" id="stance-@org.Slug">
                                        @foreach (var stance in OrganisationLimits.Stances)
                                        {
                                            <label class="switch__half switch__half--@(stance == "remarks" ? "neutral" : stance)">
                                                <input class="switch__input" type="radio" name="stance-@org.Slug" id="stance-@stance-@org.Slug" value="@stance" checked="@(_stance == stance)"
                                                       @onchange="() => _stance = stance" disabled="@Locked" aria-invalid="@Invalid("stance")" />
                                                <span>@L["Org.Stance." + stance]</span>
                                            </label>
                                        }
                                    </div>
                                    <FieldError Errors="Errors" Field="stance" For="@($"stance-{org.Slug}")" />
                                </fieldset>
                                <div class="field @ErrorClass("text")">
                                    <label for="statement-text-@org.Slug">@L["Org.Form.Text"]</label>
                                    <textarea class="textarea" id="statement-text-@org.Slug" rows="8" maxlength="@MemberTextLimits.Allowed(_maxLength ?? 0)" aria-invalid="@Invalid("text")"
                                              aria-describedby="@DescribedBy("text", $"statement-text-{org.Slug}", $"statement-text-hint-{org.Slug}")"
                                              @bind="_text" @bind:event="oninput" disabled="@Locked"></textarea>
                                    <p class="field__hint num" id="statement-text-hint-@org.Slug">@(_maxLength is > 0 and var max ? L.Format("Org.Form.TextHint", Display.Number(_text.Length), Display.Number(max)) : L.Format("Text.CountOnly", Display.Number(_text.Length)))</p>
                                    <FieldError Errors="Errors" Field="text" For="@($"statement-text-{org.Slug}")" />
                                </div>
                                <div class="field @ErrorClass("link")">
                                    <label for="statement-link-@org.Slug">@L["Org.Form.Link"]</label>
                                    <p class="field__hint" id="statement-link-hint-@org.Slug">@L["Org.Form.LinkHint"]</p>
                                    <input class="input" type="url" inputmode="url" autocomplete="off" spellcheck="false" id="statement-link-@org.Slug" maxlength="@OrganisationLimits.LinkMaxLength"
                                           aria-describedby="@DescribedBy("link", $"statement-link-{org.Slug}", $"statement-link-hint-{org.Slug}")" aria-invalid="@Invalid("link")" placeholder="https://" @bind="_link" @bind:event="oninput" disabled="@Locked" />
                                    <FieldError Errors="Errors" Field="link" For="@($"statement-link-{org.Slug}")" />
                                </div>
                                @if (_stance is "for" or "against")
                                {
                                    <div class="field @ErrorClass("goal")">
                                        <label for="statement-goal-@org.Slug">@L["Org.Form.Goal"]</label>
                                        <p class="field__hint" id="statement-goal-hint-@org.Slug">@L["Org.Form.GoalHint"]</p>
                                        <input class="input num" type="text" inputmode="numeric" autocomplete="off" id="statement-goal-@org.Slug" aria-describedby="@DescribedBy("goal", $"statement-goal-{org.Slug}", $"statement-goal-hint-{org.Slug}")" aria-invalid="@Invalid("goal")"
                                               @bind="_goal" @bind:event="oninput" disabled="@Locked" />
                                        <FieldError Errors="Errors" Field="goal" For="@($"statement-goal-{org.Slug}")" />
                                    </div>
                                }
                                <div class="row">
                                    <button type="submit" class="btn" id="statement-submit-@org.Slug" disabled="@(Locked || _stance is null || string.IsNullOrWhiteSpace(_text))">@L["Org.Form.Submit"]</button>
                                    <button type="button" class="btn btn--plain" disabled="@Locked" @onclick="Cancel">@L["Cancel"]</button>
                                </div>
                            </form>
                        }
                    }
                </div>
            }
        }
        <Messages Message="@Message" Info="@Info" />
    </section>
}

@code {
    private static readonly string[] Sides = ["for", "against"];

    /// <summary>
    /// The part shows when an organisation has a statement shown on the bill, or the caller represents one (their way to
    /// publish, change or withdraw its statement is here); otherwise nothing (owner, 2026-11-17).
    /// </summary>
    private bool Shown => Statements is { Items.Count: > 0 } || (_signedIn && Mine is { Count: > 0 });
    private bool _signedIn;
    private Guid? _reporting;
    private string? _editing;
    private string? _withdrawing;
    private string? _stance;
    private string _text = "";
    private string? _link;
    private string? _goal;

    [Parameter, EditorRequired] public string Number { get; set; } = "";

    /// <summary>The moderators' contact address, for visitors who want to report.</summary>
    [Parameter] public string? Contact { get; set; }

    [PersistentState] public BillStatementsResponse? Statements { get; set; }

    /// <summary>The comments under each statement (design 8.23.6), read with the statements and carried to the browser.</summary>
    [PersistentState] public Dictionary<Guid, CommentThreadResponse>? Threads { get; set; }

    /// <summary>The server found a moderator in a staff-passkey session (the comments' "Moderuoti", design 8.23.8).</summary>
    [Parameter] public bool Moderator { get; set; }

    /// <summary>"Rodyti daugiau komentarų" (design 8.23.14).</summary>
    [SupplyParameterFromQuery(Name = CommentLimits.ShowParameter)] public string? CommentsShown { get; set; }

    /// <summary>A link to one comment (<c>?komentaras=</c>, design 8.23.6), resolved by the page on the server: its thread open through it.</summary>
    [Parameter] public CommentPlaceResponse? Linked { get; set; }

    /// <summary>The responses' page parameter (design 8.5.6), kept in the links this part builds.</summary>
    [SupplyParameterFromQuery(Name = Lt2.Api.Contracts.Mps.MpResponseLimits.ShowParameter)] public string? ResponsesShown { get; set; }

    /// <summary>The organisations the caller represents and their statements here: the caller's own, never-cached answer.</summary>
    [PersistentState] public List<MyBillOrganisationResponse>? Mine { get; set; }

    protected override async Task OnInitializedAsync()
    {
        _signedIn = await IsSignedInAsync();
        Statements ??= (await Organisations.GetOnBillAsync(Number)).Value;
        Threads ??= await ThreadsAsync();
        if (_signedIn && Mine is null)
        {
            Mine = (await Organisations.GetMineOnBillAsync(Number)).Value?.ToList();
        }

        if (RendererInfo.IsInteractive)
        {
            BillState.Changed += OnChanged;
        }
    }

    public void Dispose() => BillState.Changed -= OnChanged;

    /// <summary>A shown statement with a goal carries the count of its side, which a side taken on the page moves.</summary>
    private bool ShowsProgress => Statements?.Items.Any(i => i.Statement.Progress is not null) == true;

    /// <summary>
    /// A moderator's action on a statement in the panel, or a side taken, changed or withdrawn while a statement shows a goal
    /// ("Siekiame {N} dalyvių · dabar {n}", n the participants on its side), shows here without reloading the page.
    /// </summary>
    private void OnChanged(Lt2.Web.Client.Appeals.BillChange change)
    {
        if (!change.Concerns(Number, this) || (!change.ByModerator && !ShowsProgress))
        {
            return;
        }

        _ = InvokeAsync(async () =>
        {
            try
            {
                Statements = (await Organisations.GetOnBillAsync(Number)).Value ?? Statements;
                if (_signedIn)
                {
                    Mine = (await Organisations.GetMineOnBillAsync(Number)).Value?.ToList() ?? Mine;
                }

                StateHasChanged();
            }
            catch (HttpRequestException)
            {
                // The statements shown stay; the next change reads again.
            }
        });
    }

    /// <summary>
    /// The action row under one statement (design 8.16.1): "Aptarimas (n)" (design 8.23.6) and "⋯" with "Pranešti" (a member's
    /// report form opens below the row; a visitor is told how to report).
    /// </summary>
    private RenderFragment Actions(StatementResponse statement) => __builder =>
    {
        <CommentThread Kind="statement" TargetId="statement.Id" Number="@Number" Thread="@Threads?.GetValueOrDefault(statement.Id)" Count="statement.Comments"
                       Open="@(CommentPaging.Asked(CommentsShown, statement.Id, Linked) is not null)" Asked="@CommentPaging.Asked(CommentsShown, statement.Id, Linked)"
                       Marked="@CommentPaging.Marked(statement.Id, Linked)" PagePath="@CommentPaging.PagePath(Number, ResponsesShown)" Contact="@Contact" Moderator="Moderator" />
        <MoreMenu Id="@($"more-statement-{statement.Id}")">
            @if (_signedIn)
            {
                <button class="menu__item" type="button" id="report-statement-@statement.Id" disabled="@Locked" popovertarget="@MoreMenu.MenuOf($"more-statement-{statement.Id}")" popovertargetaction="hide"
                        @onclick="() => _reporting = _reporting == statement.Id ? null : statement.Id">@L["Report.Open"]</button>
            }
            else
            {
                <VisitorReport Contact="@Contact" />
            }
        </MoreMenu>
        @if (_reporting == statement.Id)
        {
            <div class="act__panel"><ReportForm TargetKind="statement" TargetId="statement.Id" OnClose="() => _reporting = null" /></div>
        }
    };

    private async Task<Dictionary<Guid, CommentThreadResponse>> ThreadsAsync()
    {
        var threads = new Dictionary<Guid, CommentThreadResponse>();
        foreach (var item in Statements?.Items ?? [])
        {
            if ((await CommentsApi.GetThreadAsync("statement", item.Statement.Id, CommentPaging.Asked(CommentsShown, item.Statement.Id, Linked))).Value is { } thread)
            {
                threads[item.Statement.Id] = thread;
            }
        }

        return threads;
    }


    /// <summary>The setting Texts:MaxLength (0 = no limit; design 5.6, owner 2026-11-16), read when a statement is opened.</summary>
    private int? _maxLength;

    private Task StartAsync(MyBillOrganisationResponse org) => RunAsync(async () =>
    {
        _maxLength ??= (await Appeals.GetRulesAsync()).Value?.TextMaxLength;
        Start(org);
    });

    private void Start(MyBillOrganisationResponse org)
    {
        _editing = org.Slug;
        _withdrawing = null;
        _stance = org.Statement?.Stance;
        _text = org.Statement?.Text ?? "";
        _link = org.Statement?.Link;
        _goal = org.Statement?.Goal is { } goal ? goal.ToString(System.Globalization.CultureInfo.InvariantCulture) : null;
        Errors = NoErrors();
    }

    private void Cancel()
    {
        _editing = null;
        Errors = NoErrors();
    }

    private Task SaveAsync(string slug) => RunAsync(async () =>
    {
        int? goal = null;
        if (_stance is "for" or "against" && !string.IsNullOrWhiteSpace(_goal))
        {
            if (!int.TryParse(_goal.Replace(" ", "", StringComparison.Ordinal).Replace(" ", "", StringComparison.Ordinal), System.Globalization.NumberStyles.None,
                    System.Globalization.CultureInfo.InvariantCulture, out var parsed))
            {
                FieldFails("goal", L["Org.Form.GoalInvalid"]);
                return;
            }

            goal = parsed;
        }

        var request = new OrganisationStatementRequest { Stance = _stance ?? "", Text = _text, Link = string.IsNullOrWhiteSpace(_link) ? null : _link, Goal = goal };
        var saved = await Organisations.SaveStatementAsync(Number, slug, request);
        if (!Succeeded(saved, "stance", "text", "link", "goal"))
        {
            return;
        }

        _editing = null;
        Info = saved.Value!.Status == "pending" ? L["Org.Form.Pending"] : L["Org.Form.Published"];
        await ReloadAsync();
    });

    private Task WithdrawAsync(string slug) => RunAsync(async () =>
    {
        if (!Succeeded(await Organisations.WithdrawStatementAsync(Number, slug)))
        {
            return;
        }

        _withdrawing = null;
        Info = L["Org.Form.Withdrawn"];
        await ReloadAsync();
    });

    private async Task ReloadAsync()
    {
        Statements = (await Organisations.GetOnBillAsync(Number)).Value ?? Statements;
        Mine = (await Organisations.GetMineOnBillAsync(Number)).Value?.ToList() ?? Mine;
    }
}
