@using Lt2.Api.Contracts.Admin
@using Lt2.Api.Contracts.Organisations
@inherits InteractiveBase<AppealUi>
@inject IOrganisationModerationApi Moderation
@inject MyAccountState Account

@* The actions on an organisation or a statement (design 8.14.14), as on the queue's screen (8.3): the shared
   ModerationMenu (owner, 2026-11-17), choosing one opens only its own field with one sentence on what it does, only the actions that apply to the item's state
   are offered, one is open at a time, and the confirmation stays after the action closes. Each is recorded, audited and
   emailed to the organisation's representatives. On a statement, "Riboti rašymą" reaches its writer as for an argument. *@
<div class="stack stack--tight" id="org-actions-@Id">
    @if (!_finished)
    {
        @if (_open is null)
        {
            <ModerationMenu Id="@($"org-more-{Id}")" Choices="Choices" Primary="@Primary" Locked="Locked" OnChoose="Open" />
        }
        else if (_open == "restrict")
        {
            <RestrictAuthor Id="Id" Statement="true" IdPrefix="org-" OnCancel="() => _open = null" OnDone="RestrictedAsync" />
        }
        else if (_open == "lock")
        {
            <LockAuthor Kind="@LockTargets.Statement" Id="Id" IdPrefix="org-" OnCancel="() => _open = null" OnDone="LockedAsync" />
        }
        else
        {
            <form class="sheet sheet--quiet stack stack--tight" @onsubmit="SubmitAsync" novalidate aria-labelledby="org-action-title-@Id" id="org-action-form-@Id">
                <ActionHeading Id="@($"org-action-title-{Id}")">@L["OrgMod.Action." + _open]</ActionHeading>
                <p class="small" id="org-action-sentence-@Id">@L["OrgMod.Sentence." + _open]</p>
                <div class="field @ErrorClass("statement")">
                    <label for="org-statement-@Id">@L[_open == "keep" ? "Mod.Note.Reporters" : Optional(_open) ? "OrgMod.Note" : _open == "confirm" ? "OrgMod.Checked" : "OrgMod.Statement"]</label>
                    @if (_open == "keep")
                    {
                        <p class="field__hint">@L["Mod.Note.Reporters.Hint"]</p>
                    }
                    <textarea class="textarea" id="org-statement-@Id" maxlength="@AppealLimits.StatementMaxLength" @bind="_statement" @bind:event="oninput" disabled="@Locked"
                              aria-invalid="@Invalid("statement")" aria-describedby="@DescribedBy("statement", $"org-statement-{Id}")"></textarea>
                    <FieldError Errors="Errors" Field="statement" For="@($"org-statement-{Id}")" />
                </div>
                <div class="row">
                    <button type="submit" class="btn" id="org-action-submit-@Id" disabled="@Locked">@L["OrgMod.Action." + _open]</button>
                    <button type="button" class="btn btn--plain" disabled="@Locked" @onclick="() => _open = null">@L["Cancel"]</button>
                </div>
            </form>
        }
    }
    <Messages Message="@Message" Info="@(Info ?? _done)" />
</div>

@code {
    private string? _open;
    private string? _done;
    private bool _finished;
    private bool _administrator;
    private string _statement = "";

    [Parameter, EditorRequired] public Guid Id { get; set; }

    /// <summary><c>organisation</c> or <c>statement</c>.</summary>
    [Parameter, EditorRequired] public string Kind { get; set; } = "";

    /// <summary>The organisation's status (<c>active</c>, <c>blocked</c>), or the statement's (<c>pending</c>, <c>published</c>).</summary>
    [Parameter, EditorRequired] public string Status { get; set; } = "";

    /// <summary>For a statement: the bill's final vote is recorded. A statement still waiting then is never published (design 6.9).</summary>
    [Parameter] public bool BillFinished { get; set; }

    /// <summary>An organisation's confirmation: null while "Nepatvirtinta".</summary>
    [Parameter] public string? ConfirmedBy { get; set; }

    [Parameter] public EventCallback<string> OnDone { get; set; }

    private IReadOnlyList<string> Offered => Kind == ReportTargets.Organisation
        ? Status switch
        {
            OrganisationStatuses.Active => ConfirmedBy is null ? ["keep", "confirm", "block"] : ["keep", "unconfirm", "block"],
            OrganisationStatuses.Blocked => ConfirmedBy is null ? ["unblock"] : ["unblock", "unconfirm"],
            _ => [],
        }
        : Status switch
        {
            StatementStatuses.Pending when BillFinished => ["leave", "hide"],
            StatementStatuses.Pending => ["publish", "restrict", "hide"],
            StatementStatuses.Published => ["seen", "restrict", "hide"],
            _ => [],
        };

    /// <summary>
    /// The filled button (owner, 2026-11-17): "Palikti" on an organisation to look at, "Paskelbti" on a waiting statement,
    /// "Palikti" on a seen or closed one; a blocked organisation has none. Blocking and hiding are set apart at the end.
    /// </summary>
    private string? Primary => Offered.FirstOrDefault() is { } first && first is "keep" or "publish" or "seen" or "leave" ? first : null;

    /// <summary>Design 8.3: on a statement an administrator also locks the writer's account, last after hiding, where the writer can be restricted.</summary>
    private IReadOnlyList<ModerationChoice> Choices =>
        [.. Offered.Concat(_administrator && Kind == ReportTargets.Statement && Offered.Contains("restrict") ? ["lock"] : [])
            .Select(a => new ModerationChoice(a, $"org-action-{a}-{Id}", L["OrgMod.Action." + a], Apart: a is "hide" or "block" or "lock"))];

    private static bool Optional(string action) => action is "keep" or "publish" or "seen" or "leave";

    private void Open(string action)
    {
        _open = action;
        _statement = "";
        ClearMessages();
        if (action == "restrict")
        {
            _done = null;
        }
    }

    protected override async Task OnInitializedAsync() => _administrator = await Account.IsAdministratorAsync(RendererInfo.IsInteractive);

    private void LockedAsync()
    {
        _open = null;
        _done = L["Lock.Done"];
    }

    private async Task RestrictedAsync()
    {
        _open = null;
        _done = L["Restrict.Done"];
        await OnDone.InvokeAsync("restrict");
    }

    private Task SubmitAsync() => RunAsync(async () =>
    {
        var action = _open!;
        if (!Optional(action) && string.IsNullOrWhiteSpace(_statement))
        {
            FieldFails("statement", L["OrgMod.StatementRequired"]);
            return;
        }

        var note = new ModerationRequest { Statement = string.IsNullOrWhiteSpace(_statement) ? null : _statement };
        var statement = new StatementRequest { Statement = _statement };
        var result = action switch
        {
            "keep" => await Moderation.KeepAsync(Id, note),
            "block" => await Moderation.BlockAsync(Id, statement),
            "unblock" => await Moderation.UnblockAsync(Id, statement),
            "confirm" => await Moderation.ConfirmAsync(Id, statement),
            "unconfirm" => await Moderation.UnconfirmAsync(Id, statement),
            "publish" or "seen" => await Moderation.PublishStatementAsync(Id, note),
            "leave" => await Moderation.KeepStatementAsync(Id, note),
            "hide" => await Moderation.HideStatementAsync(Id, statement),
            _ => ApiResult.Fail(new ApiProblem { Status = 400, Code = "action" }),
        };
        if (!Succeeded(result, "statement"))
        {
            return;
        }

        _open = null;
        _finished = true;
        _done = L["OrgMod.Done." + action];
        await OnDone.InvokeAsync(action);
    });
}
