@using Lt2.Api.Contracts.Organisations
@inherits InteractiveBase<AppealUi>
@inject IOrganisationsApi Organisations

@* "Mano organizacijos" on the account page (design 8.14.14): the organisations the person represents, each with its label
   and state, and the way to register one. Only the person sees this. *@
<section class="sheet stack" aria-labelledby="my-organisations-title" id="my-organisations">
    <h2 id="my-organisations-title">@L["Org.MyList.Title"]</h2>
    @if (Items is { Count: > 0 } items)
    {
        <ul class="rows">
            @foreach (var org in items)
            {
                <li>
                    <div class="rows__main"><a href="@OrganisationWords.ProfilePath(org.Slug)">@org.Name</a></div>
                    <div class="rows__side">
                        @if (org.Status != "active")
                        {
                            <span class="tag">@L["Org.State." + org.Status]</span>
                        }
                        else
                        {
                            <OrgLabel Label="org.Label" />
                        }
                    </div>
                </li>
            }
        </ul>
    }
    else
    {
        <p class="small">@L["Org.MyList.None"]</p>
    }
    <p class="row"><a class="btn btn--plain" href="/organizacijos/nauja" id="register-organisation">@L["Org.MyList.Register"]</a> <a href="/organizacijos">@L["Org.MyList.All"]</a></p>
</section>

@code {
    [PersistentState] public List<MyOrganisationResponse>? Items { get; set; }

    protected override async Task OnInitializedAsync() => Items ??= (await Organisations.GetMineAsync()).Value?.ToList();
}
