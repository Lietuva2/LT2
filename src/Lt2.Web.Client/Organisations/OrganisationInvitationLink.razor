@using Lt2.Api.Contracts.Organisations
@inherits InteractiveBase<AppealUi>
@inject IOrganisationsApi Organisations

@* The organisation's invitation link (design 8.14.14, stage B), inside the representatives' part of the profile: the link to
   the registration form with the organisation's code, a link for each bill it has a public statement on (the same code,
   landing on that bill), "Kopijuoti nuorodą", one number (how many completed registration with its codes; nothing about who,
   when or on which side) and "replace the code". Asked only once the island runs in the browser, never while the server
   prerenders, so neither the code nor the number is ever in the page's HTML. *@
@if (Invitation is { } inv)
{
    <div class="stack stack--tight" id="org-code">
        <h3>@L["Org.Code.Title"]</h3>
        <p class="small">@L["Org.Code.Lead"]</p>
        <p class="num" id="org-code-count"><b>@L.Format("Org.Code.Count", Display.Number(inv.Completed))</b></p>
        @if (inv.Usable && inv.Link is { } link)
        {
            <CopyLink Link="@link" LinkId="org-code-link" ButtonId="org-code-copy" />
            @if (inv.Bills.Count > 0)
            {
                <p class="small">@L["Org.Code.BillsLead"]</p>
                <ul class="rows" id="org-code-bills">
                    @foreach (var b in inv.Bills)
                    {
                        @* One child: a row of ".rows" is a two-column grid, and three children would sit side by side. *@
                        <li id="org-code-bill-@b.Bill.Number" @key="b.Bill.Number">
                            <div class="stack stack--tight">
                                <span><span class="num">@b.Bill.Number</span> · @b.Bill.Title</span>
                                <CopyLink Link="@b.Link" LinkId="@($"org-code-bill-link-{b.Bill.Number}")" ButtonId="@($"org-code-copy-{b.Bill.Number}")" />
                            </div>
                        </li>
                    }
                </ul>
            }
        }
        else
        {
            <p class="small" id="org-code-off">@L[OffKey(inv)]@if (!inv.On && inv.Contact is { } contact)
                {
                    @(" ")@L["Org.Code.Ask"]@(" ")<a href="mailto:@contact">@contact</a>@(".")
                }</p>
        }
        <p class="fine">@L["Org.Code.Private"]</p>
        @if (inv.Code is not null && inv.On && !inv.OffWithOrganisation)
        {
            @if (_replacing)
            {
                <div class="row" role="group">
                    <p class="small">@L["Org.Code.ReplaceConfirm"]</p>
                    <button class="btn btn--against" type="button" id="org-code-replace-confirm" disabled="@Locked" @onclick="ReplaceAsync">@L["Org.Code.ReplaceYes"]</button>
                    <button class="btn btn--plain" type="button" disabled="@Locked" @onclick="() => _replacing = false">@L["Cancel"]</button>
                </div>
            }
            else
            {
                <p><button class="linkish small" type="button" id="org-code-replace" disabled="@Locked" @onclick="() => _replacing = true">@L["Org.Code.Replace"]</button></p>
            }
        }
        <Messages Message="@Message" Info="@Info" />
    </div>
}

@code {
    private bool _replacing;

    [Parameter, EditorRequired] public string Slug { get; set; } = "";

    private OrganisationInvitationResponse? Invitation { get; set; }

    protected override async Task OnInitializedAsync()
    {
        // Only in the browser: the server's prerendered HTML never holds the code or the number.
        if (RendererInfo.IsInteractive)
        {
            Invitation = (await Organisations.GetInvitationAsync(Slug)).Value;
        }
    }

    private static string OffKey(OrganisationInvitationResponse inv) =>
        inv.OffWithOrganisation ? "Org.Code.OffWithOrganisation" : !inv.On ? "Org.Code.SwitchedOff" : inv.Code is null ? "Org.Code.None" : "Org.Code.UsedUp";

    private Task ReplaceAsync() => RunAsync(async () =>
    {
        var result = await Organisations.ReplaceInvitationAsync(Slug);
        if (!Succeeded(result))
        {
            return;
        }

        Invitation = result.Value;
        _replacing = false;
        Info = L["Org.Code.Replaced"];
    });
}
