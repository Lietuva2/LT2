@using Lt2.Api.Contracts.Organisations
@inject IStringLocalizer<AppealUi> L

@* One organisation's statement (design 8.14.3): the organisation and its label, the stance, the text, the link with its host
   visible (never fetched by the server; nofollow, ugc), and with a goal "Siekiame {N} dalyvių · dabar {n}". All statements
   look alike: same size, no highlighting (8.14.8). Never who wrote it. *@
<article class="said statement" id="@(IdPrefix)statement-@Statement.Id" aria-label="@(Name ?? L["Org.Statement"])">
    @if (Name is not null)
    {
        <p class="row statement__who">
            @if (Slug is not null)
            {
                <a class="statement__name" href="@OrganisationWords.ProfilePath(Slug)">@Name</a>
            }
            else
            {
                <b class="statement__name">@Name</b>
            }
            @if (Label is not null)
            {
                <OrgLabel Label="Label" />
            }
        </p>
    }
    @if (ShowStance)
    {
        <p><span class="@OrganisationWords.StanceClass(Statement.Stance)">@L["Org.Stance." + Statement.Stance]</span></p>
    }
    @if (Whole)
    {
        <div class="bubble bubble--org voice">
            @foreach (var paragraph in Statement.Text.Split('\n', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries))
            {
                <p>@paragraph</p>
            }
        </div>
    }
    else
    {
        @* Design 8.14.3 (owner, 2026-11-16): a statement longer than about 1 500 characters shows its beginning and "Rodyti
           daugiau"; a moderator's screen shows it whole. *@
        <LongText Text="@Statement.Text" BubbleClass="bubble bubble--org voice"
                  Shown="TextExcerpt.StatementShown" Margin="TextExcerpt.StatementMargin" Id="@($"{IdPrefix}statement-more-{Statement.Id}")" />
    }
    <div class="said__by statement__meta">
        @if (Statement.Link is { } link)
        {
            <span class="statement__link">@L["Org.Link"] <a href="@link" rel="@OrganisationWords.UserLinkRel" target="_blank">@(Statement.LinkHost ?? link)</a></span>
        }
        @if (Statement.Goal is { } goal)
        {
            <span class="statement__goal num" id="@(IdPrefix)goal-@Statement.Id">@Goal(goal)</span>
        }
        <span class="small num">@Published</span>
        @ChildContent
    </div>
    @if (Actions is not null)
    {
        @* The action row (design 8.16.1): "Aptarimas (n)" and "⋯" on the bill's page, as under every text. *@
        <div class="act" id="@(IdPrefix)statement-actions-@Statement.Id">@Actions</div>
    }
</article>

@code {
    [Parameter, EditorRequired] public StatementResponse Statement { get; set; } = default!;

    /// <summary>The organisation, on the bill's page; null on the organisation's own profile.</summary>
    [Parameter] public string? Name { get; set; }

    [Parameter] public string? Slug { get; set; }

    [Parameter] public OrganisationLabelResponse? Label { get; set; }

    [Parameter] public bool ShowStance { get; set; } = true;

    /// <summary>The start of the element ids (<c>mod-</c> in the moderators' panel, so the public list's ids stay unique).</summary>
    [Parameter] public string IdPrefix { get; set; } = "";

    /// <summary>The whole text, never cut: the moderators' queue and panels (design 8.14.9).</summary>
    [Parameter] public bool Whole { get; set; }

    /// <summary>What stands beside the dates (on the moderators' screens, their controls).</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }

    /// <summary>The action row under the statement (design 8.16.1): the discussion and "⋯"; none where it has none.</summary>
    [Parameter] public RenderFragment? Actions { get; set; }

    /// <summary>"Siekiame {N} dalyvių · dabar {n}"; without the count (a moderator's screen) only the goal.</summary>
    private string Goal(int goal) => Statement.Progress is { } now
        ? L.Format(OrganisationWords.GoalKey(goal), Display.Number(goal), Display.Number(now))
        : L.Format(OrganisationWords.GoalKey(goal) + "Only", Display.Number(goal));

    private string Published => Statement.EditedAt is { } edited
        ? L.Format("Org.PublishedEdited", Display.Day(Statement.PublishedAt), Display.Day(edited))
        : L.Format("Org.Published", Display.Day(Statement.PublishedAt));
}
