@using Lt2.Api.Contracts.Parliament
@using Microsoft.JSInterop
@inherits InteractiveBase<UiText>
@implements IAsyncDisposable
@inject IParliamentApi Api
@inject IJSRuntime JS

@* The seat map of a bill's latest Seimas vote, under the figures of the "Seimas" part of the bill's page (design 8.12.1, 7.3).
   Public and the same for everyone, but it must cost nothing while the page is only read: nothing is fetched when the page
   loads. The "Seimas" radio of the switch lives in the page's markup, so js/lt2-switch.js tells this island when it is
   checked (also when it was chosen before the island started); only then is the vote read (GET /votes/{id}, public and
   cached), once per vote: an enhanced navigation to another bill keeps the island with the other bill's vote, and the map
   drawn for the old one is dropped. A failure says so and the next choosing of the radio tries again. Nothing of it is in the served HTML, and
   nothing is stored; without script the vote's own page is the way to the map. *@
@if (_ballots is { Count: > 0 } ballots)
{
    <div class="stack stack--tight" id="seimas-seats">
        <h3 class="label" id="h-seimas-seats">@L["SeatMap.Heading"]</h3>
        <SeatMap Ballots="ballots" />
    </div>
}
else if (_loading)
{
    <p class="small" id="seimas-seats-loading">@L["Loading"]</p>
}

<Messages Message="@Message" />

@code {
    private IReadOnlyList<BallotResponse>? _ballots;
    private bool _loading;
    private bool _watching;
    private DotNetObjectReference<SeimasSeatMap>? _self;

    /// <summary>The vote whose ballots are drawn: the bill's latest stage result.</summary>
    [Parameter, EditorRequired] public long VoteId { get; set; }

    /// <summary>The id of the radio whose choosing asks for the map.</summary>
    [Parameter] public string Radio { get; set; } = "view-seimas";

    /// <summary>The vote whose ballots <see cref="_ballots"/> are (or are being read), so a new one is read afresh.</summary>
    private long _shownVote;

    protected override async Task OnParametersSetAsync()
    {
        // An enhanced navigation to another bill keeps this island and gives it the other bill's vote: forget the map drawn
        // for the old one, and read the new one at once if its panel is already open (the server's patch may keep the radio).
        if (_shownVote == VoteId)
        {
            return;
        }

        var changed = _shownVote != 0;
        _shownVote = VoteId;
        _ballots = null;
        Message = null;
        if (changed && _self is not null)
        {
            await WatchAsync();
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || !RendererInfo.IsInteractive)
        {
            return;
        }

        _self = DotNetObjectReference.Create(this);
        await WatchAsync();
    }

    /// <summary>Asks js/lt2-switch.js to report the radio; it calls <see cref="Selected"/> at once when the radio is checked now.</summary>
    private async Task WatchAsync()
    {
        try
        {
            await JS.InvokeVoidAsync("lt2Switch.watch", Radio, _self);
            _watching = true;
        }
        catch (JSException)
        {
            // The script did not load: the map stays on the vote's own page, which the panel links to.
        }
    }

    /// <summary>Called by js/lt2-switch.js when the radio is checked.</summary>
    [JSInvokable]
    public async Task Selected()
    {
        if (_loading || _ballots is not null)
        {
            return;
        }

        var asked = VoteId;
        _loading = true;
        Message = null;
        await InvokeAsync(StateHasChanged);
        string? message = null;
        IReadOnlyList<BallotResponse>? ballots = null;
        try
        {
            var answer = await Api.GetVoteAsync(asked);
            if (answer.IsSuccess && answer.Value is { } vote)
            {
                ballots = vote.Ballots;
            }
            else if (asked == VoteId)
            {
                Show(answer.Problem);
            }
        }
        catch (HttpRequestException)
        {
            message = L["Error.Network"];
        }
        catch (Exception ex) when (ex is System.Text.Json.JsonException or NotSupportedException)
        {
            message = L["Error.Generic"];
        }
        finally
        {
            _loading = false;
        }

        if (asked != VoteId)
        {
            // The page moved to another bill while the answer was on its way: drop it and read the new vote if its panel is open.
            await WatchAsync();
            return;
        }

        _ballots = ballots;
        Message ??= message;
        await InvokeAsync(StateHasChanged);
    }

    public async ValueTask DisposeAsync()
    {
        if (_watching)
        {
            try
            {
                await JS.InvokeVoidAsync("lt2Switch.unwatch", Radio);
            }
            catch (Exception ex) when (ex is JSDisconnectedException or JSException or InvalidOperationException)
            {
                // The page is already gone.
            }
        }

        _self?.Dispose();
        GC.SuppressFinalize(this);
    }
}
