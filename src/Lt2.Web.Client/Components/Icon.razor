@* A small line icon beside a control's words (the action row, design 8.16.1): drawn here in currentColor, so it takes the
   control's colour in both themes; no icon library, nothing fetched. Decorative: the words beside it say what it is. The
   shape marked icon__fill fills in the brand's colour while its toggle is pressed ("Man svarbu", "Sutinku"; owner,
   2026-11-17), and what lies on it (icon__on-fill) turns light. *@
<svg class="icon" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" focusable="false">
    @switch (Name)
    {
        case "heart":
            <path class="icon__fill" d="M12 20s-7-4.4-9.2-8.6C1.2 8.3 3 5 6.2 5c2 0 3.2 1.1 3.8 2.2C10.6 6.1 11.8 5 13.8 5 17 5 18.8 8.3 17.2 11.4 15 15.6 12 20 12 20z" transform="translate(1 0)" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round" />
            break;
        case "agree":
            <circle class="icon__fill" cx="12" cy="12" r="9" fill="none" stroke="currentColor" stroke-width="2" />
            <path class="icon__on-fill" d="M7.8 12.4l2.8 2.8 5.6-5.6" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
            break;
        case "chat":
            <path d="M4 5h16v11H9l-5 4V5z" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round" />
            break;
        case "dots":
            <circle cx="5" cy="12" r="2" fill="currentColor" />
            <circle cx="12" cy="12" r="2" fill="currentColor" />
            <circle cx="19" cy="12" r="2" fill="currentColor" />
            break;
        case "down":
            <path d="M6 9.5l6 6 6-6" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
            break;
        case "info":
            <circle cx="12" cy="12" r="9.25" fill="none" stroke="currentColor" stroke-width="1.8" />
            <path d="M12 11v5.6" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
            <circle cx="12" cy="7.7" r="1.3" fill="currentColor" />
            break;
    }
</svg>

@code {
    /// <summary><c>heart</c> ("Man svarbu"), <c>agree</c> ("Sutinku"), <c>chat</c> ("Aptarimas"), <c>dots</c> (more actions), <c>down</c> (a moderator's "Kiti veiksmai"), <c>info</c> (the hint's small circled "i").</summary>
    [Parameter, EditorRequired] public string Name { get; set; } = "";
}
