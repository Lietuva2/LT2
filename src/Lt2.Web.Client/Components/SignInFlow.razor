@using FluentValidation
@inherits InteractiveBase<UiText>
@inject IAuthApi Auth
@inject IMeApi Me
@inject AuthenticationStateProvider AuthenticationState
@inject NavigationManager Navigation
@inject Passkeys PasskeyBrowser
@inject IValidator<RegisterRequest> RegisterValidator
@inject IValidator<RequestCodeRequest> CodeValidator
@inject IValidator<SignInRequest> SignInValidator
@inject IValidator<CompleteRegistrationRequest> CompletionValidator
@inject IJSRuntime JS

@* The sign-in and registration steps (design 6.2, layout of design/ui/prisijungimas.html): an email code or a passkey,
   registration with an invitation code, the code, then the display name, the age declaration and the terms of use (design 8.22.2). Used by the sign-in
   page and the front page; the controls stay disabled until WebAssembly runs, and without JavaScript the note says why. *@
<div class="stack">
    <noscript><p class="note">@L["NoScript"]</p></noscript>
    @switch (_step)
    {
        case Step.SignIn:
            <form class="sheet sheet--cut stack" action="@FormAction" @onsubmit="RequestCodeAsync" novalidate aria-labelledby="form-title">
                <h2 id="form-title">@L["SignIn.Title"]</h2>
                <p>@L["SignIn.Intro"]</p>
                <div class="field @ErrorClass("email")">
                    <label for="email">@L["Email.Label"]</label>
                    <input class="input" id="email" type="email" autocomplete="email webauthn" inputmode="email"
                           placeholder="@L["Email.Placeholder"]" @bind="_email" @bind:event="oninput" disabled="@Locked"
                           aria-invalid="@Invalid("email")" aria-describedby="@DescribedBy("email", "email")" />
                    <FieldError Errors="Errors" Field="email" For="email" />
                </div>
                <button class="btn btn--wide" type="submit" disabled="@Locked">@L["SignIn.SendCode"]</button>
                <button class="btn btn--plain btn--wide" type="button" disabled="@Locked" @onclick="SignInWithPasskeyAsync">@L["SignIn.Passkey"]</button>
                <p class="small">@L["SignIn.PasskeyHint"]</p>
                <p class="small">@L["SignIn.NoAccount"] <button type="button" class="linkish" disabled="@Locked" @onclick="() => Go(Step.Register)">@L[OfficeInvitation is null ? "SignIn.ToRegister" : "SignIn.ToRegisterByOffice"]</button></p>
                <Messages Message="@Message" Info="@Info" />
            </form>
            break;

        case Step.Register:
            <form class="sheet sheet--cut stack" action="@FormAction" @onsubmit="RegisterAsync" novalidate aria-labelledby="form-title">
                <p class="label">@L["Register.Label"]</p>
                <h2 id="form-title">@L["Register.Title"]</h2>
                <div class="field @ErrorClass("email")">
                    <label for="reg-email">@L["Email.Label"]</label>
                    <input class="input" id="reg-email" type="email" autocomplete="email" inputmode="email"
                           @bind="_email" @bind:event="oninput" disabled="@Locked"
                           aria-invalid="@Invalid("email")" aria-describedby="@DescribedBy("email", "reg-email")" />
                    <FieldError Errors="Errors" Field="email" For="reg-email" />
                </div>
                @if (OfficeInvitation is null)
                {
                <div class="field @ErrorClass("invitationCode")">
                    <label for="reg-invite">@L["Invitation.Label"]</label>
                    <input class="input num" id="reg-invite" autocomplete="off" autocapitalize="characters"
                           @bind="_invitation" @bind:event="oninput" disabled="@Locked"
                           aria-invalid="@Invalid("invitationCode")" aria-describedby="@DescribedBy("invitationCode", "reg-invite", "reg-invite-hint")" />
                    <p class="field__hint" id="reg-invite-hint">@L["Invitation.Hint"]</p>
                    <FieldError Errors="Errors" Field="invitationCode" For="reg-invite" />
                </div>
                }
                <button class="btn btn--wide" type="submit" disabled="@Locked">@L["Register.Submit"]</button>
                <p class="fine">@L["Register.Fine"]</p>
                <p class="small">@L["Register.HaveAccount"] <button type="button" class="linkish" disabled="@Locked" @onclick="() => Go(Step.SignIn)">@L["Register.ToSignIn"]</button></p>
                <Messages Message="@Message" Info="@Info" />
            </form>
            break;

        case Step.Complete:
            <form class="sheet sheet--cut stack" action="@FormAction" @onsubmit="CompleteAsync" novalidate aria-labelledby="form-title">
                <p class="label">@L["Complete.Label"]</p>
                <h2 id="form-title">@L["Complete.Title"]</h2>
                <p>@L["Complete.Confirmed.Before"] <b>@Masked</b> @L["Complete.Confirmed.After"]</p>
                <div class="field @ErrorClass("displayName")">
                    <label for="reg-name">@L["DisplayName.Label"]</label>
                    <input class="input" id="reg-name" autocomplete="nickname" placeholder="@L["DisplayName.Placeholder"]"
                           @bind="_displayName" @bind:event="oninput" disabled="@Locked"
                           aria-invalid="@Invalid("displayName")" aria-describedby="@DescribedBy("displayName", "reg-name", "reg-name-hint")" />
                    <p class="field__hint" id="reg-name-hint">@L["DisplayName.Hint"]</p>
                    <FieldError Errors="Errors" Field="displayName" For="reg-name" />
                </div>
                <div class="field @ErrorClass("confirmsAdult")">
                    <label class="check" for="reg-age">
                        <input type="checkbox" id="reg-age" @bind="_adult" disabled="@Locked"
                               aria-invalid="@Invalid("confirmsAdult")" aria-describedby="@DescribedBy("confirmsAdult", "reg-age")" />
                        <span>@L["Adult.Label"]</span>
                    </label>
                    <FieldError Errors="Errors" Field="confirmsAdult" For="reg-age" />
                </div>
                @* Design 8.22.2: the one required box for the terms of use, beside the age; the privacy notice informs and
                   has no box. Both open in a new tab, so what is typed here stays. *@
                <div class="field @ErrorClass("acceptsTerms")">
                    <label class="check" for="reg-terms">
                        <input type="checkbox" id="reg-terms" @bind="_terms" disabled="@Locked"
                               aria-invalid="@Invalid("acceptsTerms")" aria-describedby="@DescribedBy("acceptsTerms", "reg-terms")" />
                        <span>@L["Terms.Check.Before"] <a href="/taisykles" target="_blank" rel="noopener" id="reg-terms-link">@L["Terms.Check.Link"]</a></span>
                    </label>
                    <FieldError Errors="Errors" Field="acceptsTerms" For="reg-terms" />
                </div>
                <p class="small" id="reg-privacy">@L["Privacy.Sentence.Before"] <a href="/privatumas" target="_blank" rel="noopener" id="reg-privacy-link">@L["Privacy.Sentence.Link"]</a>.</p>
                @if (_askInvitation)
                {
                    <div class="field @ErrorClass("invitationCode")">
                        <label for="complete-invite">@L["Invitation.Label"]</label>
                        <input class="input num" id="complete-invite" autocomplete="off" autocapitalize="characters"
                               @bind="_invitation" @bind:event="oninput" disabled="@Locked"
                               aria-invalid="@Invalid("invitationCode")" aria-describedby="@DescribedBy("invitationCode", "complete-invite")" />
                        <FieldError Errors="Errors" Field="invitationCode" For="complete-invite" />
                    </div>
                }
                <button class="btn btn--wide" type="submit" disabled="@Locked">@L["Complete.Submit"]</button>
                <p class="small"><button type="button" class="linkish" disabled="@Locked" @onclick="SignOutAsync">@L["Complete.SignOut"]</button></p>
                <Messages Message="@Message" Info="@Info" />
            </form>
            break;

        default:
            <form class="sheet sheet--cut stack" action="@FormAction" @onsubmit="SignInAsync" novalidate aria-labelledby="form-title">
                <h2 id="form-title">@L["Code.Title"]</h2>
                <p role="status">
                    @if (_registered)
                    {
                        @L["Code.SentAfterRegister.Before"] <b>@Masked</b>@L["Code.SentAfterRegister.After"]
                    }
                    else
                    {
                        @L["Code.SentAfterRequest.Before"] <b>@Masked</b> @L["Code.SentAfterRequest.After"]
                    }
                </p>
                <div class="field @ErrorClass("code")">
                    <label for="code">@L["Code.Label"]</label>
                    <input class="input input--code num" id="code" inputmode="numeric" autocomplete="one-time-code" maxlength="6"
                           @bind="_code" @bind:event="oninput" disabled="@Locked"
                           aria-invalid="@Invalid("code")" aria-describedby="@DescribedBy("code", "code")" />
                    <FieldError Errors="Errors" Field="code" For="code" />
                </div>
                <button class="btn btn--wide" type="submit" disabled="@Locked">@L["Code.Submit"]</button>
                <p class="small">
                    @L["Code.NewestOnly"]
                    <button type="button" class="linkish" disabled="@Locked" @onclick="ResendAsync">@L["Code.Resend"]</button>
                    ·
                    <button type="button" class="linkish" disabled="@Locked" @onclick="() => Go(_registered ? Step.Register : Step.SignIn)">@L["Code.ChangeEmail"]</button>
                </p>
                <Messages Message="@Message" Info="@Info" />
            </form>
            break;
    }
</div>

@code {
    private enum Step { SignIn, Register, Code, Complete }

    private const string LandingKey = BrowserKeys.Landing;

    /// <summary>
    /// The invitation code typed at registration, kept in this tab's session storage until the registration is completed and
    /// sent again then (design 8.14.14, stage B): the server does not keep an organisation's code on a pending account, so
    /// nothing ties the address to the organisation. On another device the form asks for the code again.
    /// </summary>
    private const string CodeKey = BrowserKeys.InvitationCode;

    private Step _step = Step.SignIn;
    private bool _registered;
    private string _email = "";
    private string? _invitation;
    private string? _displayName;
    private bool _adult;
    private bool _terms;
    private bool _askInvitation;
    private string _code = "";

    [SupplyParameterFromQuery(Name = "registruotis")]
    public bool? StartWithRegistration { get; set; }

    /// <summary>
    /// The page this flow stands on when it is not the sign-in page (owner, 2026-11-17: an MP office member's invitation, design
    /// 8.5.3), whose own secret is after its "#": the flow then leaves the address alone (it reads no code or landing page from
    /// it and removes nothing), and after each step it reloads that page, so the secret stays in the address and in no storage.
    /// </summary>
    [Parameter]
    public string? ReturnTo { get; set; }

    /// <summary>
    /// An MP office member's invitation code (design 8.5.3; owner, 2026-11-17: "office link should count as invitation"): the
    /// registration asks for no invitation code and sends this one instead, at registration and again at completion, where the
    /// server checks it; nothing keeps it in the browser.
    /// </summary>
    [Parameter]
    public string? OfficeInvitation { get; set; }

    /// <summary>
    /// A member's invitation link in the old form (<c>?kodas=…</c>, design 6.2): opens the registration form with the code
    /// filled in. Links made now carry the code after the <c>#</c> (design 6.8), read in <see cref="OnAfterRenderAsync"/>.
    /// </summary>
    [SupplyParameterFromQuery(Name = InvitationLink.CodeParameter)]
    public string? InvitationFromLink { get; set; }

    /// <summary>
    /// The page a share link lands on (design 8.11.5, <c>tikslas</c>): checked by <see cref="LandingPath"/>, kept in this
    /// tab's session storage through the sign-in steps (they reload the page), and never sent to the server.
    /// </summary>
    [SupplyParameterFromQuery(Name = LandingPath.Parameter)]
    public string? Landing { get; set; }

    /// <summary>
    /// The forms' address: the page without its query. The page rendered on the server would otherwise repeat the address
    /// it was asked for in each form, an old link's invitation code included (design 6.8).
    /// </summary>
    private string FormAction => "/" + Navigation.ToBaseRelativePath(Navigation.Uri).Split('?', '#')[0];

    /// <summary>The address as shown back to the person: first letter and domain only.</summary>
    private string Masked
    {
        get
        {
            var email = _email.Trim();
            var at = email.LastIndexOf('@');
            return at <= 0 ? email : email[0] + "•••" + email[at..];
        }
    }

    /// <summary>The fields whose errors this step shows under the field itself; any other error goes into the note.</summary>
    private string[] FieldsOnThisStep => _step switch
    {
        Step.SignIn => ["email"],
        Step.Register => ["email", "invitationCode"],
        Step.Code => ["code"],
        _ => ["displayName", "confirmsAdult", "acceptsTerms", "invitationCode"],
    };

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || !RendererInfo.IsInteractive || ReturnTo is not null)
        {
            return;
        }

        // Design 6.8: the code and the landing page of a link made now are after the "#", which only the browser sees.
        // They are taken into the form and removed from the address bar, so the address can be copied without them.
        // The address is asked from the browser itself: after a link followed inside the site, this component can render
        // before the navigation manager has heard of the new address, and its Uri would still be the page left behind.
        var address = await BrowserAddressAsync();
        var code = InvitationLink.FromFragment(address, InvitationLink.CodeParameter);
        var landing = LandingPath.Accept(InvitationLink.FromFragment(address, LandingPath.Parameter)) ?? LandingPath.Accept(Landing);
        if (landing is not null)
        {
            Landing = landing;
            await StorageAsync("sessionStorage.setItem", LandingKey, landing);
        }

        if (code is not null && _step is Step.SignIn or Step.Register)
        {
            _step = Step.Register;
            _invitation = code;
        }

        if (address.Contains('#', StringComparison.Ordinal))
        {
            await RemoveFragmentAsync(address[..address.IndexOf('#', StringComparison.Ordinal)]);
        }

        if (code is not null)
        {
            StateHasChanged();
        }
    }

    protected override async Task OnInitializedAsync()
    {
        if (StartWithRegistration == true)
        {
            _step = Step.Register;
        }

        // An old link's code is in the query: taken only in the browser, so the page rendered on the server never holds it.
        if (RendererInfo.IsInteractive && !string.IsNullOrWhiteSpace(InvitationFromLink))
        {
            _step = Step.Register;
            _invitation ??= InvitationFromLink.Trim();
        }

        // Someone signed in whose account is still pending finishes the registration here; a member goes on. Visitors
        // are not asked: /api/v1/me would answer 401, which the browser logs as an error on every visit.
        var state = await AuthenticationState.GetAuthenticationStateAsync();
        if (state.User.Identity?.IsAuthenticated != true)
        {
            return;
        }

        var me = await Me.GetAsync();
        if (me.IsSuccess)
        {
            if (me.Value!.RegistrationComplete)
            {
                // On a page of its own the page itself goes on; the flow is shown only before that.
                if (ReturnTo is null)
                {
                    Navigation.NavigateTo(AfterSignIn(me.Value, LandingPath.Accept(Landing) ?? "/paskyra"), forceLoad: true);
                }

                return;
            }

            _email = me.Value.Email;
            _step = Step.Complete;
        }
    }

    /// <summary>
    /// Design 8.22.2: a member who has not accepted the terms in force sees the acceptance screen first, which then goes on to
    /// <paramref name="next"/>; everyone else goes to <paramref name="next"/> directly.
    /// </summary>
    private static string AfterSignIn(MeResponse? me, string next) =>
        me is { RegistrationComplete: true, TermsRequired: true } ? TermsText.AcceptanceLink(next.Split('#')[0]) : next;

    /// <summary>
    /// Goes to <paramref name="next"/> with a full load; on the page of <see cref="ReturnTo"/> it reloads that page instead, as a
    /// navigation to the same address with only its "#" part would not load anything.
    /// </summary>
    private async Task GoAsync(string next)
    {
        if (ReturnTo is not null && string.Equals(next, ReturnTo, StringComparison.Ordinal))
        {
            await JS.InvokeVoidAsync("location.reload");
            return;
        }

        Navigation.NavigateTo(next, forceLoad: true);
    }

    /// <summary>Where a member goes once signed in: the share link's page if one waits in this tab, otherwise the account.</summary>
    private async Task<string> NextPageAsync()
    {
        var stored = await StorageAsync("sessionStorage.getItem", LandingKey);
        await StorageAsync("sessionStorage.removeItem", LandingKey);
        return LandingPath.Accept(stored) ?? LandingPath.Accept(Landing) ?? "/paskyra";
    }

    /// <summary>Session storage may be blocked (private windows, settings): then the share link simply lands on the account.</summary>
    private async Task<string?> StorageAsync(string function, params object[] arguments)
    {
        try
        {
            return function.EndsWith("getItem", StringComparison.Ordinal)
                ? await JS.InvokeAsync<string?>(function, arguments)
                : await JS.InvokeAsync<object?>(function, arguments) as string;
        }
#pragma warning disable CA1031 // Storage is a convenience: whatever fails, the person lands on the account page.
        catch (Exception)
#pragma warning restore CA1031
        {
            return null;
        }
    }

    /// <summary>The address the browser shows, with its "#" part; the navigation manager's when the browser cannot be asked.</summary>
    private async Task<string> BrowserAddressAsync()
    {
        try
        {
            return await JS.InvokeAsync<string?>("location.toString") ?? Navigation.Uri;
        }
        catch (JSException)
        {
            return Navigation.Uri;
        }
    }

    /// <summary>The address without its "#" part, in place (no reload); a browser that refuses keeps it, which is harmless.</summary>
    private async Task RemoveFragmentAsync(string address)
    {
        try
        {
            await JS.InvokeVoidAsync("history.replaceState", null, "", address);
        }
        catch (JSException)
        {
            // Nothing to do: the code is never sent anyway.
        }
    }

    private void Go(Step step)
    {
        _step = step;
        _code = "";
        ClearMessages();
    }

    private Task RequestCodeAsync()
    {
        var request = new RequestCodeRequest { Email = _email.Trim() };
        ClearMessages();
        return !Valid(CodeValidator.Validate(request)) ? Task.CompletedTask : RunAsync(async () =>
        {
            if (Succeeded(await Auth.RequestCodeAsync(request), FieldsOnThisStep))
            {
                _registered = false;
                _step = Step.Code;
            }
        });
    }

    private Task RegisterAsync()
    {
        var request = new RegisterRequest
        {
            Email = _email.Trim(),
            InvitationCode = OfficeInvitation is null && !string.IsNullOrWhiteSpace(_invitation) ? _invitation.Trim() : null,
            OfficeInvitation = OfficeInvitation,
        };
        ClearMessages();
        return !Valid(RegisterValidator.Validate(request)) ? Task.CompletedTask : RunAsync(async () =>
        {
            if (Succeeded(await Auth.RegisterAsync(request), FieldsOnThisStep))
            {
                if (request.InvitationCode is { } code)
                {
                    await StorageAsync("sessionStorage.setItem", CodeKey, code);
                }

                _registered = true;
                _step = Step.Code;
            }
        });
    }

    private Task SignInAsync()
    {
        var request = new SignInRequest { Email = _email.Trim(), Code = _code.Trim() };
        ClearMessages();
        return !Valid(SignInValidator.Validate(request)) ? Task.CompletedTask : RunAsync(async () =>
        {
            if (Succeeded(await Auth.SignInAsync(request), FieldsOnThisStep))
            {
                // A new account still finishes its registration first (via /paskyra); the share link's page waits until then.
                var me = await Me.GetAsync();
                await GoAsync(me.Value?.RegistrationComplete == true ? AfterSignIn(me.Value, ReturnTo ?? await NextPageAsync()) : ReturnTo ?? "/paskyra");
            }
        });
    }

    private async Task CompleteAsync()
    {
        // The code typed in the form when it was asked for again; otherwise the one this tab kept since registering.
        var kept = _askInvitation ? null : await StorageAsync("sessionStorage.getItem", CodeKey);
        var request = new CompleteRegistrationRequest
        {
            DisplayName = string.IsNullOrWhiteSpace(_displayName) ? null : _displayName.Trim(),
            ConfirmsAdult = _adult,
            AcceptsTerms = _terms,
            InvitationCode = _askInvitation && !string.IsNullOrWhiteSpace(_invitation) ? _invitation.Trim() : string.IsNullOrWhiteSpace(kept) ? null : kept.Trim(),
            OfficeInvitation = _askInvitation ? null : OfficeInvitation,
        };
        ClearMessages();
        if (!Valid(CompletionValidator.Validate(request)))
        {
            return;
        }

        await RunAsync(async () =>
        {
            if (Succeeded(await Me.CompleteRegistrationAsync(request), FieldsOnThisStep))
            {
                await StorageAsync("sessionStorage.removeItem", CodeKey);
                await GoAsync(ReturnTo ?? await NextPageAsync());
                return;
            }

            // The invitation held has run out or is no longer valid: ask for another in the same form (design 6.2).
            if (Errors.ContainsKey("invitationCode"))
            {
                _askInvitation = true;
            }
        });
    }

    private Task SignOutAsync() => RunAsync(async () =>
    {
        if (Succeeded(await Auth.SignOutAsync()))
        {
            Navigation.NavigateTo("/", forceLoad: true);
        }
    });

    private Task ResendAsync() => RunAsync(async () =>
    {
        if (Succeeded(await Auth.RequestCodeAsync(new RequestCodeRequest { Email = _email.Trim() }), FieldsOnThisStep))
        {
            Info = L["Code.Resent"];
        }
    });

    private Task SignInWithPasskeyAsync() => RunAsync(async () =>
    {
        if (!await PasskeyBrowser.IsSupportedAsync())
        {
            Message = L["Passkey.Unsupported"];
            return;
        }

        var options = await Auth.GetPasskeyRequestOptionsAsync();
        if (!Succeeded(options, FieldsOnThisStep))
        {
            return;
        }

        var credential = await PasskeyBrowser.GetAsync(options.Value!);
        if (credential is null)
        {
            Message = L["Passkey.Cancelled"];
            return;
        }

        if (Succeeded(await Auth.SignInWithPasskeyAsync(new PasskeyCredentialRequest { Credential = credential }), FieldsOnThisStep))
        {
            await GoAsync(AfterSignIn((await Me.GetAsync()).Value, ReturnTo ?? await NextPageAsync()));
        }
    });
}
