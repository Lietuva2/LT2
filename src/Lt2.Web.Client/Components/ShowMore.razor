@inject IStringLocalizer<UiText> T

@* "Rodyti daugiau" under a long list (owner, 2026-11-19: every "show more" looks and works the same): one line under the list,
   "Rodoma N iš M" where the total is known, then the link, a plain text link (owner, 2026-11-19: not a button's look, which
   clashed with the buttons under a list, such as "Parašyti argumentą"). It is always a link (<a>) whose address is the same page with the list
   grown, so it works without JavaScript. Enhanced navigation keeps the viewport during the update. When an island
   handles OnMore, it fetches and appends the next page on its own. It focuses the first item added without scrolling.
   The browser and enhanced navigation leave the click to the island once it runs. Further links of the list (an older page)
   go in ChildContent, after it. *@
<div class="row show-more" id="@(Id + "-line")" aria-busy="@(_busy ? "true" : null)">
    @if (Total is { } total)
    {
        <p class="small num" role="status" id="@(StatusId ?? Id + "-shown")">@T.Format("List.Shown", Display.Number(Shown), Display.Number(total))</p>
    }
    @if (Href is { } href)
    {
        @if (OnMore.HasDelegate && RendererInfo.IsInteractive)
        {
            <a class="show-more__link" href="@href" id="@Id" data-enhance-nav="false" aria-controls="@Controls"
               @onclick="MoreAsync" @onclick:preventDefault="true">@(Text ?? T["Text.ShowMore"])</a>
        }
        else
        {
            <a class="show-more__link" href="@href" id="@Id">@(Text ?? T["Text.ShowMore"])</a>
        }
    }
    @ChildContent
</div>

@code {
    private bool _busy;

    /// <summary>The link's id; the line is <c>{Id}-line</c>, the status <c>{Id}-shown</c> unless <see cref="StatusId"/> names it.</summary>
    [Parameter, EditorRequired] public string Id { get; set; } = "";

    /// <summary>The same page with the list grown; null when every row is shown (no link).</summary>
    [Parameter] public string? Href { get; set; }

    /// <summary>How many rows the list shows now, for "Rodoma N iš M".</summary>
    [Parameter] public int Shown { get; set; }

    /// <summary>How many rows the list has in all; null when not known (no status line).</summary>
    [Parameter] public int? Total { get; set; }

    /// <summary>The status line's id, where a page has long had its own.</summary>
    [Parameter] public string? StatusId { get; set; }

    /// <summary>The link's words: "Rodyti daugiau", or a list's own where one long text's "Rodyti daugiau" stands among its rows.</summary>
    [Parameter] public string? Text { get; set; }

    /// <summary>The list the link grows, for assistive technology.</summary>
    [Parameter] public string? Controls { get; set; }

    /// <summary>An island's own fetch of the next page; without it the link is followed.</summary>
    [Parameter] public EventCallback OnMore { get; set; }

    [Parameter] public RenderFragment? ChildContent { get; set; }

    private async Task MoreAsync()
    {
        // One page at a time: a second press while the first page is on its way adds nothing.
        if (_busy)
        {
            return;
        }

        _busy = true;
        try
        {
            await OnMore.InvokeAsync();
        }
        finally
        {
            _busy = false;
        }
    }
}
