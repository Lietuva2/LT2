@inject IStringLocalizer<UiText> T

@* Design 8.21: the three tabs of "Projektai" as a row of plain links under the page's heading on the three pages, the current
   one marked; on the ground (design 8.16), no script. Each tab reaches the other two. *@
<nav class="row tabs project-tabs" aria-label="@T["Tabs.Label"]" id="project-tabs">
    @foreach (var (tab, path, key) in MenuSections.Tabs)
    {
        <a href="@path" id="@("tab-" + path.TrimStart('/').Replace('/', '-'))" aria-current="@(tab == Current ? "page" : null)">@T[key]</a>
    }
</nav>

@code {
    /// <summary>The page the row stands on.</summary>
    [Parameter, EditorRequired] public ProjectTab Current { get; set; }
}
