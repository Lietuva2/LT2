@inject IStringLocalizer<UiText> T

@* Design 8.21: the four tabs of "Projektai" ("Darbotvarkė", "Projektai", "Balsavimai", "Suvestinės") as a row of plain links
   under the page's heading on the four pages, the current one marked; on the ground (design 8.16), no script. Each tab
   reaches the other three. *@
<nav class="row tabs project-tabs" aria-label="@T["Tabs.Label"]" id="project-tabs">
    @foreach (var item in MenuSections.Tabs)
    {
        <a href="@item.Path" id="@item.Slug" aria-current="@(item.Tab == Current ? "page" : null)">@T[item.NameKey]</a>
    }
</nav>

@code {
    /// <summary>The page the row stands on.</summary>
    [Parameter, EditorRequired] public ProjectTab Current { get; set; }
}
