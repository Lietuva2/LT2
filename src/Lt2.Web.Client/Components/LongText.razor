@inject IStringLocalizer<UiText> T

@* A member's text in its bubble (design 8.2, owner 2026-11-16): an argument, an organisation's statement, an MP's response, a
   comment. Its paragraphs and lists come from TextLayout (design 8.2, "A text's layout", owner 2026-11-17), laid out on the
   whole text before it is cut, so a list cut by "Rodyti daugiau" stays a list on both sides. A long one shows its beginning
   (TextExcerpt: about 300 characters for an argument, 1 500 for a statement or a response) and the rest behind "Rodyti
   daugiau", the browser's own <details class="more"> (design 8.15), so it opens and closes without JavaScript, on
   server-rendered pages and in an island before it starts; nothing here sets "open". The summary stays in the page and
   focusable: closed it reads "Rodyti daugiau" under the beginning; opened, the "…" steps aside, the rest follows the beginning
   and the summary, now "Rodyti mažiau", is drawn after it (flex order, lt2.css). Both texts come from the resources; the one
   not in force is display: none, so assistive technology does not read it either. With an id, js/lt2-disclosures.js gives the
   island's replacement the state the person chose. The moderators' queue shows texts whole (TypedText) and does not use this. *@
@if (_parts.Rest is { } rest)
{
    <div class="@BubbleClass long-text">
        <TypedText Blocks="_parts.Shown" Links="Links" Cut="true" />
        <details class="more stack stack--tight long-text__more" id="@Id">
            <summary class="linkish small"><span class="long-text__closed">@T["Text.ShowMore"]</span><span class="long-text__opened">@T["Text.ShowLess"]</span></summary>
            <TypedText Blocks="rest" Links="Links" />
        </details>
    </div>
}
else if (_parts.Shown.Count == 0)
{
    <p class="@BubbleClass"></p>
}
else
{
    <TypedText Blocks="_parts.Shown" Links="Links" Class="@BubbleClass" />
}

@code {
    /// <summary>The text as stored (plain text, encoded on output).</summary>
    [Parameter, EditorRequired] public string Text { get; set; } = "";

    /// <summary>The bubble's classes, for example <c>bubble bubble--people voice</c>.</summary>
    [Parameter, EditorRequired] public string BubbleClass { get; set; } = "";

    /// <summary>About how many characters are shown at first (<see cref="TextExcerpt.ArgumentShown"/> by default).</summary>
    [Parameter] public int Shown { get; set; } = TextExcerpt.ArgumentShown;

    /// <summary>A text at most this much longer than <see cref="Shown"/> is shown whole.</summary>
    [Parameter] public int Margin { get; set; } = TextExcerpt.ArgumentMargin;

    /// <summary>
    /// The disclosure's id, unique on the page (a text shown twice takes a different prefix), so an opened one stays open
    /// when an island replaces the prerendered markup; none is needed on a page without an island.
    /// </summary>
    [Parameter] public string? Id { get; set; }

    /// <summary>
    /// A comment's <c>https://</c> addresses become links (design 8.23.3): the address shown as typed (shortened after its host),
    /// <c>rel="nofollow ugc noopener noreferrer"</c>, a new tab. Everything else stays text, encoded on output.
    /// </summary>
    [Parameter] public bool Links { get; set; }

    private TextLayoutParts _parts = new([], null);

    protected override void OnParametersSet() => _parts = TextLayout.Of(Text, Shown, Margin);
}
