@using Lt2.Api.Contracts.Appeals
@inherits InteractiveBase<AppealUi>
@inject IModerationApi Moderation
@inject FluentValidation.IValidator<ModeratorDescriptionRequest> DescriptionValidator

@* The actions on one item (design 8.3, 8.12.3). Each action is its own control; choosing one opens only its own fields,
   with one sentence on what it does. Only the actions that apply to the item's state are offered, one is open at a time,
   and the confirmation stays visible after the action closes. An action that finishes the item (publish, keep, hide,
   merge) leaves the confirmation in place of the controls. On a bill without a record (Id null) the first action creates
   it (design 8.12.1). "Rašyti aprašymą" works on any active bill and offers the AI draft from pasted official text only
   when a provider is configured (8.11.4); without one nothing here mentions a draft. A bill's description can also be
   confirmed (only an AI summary nobody has read) or removed (design 8.13). Every element id carries IdPrefix, so the same
   item's actions in the panel and in the list beside it never share an id. *@
<div class="stack stack--tight" id="actions-@Key">
    @if (!_finished)
    {
        @if (_open is null)
        {
            <div class="actions" role="group" aria-label="@L["Mod.Actions"]">
                @foreach (var action in Offered)
                {
                    <button type="button" class="@(action == Offered[0] ? "btn" : "btn btn--plain")" id="action-@action-@Key" disabled="@Locked" @onclick="() => OpenAsync(action)">@L[ActionLabel(action)]</button>
                }
            </div>
        }
        else if (_open == "restrict" && Id is { } reasonId)
        {
            <RestrictAuthor Id="reasonId" IdPrefix="@IdPrefix" OnCancel="Close" OnDone="RestrictedAsync" />
        }
        else
        {
            <form class="sheet stack stack--tight" @onsubmit="SubmitAsync" novalidate aria-labelledby="action-title-@Key" id="action-form-@Key">
                <h4 id="action-title-@Key">@L[ActionLabel(_open)]</h4>
                <p class="small" id="action-sentence-@Key">@L["Mod.Sentence." + SentenceKind + "." + _open]</p>

                @if (_open == "describe")
                {
                    @if (_ai is { DraftAvailable: true })
                    {
                        <div class="field @ErrorClass("sourceText")">
                            <label for="describe-source-@Key">@L["ModOpen.Source"]</label>
                            <p class="field__hint" id="describe-source-hint-@Key">
                                @L["ModOpen.SourceHint"]
                                @if (ESeimasUrl is { } link)
                                {
                                    @(" ")<a href="@link" rel="external">@L["ModOpen.ESeimas"]</a>
                                }
                            </p>
                            @* No maxlength: the browser would cut a long paste silently; the length is checked and said instead. *@
                            <textarea class="textarea" id="describe-source-@Key" aria-describedby="@DescribedBy("sourceText", $"describe-source-{Key}", $"describe-source-hint-{Key}")"
                                      aria-invalid="@Invalid("sourceText")" @bind="_source" @bind:event="oninput" disabled="@Locked"></textarea>
                            <p class="small num @(_source.Length > AppealLimits.DraftSourceMaxLength ? "field__error" : "")">@L.Format("ModOpen.SourceLength", Display.Number(_source.Length), Display.Number(AppealLimits.DraftSourceMaxLength))</p>
                            <FieldError Errors="Errors" Field="sourceText" For="@($"describe-source-{Key}")" />
                        </div>
                        <p><button type="button" class="btn btn--plain" id="describe-draft-@Key" disabled="@(Locked || string.IsNullOrWhiteSpace(_source))" @onclick="DraftAsync">@L["ModOpen.Draft"]</button></p>
                    }
                    <div class="field @ErrorClass("description")">
                        <label for="describe-@Key">@L["Mod.Description"]</label>
                        <p class="field__hint" id="describe-hint-@Key">
                            @L["Mod.DescriptionHint"]
                            @if (_fromDraft)
                            {
                                @(" ")<span class="tag" id="describe-from-draft-@Key">@L["ModOpen.FromDraft"]</span>
                            }
                        </p>
                        <textarea class="textarea" id="describe-@Key" rows="10" maxlength="@AppealLimits.DescriptionMaxLength" aria-describedby="@DescribedBy("description", $"describe-{Key}", $"describe-hint-{Key}")"
                                  aria-invalid="@Invalid("description")" @bind="_description" @bind:event="oninput" disabled="@Locked"></textarea>
                        <FieldError Errors="Errors" Field="description" For="@($"describe-{Key}")" />
                    </div>
                    @* Design 8.13 (decided 2026-11-14): filled in advance with the record's address, so leaving it keeps it;
                       empty clears it. The same rule here and on the server (OfficialTextAddress). *@
                    <div class="field @ErrorClass("descriptionUrl")">
                        <label for="describe-url-@Key">@L["Mod.DescriptionUrl"]</label>
                        <p class="field__hint" id="describe-url-hint-@Key">@L["Mod.DescriptionUrlHint"]</p>
                        <input class="input" type="url" inputmode="url" autocomplete="off" spellcheck="false" id="describe-url-@Key"
                               aria-describedby="@DescribedBy("descriptionUrl", $"describe-url-{Key}", $"describe-url-hint-{Key}")" aria-invalid="@Invalid("descriptionUrl")"
                               maxlength="@AppealLimits.DescriptionUrlMaxLength" @bind="_descriptionUrl" @bind:event="oninput" disabled="@Locked" />
                        <FieldError Errors="Errors" Field="descriptionUrl" For="@($"describe-url-{Key}")" />
                    </div>
                }
                @if (_open == "threshold")
                {
                    <div class="field @ErrorClass("threshold")">
                        <label for="threshold-@Key">@L["Mod.Threshold"]</label>
                        <input class="input num" type="number" inputmode="numeric" id="threshold-@Key" min="1" step="1" @bind="_threshold" disabled="@Locked"
                               aria-invalid="@Invalid("threshold")" aria-describedby="@DescribedBy("threshold", $"threshold-{Key}")" />
                        <FieldError Errors="Errors" Field="threshold" For="@($"threshold-{Key}")" />
                    </div>
                }
                @if (_open == "planned")
                {
                    <div class="pair">
                        <div class="field @ErrorClass("date")">
                            <label for="planned-@Key">@L["Mod.PlannedDate"]</label>
                            <p class="field__hint" id="planned-hint-@Key">@L.Format("Date.Hint", Display.DateExample)</p>
                            <input class="input num" type="text" inputmode="numeric" autocomplete="off" pattern="@Display.DatePattern" placeholder="@Display.DateExample"
                                   id="planned-@Key" aria-describedby="@DescribedBy("date", $"planned-{Key}", $"planned-hint-{Key}")" aria-invalid="@Invalid("date")" @bind="_planned" disabled="@Locked" />
                            <FieldError Errors="Errors" Field="date" For="@($"planned-{Key}")" />
                        </div>
                        <div class="field">
                            <label for="stage-@Key">@L["Mod.PlannedStage"]</label>
                            <select class="input" id="stage-@Key" @bind="_stage" disabled="@Locked">
                                <option value="presentation">@L["Mod.Stage.presentation"]</option>
                                <option value="consideration">@L["Mod.Stage.consideration"]</option>
                                <option value="adoption">@L["Mod.Stage.adoption"]</option>
                            </select>
                        </div>
                    </div>
                }
                @if (_open == "merge" && MergeCandidates is { Count: > 0 })
                {
                    <fieldset class="stack stack--tight @ErrorClass("into")">
                        <legend class="label">@L["Mod.MergeInto"]</legend>
                        @foreach (var candidate in MergeCandidates)
                        {
                            <label class="check">
                                <input type="radio" name="merge-@Key" value="@candidate.Id" checked="@(_mergeInto == candidate.Id)" @onchange="() => _mergeInto = candidate.Id" disabled="@Locked" />
                                <span>@candidate.Text <span class="small num">(@Display.Number(candidate.Endorsements))</span></span>
                            </label>
                        }
                        <FieldError Errors="Errors" Field="into" For="@($"merge-{Key}")" />
                    </fieldset>
                }

                <div class="field @ErrorClass("statement")">
                    <label for="statement-@Key">@L[StatementLabel(_open)]</label>
                    <textarea class="textarea" id="statement-@Key" maxlength="@AppealLimits.StatementMaxLength" @bind="_statement" @bind:event="oninput" disabled="@Locked"
                              aria-invalid="@Invalid("statement")" aria-describedby="@DescribedBy("statement", $"statement-{Key}")"></textarea>
                    <FieldError Errors="Errors" Field="statement" For="@($"statement-{Key}")" />
                </div>
                <div class="row">
                    <button type="submit" class="btn" id="action-submit-@Key" disabled="@Locked">@L[ActionLabel(_open)]</button>
                    <button type="button" class="btn btn--plain" disabled="@Locked" @onclick="Close">@L["Cancel"]</button>
                </div>
            </form>
        }
    }
    @* Outside the form, so the confirmation stays after it closes. *@
    <Messages Message="@Message" Info="@(Info ?? _done)" />
</div>

@code {
    private string? _open;
    private string? _done;
    private bool _finished;
    private bool? _held;
    private string _statement = "";
    private int? _threshold;
    private Guid? _mergeInto;
    private string? _planned;
    private string _stage = "consideration";
    private string _description = "";
    private string? _descriptionUrl;
    private string? _descriptionNow;
    private string? _sourceNow;
    private string? _urlNow;
    private string _source = "";
    private bool _fromDraft;
    private AiStatusResponse? _ai;
    private Guid? _record;

    /// <summary>The argument, or the bill's record; null for a bill without a record (an action creates it).</summary>
    [Parameter] public Guid? Id { get; set; }

    /// <summary>For a bill: its number, which the description and a new record go by.</summary>
    [Parameter] public string? Number { get; set; }

    /// <summary><c>record</c> (a bill's record) or <c>reason</c>.</summary>
    [Parameter, EditorRequired] public string Kind { get; set; } = "";

    /// <summary>The kind as the resource keys name it: their keys for a record still say <c>appeal</c> (kept on purpose).</summary>
    private string SentenceKind => Kind == "record" ? "appeal" : Kind;

    [Parameter] public string Status { get; set; } = "";

    [Parameter] public IReadOnlyList<ReasonResponse>? MergeCandidates { get; set; }

    /// <summary>For a bill: its sending is held.</summary>
    [Parameter] public bool Held { get; set; }

    /// <summary>For a bill: the threshold that applies now, the starting value of a change.</summary>
    [Parameter] public int? Threshold { get; set; }

    /// <summary>For a bill: the planned date the page shows now, the starting value of a correction.</summary>
    [Parameter] public PlannedDateResponse? Planned { get; set; }

    /// <summary>For a bill: its description now (empty when it has none), the starting text of "Rašyti aprašymą".</summary>
    [Parameter] public string? Description { get; set; }

    /// <summary>For a bill: who made its description (<c>ai</c>: an AI summary nobody has read, which can be confirmed).</summary>
    [Parameter] public string? DescriptionSource { get; set; }

    /// <summary>For a bill: the official text's address its description carries, the starting value of the address field.</summary>
    [Parameter] public string? DescriptionUrl { get; set; }

    /// <summary>For a bill: its text on e-seimas, beside the field for pasted official text.</summary>
    [Parameter] public string? ESeimasUrl { get; set; }

    /// <summary>The item has open reports or date flags, so "keep" means something.</summary>
    [Parameter] public bool HasOpenItems { get; set; }

    /// <summary>The start of every element id here (<c>panel-</c> in the panel on the bill's page), so ids stay unique.</summary>
    [Parameter] public string IdPrefix { get; set; } = "";

    /// <summary>After an action: the item's queue may change (the page decides whether to reload).</summary>
    [Parameter] public EventCallback<string> OnDone { get; set; }

    /// <summary>After a restriction: the page reloads its list of restrictions.</summary>
    [Parameter] public EventCallback OnRestricted { get; set; }

    private bool IsHeld => _held ?? Held;

    /// <summary>Element ids: the prefix and the item's id, or the bill's number while it has no record.</summary>
    private string Key => IdPrefix + (Id?.ToString() ?? Number ?? "new");

    /// <summary>The actions that apply to the item's state, the main one first (design 8.3, 8.12.3).</summary>
    private IReadOnlyList<string> Offered => (Kind, Status) switch
    {
        ("record", "open") => [.. (HasOpenItems ? new[] { "keep" } : []), .. DescriptionActions, "threshold", "planned", IsHeld ? "release" : "hold", .. (IsHeld ? Array.Empty<string>() : ["urgent"]), "hide"],
        ("reason", "pending") => ["publish", "hide", .. (MergeCandidates is { Count: > 0 } ? new[] { "merge" } : []), "restrict"],
        ("reason", _) => ["keep", "hide", .. (MergeCandidates is { Count: > 0 } ? new[] { "merge" } : []), "restrict"],
        _ => [],
    };

    /// <summary>
    /// The description's actions on a bill (design 8.13), by its number: confirm an AI summary nobody has read, write or
    /// correct, and remove one that exists.
    /// </summary>
    private string[] DescriptionActions => Number is null
        ? []
        : [.. (CurrentSource == "ai" ? new[] { "confirm" } : []), "describe", .. (string.IsNullOrEmpty(CurrentDescription) ? Array.Empty<string>() : ["undescribe"])];

    /// <summary>The description as it is after this control's own actions (the queue does not reload).</summary>
    private string? CurrentDescription => _descriptionNow ?? Description;

    private string? CurrentSource => _descriptionNow is null ? DescriptionSource : _sourceNow;

    private string? CurrentUrl => _descriptionNow is null ? DescriptionUrl : _urlNow;

    /// <summary>"Rašyti aprašymą" for a bill without one, "Taisyti aprašymą" for one that has it.</summary>
    private string ActionLabel(string action) =>
        action == "describe" ? (string.IsNullOrEmpty(CurrentDescription) ? "Mod.Action.write" : "Mod.Action.describe") : "Mod.Action." + action;

    /// <summary>A note is optional when publishing or keeping, a statement required for everything else.</summary>
    private static string StatementLabel(string action) => action switch
    {
        "publish" or "keep" => "Mod.Note.Optional",
        "confirm" => "Mod.Note.Record",
        _ => "Mod.Statement.Required",
    };

    /// <summary>Actions after which the item has left the queue for good.</summary>
    private static bool Finishes(string action) => action is "publish" or "keep" or "hide" or "merge";

    /// <summary>Opens one action's fields; "describe" first asks whether the AI draft is available, with the controls locked.</summary>
    private Task OpenAsync(string action) => RunAsync(async () =>
    {
        _open = action;
        _statement = "";
        _done = null;
        _threshold = Threshold;
        _planned = Planned is { } p ? Display.Day(p.Date) : null;
        _stage = Planned?.Stage ?? "consideration";
        _mergeInto = null;
        _description = CurrentDescription ?? "";
        _descriptionUrl = CurrentUrl;
        _source = "";
        _fromDraft = false;
        if (action == "describe" && _ai is null)
        {
            // Without an answer the form works as without a provider: nothing mentions a draft.
            _ai = (await Moderation.GetAiAsync()).Value;
        }
    });

    private void Close() => _open = null;

    private async Task RestrictedAsync()
    {
        _open = null;
        _done = L["Restrict.Done"];
        await OnRestricted.InvokeAsync();
    }

    private Task DraftAsync() => RunAsync(async () =>
    {
        var result = await Moderation.DraftDescriptionAsync(Number!, new DescriptionDraftRequest { SourceText = _source });
        if (!Succeeded(result, "sourceText"))
        {
            return;
        }

        // The draft fills the description; the moderator edits it. The label stays for the description's whole life.
        _description = result.Value!.Draft;
        _fromDraft = true;
        Info = L["ModOpen.DraftReady"];
    });

    private Task SubmitAsync() => RunAsync(async () =>
    {
        var action = _open!;
        if (!Checked(action))
        {
            return;
        }

        if (!Succeeded(await SendAsync(action), "statement", "threshold", "date", "stage", "description", "descriptionUrl"))
        {
            return;
        }

        if (action is "hold" or "release")
        {
            _held = action == "hold";
        }

        // The description's state after the action, as the server made it (design 8.13).
        (_descriptionNow, _sourceNow, _urlNow) = action switch
        {
            "confirm" => (CurrentDescription, "ai-draft", CurrentUrl),
            "undescribe" => ("", null, null),
            "describe" => (_description.Trim(), _fromDraft || CurrentSource is "ai" or "ai-draft" ? "ai-draft" : "moderator", OfficialTextAddress.Normalise(_descriptionUrl)),
            _ => (_descriptionNow, _sourceNow, _urlNow),
        };
        _open = null;
        _finished = Finishes(action);
        _done = L["Mod.Done." + action];
        await OnDone.InvokeAsync(_done);
    });

    /// <summary>What the form can tell before sending: a typed date in the form yyyy-MM-dd, a chosen merge target.</summary>
    private bool Checked(string action)
    {
        if (action == "planned" && !Display.TryReadDate(_planned, out _))
        {
            FieldFails("date", L.Format("Date.Invalid", Display.DateExample));
            return false;
        }

        if (action == "merge" && _mergeInto is null)
        {
            FieldFails("into", L["Mod.MergeChoose"]);
            return false;
        }

        // The description, the statement and the official text's address: the same validator the server applies.
        return action != "describe" || Valid(DescriptionValidator.Validate(DescribeRequest()));
    }

    private ModeratorDescriptionRequest DescribeRequest() =>
        new() { Description = _description, Statement = _statement, FromDraft = _fromDraft, DescriptionUrl = OfficialTextAddress.Normalise(_descriptionUrl) };

    private async Task<ApiResult> SendAsync(string action)
    {
        var statement = new StatementRequest { Statement = _statement };
        var note = new ModerationRequest { Statement = string.IsNullOrWhiteSpace(_statement) ? null : _statement };
        if (Kind == "reason")
        {
            var reasonId = Id!.Value;
            return action switch
            {
                "publish" or "keep" => await Moderation.PublishReasonAsync(reasonId, note),
                "hide" => await Moderation.HideReasonAsync(reasonId, statement),
                "merge" => await Moderation.MergeReasonAsync(reasonId, new MergeReasonRequest { IntoReasonId = _mergeInto!.Value, Statement = _statement }),
                _ => throw new InvalidOperationException($"No action {action} for a reason."),
            };
        }

        switch (action)
        {
            case "describe":
                return await Moderation.WriteDescriptionAsync(Number!, DescribeRequest());
            case "confirm":
                return await Moderation.ConfirmDescriptionAsync(Number!, note);
            case "undescribe":
                return await Moderation.RemoveDescriptionAsync(Number!, statement);
        }

        // An action on a bill without a record creates it first (design 8.12.1).
        var id = Id ?? _record;
        if (id is null)
        {
            var record = await Moderation.EnsureRecordAsync(Number!);
            if (!record.IsSuccess)
            {
                return ApiResult.Fail(record.Problem!);
            }

            id = _record = record.Value!.Id;
        }

        return action switch
        {
            "keep" => await Moderation.KeepRecordAsync(id.Value, note),
            "hide" => await Moderation.HideRecordAsync(id.Value, statement),
            "threshold" => await Moderation.SetThresholdAsync(id.Value, new ModeratorThresholdRequest { Threshold = _threshold ?? 0, Statement = _statement }),
            "planned" => await Moderation.SetPlannedAsync(id.Value, new ModeratorPlannedRequest { Date = Display.TryReadDate(_planned, out var day) ? day : default, Stage = _stage, Statement = _statement }),
            "hold" => await Moderation.HoldAsync(id.Value, statement),
            "release" => await Moderation.ReleaseAsync(id.Value, statement),
            "urgent" => await Moderation.UrgentAsync(id.Value, new Lt2.Api.Contracts.Digests.UrgentDigestRequest { Statement = _statement }),
            _ => throw new InvalidOperationException($"No action {action} for a bill."),
        };
    }
}
