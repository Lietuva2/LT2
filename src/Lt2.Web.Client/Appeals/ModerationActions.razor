@using Lt2.Api.Contracts.Admin
@using Lt2.Api.Contracts.Appeals
@using Lt2.Api.Contracts.Parliament
@inherits InteractiveBase<AppealUi>
@inject IModerationApi Moderation
@inject FluentValidation.IValidator<ModeratorDescriptionRequest> DescriptionValidator
@inject FluentValidation.IValidator<CloseRecordRequest> CloseValidator
@inject IAuthApi Auth
@inject IMeApi MeApi
@inject Passkeys PasskeyBrowser
@inject MyAccountState Account

@* The actions on one item (design 8.3, 8.12.3). Owner, 2026-11-17: one filled button for what the item needs most in its
   state ("Palikti" while a report or a date flag is open, "Patvirtinti aprašymą" while an AI summary nobody has read is
   shown, "Skelbti" for a waiting argument; otherwise none) and the rest in "Kiti veiksmai" (ModerationMenu), a bill's under
   "Aprašymas", "Seime" and "Suvestinės", "Paslėpti" set apart at the end. Choosing one opens only its own fields, with one
   sentence on what it does, and the focus moves into them. Only the actions that apply to the item's state are offered,
   one is open at a time, and the confirmation stays visible after the action closes. An action that finishes the item (publish, keep, hide,
   merge) leaves the confirmation in place of the controls. On a bill without a record (Id null) the first action creates
   it (design 8.12.1). "Rašyti aprašymą" works on any bill, a finished one too (owner, 2026-11-26), and offers the AI draft from pasted official text only
   when a provider is configured (8.11.4); without one nothing here mentions a draft. A bill's description can also be
   confirmed (only an AI summary nobody has read) or removed (design 8.13). Under "Seime" an open record also offers
   "Uždaryti: projektas atmestas ar atsiimtas" (the reason, the day, the lrs.lt source) and a record a moderator closed
   "Atšaukti uždarymą" (design 8.1 step 6, owner 2026-11-19). Approving an urgent summary needs the staff passkey
   confirmed in the last ten minutes (design 6.2): when the server asks for it, the browser's passkey prompt opens on the
   same press, then the action is sent again, the form and its statement kept. Every element id carries IdPrefix, so the
   same item's actions in the panel and in the list beside it never share an id. *@
<div class="stack stack--tight" id="actions-@Key">
    @if (!_finished)
    {
        @if (_open is null)
        {
            <ModerationMenu Id="@($"mod-more-{Key}")" Choices="Choices" Primary="@Primary" Locked="Locked" OnChoose="OpenAsync" />
        }
        else if (_open == "restrict" && Id is { } reasonId)
        {
            <RestrictAuthor Id="reasonId" IdPrefix="@IdPrefix" OnCancel="Close" OnDone="RestrictedAsync" />
        }
        else if (_open == "lock" && Id is { } lockId)
        {
            <LockAuthor Kind="@LockTargets.Reason" Id="lockId" IdPrefix="@IdPrefix" OnCancel="Close" OnDone="LockedAsync" />
        }
        else
        {
            <form class="sheet sheet--quiet stack stack--tight" @onsubmit="SubmitAsync" novalidate aria-labelledby="action-title-@Key" id="action-form-@Key">
                <ActionHeading Id="@($"action-title-{Key}")">@L[ActionLabel(_open)]</ActionHeading>
                <p class="small" id="action-sentence-@Key">@L["Mod.Sentence." + SentenceKind + "." + _open]@if (_open == "merge" && Comments > 0) {@(" ")@L.Format("Mod.Sentence.reason.merge.Comments", Display.Number(Comments))}</p>

                @if (_open == "describe")
                {
                    @if (_ai is { DraftAvailable: true })
                    {
                        <div class="field @ErrorClass("sourceText")">
                            <label for="describe-source-@Key">@L["ModOpen.Source"]</label>
                            <p class="field__hint" id="describe-source-hint-@Key">
                                @L["ModOpen.SourceHint"]
                                @if (_ai.ReadsOfficialTexts)
                                {
                                    @(" ")@L["ModOpen.SourceHintReader"]
                                }
                                @if (ESeimasUrl is { } link)
                                {
                                    @(" ")<OfficialLink Href="@link">@L["ModOpen.ESeimas"]</OfficialLink>
                                }
                            </p>
                            @* No maxlength: the browser would cut a long paste silently; the length is checked and said instead. *@
                            <textarea class="textarea" id="describe-source-@Key" aria-describedby="@DescribedBy("sourceText", $"describe-source-{Key}", $"describe-source-hint-{Key}")"
                                      aria-invalid="@Invalid("sourceText")" @bind="_source" @bind:event="oninput" disabled="@Locked"></textarea>
                            <p class="small num @(_source.Length > AppealLimits.DraftSourceMaxLength ? "field__error" : "")">@L.Format("ModOpen.SourceLength", Display.Number(_source.Length), Display.Number(AppealLimits.DraftSourceMaxLength))</p>
                            <FieldError Errors="Errors" Field="sourceText" For="@($"describe-source-{Key}")" />
                        </div>
                        <p><button type="button" class="btn btn--plain" id="describe-draft-@Key" disabled="@(Locked || (string.IsNullOrWhiteSpace(_source) && !_ai.ReadsOfficialTexts))" @onclick="DraftAsync">@L["ModOpen.Draft"]</button></p>
                    }
                    @* Design 8.13.1: the readable title, kept with the description under the same source and label. *@
                    <div class="field @ErrorClass("plainTitle")">
                        <label for="describe-title-@Key">@L["Mod.PlainTitle"]</label>
                        <p class="field__hint" id="describe-title-hint-@Key">
                            @L["Mod.PlainTitleHint"]
                            @if (_fromDraft)
                            {
                                @(" ")<span class="tag" id="describe-title-from-draft-@Key">@L["ModOpen.FromDraft"]</span>
                            }
                        </p>
                        <input class="input" type="text" maxlength="@AppealLimits.PlainTitleMaxLength" autocomplete="off" id="describe-title-@Key"
                               aria-describedby="@DescribedBy("plainTitle", $"describe-title-{Key}", $"describe-title-hint-{Key}")" aria-invalid="@Invalid("plainTitle")"
                               @bind="_plainTitle" @bind:event="oninput" disabled="@Locked" />
                        <p class="small num">@L.Format("ModOpen.SourceLength", Display.Number(_plainTitle.Length), Display.Number(AppealLimits.PlainTitleMaxLength))</p>
                        <FieldError Errors="Errors" Field="plainTitle" For="@($"describe-title-{Key}")" />
                    </div>
                    <div class="field @ErrorClass("description")">
                        <label for="describe-@Key">@L["Mod.Description"]</label>
                        <p class="field__hint" id="describe-hint-@Key">
                            @L["Mod.DescriptionHint"]
                            @if (_fromDraft)
                            {
                                @(" ")<span class="tag" id="describe-from-draft-@Key">@L["ModOpen.FromDraft"]</span>
                            }
                        </p>
                        <textarea class="textarea" id="describe-@Key" rows="10" maxlength="@AppealLimits.DescriptionMaxLength" aria-describedby="@DescribedBy("description", $"describe-{Key}", $"describe-hint-{Key}", $"describe-layout-{Key}")"
                                  aria-invalid="@Invalid("description")" @bind="_description" @bind:event="oninput" disabled="@Locked"></textarea>
                        <TextLayoutHint Id="@($"describe-layout-{Key}")" />
                        <FieldError Errors="Errors" Field="description" For="@($"describe-{Key}")" />
                    </div>
                    @* Design 8.13 (decided 2026-11-14): filled in advance with the record's address, so leaving it keeps it;
                       empty clears it. The same rule here and on the server (OfficialTextAddress). *@
                    <div class="field @ErrorClass("descriptionUrl")">
                        <label for="describe-url-@Key">@L["Mod.DescriptionUrl"]</label>
                        <p class="field__hint" id="describe-url-hint-@Key">@L["Mod.DescriptionUrlHint"]</p>
                        <input class="input" type="url" inputmode="url" autocomplete="off" spellcheck="false" id="describe-url-@Key"
                               aria-describedby="@DescribedBy("descriptionUrl", $"describe-url-{Key}", $"describe-url-hint-{Key}")" aria-invalid="@Invalid("descriptionUrl")"
                               maxlength="@AppealLimits.DescriptionUrlMaxLength" @bind="_descriptionUrl" @bind:event="oninput" disabled="@Locked" />
                        <FieldError Errors="Errors" Field="descriptionUrl" For="@($"describe-url-{Key}")" />
                    </div>
                }
                @if (_open == "threshold")
                {
                    <div class="field @ErrorClass("threshold")">
                        <label for="threshold-@Key">@L["Mod.Threshold"]</label>
                        <input class="input num" type="number" inputmode="numeric" id="threshold-@Key" min="1" step="1" @bind="_threshold" disabled="@Locked"
                               aria-invalid="@Invalid("threshold")" aria-describedby="@DescribedBy("threshold", $"threshold-{Key}")" />
                        <FieldError Errors="Errors" Field="threshold" For="@($"threshold-{Key}")" />
                    </div>
                }
                @if (_open == "planned")
                {
                    <div class="pair">
                        <div class="field @ErrorClass("date")">
                            <label for="planned-@Key">@L["Mod.PlannedDate"]</label>
                            <div class="date-row">
                                <input class="input num" type="text" inputmode="numeric" autocomplete="off" pattern="@Display.DatePattern" placeholder="@Display.DateExample"
                                       id="planned-@Key" aria-describedby="@DescribedBy("date", $"planned-{Key}")" aria-invalid="@Invalid("date")" @bind="_planned" disabled="@Locked" />
                                <DatePick InputId="@($"planned-{Key}")" Disabled="Locked" />
                            </div>
                            <FieldError Errors="Errors" Field="date" For="@($"planned-{Key}")" />
                        </div>
                        <div class="field">
                            <label for="stage-@Key">@L["Mod.PlannedStage"]</label>
                            <select class="input" id="stage-@Key" @bind="_stage" disabled="@Locked">
                                <option value="@BillStages.Presentation">@L["Mod.Stage.presentation"]</option>
                                <option value="@BillStages.Consideration">@L["Mod.Stage.consideration"]</option>
                                <option value="@BillStages.Adoption">@L["Mod.Stage.adoption"]</option>
                            </select>
                        </div>
                    </div>
                }
                @if (_open == "close")
                {
                    @* Design 8.1 step 6 (owner, 2026-11-19): what happened, the day of that decision (a typed date with a
                       calendar button, the field itself never the browser's control) and the source on lrs.lt, with the statement below. *@
                    <fieldset class="stack stack--tight @ErrorClass("reason")" id="close-reason-@Key">
                        <legend class="label">@L["Mod.Close.Reason"]</legend>
                        @foreach (var reason in ClosingReasons.ByModerator)
                        {
                            <label class="check">
                                <input type="radio" name="close-reason-@Key" id="close-reason-@reason-@Key" value="@reason" checked="@(_closeReason == reason)"
                                       @onchange="() => _closeReason = reason" disabled="@Locked" />
                                <span>@L["Mod.Close.Reason." + reason]</span>
                            </label>
                        }
                        <FieldError Errors="Errors" Field="reason" For="@($"close-reason-{Key}")" />
                    </fieldset>
                    <div class="field @ErrorClass("decidedOn")">
                        <label for="close-date-@Key">@L["Mod.Close.Date"]</label>
                        <div class="date-row">
                            <input class="input num" type="text" inputmode="numeric" autocomplete="off" pattern="@Display.DatePattern" placeholder="@Display.DateExample"
                                   id="close-date-@Key" aria-describedby="@DescribedBy("decidedOn", $"close-date-{Key}")" aria-invalid="@Invalid("decidedOn")"
                                   @bind="_decidedOn" disabled="@Locked" />
                            <DatePick InputId="@($"close-date-{Key}")" Disabled="Locked" />
                        </div>
                        <FieldError Errors="Errors" Field="decidedOn" For="@($"close-date-{Key}")" />
                    </div>
                    <div class="field @ErrorClass("sourceUrl")">
                        <label for="close-url-@Key">@L["Mod.Close.Url"]</label>
                        <p class="field__hint" id="close-url-hint-@Key">@L["Mod.Close.UrlHint"]</p>
                        <input class="input" type="url" inputmode="url" autocomplete="off" spellcheck="false" id="close-url-@Key"
                               aria-describedby="@DescribedBy("sourceUrl", $"close-url-{Key}", $"close-url-hint-{Key}")" aria-invalid="@Invalid("sourceUrl")"
                               maxlength="@AppealLimits.DescriptionUrlMaxLength" @bind="_sourceUrl" @bind:event="oninput" disabled="@Locked" />
                        <FieldError Errors="Errors" Field="sourceUrl" For="@($"close-url-{Key}")" />
                    </div>
                }
                @if (_open == "merge" && MergeCandidates is { Count: > 0 })
                {
                    <fieldset class="stack stack--tight @ErrorClass("into")">
                        <legend class="label">@L["Mod.MergeInto"]</legend>
                        @foreach (var candidate in MergeCandidates)
                        {
                            <label class="check">
                                <input type="radio" name="merge-@Key" value="@candidate.Id" checked="@(_mergeInto == candidate.Id)" @onchange="() => _mergeInto = candidate.Id" disabled="@Locked" />
                                <span>@candidate.Text <span class="small num">(@Display.Number(candidate.Endorsements))</span></span>
                            </label>
                        }
                        <FieldError Errors="Errors" Field="into" For="@($"merge-{Key}")" />
                    </fieldset>
                }

                @* Design 8.3 (owner, 2026-11-22): the explanation says who reads it, the author by email, everyone on the
                   bill's page, or staff only; the note of "Palikti" goes to the members who reported, by email (2026-11-17). *@
                @* A description's statement is public in its history and laid out as typed (design 8.13, owner 2026-11-25). *@
                @{ var hint = StatementHint(_open); var typed = IsDescriptionAction(_open); }
                <div class="field @ErrorClass("statement")">
                    <label for="statement-@Key">@StatementLabel(_open)</label>
                    @if (hint is not null)
                    {
                        <p class="field__hint" id="statement-hint-@Key">@hint</p>
                    }
                    <textarea class="textarea" id="statement-@Key" rows="@(typed ? "5" : null)" maxlength="@AppealLimits.StatementMaxLength" @bind="_statement" @bind:event="oninput" disabled="@Locked"
                              aria-invalid="@Invalid("statement")" aria-describedby="@DescribedBy("statement", $"statement-{Key}", hint is null ? "" : $"statement-hint-{Key}", typed ? $"statement-layout-{Key}" : "")"></textarea>
                    @if (typed)
                    {
                        <TextLayoutHint Id="@($"statement-layout-{Key}")" />
                    }
                    <FieldError Errors="Errors" Field="statement" For="@($"statement-{Key}")" />
                </div>
                @if (_open == "describe")
                {
                    @* Design 8.13 (owner, 2026-11-25): for an AI agent filling the form in the moderator's session, out of sight
                       and out of the tab order but in the page's text and accessibility tree, where agents read; ticked, the
                       description is "ai", "Sukurta DI · žmonių neperžiūrėta". *@
                    <div class="visually-hidden" id="describe-by-ai-box-@Key">
                        <label class="check">
                            <input type="checkbox" id="describe-by-ai-@Key" name="writtenByAi" tabindex="-1" @bind="_writtenByAi" disabled="@Locked" />
                            <span>@L["Mod.WrittenByAi"]</span>
                        </label>
                    </div>
                }
                <div class="row">
                    <button type="submit" class="btn" id="action-submit-@Key" disabled="@Locked">@L[ActionLabel(_open)]</button>
                    <button type="button" class="btn btn--plain" disabled="@Locked" @onclick="Close">@L["Cancel"]</button>
                </div>
            </form>
        }
    }
    @* Outside the form, so the confirmation stays after it closes. *@
    <Messages Message="@Message" Info="@(Info ?? _done)" />
</div>

@code {
    /// <summary>The moderators' tabs, told after an action so their counts are read again (design 8.3); null elsewhere.</summary>
    [CascadingParameter] public QueueChanges? QueueChanges { get; set; }

    private string? _open;
    private string? _done;
    private bool _administrator;
    private bool _finished;
    private bool? _held;
    private string _statement = "";
    private int? _threshold;
    private Guid? _mergeInto;
    private string? _planned;
    private string _stage = BillStages.Consideration;
    private string _description = "";
    private string _plainTitle = "";
    private string? _plainNow;
    private string? _descriptionUrl;
    private string? _descriptionNow;
    private string? _sourceNow;
    private string? _urlNow;
    private string _source = "";
    private bool _fromDraft;
    private bool _writtenByAi;
    private AiStatusResponse? _ai;
    private Guid? _record;
    private string? _closeReason;
    private string? _decidedOn;
    private string? _sourceUrl;

    /// <summary>The argument, or the bill's record; null for a bill without a record (an action creates it).</summary>
    [Parameter] public Guid? Id { get; set; }

    /// <summary>For a bill: its number, which the description and a new record go by.</summary>
    [Parameter] public string? Number { get; set; }

    /// <summary><c>record</c> (a bill's record) or <c>reason</c>.</summary>
    [Parameter, EditorRequired] public string Kind { get; set; } = "";

    /// <summary>The kind as the resource keys name it: their keys for a record still say <c>appeal</c> (kept on purpose).</summary>
    private string SentenceKind => Kind == ReportTargets.Record ? "appeal" : Kind;

    [Parameter] public string Status { get; set; } = "";

    /// <summary>For an argument: its record's status. On a closed record only hiding and "Palikti" are offered (design 6.9).</summary>
    [Parameter] public string RecordStatus { get; set; } = BillRecordStatuses.Open;

    [Parameter] public IReadOnlyList<ReasonResponse>? MergeCandidates { get; set; }

    /// <summary>The argument's comments, which a merge deletes (design 8.23.7): the confirmation says how many.</summary>
    [Parameter] public int Comments { get; set; }

    /// <summary>For a closed bill: why it closed (<c>vote</c>, <c>rejected</c>, <c>withdrawn</c>); only a moderator's close can be undone (design 8.1 step 6).</summary>
    [Parameter] public string? ClosedReason { get; set; }

    /// <summary>For a bill: its sending is held.</summary>
    [Parameter] public bool Held { get; set; }

    /// <summary>For a bill: the threshold that applies now, the starting value of a change.</summary>
    [Parameter] public int? Threshold { get; set; }

    /// <summary>For a bill: the planned date the page shows now, the starting value of a correction.</summary>
    [Parameter] public PlannedDateResponse? Planned { get; set; }

    /// <summary>For a bill: its description now (empty when it has none), the starting text of "Rašyti aprašymą".</summary>
    [Parameter] public string? Description { get; set; }

    /// <summary>For a bill: its readable title now (design 8.13.1); null when it has none. The starting value of the title field.</summary>
    [Parameter] public string? CurrentPlainTitle { get; set; }

    /// <summary>For a bill: who made its description (<c>ai</c>: an AI summary nobody has read, which can be confirmed).</summary>
    [Parameter] public string? DescriptionSource { get; set; }

    /// <summary>For a bill: the official text's address its description carries, the starting value of the address field.</summary>
    [Parameter] public string? DescriptionUrl { get; set; }

    /// <summary>For a bill: its text on e-seimas, beside the field for pasted official text.</summary>
    [Parameter] public string? ESeimasUrl { get; set; }

    /// <summary>
    /// The item has something "keep" answers (design 8.3, owner 2026-11-26): open reports or date flags, or for an open bill a
    /// surge or being under its threshold on the agenda.
    /// </summary>
    [Parameter] public bool HasOpenItems { get; set; }

    /// <summary>For an argument: a moderator has seen it (design 8.3).</summary>
    [Parameter] public bool Seen { get; set; }

    /// <summary>For an argument: it has an open report.</summary>
    [Parameter] public bool Reported { get; set; }

    /// <summary>
    /// "Palikti" on a published argument only when it does something (owner, 2026-11-17): it answers an open report or marks an
    /// argument not yet seen as seen, taking it out of the queue. On a seen one without a report it would change nothing.
    /// </summary>
    private string[] KeepReason => Reported || !Seen ? ["keep"] : [];

    /// <summary>The start of every element id here (<c>panel-</c> in the panel on the bill's page), so ids stay unique.</summary>
    [Parameter] public string IdPrefix { get; set; } = "";

    /// <summary>After an action: the item's queue may change (the page decides whether to reload).</summary>
    [Parameter] public EventCallback<string> OnDone { get; set; }

    /// <summary>After a restriction: the page reloads its list of restrictions.</summary>
    [Parameter] public EventCallback OnRestricted { get; set; }

    private bool IsHeld => _held ?? Held;

    /// <summary>Element ids: the prefix and the item's id, or the bill's number while it has no record.</summary>
    private string Key => IdPrefix + (Id?.ToString() ?? Number ?? "new");

    /// <summary>
    /// The actions that apply to the item's state, in the order they are shown (design 8.3, 8.12.3): the main one first, a
    /// bill's by kind (the description, the Seimas's timing, the summaries), hiding last.
    /// </summary>
    private IReadOnlyList<string> Offered => (Kind, Status) switch
    {
        (ReportTargets.Record, BillRecordStatuses.Open) => [.. (HasOpenItems ? new[] { "keep" } : []), .. DescriptionActions, "planned", "threshold", "close", IsHeld ? "release" : "hold", .. (IsHeld ? Array.Empty<string>() : ["urgent"]), "hide"],
        // A finished bill nobody took part in has no record: only its description can be written (owner, 2026-11-26).
        (ReportTargets.Record, BillRecordStatuses.Closed) when Id is null => ClosedDescriptionActions,
        (ReportTargets.Record, BillRecordStatuses.Closed) => [.. (HasOpenItems ? new[] { "keep" } : []), .. ClosedDescriptionActions, .. (ClosingReasons.ByModerator.Contains(ClosedReason ?? "") ? new[] { "reopen" } : []), "hide"],
        (ReportTargets.Reason, ReasonStatuses.Published) when RecordStatus == BillRecordStatuses.Closed => [.. KeepReason, "hide"],
        (ReportTargets.Reason, _) when RecordStatus == BillRecordStatuses.Closed => ["hide"],
        (ReportTargets.Reason, ReasonStatuses.Pending) => ["publish", .. (MergeCandidates is { Count: > 0 } ? new[] { "merge" } : []), "restrict", "hide"],
        (ReportTargets.Reason, _) => [.. KeepReason, .. (MergeCandidates is { Count: > 0 } ? new[] { "merge" } : []), "restrict", "hide"],
        _ => [],
    };

    /// <summary>
    /// The one filled button (owner, 2026-11-17, 2026-11-26): what the reason the item is there asks for. "Palikti" when keep
    /// answers something (reports, date flags, a surge, under its threshold on the agenda); else "Atnaujinti siuntimą" on a
    /// held bill; else confirming an AI summary nobody has read, or publishing a waiting argument; otherwise none.
    /// </summary>
    private string? Primary => Offered.FirstOrDefault() switch
    {
        "keep" => "keep",
        _ when Offered.Contains("release") => "release",
        var first when first is "confirm" or "publish" => first,
        _ => null,
    };

    /// <summary>The offered actions as the menu shows them: a bill's under the headings of their kind, hiding set apart.</summary>
    private IReadOnlyList<ModerationChoice> Choices =>
        [.. Offered.Concat(OffersLock ? ["lock"] : []).Select(a => new ModerationChoice(a, $"action-{a}-{Key}", L[ActionLabel(a)], GroupOf(a), Apart: a is "hide" or "lock"))];

    /// <summary>
    /// Design 8.3: an administrator also locks the author's account, wherever the author can be restricted from writing, last of all
    /// after hiding (the heaviest action, set apart with it). A moderator who is not an administrator is never offered it.
    /// </summary>
    private bool OffersLock => _administrator && Offered.Contains("restrict");

    private string? GroupOf(string action) => Kind != ReportTargets.Record ? null : action switch
    {
        "confirm" or "describe" or "undescribe" => L["Mod.Group.description"].Value,
        "planned" or "threshold" or "close" or "reopen" => L["Mod.Group.seimas"].Value,
        "hold" or "release" or "urgent" => L["Mod.Group.digests"].Value,
        _ => null,
    };

    /// <summary>
    /// The description's actions on a bill (design 8.13), by its number: confirm an AI summary nobody has read, write or
    /// correct, and remove one that exists.
    /// </summary>
    private string[] DescriptionActions => Number is null
        ? []
        : [.. (CurrentSource == DescriptionSources.Ai ? new[] { "confirm" } : []), "describe", .. (string.IsNullOrEmpty(CurrentDescription) ? Array.Empty<string>() : ["undescribe"])];

    /// <summary>
    /// The description's actions on a closed record (design 6.9): correct it or remove one that exists. Confirming an AI
    /// summary is not among them.
    /// </summary>
    private string[] ClosedDescriptionActions => Number is null
        ? []
        : ["describe", .. (string.IsNullOrEmpty(CurrentDescription) ? Array.Empty<string>() : ["undescribe"])];

    /// <summary>The readable title (design 8.13.1) as it is after this control's own actions, which change it with the description.</summary>
    private string? PlainTitleNow => _descriptionNow is null ? CurrentPlainTitle : _plainNow;

    /// <summary>The description as it is after this control's own actions (the queue does not reload).</summary>
    private string? CurrentDescription => _descriptionNow ?? Description;

    private string? CurrentSource => _descriptionNow is null ? DescriptionSource : _sourceNow;

    private string? CurrentUrl => _descriptionNow is null ? DescriptionUrl : _urlNow;

    /// <summary>
    /// What "Oficialaus teksto adresas" starts with (design 8.13): the description's own address; on a bill without a
    /// description, the bill's e-seimas address when the field would accept it. A description that has text but no address
    /// keeps the field empty, so correcting its text never adds an address nobody chose.
    /// </summary>
    private string? StartingUrl => string.IsNullOrEmpty(CurrentDescription) && OfficialTextAddress.IsAcceptable(ESeimasUrl)
        ? ESeimasUrl
        : CurrentUrl;

    /// <summary>"Rašyti aprašymą" for a bill without one, "Taisyti aprašymą" for one that has it.</summary>
    private string ActionLabel(string action) =>
        action == "describe" ? (string.IsNullOrEmpty(CurrentDescription) ? "Mod.Action.write" : "Mod.Action.describe") : "Mod.Action." + action;

    /// <summary>
    /// A note is optional when publishing, keeping or confirming, a statement required for everything else, labelled by who reads
    /// it (design 8.3, owner 2026-11-22): an argument's author by email (hiding, merging); everyone on the bill's page (hiding the
    /// record, 8.12.3; its own threshold, 8.12.2); otherwise only staff (the description, the planned date, closing and undoing
    /// it, holding, releasing and an urgent summary are recorded and audited and emailed to nobody).
    /// </summary>
    private string StatementLabel(string action) => action switch
    {
        "keep" => L["Mod.Note.Reporters"],
        "publish" => L["Mod.Note.Optional"],
        "confirm" => L["Mod.Statement.Public.Optional"],
        _ when Kind == ReportTargets.Reason => L["Mod.Statement.Author"],
        "hide" or "threshold" or "describe" or "undescribe" => L["Mod.Statement.Public"],
        _ => L["Mod.Statement.Staff"],
    };

    /// <summary>The actions on a bill's description, whose statement is public in its history (design 8.13).</summary>
    private static bool IsDescriptionAction(string? action) => action is "describe" or "undescribe" or "confirm";

    /// <summary>
    /// The line under the label on where the explanation goes, or null when the label says it all (the author's). A bill's
    /// description answers the reports on it, whose members get the statement too (8.3, 8.13).
    /// </summary>
    private string? StatementHint(string action) => action switch
    {
        "keep" => L["Mod.Note.Reporters.Hint"].Value,
        "publish" => null,
        _ when Kind == ReportTargets.Reason => null,
        "hide" or "threshold" => L["Mod.Statement.Public.Hint.bill"].Value,
        "describe" or "undescribe" or "confirm" => L["Mod.Statement.Public.Hint.description"].Value,
        _ => L["Mod.Statement.Staff.Hint"].Value,
    };

    /// <summary>Actions after which the item has left the queue for good.</summary>
    private static bool Finishes(string action) => action is "publish" or "keep" or "hide" or "merge";

    /// <summary>Opens one action's fields; "describe" first asks whether the AI draft is available, with the controls locked.</summary>
    private Task OpenAsync(string action) => RunAsync(async () =>
    {
        _open = action;
        _statement = "";
        _done = null;
        _threshold = Threshold;
        _planned = Planned is { } p ? Display.Day(p.Date) : null;
        _stage = Planned?.Stage ?? BillStages.Consideration;
        _mergeInto = null;
        _description = CurrentDescription ?? "";
        _plainTitle = PlainTitleNow ?? "";
        _descriptionUrl = StartingUrl;
        _source = "";
        _fromDraft = false;
        _writtenByAi = false;
        _closeReason = null;
        _decidedOn = null;
        _sourceUrl = null;
        if (action == "describe" && _ai is null)
        {
            // Without an answer the form works as without a provider: nothing mentions a draft.
            _ai = (await Moderation.GetAiAsync()).Value;
        }
    });

    protected override async Task OnInitializedAsync() => _administrator = await Account.IsAdministratorAsync(RendererInfo.IsInteractive);

    private void Close() => _open = null;

    private async Task RestrictedAsync()
    {
        _open = null;
        _done = L["Restrict.Done"];
        await OnRestricted.InvokeAsync();
        await (QueueChanges?.ChangedAsync() ?? Task.CompletedTask);
    }

    private async Task LockedAsync()
    {
        _open = null;
        _done = L["Lock.Done"];
        await (QueueChanges?.ChangedAsync() ?? Task.CompletedTask);
    }

    private Task DraftAsync() => RunAsync(async () =>
    {
        var result = await Moderation.DraftDescriptionAsync(Number!, new DescriptionDraftRequest { SourceText = _source });
        if (!Succeeded(result, "sourceText"))
        {
            return;
        }

        // The draft fills the description, the title and the public statement; the moderator edits them. The label stays
        // for the description's whole life. The address of a read document it rests on fills "Oficialaus teksto adresas";
        // pasted text has none, so the field keeps what it holds (design 8.11.4, 8.13).
        _description = result.Value!.Draft;
        _plainTitle = result.Value.PlainTitle ?? "";
        if (result.Value.Statement is { } statement)
        {
            _statement = statement;
        }

        if (result.Value.DescriptionUrl is { } address)
        {
            _descriptionUrl = address;
        }

        _fromDraft = true;
        Info = L["ModOpen.DraftReady"];
    });

    private Task SubmitAsync() => RunAsync(async () =>
    {
        var action = _open!;
        if (!Checked(action))
        {
            return;
        }

        var sent = await SendAsync(action);
        if (sent.Problem?.Code == ConfirmationRequired)
        {
            // Design 6.2 (an urgent summary): the staff passkey once more, then the same action again; the form stays open
            // with what was typed if the passkey is not given.
            if (!await ConfirmPasskeyAsync())
            {
                return;
            }

            sent = await SendAsync(action);
        }

        if (!Succeeded(sent, "statement", "threshold", "date", "stage", "description", "plainTitle", "descriptionUrl", "reason", "decidedOn", "sourceUrl"))
        {
            return;
        }

        if (action is "hold" or "release")
        {
            _held = action == "hold";
        }

        // The description's state after the action, as the server made it (design 8.13).
        // The readable title goes with it (design 8.13.1): written with the description, removed with it, kept by a confirmation.
        _plainNow = action switch
        {
            "undescribe" => null,
            "describe" => string.IsNullOrWhiteSpace(_plainTitle) ? null : _plainTitle.Trim(),
            _ => PlainTitleNow,
        };
        (_descriptionNow, _sourceNow, _urlNow) = action switch
        {
            "confirm" => (CurrentDescription, DescriptionSources.AiDraft, CurrentUrl),
            "undescribe" => ("", null, null),
            "describe" => (_description.Trim(), DescribedSource(), OfficialTextAddress.Normalise(_descriptionUrl)),
            _ => (_descriptionNow, _sourceNow, _urlNow),
        };
        _open = null;
        _finished = Finishes(action);
        _done = L["Mod.Done." + action];
        await OnDone.InvokeAsync(_done);
        await (QueueChanges?.ChangedAsync() ?? Task.CompletedTask);
    });

    /// <summary>The server's answer when the staff passkey must be confirmed again (design 6.2).</summary>
    private const string ConfirmationRequired = "passkey.confirmation-required";

    /// <summary>
    /// The staff passkey once more, in this session (design 6.2's ten-minute rule): the browser's passkey prompt, then the
    /// server's check. False, with the message set, when the browser cannot, the moderator cancels or the server refuses.
    /// </summary>
    private async Task<bool> ConfirmPasskeyAsync()
    {
        if (!await PasskeyBrowser.IsSupportedAsync())
        {
            Message = L["Mod.Passkey.Unsupported"];
            return false;
        }

        var options = await Auth.GetPasskeyRequestOptionsAsync();
        if (!Succeeded(options))
        {
            return false;
        }

        var credential = await PasskeyBrowser.GetAsync(options.Value!);
        if (credential is null)
        {
            Message = L["Mod.Passkey.Cancelled"];
            return false;
        }

        return Succeeded(await MeApi.ConfirmPasskeyAsync(new Lt2.Api.Contracts.Auth.PasskeyCredentialRequest { Credential = credential }));
    }

    /// <summary>What the form can tell before sending: a typed date in the form yyyy-MM-dd, a chosen merge target.</summary>
    private bool Checked(string action)
    {
        if (action == "planned" && !Display.TryReadDate(_planned, out _))
        {
            FieldFails("date", L.Format("Date.Invalid", Display.DateExample));
            return false;
        }

        if (action == "merge" && _mergeInto is null)
        {
            FieldFails("into", L["Mod.MergeChoose"]);
            return false;
        }

        if (action == "close" && !Display.TryReadDate(_decidedOn, out _))
        {
            FieldFails("decidedOn", L.Format("Date.Invalid", Display.DateExample));
            return false;
        }

        // A close: the reason, the source and the statement, by the validator the server applies; the day not in the future
        // is the server's to say (its clock, Vilnius).
        if (action == "close")
        {
            return Valid(CloseValidator.Validate(CloseRequest()));
        }

        // The description, the statement and the official text's address: the same validator the server applies.
        return action != "describe" || Valid(DescriptionValidator.Validate(DescribeRequest()));
    }

    private ModeratorDescriptionRequest DescribeRequest() =>
        new()
        {
            Description = _description, PlainTitle = string.IsNullOrWhiteSpace(_plainTitle) ? null : _plainTitle, Statement = _statement, FromDraft = _fromDraft,
            DescriptionUrl = OfficialTextAddress.Normalise(_descriptionUrl), WrittenByAi = _writtenByAi,
        };

    /// <summary>
    /// The label after "describe", as the server decides it (RecordRules.SourceOfModeratorText): an address alone keeps it;
    /// text an AI agent sent is "ai"; a draft or earlier AI text is "ai-draft"; otherwise the moderator's.
    /// </summary>
    private string? DescribedSource()
    {
        var changed = _description.Trim() != (CurrentDescription ?? "").Trim()
            || (string.IsNullOrWhiteSpace(_plainTitle) ? null : _plainTitle.Trim()) != (string.IsNullOrWhiteSpace(PlainTitleNow) ? null : PlainTitleNow.Trim());
        return !changed ? CurrentSource
            : _writtenByAi ? DescriptionSources.Ai
            : _fromDraft || CurrentSource is DescriptionSources.Ai or DescriptionSources.AiDraft ? DescriptionSources.AiDraft
            : DescriptionSources.Moderator;
    }

    private CloseRecordRequest CloseRequest() => new()
    {
        Reason = _closeReason ?? "",
        DecidedOn = Display.TryReadDate(_decidedOn, out var day) ? day : default,
        SourceUrl = OfficialTextAddress.Normalise(_sourceUrl) ?? "",
        Statement = _statement,
    };

    private async Task<ApiResult> SendAsync(string action)
    {
        var statement = new StatementRequest { Statement = _statement };
        var note = new ModerationRequest { Statement = string.IsNullOrWhiteSpace(_statement) ? null : _statement };
        if (Kind == ReportTargets.Reason)
        {
            var reasonId = Id!.Value;
            return action switch
            {
                "publish" or "keep" => await Moderation.PublishReasonAsync(reasonId, note),
                "hide" => await Moderation.HideReasonAsync(reasonId, statement),
                "merge" => await Moderation.MergeReasonAsync(reasonId, new MergeReasonRequest { IntoReasonId = _mergeInto!.Value, Statement = _statement }),
                _ => throw new InvalidOperationException($"No action {action} for a reason."),
            };
        }

        switch (action)
        {
            case "describe":
                return await Moderation.WriteDescriptionAsync(Number!, DescribeRequest());
            case "confirm":
                return await Moderation.ConfirmDescriptionAsync(Number!, note);
            case "undescribe":
                return await Moderation.RemoveDescriptionAsync(Number!, statement);
        }

        // An action on a bill without a record creates it first (design 8.12.1).
        var id = Id ?? _record;
        if (id is null)
        {
            var record = await Moderation.EnsureRecordAsync(Number!);
            if (!record.IsSuccess)
            {
                return ApiResult.Fail(record.Problem!);
            }

            id = _record = record.Value!.Id;
        }

        return action switch
        {
            "keep" => await Moderation.KeepRecordAsync(id.Value, note),
            "hide" => await Moderation.HideRecordAsync(id.Value, statement),
            "close" => await Moderation.CloseRecordAsync(id.Value, CloseRequest()),
            "reopen" => await Moderation.ReopenRecordAsync(id.Value, statement),
            "threshold" => await Moderation.SetThresholdAsync(id.Value, new ModeratorThresholdRequest { Threshold = _threshold ?? 0, Statement = _statement }),
            "planned" => await Moderation.SetPlannedAsync(id.Value, new ModeratorPlannedRequest { Date = Display.TryReadDate(_planned, out var day) ? day : default, Stage = _stage, Statement = _statement }),
            "hold" => await Moderation.HoldAsync(id.Value, statement),
            "release" => await Moderation.ReleaseAsync(id.Value, statement),
            "urgent" => await Moderation.UrgentAsync(id.Value, new Lt2.Api.Contracts.Digests.UrgentDigestRequest { Statement = _statement }),
            _ => throw new InvalidOperationException($"No action {action} for a bill."),
        };
    }
}
