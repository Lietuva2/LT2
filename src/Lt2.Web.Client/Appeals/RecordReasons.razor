@using Lt2.Api.Contracts.Appeals
@inherits InteractiveBase<AppealUi>
@inject IAppealsApi Appeals
@inject MyBillState State
@inject NavigationManager Navigation

@* The arguments of both sides (design 8.1, 8.2, design/ui/kreipimasis.html "Kodėl"): "Man svarbu" on one's own side, a
   report button on every argument, and writing a new one for either side (the person's own side preselected, if any),
   offered a similar existing one first. Prerendered on the server, so the arguments are readable without JavaScript;
   nothing in an argument's markup depends on its author's side. A moderator or an administrator in a staff-passkey session
   also gets the queue's actions on each argument, behind "Moderuoti" (design 8.12.3, decided 2026-11-14): what they need
   comes from the moderators' own answer, asked for only once the island runs in the browser (the panel beside it hands
   over its own, MyBillState), and for anyone else the server refuses it, so nothing of it renders. Each argument is keyed by its id: "Man svarbu" re-sorts the list, and an
   open form must stay with its own argument. *@
<section class="stack" aria-labelledby="h-why" id="reasons">
    <h2 id="h-why">@L["Reasons.Title"]</h2>
    @if (Record is { } record)
    {
        <div class="pair pair--reasons">
            @foreach (var side in AppealLimits.Sides)
            {
                var all = record.Reasons.Where(r => r.Side == side).ToList();
                <div class="stack" id="reasons-@side">
                    <h3><span class="choice choice--@side">@L["Reasons." + side]</span></h3>
                    @if (all.Count == 0)
                    {
                        <p class="small">@L["Reasons.None"]</p>
                    }
                    @foreach (var reason in _showAll ? all : all.Take(Shown))
                    {
                        <div class="said" id="reason-@reason.Id" @key="reason.Id">
                            <p class="bubble bubble--people voice">@reason.Text</p>
                            @* The name, then the actions as one group that never wraps item by item (owner, 2026-11-13): when
                               the two do not fit side by side, the name takes its own line above. *@
                            <div class="said__by">
                                <b class="said__name">@(reason.AuthorName ?? L["Reasons.Anonymous"])</b>
                                <span class="said__actions" id="said-actions-@reason.Id">
                                    @if (_signedIn)
                                    {
                                        var endorsed = Mine?.Endorsed.Contains(reason.Id) == true;
                                        <button class="mark num" type="button" aria-pressed="@(endorsed ? "true" : "false")"
                                                disabled="@(Locked || !MayEndorse(reason, endorsed))" title="@EndorseHint(reason, endorsed)"
                                                @onclick="() => ToggleEndorsementAsync(reason.Id, endorsed)">@L.Format("Reasons.Endorse", Display.Number(reason.Endorsements))</button>
                                        <button class="linkish small" type="button" disabled="@Locked" @onclick="() => _reporting = _reporting == reason.Id ? null : reason.Id">@L["Report.Open"]</button>
                                        @if (IsMine(reason) && record.Status == "open")
                                        {
                                            <button class="linkish small" type="button" id="withdraw-@reason.Id" disabled="@Locked"
                                                    @onclick="() => _withdrawing = _withdrawing == reason.Id ? null : reason.Id">@L["Reasons.Withdraw"]</button>
                                        }
                                    }
                                    else
                                    {
                                        <span class="mark num">@L.Format("Reasons.Endorse", Display.Number(reason.Endorsements))</span>
                                        <VisitorReport Contact="@Contact" />
                                    }
                                </span>
                            </div>
                            @if (_reporting == reason.Id)
                            {
                                <ReportForm TargetKind="reason" TargetId="reason.Id" OnClose="() => _reporting = null" />
                            }
                            @if (Moderated(reason.Id) is { } moderated)
                            {
                                <details class="more moderate" id="moderate-@reason.Id">
                                    <summary class="linkish small">@L["ModReason.Open"]</summary>
                                    <ModerationActions Id="reason.Id" Kind="reason" Status="@moderated.Status" RecordStatus="@moderated.RecordStatus" MergeCandidates="moderated.MergeCandidates" OnDone="Reload" OnRestricted="ReloadPage" />
                                </details>
                            }
                            @if (_withdrawing == reason.Id)
                            {
                                <div class="row" role="group" aria-label="@L["Reasons.Withdraw"]">
                                    <p class="small">@L["Reasons.WithdrawConfirm"]</p>
                                    <button class="btn" type="button" id="withdraw-confirm" disabled="@Locked" @onclick="() => WithdrawAsync(reason.Id)">@L["Reasons.WithdrawYes"]</button>
                                    <button class="btn btn--plain" type="button" disabled="@Locked" @onclick="() => _withdrawing = null">@L["Cancel"]</button>
                                </div>
                            }
                        </div>
                    }
                </div>
            }
        </div>
        <div class="row">
            @if (CanWrite && !_writing)
            {
                <button class="btn btn--plain" type="button" id="add-reason" disabled="@Locked" @onclick="StartWriting">@L["Reasons.Write"]</button>
            }
            @if (record.Reasons.GroupBy(r => r.Side).Any(g => g.Count() > Shown))
            {
                <button class="linkish" type="button" disabled="@Locked" @onclick="() => _showAll = !_showAll">
                    @(_showAll ? L["Reasons.Fewer"] : L.Format("Reasons.All", Display.Number(record.Reasons.Count)))
                </button>
            }
        </div>
        @if (_signedIn && record.Status == "open" && Restriction is { Restricted: true } restriction)
        {
            <WritingRestricted Restriction="restriction" />
        }

        @if (_signedIn && Mine is { } mine)
        {
            // Counters only while a limit is set (design 8.2: none by default, so usually nothing but the side note).
            var marks = mine.Side is null ? L["Reasons.NeedSide"].Value : mine.EndorsementsLeft is { } e ? L.Format("Reasons.EndorsementsLeft", Display.Number(e)) : null;
            var reasons = mine.ReasonsLeft switch { null => null, > 0 and var r => L.Format("Reasons.Left", Display.Number(r)), _ => L["Reasons.NoneLeft"].Value };
            @if (marks is not null || reasons is not null)
            {
                <p class="small num" id="reasons-note">@marks @reasons</p>
            }
        }

        @if (_writing && Mine is not null)
        {
            <form class="sheet stack" @onsubmit="SubmitAsync" novalidate aria-labelledby="write-title" id="write-reason">
                <h3 id="write-title">@L["Reasons.WriteTitle"]</h3>
                @* A two-part switch over real radio inputs (owner, 2026-11-13): the chosen half filled in its side's colour;
                   neither when the person has no side and has not chosen yet. Either side may be chosen (design 8.2;
                   the methodology's "Argumentai" says so, design 8.15). *@
                <fieldset class="field stack stack--tight @ErrorClass("side")">
                    <legend>@L["Reasons.SideLegend"]</legend>
                    <div class="switch" id="reason-side">
                        @foreach (var side in AppealLimits.Sides)
                        {
                            <label class="switch__half switch__half--@side">
                                <input class="switch__input" type="radio" name="reason-side" id="reason-side-@side" value="@side" checked="@(_side == side)"
                                       @onchange="() => ChooseSide(side)" disabled="@Locked" aria-invalid="@Invalid("side")" />
                                <span>@L["Reasons.Switch." + side]</span>
                            </label>
                        }
                    </div>
                    <FieldError Errors="Errors" Field="side" For="reason-side" />
                </fieldset>
                <div class="field @ErrorClass("text")">
                    <label for="reason-text">@L["Reasons.Label"]</label>
                    <textarea class="textarea" id="reason-text" maxlength="@AppealLimits.ReasonMaxLength" aria-describedby="@DescribedBy("text", "reason-text", "reason-hint")"
                              aria-invalid="@Invalid("text")" @bind="_text" @bind:event="oninput" disabled="@Locked"></textarea>
                    <p class="field__hint num" id="reason-hint">@L.Format("Reasons.Hint", Display.Number(_text.Length), Display.Number(AppealLimits.ReasonMaxLength))</p>
                    <FieldError Errors="Errors" Field="text" For="reason-text" />
                </div>
                @if (_similar is { Count: > 0 } similar)
                {
                    <div class="stack stack--tight" role="group" aria-labelledby="similar-title">
                        <h4 id="similar-title">@L["Reasons.SimilarTitle"]</h4>
                        <p class="small">@L["Reasons.SimilarText"]</p>
                        @foreach (var reason in similar)
                        {
                            var endorsed = Mine.Endorsed.Contains(reason.Id);
                            <div class="said" @key="reason.Id">
                                <p class="bubble bubble--people voice">@reason.Text</p>
                                <div class="said__by">
                                    <b>@(reason.AuthorName ?? L["Reasons.Anonymous"])</b>
                                    <button class="mark num" type="button" aria-pressed="@(endorsed ? "true" : "false")" disabled="@(Locked || !MayEndorse(reason, endorsed))"
                                            @onclick="() => ToggleEndorsementAsync(reason.Id, endorsed)">@L.Format("Reasons.Endorse", Display.Number(reason.Endorsements))</button>
                                </div>
                            </div>
                        }
                    </div>
                }
                <div class="row">
                    <button type="submit" class="btn" disabled="@(Locked || string.IsNullOrWhiteSpace(_text))">
                        @(_similar is { Count: > 0 } ? L["Reasons.PublishAnyway"] : L["Reasons.Submit"])
                    </button>
                    <button type="button" class="btn btn--plain" disabled="@Locked" @onclick="CancelWriting">@L["Cancel"]</button>
                </div>
            </form>
        }
    }
    <Messages Message="@Message" Info="@Info" />
</section>

@code {
    private const int Shown = 2;
    private bool _signedIn;
    private bool _showAll;
    private bool _writing;
    private string _text = "";
    private string? _side;
    private Guid? _withdrawing;
    private IReadOnlyList<ReasonResponse>? _similar;
    private Guid? _reporting;

    /// <summary>The moderators' answer for this bill: null for everyone else (the server refuses it).</summary>
    private ModerationBillResponse? _moderation;

    [Parameter, EditorRequired] public string Number { get; set; } = "";

    /// <summary>The moderators' contact address, for visitors who want to report.</summary>
    [Parameter] public string? Contact { get; set; }

    /// <summary>
    /// The server found a moderator or an administrator in a staff-passkey session; the server still refuses the
    /// moderators' answer and every action to anyone else.
    /// </summary>
    [Parameter] public bool Moderator { get; set; }

    [PersistentState] public BillRecordResponse? Record { get; set; }

    [PersistentState] public MyBillRecordResponse? Mine { get; set; }

    /// <summary>The person's own writing restriction (design 8.3): the writing box gives way to the notice.</summary>
    [PersistentState] public MyRestrictionResponse? Restriction { get; set; }


    /// <summary>An argument may be written for either side, with or without a side of one's own (design 8.2).</summary>
    private bool CanWrite => _signedIn && Record?.Status == "open" && Restriction is not { Restricted: true } && Mine is { } mine && mine.ReasonsLeft is null or > 0;

    protected override async Task OnInitializedAsync()
    {
        _signedIn = await IsSignedInAsync();
        Record ??= (await Appeals.GetRecordAsync(Number)).Value;
        if (_signedIn)
        {
            Mine ??= await State.MineAsync(Number);
            Restriction ??= await State.RestrictionAsync();
        }

        // Only for a moderator (the page says so; nobody else asks), and only in the browser: a "Moderuoti" opened before
        // the island starts would close when it does. The panel beside it hands over the answer it brought from the
        // server (MyBillState), so usually nothing is asked again.
        if (Moderator && _signedIn && RendererInfo.IsInteractive && Record is { Id: not null, Status: "open" or "closed" })
        {
            _moderation = await State.ModerationAsync(Number);
        }
    }

    private QueueReasonResponse? Moderated(Guid reasonId) => _moderation?.Reasons.FirstOrDefault(r => r.Id == reasonId);

    private void Reload(string _) => ReloadPage();

    private void ReloadPage() => Navigation.NavigateTo(Navigation.Uri, forceLoad: true);

    /// <summary>One's own argument, known only from the never-cached "mine" answer.</summary>
    private bool IsMine(ReasonResponse reason) => Mine?.MyReasons.Any(r => r.Id == reason.Id) == true;

    private Task WithdrawAsync(Guid reasonId) => RunAsync(async () =>
    {
        if (!Succeeded(await Appeals.WithdrawReasonAsync(reasonId)))
        {
            return;
        }

        _withdrawing = null;
        Info = L["Reasons.Withdrawn"];
        await ReloadAsync();
    });

    /// <summary>
    /// The side is preselected to the person's own, read from their never-cached "mine" answer; with no side of their
    /// own nothing is preselected and they choose.
    /// </summary>
    private void StartWriting()
    {
        _side = Mine?.Side;
        _writing = true;
    }

    private void ChooseSide(string side)
    {
        _side = side;
        _similar = null;
        Errors = NoErrors();
    }

    private bool MayEndorse(ReasonResponse reason, bool endorsed) =>
        Record?.Status == "open" && Mine is { } mine && (endorsed || (mine.Side == reason.Side && mine.EndorsementsLeft is null or > 0));

    private string? EndorseHint(ReasonResponse reason, bool endorsed) =>
        MayEndorse(reason, endorsed) ? null
            : Mine?.Side is null ? L["Reasons.NeedSide"].Value
            : Mine.Side != reason.Side ? L["Reasons.OwnSideOnly"].Value
            : L["Reasons.NoEndorsementsLeft"].Value;

    private Task ToggleEndorsementAsync(Guid reasonId, bool endorsed) => RunAsync(async () =>
    {
        if (!Succeeded(endorsed ? await Appeals.RemoveEndorsementAsync(reasonId) : await Appeals.EndorseAsync(reasonId)))
        {
            return;
        }

        await ReloadAsync();
        if (_similar is not null && Record is not null)
        {
            _similar = _similar.Select(s => Record.Reasons.FirstOrDefault(r => r.Id == s.Id) ?? s).ToList();
        }
    });

    private Task SubmitAsync() => RunAsync(async () =>
    {
        if (_side is null)
        {
            FieldFails("side", L["Reasons.ChooseSide"]);
            return;
        }

        var request = new ReasonRequest { Side = _side, Text = _text };
        if (_similar is null)
        {
            var similar = await Appeals.FindSimilarAsync(Number, request);
            if (!Succeeded(similar, "text"))
            {
                return;
            }

            if (similar.Value!.Count > 0)
            {
                _similar = similar.Value;
                return;
            }
        }

        var written = await Appeals.WriteReasonAsync(Number, request);
        if (!Succeeded(written, "text"))
        {
            return;
        }

        CancelWriting();
        Info = written.Value!.Status == "pending" ? L["Reasons.Pending"] : L["Reasons.Published"];
        await ReloadAsync();
    });

    private void CancelWriting()
    {
        _writing = false;
        _side = null;
        _text = "";
        _similar = null;
        Errors = NoErrors();
    }

    private async Task ReloadAsync()
    {
        State.Forget(Number);
        Record = (await Appeals.GetRecordAsync(Number)).Value ?? Record;
        Mine = await State.MineAsync(Number) ?? Mine;
    }
}
