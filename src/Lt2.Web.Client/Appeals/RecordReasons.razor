@using Lt2.Api.Contracts.Appeals
@using Lt2.Api.Contracts.Me
@using Lt2.Api.Contracts.Comments
@using Lt2.Web.Client.Comments
@inherits InteractiveBase<AppealUi>
@implements IDisposable
@inject ICommentsApi CommentsApi
@inject IAppealsApi Appeals
@inject IMeApi MeApi
@inject MyBillState State
@inject MyAccountState Account
@inject NavigationManager Navigation

@* The arguments of both sides (design 8.1, 8.2, design/ui/kreipimasis.html "Kodėl"): "Man svarbu" on either side's
   argument, counted only on one's own side (owner, 2026-11-18; one's own uncounted marks carry a short note), a
   report button on every argument, and writing a new one for either side (the person's own side preselected, if any),
   offered a similar existing one first. Prerendered on the server, so the arguments are readable without JavaScript;
   nothing in an argument's markup depends on its author's side. A moderator or an administrator in a staff-passkey session
   also gets the queue's actions on each argument, behind "Moderuoti" (design 8.12.3, decided 2026-11-14): what they need
   comes from the moderators' own answer, asked for only once the island runs in the browser (the panel beside it hands
   over its own, MyBillState), and for anyone else the server refuses it, so nothing of it renders. Each argument is keyed by its id, and after the person's own action the
   shown order is kept (owner, 2026-11-17: a mark moves nothing on the page), so an open form stays with its own argument
   and the pressed button keeps its place and its focus. The MP's own account takes no part (design 8.5.4, owner 2026-11-17):
   once the island runs it gets neither "Man svarbu" (the number stays, as a visitor reads it) nor writing an argument. *@
<section class="sheet stack" aria-labelledby="h-why" id="reasons">
    <h2 id="h-why">@L["Reasons.Title"]</h2>
    @* Owner, 2026-11-17: one hint beside the arguments (design 8.15: one beside the list, never per row) says when "Man svarbu"
       can be marked, since many browsers show no title on a disabled button. The same markup for everyone the server serves;
       the MP's own account, which gets no "Man svarbu", loses it once the island runs (design 8.5.4). *@
    @if (!_mpAccount)
    {
        <p class="small" id="reasons-endorse-what"><Hint Id="endorse-what" Text="@L["Reasons.EndorseWhat"]" Answer="@L["Reasons.EndorseAnswer"]" More="/metodika#argumentai" /></p>
    }
    @if (Record is { } record)
    {
        @* Design 8.25.4: each public profile's card once on the page, for js/lt2-cards.js; no follower number in it. *@
        @foreach (var card in record.Cards ?? [])
        {
            <template id="card-@card.ProfileId" @key="card.ProfileId"><p><b>@card.Name</b></p>@if (card.About is { } about) {<p class="small">@TextExcerpt.Of(about, CardShown).Shown</p>}<p class="small"><a href="@ProfileRoutes.Page(card.ProfileId, card.Name)">@L["Card.Open"]</a></p></template>
        }
        <div class="pair pair--reasons">
            @foreach (var side in AppealLimits.Sides)
            {
                // Design 8.11.8: under "Rodyti tik naujus" only new arguments and those whose discussion has new comments, all of them.
                var all = record.Reasons.Where(r => r.Side == side && State.Keeps(Number, r.Id)).ToList();
                <div class="stack" id="reasons-@side">
                    <h3><span class="choice choice--@side">@L["Reasons." + side]</span></h3>
                    @if (all.Count == 0 && !OnlyNew)
                    {
                        <p class="small">@L["Reasons.None"]</p>
                    }
                    @foreach (var reason in _showAll || OnlyNew ? all : all.Take(ShownOf(all)))
                    {
                        <div class="said @(LinkedReason == reason.Id || _written == reason.Id ? "said--linked" : null)" id="@BillTextLinks.ReasonElement(reason.Id)" @key="reason.Id"
                             tabindex="@(_written == reason.Id ? "-1" : null)" @ref="_said[reason.Id]">
                            @* The name first, then the text, then the action row (owner, 2026-11-17: as statements, responses and
                               comments read). The row is one line that never wraps (design 8.16.1): "Man svarbu · n",
                               "Aptarimas (n)" and "⋯" with the rarer actions; a chosen action opens directly under the row, an
                               open discussion below that, both at the row's width. *@
                            <div class="said__by">
                                @if (reason.AuthorProfileId is { } profileId)
                                {
                                    @* Design 8.25.4: a member with a public profile: the name leads to their page, with a card. *@
                                    <a class="said__name" href="@ProfileRoutes.Page(profileId, reason.AuthorName)" data-card="card-@profileId">@(reason.AuthorName ?? L["Reasons.Anonymous"])</a>
                                }
                                else
                                {
                                    <b class="said__name">@(reason.AuthorName ?? L["Reasons.Anonymous"])</b>
                                }
                                <NewMark Number="@Number" Id="reason.Id" />
                            </div>
                            <LongText Text="@reason.Text" BubbleClass="bubble bubble--people voice" Id="@($"reason-more-{reason.Id}")" />
                            <div class="act" id="said-actions-@reason.Id">
                                @if (_mpAccount)
                                {
                                    <span class="mark act__item num" id="mark-@reason.Id"><Icon Name="heart" /><span>@L.Format("Reasons.Endorse", Display.Number(reason.Endorsements))</span></span>
                                }
                                else if (_signedIn)
                                {
                                    var endorsed = Mine?.Endorsed.Contains(reason.Id) == true;
                                    <button class="mark act__item num" type="button" id="mark-@reason.Id" aria-pressed="@(endorsed ? "true" : "false")"
                                            aria-describedby="@(UncountedNote(reason) is not null ? $"mark-note-{reason.Id}" : null)"
                                            disabled="@(Locked || !MayEndorse(reason, endorsed))" title="@EndorseHint(reason, endorsed)" @ref="_marks[reason.Id]"
                                            @onclick="() => ToggleEndorsementAsync(reason, endorsed)"><Icon Name="heart" /><span>@L.Format("Reasons.Endorse", Display.Number(reason.Endorsements))</span></button>
                                }
                                else
                                {
                                    @* A visitor: a sign-in link that comes back to the bill, of the same look (owner, 2026-11-17), as the
                                       side buttons and "Sekti" are (design 6.9). *@
                                    <a class="mark act__item num" id="mark-@reason.Id" href="@LandingPath.SignInLink(BillPath)"><Icon Name="heart" /><span>@L.Format("Reasons.Endorse", Display.Number(reason.Endorsements))</span></a>
                                }
                                @* Design 8.23.6: "Aptarimas" under the argument; prerendered with the island for the arguments shown
                                   first, read when first opened for those revealed by "show all". *@
                                <CommentThread Kind="reason" TargetId="reason.Id" Number="@Number" Thread="@Threads?.GetValueOrDefault(reason.Id)" Count="reason.Comments"
                                               Open="@(AskedFor(reason.Id) is not null)" Asked="@AskedFor(reason.Id)" Marked="@CommentPaging.Marked(reason.Id, Linked)" PagePath="@PagePath" Contact="@Contact" Moderator="Moderator" />
                                <MoreMenu Id="@($"more-reason-{reason.Id}")">
                                    @if (_signedIn)
                                    {
                                        var menu = MoreMenu.MenuOf($"more-reason-{reason.Id}");
                                        @if (MayReport(reason))
                                        {
                                            <button class="menu__item" type="button" id="report-@reason.Id" disabled="@Locked" popovertarget="@menu" popovertargetaction="hide"
                                                    @onclick="() => _reporting = _reporting == reason.Id ? null : reason.Id">@L["Report.Open"]</button>
                                        }
                                        @if (MayEdit(reason))
                                        {
                                            @* Owner, 2026-11-17: only while nobody reacted, from the never-cached "mine" answer; not shown otherwise. *@
                                            <button class="menu__item" type="button" id="edit-@reason.Id" disabled="@Locked" popovertarget="@menu" popovertargetaction="hide"
                                                    @onclick="() => StartEditingAsync(reason)">@L["Reasons.Edit"]</button>
                                        }
                                        @if (IsMine(reason) && record.Status == "open")
                                        {
                                            <button class="menu__item" type="button" id="withdraw-@reason.Id" disabled="@Locked" popovertarget="@menu" popovertargetaction="hide"
                                                    @onclick="() => _withdrawing = _withdrawing == reason.Id ? null : reason.Id">@L["Reasons.Withdraw"]</button>
                                        }
                                        @if (Moderated(reason.Id) is not null)
                                        {
                                            <button class="menu__item" type="button" id="moderate-@reason.Id" disabled="@Locked" popovertarget="@menu" popovertargetaction="hide"
                                                    @onclick="() => _moderating = _moderating == reason.Id ? null : reason.Id">@L["ModReason.Open"]</button>
                                        }
                                    }
                                    else
                                    {
                                        <VisitorReport Contact="@Contact" />
                                    }
                                </MoreMenu>
                                @if (_consentForMark == reason.Id)
                                {
                                    @* Design 6.5 (owner, 2026-11-18): a first "Man svarbu" without the positions consent asks for it in
                                       place, with the side buttons' form; nothing is saved before it is given. *@
                                    <div class="act__panel" id="mark-consent-@reason.Id">
                                        <PositionConsentForm Side="@reason.Side" ForMark="true" Locked="Locked" IdPrefix="@($"mark-{reason.Id}-")"
                                                             OnConfirm="() => ConsentAndEndorseAsync(reason)" OnCancel="() => _consentForMark = null" />
                                    </div>
                                }
                                @if (_reporting == reason.Id)
                                {
                                    <div class="act__panel"><ReportForm TargetKind="reason" TargetId="reason.Id" OnClose="() => _reporting = null" /></div>
                                }
                                @if (_editing == reason.Id)
                                {
                                    <form class="act__panel sheet sheet--quiet stack" @onsubmit="() => SaveEditAsync(reason.Id)" novalidate aria-labelledby="edit-title-@reason.Id" id="edit-reason-@reason.Id">
                                        <h3 id="edit-title-@reason.Id">@L["Reasons.EditTitle"]</h3>
                                        <fieldset class="field stack stack--tight @ErrorClass("side")">
                                            <legend>@L["Reasons.SideLegend"]</legend>
                                            <div class="switch" id="edit-side-@reason.Id">
                                                @foreach (var half in AppealLimits.Sides)
                                                {
                                                    <label class="switch__half switch__half--@half">
                                                        <input class="switch__input" type="radio" name="edit-side-@reason.Id" id="edit-side-@half-@reason.Id" value="@half" checked="@(_editSide == half)"
                                                               @onchange="() => _editSide = half" disabled="@Locked" aria-invalid="@Invalid("side")" />
                                                        <span>@L["Reasons.Switch." + half]</span>
                                                    </label>
                                                }
                                            </div>
                                            <FieldError Errors="Errors" Field="side" For="@($"edit-side-{reason.Id}")" />
                                        </fieldset>
                                        <div class="field @ErrorClass("text")">
                                            <label for="edit-text-@reason.Id">@L["Reasons.Label"]</label>
                                            <textarea class="textarea" id="edit-text-@reason.Id" maxlength="@MemberTextLimits.Allowed(_maxLength ?? 0)"
                                                      aria-describedby="@DescribedBy("text", $"edit-text-{reason.Id}", $"edit-hint-{reason.Id}", $"edit-layout-{reason.Id}")"
                                                      aria-invalid="@Invalid("text")" @bind="_editText" @bind:event="oninput" disabled="@Locked"></textarea>
                                            <p class="field__hint num" id="edit-hint-@reason.Id">@(_maxLength is > 0 and var max ? L.Format("Reasons.Hint", Display.Number(_editText.Length), Display.Number(max)) : L["Reasons.HintNoLimit"].Value)</p>
                                            <TextLayoutHint Id="@($"edit-layout-{reason.Id}")" />
                                        </div>
                                        <div class="row">
                                            <button type="submit" class="btn" id="edit-save-@reason.Id" disabled="@(Locked || string.IsNullOrWhiteSpace(_editText))">@L["Reasons.Save"]</button>
                                            <button type="button" class="btn btn--plain" disabled="@Locked" @onclick="CancelEditing">@L["Cancel"]</button>
                                        </div>
                                    </form>
                                }
                                @if (_withdrawing == reason.Id)
                                {
                                    <div class="act__panel row sheet sheet--quiet" role="group" aria-label="@L["Reasons.Withdraw"]">
                                        <p class="small">@L["Reasons.WithdrawConfirm"]</p>
                                        <button class="btn" type="button" id="withdraw-confirm" disabled="@Locked" @onclick="() => WithdrawAsync(reason.Id)">@L["Reasons.WithdrawYes"]</button>
                                        <button class="btn btn--plain" type="button" disabled="@Locked" @onclick="() => _withdrawing = null">@L["Cancel"]</button>
                                    </div>
                                }
                                @if (_moderating == reason.Id && Moderated(reason.Id) is { } moderated)
                                {
                                    <div class="act__panel sheet sheet--quiet moderate" id="moderation-@reason.Id">
                                        <ModerationActions Id="reason.Id" Kind="reason" Status="@moderated.Status" RecordStatus="@moderated.RecordStatus" MergeCandidates="moderated.MergeCandidates" Comments="moderated.Comments" Seen="moderated.Seen" Reported="moderated.Reports.Count > 0" OnDone="ModeratorActedAsync" OnRestricted="ModeratorActedAsync" />
                                    </div>
                                }
                            </div>
                            @if (UncountedNote(reason) is { } note)
                            {
                                @* Owner, 2026-11-18: the person's own mark that does not count now, from their never-cached answer. *@
                                <p class="small mark-note" id="mark-note-@reason.Id">@note</p>
                            }
                        </div>
                    }
                    @foreach (var hidden in OwnHidden(side))
                    {
                        @* Owner, 2026-11-17: the author's own hidden argument, in its side's column, for them only (the never-cached
                           answer, once the island runs), quiet, with the moderator's explanation; no actions. *@
                        <div class="said said--hidden" id="hidden-reason-@hidden.Id" @key="hidden.Id">
                            <div class="said__by"><b class="said__name">@(hidden.AuthorName ?? L["Reasons.Anonymous"])</b></div>
                            <LongText Text="@hidden.Text" BubbleClass="bubble bubble--people voice" Id="@($"hidden-reason-more-{hidden.Id}")" />
                            <p class="small hidden-why" id="hidden-reason-why-@hidden.Id">
                                @(Mine!.HiddenStatements.TryGetValue(hidden.Id, out var why) ? L.Format("Reasons.HiddenBy", why) : L["Reasons.Hidden"].Value)
                                @L["Reasons.HiddenOnlyYou"]
                            </p>
                        </div>
                    }
                </div>
            }
        </div>
        <div class="row">
            @if (CanWrite && !_writing)
            {
                <button class="btn btn--plain" type="button" id="add-reason" disabled="@Locked" @onclick="StartWritingAsync">@L["Reasons.Write"]</button>
            }
            @if (!OnlyNew && record.Reasons.GroupBy(r => r.Side).Any(g => g.Count() > ShownOf(g.ToList())))
            {
                @if (RendererInfo.IsInteractive)
                {
                    <button class="linkish" type="button" id="reasons-all" disabled="@Locked" @onclick="() => _showAll = !_showAll">
                        @(_showAll ? L["Reasons.Fewer"] : L.Format("Reasons.All", Display.Number(record.Reasons.Count)))
                    </button>
                }
                else
                {
                    @* Owner, 2026-11-18: without script (and before the island starts) the same words are a link to the page with
                       every argument (?argumentai=visi), rendered by the server; the island's button then works in place. *@
                    <a class="linkish" id="reasons-all" href="@(_showAll ? PagePath : AllPath)#reasons">
                        @(_showAll ? L["Reasons.Fewer"] : L.Format("Reasons.All", Display.Number(record.Reasons.Count)))
                    </a>
                }
            }
        </div>
        @if (_signedIn && record.Status == "open" && Restriction is { Restricted: true } restriction)
        {
            <WritingRestricted Restriction="restriction" />
        }

        @if (_signedIn && !_mpAccount && Mine is { } mine)
        {
            // Counters only while a limit is set (design 8.2: none by default, so usually nothing). Marking needs no side (owner,
            // 2026-11-18), so there is no side note.
            var marks = mine.EndorsementsLeft is { } e ? L.Format("Reasons.EndorsementsLeft", Display.Number(e)) : null;
            var reasons = mine.ReasonsLeft switch { null => null, > 0 and var r => L.Format("Reasons.Left", Display.Number(r)), _ => L["Reasons.NoneLeft"].Value };
            @if (marks is not null || reasons is not null)
            {
                <p class="small num" id="reasons-note">@marks @reasons</p>
            }
        }

        @if (_writing && Mine is not null)
        {
            <form class="sheet sheet--quiet stack" @onsubmit="SubmitAsync" novalidate aria-labelledby="write-title" id="write-reason">
                <h3 id="write-title">@L["Reasons.WriteTitle"]</h3>
                @* A two-part switch over real radio inputs (owner, 2026-11-13): the chosen half filled in its side's colour;
                   neither when the person has no side and has not chosen yet. Either side may be chosen (design 8.2;
                   the methodology's "Argumentai" says so, design 8.15). *@
                <fieldset class="field stack stack--tight @ErrorClass("side")">
                    <legend>@L["Reasons.SideLegend"]</legend>
                    <div class="switch" id="reason-side">
                        @foreach (var side in AppealLimits.Sides)
                        {
                            <label class="switch__half switch__half--@side">
                                <input class="switch__input" type="radio" name="reason-side" id="reason-side-@side" value="@side" checked="@(_side == side)"
                                       @onchange="() => ChooseSide(side)" disabled="@Locked" aria-invalid="@Invalid("side")" />
                                <span>@L["Reasons.Switch." + side]</span>
                            </label>
                        }
                    </div>
                    <FieldError Errors="Errors" Field="side" For="reason-side" />
                </fieldset>
                <div class="field @ErrorClass("text")">
                    <label for="reason-text">@L["Reasons.Label"]</label>
                    @* Design 8.2 (owner, 2026-11-16): the length is the setting Texts:MaxLength; with 0 (no limit) only the
                       technical ceiling holds and no counter is shown. *@
                    <textarea class="textarea" id="reason-text" maxlength="@MemberTextLimits.Allowed(_maxLength ?? 0)" aria-describedby="@DescribedBy("text", "reason-text", "reason-hint", "reason-layout")"
                              aria-invalid="@Invalid("text")" @bind="_text" @bind:event="oninput" disabled="@Locked" @ref="_textArea"></textarea>
                    <p class="field__hint num" id="reason-hint">@(_maxLength is > 0 and var max ? L.Format("Reasons.Hint", Display.Number(_text.Length), Display.Number(max)) : L["Reasons.HintNoLimit"].Value)</p>
                    <TextLayoutHint Id="reason-layout" />
                </div>
                @if (_tooShort)
                {
                    @* Owner, 2026-11-17: asked in place before a too short argument is published. *@
                    <div class="note note--quiet stack stack--tight" role="group" aria-labelledby="too-short-text" id="too-short">
                        <p id="too-short-text">@L["Reasons.TooShort"]</p>
                        <div class="row">
                            <button type="button" class="btn" id="too-short-more" disabled="@Locked" @onclick="AddMoreAsync">@L["Reasons.TooShort.More"]</button>
                            <button type="button" class="btn btn--plain" id="too-short-anyway" disabled="@Locked" @onclick="PublishAnywayAsync">@L["Reasons.TooShort.Anyway"]</button>
                        </div>
                    </div>
                }
                @if (_similar is { Count: > 0 } similar)
                {
                    <div class="stack stack--tight" role="group" aria-labelledby="similar-title">
                        <h4 id="similar-title">@L["Reasons.SimilarTitle"]</h4>
                        <p class="small">@L["Reasons.SimilarText"]</p>
                        @foreach (var reason in similar)
                        {
                            var endorsed = Mine.Endorsed.Contains(reason.Id);
                            <div class="said" @key="reason.Id">
                                <LongText Text="@reason.Text" BubbleClass="bubble bubble--people voice" Id="@($"similar-more-{reason.Id}")" />
                                <div class="said__by">
                                    <b>@(reason.AuthorName ?? L["Reasons.Anonymous"])</b>
                                    <button class="mark num" type="button" aria-pressed="@(endorsed ? "true" : "false")" disabled="@(Locked || !MayEndorse(reason, endorsed))"
                                            title="@EndorseHint(reason, endorsed)" @onclick="() => ToggleEndorsementAsync(reason, endorsed)">@L.Format("Reasons.Endorse", Display.Number(reason.Endorsements))</button>
                                </div>
                                @if (_consentForMark == reason.Id)
                                {
                                    <PositionConsentForm Side="@reason.Side" ForMark="true" Locked="Locked" IdPrefix="@($"similar-mark-{reason.Id}-")"
                                                         OnConfirm="() => ConsentAndEndorseAsync(reason)" OnCancel="() => _consentForMark = null" />
                                }
                            </div>
                        }
                    </div>
                }
                <div class="row">
                    <button type="submit" class="btn" disabled="@(Locked || string.IsNullOrWhiteSpace(_text))">
                        @(_similar is { Count: > 0 } ? L["Reasons.PublishAnyway"] : L["Reasons.Submit"])
                    </button>
                    <button type="button" class="btn btn--plain" disabled="@Locked" @onclick="CancelWriting">@L["Cancel"]</button>
                </div>
            </form>
        }
    }
    <Messages Message="@Message" Info="@Info" />
</section>

@code {
    private const int Shown = 2;

    /// <summary>About this many characters of "Apie mane" in a card (design 8.25.4: "the first lines").</summary>
    private const int CardShown = 200;
    private bool _signedIn;
    private bool _mpAccount;
    private bool _showAll;
    private bool _writing;
    private string _text = "";
    private string? _side;
    private Guid? _withdrawing;
    private IReadOnlyList<ReasonResponse>? _similar;
    private Guid? _reporting;

    /// <summary>The argument whose moderator's actions are open below its row ("⋯" → "Moderuoti", design 8.12.3).</summary>
    private Guid? _moderating;

    /// <summary>Each shown argument's "Man svarbu" button, to give the focus back after pressing it.</summary>
    private readonly Dictionary<Guid, ElementReference> _marks = [];

    /// <summary>The argument whose "Man svarbu" was just pressed; its button gets the focus back once enabled again.</summary>
    private Guid? _refocus;

    /// <summary>
    /// The argument the person just published (owner, 2026-11-17: "it doesn't show up after posting"): shown first in its side's
    /// column on top of the usual two, marked, until the page is read again. A waiting one is not public and is never set here.
    /// </summary>
    private Guid? _written;

    /// <summary>The published argument is brought into view and given the focus once, after the render that shows it.</summary>
    private bool _focusWritten;

    /// <summary>Each shown argument, to bring the one just published into view.</summary>
    private readonly Dictionary<Guid, ElementReference> _said = [];

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        await base.OnAfterRenderAsync(firstRender);
        if (_focusWritten && !Busy && _written is { } written && _said.TryGetValue(written, out var said))
        {
            _focusWritten = false;
            try
            {
                // Focusing scrolls it into view, as a link to an argument does (design 8.12.1).
                await said.FocusAsync();
            }
            catch (Microsoft.JSInterop.JSException)
            {
                // The argument is gone meanwhile: nothing to focus.
            }
        }

        if (_refocus is { } id && !Busy && _marks.TryGetValue(id, out var button))
        {
            _refocus = null;
            try
            {
                // Without scrolling: the argument stays where it stood (owner, 2026-11-17).
                await button.FocusAsync(preventScroll: true);
            }
            catch (Microsoft.JSInterop.JSException)
            {
                // The button is gone (the argument was withdrawn meanwhile): nothing to focus.
            }
        }
    }

    /// <summary>The setting Texts:MaxLength (0 = no limit), read when writing starts; null until then or if unread.</summary>
    private int? _maxLength;

    /// <summary>The moderators' answer for this bill: null for everyone else (the server refuses it).</summary>
    private ModerationBillResponse? _moderation;

    [Parameter, EditorRequired] public string Number { get; set; } = "";

    /// <summary>The moderators' contact address, for visitors who want to report.</summary>
    [Parameter] public string? Contact { get; set; }

    /// <summary>
    /// The server found a moderator or an administrator in a staff-passkey session; the server still refuses the
    /// moderators' answer and every action to anyone else.
    /// </summary>
    [Parameter] public bool Moderator { get; set; }

    [PersistentState] public BillRecordResponse? Record { get; set; }

    /// <summary>The comments under the arguments shown first (design 8.23.6), read with the record and carried to the browser.</summary>
    [PersistentState] public Dictionary<Guid, CommentThreadResponse>? Threads { get; set; }

    /// <summary>"Rodyti daugiau komentarų": which target's comments the address asks for, and how many (design 8.23.14).</summary>
    [SupplyParameterFromQuery(Name = CommentLimits.ShowParameter)] public string? CommentsShown { get; set; }

    /// <summary>The responses' page parameter (design 8.5.6), kept in the links this part builds.</summary>
    [SupplyParameterFromQuery(Name = Lt2.Api.Contracts.Mps.MpResponseLimits.ShowParameter)] public string? ResponsesShown { get; set; }

    /// <summary>
    /// A link to one comment (<c>?komentaras=</c>), resolved by the page on the server (design 8.23.6): the argument it stands
    /// under is shown and its "Aptarimas" rendered open through the linked comment, marked. A parameter, so the island gets the
    /// same state in the browser and does not close the thread when it starts. Null when the address names none, or one not shown.
    /// </summary>
    [Parameter] public CommentPlaceResponse? Linked { get; set; }

    /// <summary>A link to one argument (<c>?argumentas=</c>, design 8.12.1): shown even beyond the first two of its side, marked.</summary>
    [Parameter] public Guid? LinkedReason { get; set; }

    private string PagePath => CommentPaging.PagePath(Number, ResponsesShown);

    /// <summary>The address's word for every argument (owner, 2026-11-18): <c>?argumentai=visi</c>.</summary>
    public const string AllParameter = "argumentai";

    public const string AllValue = "visi";

    /// <summary>"Visi argumentai" without script: the page with every argument of both sides, rendered by the server.</summary>
    [SupplyParameterFromQuery(Name = AllParameter)] public string? AllShown { get; set; }

    private bool AllAsked => AllShown == AllValue;

    private string AllPath => PagePath + (PagePath.Contains('?', StringComparison.Ordinal) ? "&" : "?") + AllParameter + "=" + AllValue;

    /// <summary>The bill's page, where signing in from "Man svarbu" comes back to.</summary>
    private string BillPath => "/seimas/" + Uri.EscapeDataString(Number);

    /// <summary>How many comments of an argument the page shows open: "Rodyti daugiau komentarų" or a link to one; null: closed.</summary>
    private int? AskedFor(Guid reasonId) => CommentPaging.Asked(CommentsShown, reasonId, Linked);

    [PersistentState] public MyBillRecordResponse? Mine { get; set; }

    /// <summary>The person's own writing restriction (design 8.3): the writing box gives way to the notice.</summary>
    [PersistentState] public MyRestrictionResponse? Restriction { get; set; }


    /// <summary>An argument may be written for either side, with or without a side of one's own (design 8.2).</summary>
    private bool CanWrite => _signedIn && !_mpAccount && Record?.Status == "open" && Restriction is not { Restricted: true } && Mine is { } mine && mine.ReasonsLeft is null or > 0;

    protected override async Task OnInitializedAsync()
    {
        _signedIn = await IsSignedInAsync();
        Record ??= (await Appeals.GetRecordAsync(Number)).Value;

        // "Rodyti daugiau komentarų" or a link to a comment under an argument the page shows only after "show all", or a link to
        // such an argument: shown already (design 8.23.6, 8.12.1); and every argument when the address asks for all.
        _showAll = AllAsked || (Record?.Reasons is { } reasons
            && reasons.Any(r => (AskedFor(r.Id) is not null || r.Id == LinkedReason) && !FirstShown(reasons).Contains(r.Id)));
        Threads ??= await ThreadsAsync();
        if (_signedIn)
        {
            Mine ??= await State.MineAsync(Number);
            Restriction ??= await State.RestrictionAsync();
            _mpAccount = await Account.IsMpAccountAsync(RendererInfo.IsInteractive);
        }

        // Only for a moderator (the page says so; nobody else asks), and only in the browser: a "Moderuoti" opened before
        // the island starts would close when it does. The panel beside it hands over the answer it brought from the
        // server (MyBillState), so usually nothing is asked again.
        if (Moderator && _signedIn && RendererInfo.IsInteractive && Record is { Id: not null, Status: "open" or "closed" })
        {
            _moderation = await State.ModerationAsync(Number);
        }

        if (RendererInfo.IsInteractive)
        {
            State.Changed += OnChanged;
            State.NewsChanged += OnNewsChanged;
        }
    }

    public void Dispose()
    {
        State.Changed -= OnChanged;
        State.NewsChanged -= OnNewsChanged;
    }

    /// <summary>"Rodyti tik naujus" is on (design 8.11.8): the page being read only, never stored.</summary>
    private bool OnlyNew => State.OnlyNew(Number);

    /// <summary>What is new arrived, or "Rodyti tik naujus" was switched (design 8.11.8): the arguments are drawn again.</summary>
    private void OnNewsChanged(string number)
    {
        if (string.Equals(number, Number, StringComparison.OrdinalIgnoreCase))
        {
            _ = InvokeAsync(StateHasChanged);
        }
    }

    /// <summary>
    /// A change elsewhere on the page (a side taken, changed or withdrawn, which drops the marks of the old side; a moderator's
    /// action in the panel): the arguments, the person's own answer and the moderators' one are read again in place.
    /// </summary>
    private void OnChanged(BillChange change)
    {
        if (!change.Concerns(Number, this))
        {
            return;
        }

        _ = InvokeAsync(async () =>
        {
            try
            {
                await ReadAgainAsync(threads: false);
                StateHasChanged();
            }
            catch (HttpRequestException)
            {
                // The arguments shown stay; the next change reads again.
            }
        });
    }

    /// <summary>
    /// The comments of the arguments the page shows before "show all" (two per side, design 8.12.1, 8.23.6), each the first ten
    /// or as many as the address asks for; of every argument when the address asks for all (so "Aptarimas" opens without
    /// script there too). Others are read when their "Aptarimas" is first opened.
    /// </summary>
    private async Task<Dictionary<Guid, CommentThreadResponse>> ThreadsAsync()
    {
        var threads = new Dictionary<Guid, CommentThreadResponse>();
        if (Record is not { Status: "open" or "closed" } record)
        {
            return threads;
        }

        foreach (var reason in record.Reasons.Where(r => AllAsked || FirstShown(record.Reasons).Contains(r.Id) || AskedFor(r.Id) is not null))
        {
            if ((await CommentsApi.GetThreadAsync("reason", reason.Id, AskedFor(reason.Id))).Value is { } thread)
            {
                threads[reason.Id] = thread;
            }
        }

        return threads;
    }

    /// <summary>The fresh record with its arguments in the order they stand on the page; arguments not shown before come last, in the answer's order.</summary>
    public static BillRecordResponse? StableOrder(BillRecordResponse? fresh, BillRecordResponse? shown)
    {
        if (fresh is null || shown is null)
        {
            return fresh;
        }

        var at = shown.Reasons.Select((r, i) => (r.Id, i)).ToDictionary(x => x.Id, x => x.i);
        return fresh with { Reasons = fresh.Reasons.OrderBy(r => at.TryGetValue(r.Id, out var i) ? i : int.MaxValue).ToList() };
    }

    /// <summary>
    /// The fresh record with the argument the person just published first, so it leads its side's column (owner, 2026-11-17);
    /// unchanged without one, or when it is not in the answer (withdrawn, hidden).
    /// </summary>
    public static BillRecordResponse? WrittenFirst(BillRecordResponse? record, Guid? written) =>
        record is null || written is not { } id || record.Reasons.All(r => r.Id != id)
            ? record
            : record with { Reasons = record.Reasons.OrderBy(r => r.Id == id ? 0 : 1).ToList() };

    /// <summary>
    /// How many of one side's arguments show before "show all": two (design 8.12.1), and the one the person just published on
    /// top of them, so publishing pushes nothing behind "show all".
    /// </summary>
    private int ShownOf(IReadOnlyList<ReasonResponse> side) => Shown + (_written is { } id && side.Any(r => r.Id == id) ? 1 : 0);

    /// <summary>The arguments shown before "show all": the first two of each side (design 8.12.1), and one just published.</summary>
    private HashSet<Guid> FirstShown(IReadOnlyList<ReasonResponse> reasons) =>
        AppealLimits.Sides.SelectMany(side =>
        {
            var ofSide = reasons.Where(r => r.Side == side).ToList();
            return ofSide.Take(ShownOf(ofSide));
        }).Select(r => r.Id).ToHashSet();

    private QueueReasonResponse? Moderated(Guid reasonId) => _moderation?.Reasons.FirstOrDefault(r => r.Id == reasonId);

    /// <summary>
    /// A moderator's action on an argument: the other islands are told (the moderators' panel lists the same arguments), these
    /// arguments are read again, and the server's part of the page is read again in place, without reloading it.
    /// </summary>
    private async Task ModeratorActedAsync()
    {
        State.Announce(Number, this, byModerator: true);
        await ReadAgainAsync(threads: true);
        Navigation.Refresh();
    }

    /// <summary>One's own argument, known only from the never-cached "mine" answer.</summary>
    private bool IsMine(ReasonResponse reason) => Mine?.MyReasons.Any(r => r.Id == reason.Id) == true;

    /// <summary>
    /// "Pranešti" (owner, 2026-11-17): never on one's own argument, and not for a moderator in a staff-passkey session, who gets
    /// the moderators' actions instead. Decided once the island runs, so the served HTML is the same for every member.
    /// </summary>
    private bool MayReport(ReasonResponse reason) => !RendererInfo.IsInteractive || (!Moderator && !IsMine(reason));

    /// <summary>
    /// The caller's own hidden arguments of one side (owner, 2026-11-17), from the never-cached answer and only once the island
    /// runs, so the served HTML stays the same for everyone; not under "Rodyti tik naujus". A record hidden as a whole shows none.
    /// </summary>
    private IEnumerable<ReasonResponse> OwnHidden(string side) =>
        RendererInfo.IsInteractive && !OnlyNew && Record?.Status is "open" or "closed" && Mine is { } mine
            ? mine.MyReasons.Where(r => r.Status == "hidden" && r.Side == side)
            : [];

    /// <summary>The argument whose edit form is open below its row ("⋯" → "Redaguoti").</summary>
    private Guid? _editing;
    private string? _editSide;
    private string _editText = "";

    /// <summary>
    /// "Redaguoti" on one's own argument (design 8.2, owner 2026-11-17): only while the server says it may be edited (nobody has
    /// reacted, the record open, no writing restriction), from the never-cached "mine" answer, so the served HTML stays the same
    /// for everyone. Not shown at all otherwise.
    /// </summary>
    private bool MayEdit(ReasonResponse reason) =>
        !_mpAccount && Record?.Status == "open" && Restriction is not { Restricted: true } && Mine?.Editable.Contains(reason.Id) == true;

    private Task StartEditingAsync(ReasonResponse reason) => RunAsync(async () =>
    {
        _maxLength ??= (await Appeals.GetRulesAsync()).Value?.TextMaxLength;
        _editing = reason.Id;
        _editSide = reason.Side;
        _editText = reason.Text;
        _withdrawing = null;
        _reporting = null;
        Errors = NoErrors();
    });

    private void CancelEditing()
    {
        _editing = null;
        _editSide = null;
        _editText = "";
        Errors = NoErrors();
    }

    /// <summary>Saves the edit in place: the list is read again; a text pre-screening flags waits for a moderator (not shown).</summary>
    private Task SaveEditAsync(Guid reasonId) => RunAsync(async () =>
    {
        var saved = await Appeals.EditReasonAsync(reasonId, new ReasonRequest { Side = _editSide ?? "", Text = _editText });
        if (!Succeeded(saved, "side", "text"))
        {
            if (saved.Problem?.Code == "reason.reacted")
            {
                // Someone reacted meanwhile: the message says so, the form closes and "Redaguoti" goes.
                _editing = null;
                await ReloadAsync();
            }

            return;
        }

        CancelEditing();
        Info = saved.Value!.Status == "pending" ? L["Reasons.EditedPending"] : L["Reasons.Edited"];
        await ReloadAsync();
    });

    private Task WithdrawAsync(Guid reasonId) => RunAsync(async () =>
    {
        if (!Succeeded(await Appeals.WithdrawReasonAsync(reasonId)))
        {
            return;
        }

        _withdrawing = null;
        Info = L["Reasons.Withdrawn"];
        await ReloadAsync();
    });

    /// <summary>
    /// The side is preselected to the person's own, read from their never-cached "mine" answer; with no side of their
    /// own nothing is preselected and they choose.
    /// </summary>
    private Task StartWritingAsync() => RunAsync(async () =>
    {
        // The length an argument may have and the fewest words it should have are runtime settings (design 8.2, owner
        // 2026-11-17): read when writing starts.
        var rules = (await Appeals.GetRulesAsync()).Value;
        _maxLength = rules?.TextMaxLength ?? _maxLength;
        _minWords = rules?.MinReasonWords ?? 0;
        _side = Mine?.Side;
        _writing = true;
    });

    /// <summary>The setting <c>Appeals:MinReasonWords</c> (0 = off), read when writing starts.</summary>
    private int _minWords;

    /// <summary>The form asks about a too short argument (owner, 2026-11-17), in place, before publishing it.</summary>
    private bool _tooShort;

    /// <summary>The person chose "Vis tiek skelbti": the argument goes as it is, and waits for a moderator.</summary>
    private bool _shortConfirmed;

    private ElementReference _textArea;

    /// <summary>"Papildyti": back to the text, the focus in it.</summary>
    private async Task AddMoreAsync()
    {
        _tooShort = false;
        try
        {
            await _textArea.FocusAsync();
        }
        catch (Microsoft.JSInterop.JSException)
        {
            // The field is gone (the form closed meanwhile).
        }
    }

    /// <summary>"Vis tiek skelbti": published as it is; pre-screening flags it and a moderator decides.</summary>
    private Task PublishAnywayAsync()
    {
        _shortConfirmed = true;
        _tooShort = false;
        return SubmitAsync();
    }

    private void ChooseSide(string side)
    {
        _side = side;
        _similar = null;
        Errors = NoErrors();
    }

    /// <summary>
    /// "Man svarbu" on someone else's argument of either side, with or without a side of one's own (owner, 2026-11-18), within
    /// the limit (design 8.2); never on one's own (owner, 2026-11-17), known from the never-cached "mine" answer. Without the
    /// positions consent the press asks for it in place (<see cref="ToggleEndorsementAsync"/>).
    /// </summary>
    private bool MayEndorse(ReasonResponse reason, bool endorsed) =>
        Record?.Status == "open" && Mine is { } mine && (endorsed || (!IsMine(reason) && mine.EndorsementsLeft is null or > 0));

    private string? EndorseHint(ReasonResponse reason, bool endorsed) =>
        MayEndorse(reason, endorsed) ? null
            : IsMine(reason) ? L["Reasons.OwnReason"].Value
            : Record?.Status != "open" || Mine is null ? null
            : L["Reasons.NoEndorsementsLeft"].Value;

    /// <summary>
    /// The short note beside the person's own mark that does not count now (owner, 2026-11-18): without a side, it will count
    /// once they ask for the argument's side; with the other side, it does not count while they ask for theirs. Null for a
    /// counted mark, no mark, and anyone but the person (the never-cached answer only).
    /// </summary>
    private string? UncountedNote(ReasonResponse reason) =>
        Mine is { } mine && !_mpAccount && mine.Endorsed.Contains(reason.Id) && mine.Uncounted.Contains(reason.Id)
            ? mine.Side is { } side ? L["Reasons.Uncounted.Other." + side].Value : L["Reasons.Uncounted.NoSide." + reason.Side].Value
            : null;

    /// <summary>The argument whose "Man svarbu" asks for the positions consent below its row (design 6.5, owner 2026-11-18).</summary>
    private Guid? _consentForMark;

    private Task ToggleEndorsementAsync(ReasonResponse reason, bool endorsed) => RunAsync(async () =>
    {
        if (!endorsed && Mine is { HasPositionConsent: false })
        {
            // A mark is about a political question, as a side is (owner, 2026-11-18): the consent first, in place.
            _consentForMark = reason.Id;
            _reporting = null;
            return;
        }

        await EndorseAsync(reason.Id, endorsed);
    });

    /// <summary>"Sutinku ir pažymėti": the consent, then the mark; the other islands (the side buttons) learn the consent was given.</summary>
    private Task ConsentAndEndorseAsync(ReasonResponse reason) => RunAsync(async () =>
    {
        var consent = await MeApi.GivePositionConsentAsync(new PositionConsentRequest { TextVersion = PositionConsentText.Version });
        if (!Succeeded(consent))
        {
            return;
        }

        _consentForMark = null;
        await EndorseAsync(reason.Id, endorsed: false);
        State.Announce(Number, this);
    });

    private async Task EndorseAsync(Guid reasonId, bool endorsed)
    {
        // The button is disabled while the action runs, which takes the focus from it: it gets it back once it is enabled.
        _refocus = reasonId;
        var result = endorsed ? await Appeals.RemoveEndorsementAsync(reasonId) : await Appeals.EndorseAsync(reasonId);
        if (result.Problem?.Code == "consent.required")
        {
            // The consent was withdrawn since the page was read: ask for it again, in place.
            _consentForMark = reasonId;
            await ReloadAsync();
            return;
        }

        if (!Succeeded(result))
        {
            return;
        }

        await ReloadAsync();
        if (_similar is not null && Record is not null)
        {
            _similar = _similar.Select(s => Record.Reasons.FirstOrDefault(r => r.Id == s.Id) ?? s).ToList();
        }
    }

    private Task SubmitAsync() => RunAsync(async () =>
    {
        if (_side is null)
        {
            FieldFails("side", L["Reasons.ChooseSide"]);
            return;
        }

        // Owner, 2026-11-17: a too short argument is asked about first, the same step as the similar ones; the server decides too.
        if (!_shortConfirmed && ReasonWords.TooShort(_text, _minWords))
        {
            _tooShort = true;
            return;
        }

        var request = new ReasonRequest { Side = _side, Text = _text };
        if (_similar is null)
        {
            var similar = await Appeals.FindSimilarAsync(Number, request);
            if (!Succeeded(similar, "text"))
            {
                return;
            }

            if (similar.Value!.Count > 0)
            {
                _similar = similar.Value;
                return;
            }
        }

        var written = await Appeals.WriteReasonAsync(Number, request);
        if (!Succeeded(written, "text"))
        {
            return;
        }

        CancelWriting();
        if (written.Value!.Status == "pending")
        {
            // Waiting for a moderator (design 8.3): not public, so nothing of it is shown.
            Info = L["Reasons.Pending"];
            await ReloadAsync();
            return;
        }

        // Published: shown where the person sees it without opening the whole list, until the page is read again.
        _written = written.Value.Id;
        _focusWritten = true;
        Info = L["Reasons.Published"];
        await ReloadAsync();
    });

    private void CancelWriting()
    {
        _writing = false;
        _side = null;
        _text = "";
        _similar = null;
        _tooShort = false;
        _shortConfirmed = false;
        Errors = NoErrors();
    }

    /// <summary>
    /// Reads the record again after the person's own action and keeps the arguments where they stand (owner, 2026-11-17: "the
    /// view is scrolled away after clicking 'Man svarbu'"): the answer is ordered by the marks, so a mark could move the argument
    /// the person just pressed, or push it behind "show all", and the browser lost both the place and the focus. The new numbers
    /// show in place; someone else's new argument comes last, the person's own just published first (WrittenFirst); the order by
    /// marks returns when the page is read again.
    /// </summary>
    private async Task ReloadAsync()
    {
        State.Forget(Number);
        await ReadAgainAsync(threads: true);
    }

    /// <summary>The record, the person's own answer and, for a moderator, the moderators' one, as the shared state has them now.</summary>
    private async Task ReadAgainAsync(bool threads)
    {
        Record = WrittenFirst(StableOrder(await State.RecordAsync(Number), Record), _written) ?? Record;
        if (threads)
        {
            Threads = await ThreadsAsync();
        }

        if (_signedIn)
        {
            Mine = await State.MineAsync(Number) ?? Mine;
        }

        if (_moderation is not null)
        {
            _moderation = await State.ModerationAsync(Number) ?? _moderation;
        }
    }
}
