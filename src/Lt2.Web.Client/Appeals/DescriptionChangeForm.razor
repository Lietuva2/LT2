@using Lt2.Api.Contracts.Appeals
@inherits InteractiveBase
@inject IAppealsApi Appeals

@* For the initiator of an open appeal only (design 8.1): propose a new neutral description. The page keeps showing the
   approved text until a moderator approves the new one; one pending proposal at a time. Renders nothing for anyone
   else. *@
@if (Mine is { IsInitiator: true } mine)
{
    <section class="stack stack--tight" aria-labelledby="change-title" id="description-change">
        @if (Restriction is { Restricted: true } restriction)
        {
            <WritingRestricted Restriction="restriction" />
        }
        else if (_sent || mine.DescriptionChange is { Status: "pending" })
        {
            <p class="note" role="status" id="change-pending">@L["Change.Pending"]</p>
            @if (mine.DescriptionChange is { Status: "pending" } pending)
            {
                <details>
                    <summary class="linkish">@L["Change.ShowProposed"]</summary>
                    <p class="voice">@pending.Text</p>
                </details>
            }
        }
        else if (!_open)
        {
            @if (mine.DescriptionChange is { Status: "returned", Note: { } note })
            {
                <p class="note note--quiet" id="change-returned">@Text("Change.Returned", note)</p>
            }
            <div class="row">
                <button type="button" class="btn btn--plain" id="change-open" disabled="@Locked" @onclick="Open">@L["Change.Open"]</button>
            </div>
        }
        else
        {
            <form class="sheet stack stack--tight" @onsubmit="SendAsync" novalidate aria-labelledby="change-title">
                <h3 id="change-title">@L["Change.Title"]</h3>
                <p class="small">@L["Change.Explained"]</p>
                <div class="field @(Errors.ContainsKey("description") ? "field--error" : "")">
                    <label for="change-description">@L["Open.Description"]</label>
                    <textarea class="textarea" id="change-description" maxlength="@AppealLimits.DescriptionMaxLength" @bind="_description" @bind:event="oninput" disabled="@Locked"></textarea>
                    <FieldError Errors="Errors" Field="description" />
                </div>
                <div class="row">
                    <button type="submit" class="btn" disabled="@Locked">@L["Change.Submit"]</button>
                    <button type="button" class="btn btn--plain" disabled="@Locked" @onclick="() => _open = false">@L["Cancel"]</button>
                </div>
            </form>
        }
        <Messages Message="@Message" Info="@Info" />
    </section>
}

@code {
    private bool _open;
    private bool _sent;
    private string _description = "";

    [Parameter, EditorRequired] public string Number { get; set; } = "";

    /// <summary>The approved description shown now, the starting point of a change.</summary>
    [Parameter, EditorRequired] public string Description { get; set; } = "";

    [CascadingParameter] private Task<AuthenticationState>? AuthState { get; set; }

    [PersistentState] public MyAppealResponse? Mine { get; set; }

    /// <summary>The person's own writing restriction (design 8.3): proposing a description is writing.</summary>
    [PersistentState] public MyRestrictionResponse? Restriction { get; set; }

    protected override async Task OnInitializedAsync()
    {
        if (AuthState is null || (await AuthState).User.Identity?.IsAuthenticated != true)
        {
            return;
        }

        Mine ??= (await Appeals.GetMineAsync(Number)).Value;
        if (Mine?.IsInitiator == true)
        {
            Restriction ??= (await Appeals.GetMyRestrictionAsync()).Value;
        }
    }

    private void Open()
    {
        _description = Description;
        _open = true;
    }

    private Task SendAsync() => RunAsync(async () =>
    {
        var result = await Appeals.ProposeDescriptionAsync(Number, new EditAppealRequest { Description = _description });
        if (!result.IsSuccess)
        {
            Show(result.Problem, "description");
            return;
        }

        _open = false;
        _sent = true;
        Info = L["Change.Sent"];
    });
}
