@using Lt2.Api.Contracts.Appeals
@inherits InteractiveBase
@inject IModerationApi Moderation

@* A proposed description change (design 8.1): "Skelbti" (an optional note) puts it on the page and in the history;
   "Grąžinti autoriui" (a required note) keeps the approved text. Each opens only its own field, with one sentence; one
   is open at a time; the confirmation stays after it closes. *@
<div class="stack stack--tight" id="change-actions-@Id">
    @if (_done is null)
    {
        @if (_open is null)
        {
            <div class="row" role="group" aria-label="@L["Mod.Actions"]">
                <button type="button" class="btn" id="change-approve-@Id" disabled="@Locked" @onclick='() => Open("approve")'>@L["Mod.Publish"]</button>
                <button type="button" class="btn btn--plain" id="change-return-@Id" disabled="@Locked" @onclick='() => Open("return")'>@L["Mod.Return"]</button>
            </div>
        }
        else
        {
            <form class="sheet stack stack--tight" @onsubmit="SubmitAsync" novalidate aria-labelledby="change-action-title-@Id">
                <h4 id="change-action-title-@Id">@L[_open == "approve" ? "Mod.Publish" : "Mod.Return"]</h4>
                <p class="small">@L[_open == "approve" ? "Change.Mod.Approve.Sentence" : "Change.Mod.Return.Sentence"]</p>
                <div class="field @(Errors.ContainsKey("statement") ? "field--error" : "")">
                    <label for="change-statement-@Id">@L[_open == "approve" ? "Mod.Note.Optional" : "Mod.Note.Required"]</label>
                    <textarea class="textarea" id="change-statement-@Id" maxlength="@AppealLimits.StatementMaxLength" @bind="_statement" @bind:event="oninput" disabled="@Locked"></textarea>
                    <FieldError Errors="Errors" Field="statement" />
                </div>
                <div class="row">
                    <button type="submit" class="btn" id="change-submit-@Id" disabled="@Locked">@L[_open == "approve" ? "Mod.Publish" : "Mod.Return"]</button>
                    <button type="button" class="btn btn--plain" disabled="@Locked" @onclick="() => _open = null">@L["Cancel"]</button>
                </div>
            </form>
        }
    }
    <Messages Message="@Message" Info="@(Info ?? _done)" />
</div>

@code {
    private string? _open;
    private string? _done;
    private string _statement = "";

    [Parameter, EditorRequired] public Guid Id { get; set; }

    private void Open(string action)
    {
        _open = action;
        _statement = "";
        Message = null;
        Info = null;
    }

    private Task SubmitAsync() => RunAsync(async () =>
    {
        var result = _open == "approve"
            ? await Moderation.ApproveDescriptionAsync(Id, new ModerationRequest { Statement = string.IsNullOrWhiteSpace(_statement) ? null : _statement })
            : await Moderation.ReturnDescriptionAsync(Id, new StatementRequest { Statement = _statement });
        if (!result.IsSuccess)
        {
            Show(result.Problem, "statement");
            return;
        }

        _done = L[_open == "approve" ? "Change.Mod.Approved" : "Change.Mod.Returned"];
        _open = null;
    });
}
