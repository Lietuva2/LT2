@using Lt2.Api.Contracts.Appeals
@inherits InteractiveBase<AppealUi>
@inject IAppealsApi Appeals
@inject MyBillState State

@* Design 8.4: participants can say the planned date is wrong or the bill is voted sooner, with a link to the source and,
   when they know it, the right date (owner, 2026-11-17: a text field yyyy-MM-dd, never the browser's date control); a
   moderator makes the change. Shown only to members who have a side on the bill, in the side column's "Stadijos Seime"
   right under the stages and their planned date (owner, 2026-11-17), so the form that opens lies inside that sheet and is
   a quiet one (8.16). *@
@if (Mine is { Side: not null })
{
    <details class="more stack stack--tight" id="date-flag">
        <summary class="linkish small">@L["Flag.Open"]</summary>
        @if (_sent)
        {
            <p class="note note--quiet" role="status">@L["Flag.Sent"]</p>
        }
        else if (Restriction is { Restricted: true } restriction)
        {
            <WritingRestricted Restriction="restriction" />
        }
        else
        {
            <form class="sheet sheet--quiet stack stack--tight" @onsubmit="SendAsync" novalidate>
                <fieldset class="stack stack--tight">
                    <legend class="label">@L["Flag.Kind"]</legend>
                    @foreach (var kind in Kinds)
                    {
                        <label class="check">
                            <input type="radio" name="flag-kind" id="flag-@kind" checked="@(_kind == kind)" @onchange="() => _kind = kind" disabled="@Locked" />
                            <span>@L["Flag." + kind]</span>
                        </label>
                    }
                </fieldset>
                <div class="field @ErrorClass("date")">
                    <label for="flag-date">@L["Flag.Date"]</label>
                    <p class="field__hint" id="flag-date-hint">@L.Format("Date.Hint", Display.DateExample)</p>
                    <input class="input num" id="flag-date" type="text" inputmode="numeric" autocomplete="off" pattern="@Display.DatePattern" placeholder="@Display.DateExample"
                           aria-describedby="@DescribedBy("date", "flag-date", "flag-date-hint")" aria-invalid="@Invalid("date")" @bind="_date" disabled="@Locked" />
                    <FieldError Errors="Errors" Field="date" For="flag-date" />
                </div>
                <div class="field @ErrorClass("link")">
                    <label for="flag-link">@L["Flag.Link"]</label>
                    <input class="input" id="flag-link" type="url" maxlength="@AppealLimits.FlagLinkMaxLength" @bind="_link" disabled="@Locked"
                           aria-invalid="@Invalid("link")" aria-describedby="@DescribedBy("link", "flag-link")" />
                    <FieldError Errors="Errors" Field="link" For="flag-link" />
                </div>
                <div class="field">
                    <label for="flag-note">@L["Report.Text"]</label>
                    <textarea class="textarea" id="flag-note" maxlength="@AppealLimits.FlagNoteMaxLength" @bind="_note" disabled="@Locked"></textarea>
                </div>
                <button type="submit" class="btn btn--plain" disabled="@(Locked || _kind is null)">@L["Flag.Submit"]</button>
                <Messages Message="@Message" Info="@Info" />
            </form>
        }
    </details>
}

@code {
    private static readonly string[] Kinds = ["date-wrong", "sooner"];
    private string? _kind;
    private string _link = "";
    private string? _note;

    /// <summary>The right date as typed, <c>yyyy-MM-dd</c>; empty when the person does not know it.</summary>
    private string? _date;
    private bool _sent;

    [Parameter, EditorRequired] public string Number { get; set; } = "";

    [PersistentState] public MyBillRecordResponse? Mine { get; set; }

    /// <summary>The person's own writing restriction (design 8.3): flags are writing, so the form gives way to the notice.</summary>
    [PersistentState] public MyRestrictionResponse? Restriction { get; set; }

    protected override async Task OnInitializedAsync()
    {
        if (await IsSignedInAsync())
        {
            Mine ??= await State.MineAsync(Number);
            Restriction ??= await State.RestrictionAsync();
        }
    }

    private Task SendAsync() => RunAsync(async () =>
    {
        DateOnly? date = null;
        if (!string.IsNullOrWhiteSpace(_date))
        {
            if (!Display.TryReadDate(_date, out var day))
            {
                FieldFails("date", L.Format("Date.Invalid", Display.DateExample));
                return;
            }

            date = day;
        }

        if (Succeeded(await Appeals.FlagDateAsync(Number, new FlagRequest { Kind = _kind!, Link = _link.Trim(), Note = _note, Date = date }), "link", "date"))
        {
            _sent = true;
        }
    });
}
