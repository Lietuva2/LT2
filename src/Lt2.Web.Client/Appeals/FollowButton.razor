@inherits InteractiveBase<AppealUi>
@implements IDisposable
@inject NavigationManager Navigation
@inject MyBillState BillState
@inject Lt2.Api.Contracts.Follows.IFollowsApi Follows
@inject IProfilesApi Profiles

@* "Sekti" / "Nebesekti" a bill, an MP (design 8.11.2), an organisation (design 8.14.14, stage B) or a member with a public
   profile (design 8.25.5). Private: who follows what is shown to nobody. One compact line under the page's title (owner,
   2026-11-17), the same on every page that has it: "Sekti" (the compact button, about a link's height, with a 44px tall
   press target; owner, 2026-11-18), then the number of followers (FollowerLine, design 8.11.2) when
   the page gives it, moving with the person's own "Sekti" at once (browser look, 2026-11-16), then one hint, "Kas yra
   sekimas?", with what the emails are about for this kind, that nobody sees who follows and what the number is (design
   8.15: the sentence that stood beside the button). A visitor gets a link to sign in that comes back here instead; the
   member on their own page a link to "Profilis" and the number with its own hint. The page may put its own tags before it
   in the same row (.follow-line). *@
<div class="row follow" id="follow-@Kind">
    @if (_own)
    {
        <span class="small">@L["Follow.Own"]</span>
        <a href="@AccountScreens.Profile" id="follow-own-link">@L["Follow.OwnLink"]</a>
    }
    else if (!_signedIn)
    {
        <a class="btn btn--plain btn--compact" href="@SignInHref" id="follow-sign-in-@Kind">@L["Follow.Follow"]</a>
    }
    else
    {
        <button type="button" class="btn btn--plain btn--compact" id="follow-toggle-@Kind" aria-pressed="@(Following == true ? "true" : "false")"
                disabled="@(Locked || Following is null)" @onclick="ToggleAsync">@L[Following == true ? "Follow.Unfollow" : "Follow.Follow"]</button>
    }
    @if (Followers is not null)
    {
        <Lt2.Web.Client.Components.FollowerLine Count="_followers" WithHint="_own" />
    }
    @if (!_own)
    {
        <span class="small"><Lt2.Web.Client.Components.Hint Id="@($"follow-what-{Kind}")" Icon="true" Text="@L["Follow.Hint"]" Answer="@Answer" More="/metodika#sekimas" /></span>
    }
    <Messages Message="@Message" Info="@Info" />
</div>

@code {
    /// <summary>The sign-in page that brings the visitor back to this page when it is a bill's (design 6.9).</summary>
    private string SignInHref => LandingPath.SignInLink(LandingPath.PathOf(Navigation.Uri, Navigation.BaseUri));

    /// <summary>
    /// "Kas yra sekimas?": what the emails are about for this kind (a visitor's sentence says that signing in comes first),
    /// then that nobody sees who follows and what the number is.
    /// </summary>
    private string Answer => L[(_signedIn ? "Follow.What." : "Follow.SignIn.") + Kind] + " " + L["Follow.Private"];

    private bool _signedIn;
    private bool _own;

    /// <summary>What is followed, <see cref="Kind"/>: a bill (by its number).</summary>
    public const string Bill = "bill";

    /// <summary>An MP, by the profile's slug.</summary>
    public const string Mp = "mp";

    /// <summary>An organisation, by the profile's slug.</summary>
    public const string Organisation = "organisation";

    /// <summary>A member's public profile, by its id.</summary>
    public const string Member = "member";

    /// <summary><see cref="Bill"/>, <see cref="Mp"/>, <see cref="Organisation"/> or <see cref="Member"/>.</summary>
    [Parameter, EditorRequired] public string Kind { get; set; } = Bill;

    /// <summary>The bill's number, the MP's or the organisation's profile slug, or a member's public profile id.</summary>
    [Parameter, EditorRequired] public string Key { get; set; } = "";

    [PersistentState] public bool? Following { get; set; }

    /// <summary>How many follow, as the page counted it; null: the page shows no number here.</summary>
    [Parameter] public int? Followers { get; set; }

    private int _followers;

    /// <summary>
    /// New parameters are the page's count, made at the start or when the page is read again in place (after an action that
    /// changes the server's part of it), which holds the person's own change already.
    /// </summary>
    protected override void OnParametersSet()
    {
        _moved = 0;
        _followers = Math.Max(0, Followers ?? 0);
    }

    /// <summary>The person's own change since the page was counted: +1 for a follow, -1 for an unfollow.</summary>
    private int _moved;

    /// <summary>A member's own page: nothing to follow (design 8.25.5).</summary>
    [PersistentState] public bool? Own { get; set; }

    protected override async Task OnInitializedAsync()
    {
        _signedIn = await IsSignedInAsync();
        if (_signedIn && Kind == Member)
        {
            Own ??= (await Profiles.GetMineAsync()).Value?.ProfileId == Key;
            _own = Own == true;
        }

        if (_signedIn && !_own && Following is null && (await Follows.GetMineAsync()).Value is { } mine)
        {
            Following = Kind switch
            {
                Mp => mine.Mps.Any(m => m.Slug == Key),
                Organisation => mine.Organisations.Any(o => o.Slug == Key),
                Member => (mine.Members ?? []).Any(m => m.ProfileId == Key),
                _ => mine.Bills.Any(b => string.Equals(b.Number, Key, StringComparison.OrdinalIgnoreCase)),
            };
        }

        if (_signedIn && Kind == Bill && RendererInfo.IsInteractive)
        {
            BillState.Changed += OnBillChanged;
        }
    }

    public void Dispose() => BillState.Changed -= OnBillChanged;

    /// <summary>A first side taken on the bill's page follows the bill (design 8.11.2): the button and the number show it.</summary>
    private void OnBillChanged(BillChange change)
    {
        if (change.ByModerator || !change.Concerns(Key, this))
        {
            return;
        }

        _ = InvokeAsync(async () =>
        {
            try
            {
                if ((await Follows.GetMineAsync()).Value is { } mine
                    && mine.Bills.Any(b => string.Equals(b.Number, Key, StringComparison.OrdinalIgnoreCase)) is var now
                    && now != (Following == true))
                {
                    Following = now;
                    _moved += now ? 1 : -1;
                    _followers = Math.Max(0, (Followers ?? 0) + _moved);
                    StateHasChanged();
                }
            }
            catch (HttpRequestException)
            {
                // The button stays as it was.
            }
        });
    }

    private Task ToggleAsync() => RunAsync(async () =>
    {
        var follow = Following != true;
        var result = (Kind, follow) switch
        {
            (Mp, true) => await Follows.FollowMpAsync(Key),
            (Mp, false) => await Follows.UnfollowMpAsync(Key),
            (Organisation, true) => await Follows.FollowOrganisationAsync(Key),
            (Organisation, false) => await Follows.UnfollowOrganisationAsync(Key),
            (Member, true) => await Follows.FollowMemberAsync(Key),
            (Member, false) => await Follows.UnfollowMemberAsync(Key),
            (_, true) => await Follows.FollowBillAsync(Key),
            _ => await Follows.UnfollowBillAsync(Key),
        };
        if (!result.IsSuccess)
        {
            Show(result.Problem);
            return;
        }

        Following = follow;
        _moved += follow ? 1 : -1;
        _followers = Math.Max(0, (Followers ?? 0) + _moved);
    });
}
