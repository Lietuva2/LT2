@using Lt2.Api.Contracts.Follows
@inherits InteractiveBase<AppealUi>
@inject IFollowsApi Follows

@* The account page's follows (design 8.11.2, 8.14.14): the followed bills with their planned date or last stage result,
   the followed MPs and organisations, "Nebesekti", and the three email switches. The person's own data only; every follow
   email links here. *@
<section class="sheet stack" aria-labelledby="follows-title" id="sekami">
    <h2 id="follows-title">@L["Follows.Title"]</h2>
    <p>@L["Follows.Lead"]</p>
    @if (Mine is { } mine)
    {
        @if (mine.Bills.Count == 0 && mine.Mps.Count == 0 && mine.Organisations.Count == 0)
        {
            <p class="small" id="follows-none">@L["Follows.None"] <a href="/darbotvarke">@L["Follows.ToAgenda"]</a></p>
        }
        @if (mine.Bills.Count > 0)
        {
            <h3>@L["Follows.Bills"]</h3>
            <ul class="rows" id="follows-bills">
                @foreach (var b in mine.Bills)
                {
                    <li>
                        <div class="rows__main">
                            <span><a class="num" href="/seimas/@Uri.EscapeDataString(b.Number)">@b.Number</a> · @b.Title</span>
                            <span class="small num">
                                @if (b.Planned is { } plan)
                                {
                                    @L.Format("Follows.Planned", Display.Day(plan.Date))
                                }
                                else if (b.LastStageResult is { } vote)
                                {
                                    @L.Format("Follows.Voted", Display.Day(vote.HeldAt))
                                    @(vote.IsConsensus ? " " + L["Follows.Consensus"] : " " + L.Format("Follows.Result", Display.Number(vote.For), Display.Number(vote.Against), Display.Number(vote.Abstain)))
                                }
                                else
                                {
                                    @L["Follows.NothingYet"]
                                }
                            </span>
                        </div>
                        <div class="rows__side">
                            <button type="button" class="btn btn--plain" disabled="@Locked" @onclick="() => UnfollowBillAsync(b.Number)">@L["Follow.Unfollow"]</button>
                        </div>
                    </li>
                }
            </ul>
        }
        @if (mine.Mps.Count > 0)
        {
            <h3>@L["Follows.Mps"]</h3>
            <ul class="rows" id="follows-mps">
                @foreach (var m in mine.Mps)
                {
                    <li>
                        <div class="rows__main"><a href="/p/@m.Slug">@m.FirstName @m.LastName</a></div>
                        <div class="rows__side">
                            <button type="button" class="btn btn--plain" disabled="@Locked" @onclick="() => UnfollowMpAsync(m.Slug)">@L["Follow.Unfollow"]</button>
                        </div>
                    </li>
                }
            </ul>
        }
        @if (mine.Organisations.Count > 0)
        {
            <h3>@L["Follows.Organisations"]</h3>
            <ul class="rows" id="follows-organisations">
                @foreach (var o in mine.Organisations)
                {
                    <li>
                        <div class="rows__main">
                            <a href="/o/@Uri.EscapeDataString(o.Slug)">@o.Name</a>
                            <span class="small">@OrganisationWords.LabelText(L, o.Label)@(o.Status != "active" ? " · " + L["Org.State." + o.Status] : "")</span>
                        </div>
                        <div class="rows__side">
                            <button type="button" class="btn btn--plain" disabled="@Locked" @onclick="() => UnfollowOrganisationAsync(o.Slug)">@L["Follow.Unfollow"]</button>
                        </div>
                    </li>
                }
            </ul>
        }
    }
    @if (Notices is { } notices)
    {
        <fieldset class="stack stack--tight" id="follow-notices" @key="_noticesShown">
            <legend class="label">@L["Follows.Emails"]</legend>
            <label class="check"><input type="checkbox" id="notice-planned" checked="@notices.Planned" disabled="@Locked" @onchange="e => SetAsync(e.Value is true, notices.Voted, notices.Statements)" /><span>@L["Follows.Email.planned"]</span></label>
            <label class="check"><input type="checkbox" id="notice-voted" checked="@notices.Voted" disabled="@Locked" @onchange="e => SetAsync(notices.Planned, e.Value is true, notices.Statements)" /><span>@L["Follows.Email.voted"]</span></label>
            <label class="check"><input type="checkbox" id="notice-statements" checked="@notices.Statements" disabled="@Locked" @onchange="e => SetAsync(notices.Planned, notices.Voted, e.Value is true)" /><span>@L["Follows.Email.statements"]</span></label>
        </fieldset>
    }
    <Messages Message="@Message" Info="@Info" />
</section>

@code {
    private int _noticesShown;

    [PersistentState] public MyFollowsResponse? Mine { get; set; }

    [PersistentState] public NoticeSettingsResponse? Notices { get; set; }

    protected override async Task OnInitializedAsync()
    {
        Mine ??= (await Follows.GetMineAsync()).Value;
        Notices ??= (await Follows.GetNoticesAsync()).Value;
    }

    

    private Task UnfollowBillAsync(string number) => RunAsync(async () =>
    {
        var result = await Follows.UnfollowBillAsync(number);
        await AfterAsync(result);
    });

    private Task UnfollowMpAsync(string slug) => RunAsync(async () =>
    {
        var result = await Follows.UnfollowMpAsync(slug);
        await AfterAsync(result);
    });

    private async Task AfterAsync(ApiResult result)
    {
        if (!result.IsSuccess)
        {
            Show(result.Problem);
            return;
        }

        Mine = (await Follows.GetMineAsync()).Value;
    }

    private Task UnfollowOrganisationAsync(string slug) => RunAsync(async () =>
    {
        var result = await Follows.UnfollowOrganisationAsync(slug);
        await AfterAsync(result);
    });


    private Task SetAsync(bool planned, bool voted, bool statements) => RunAsync(async () =>
    {
        var result = await Follows.SetNoticesAsync(new NoticeSettingsRequest { Planned = planned, Voted = voted, Statements = statements });
        if (!result.IsSuccess)
        {
            // The box the person clicked shows the saved state again: rebuilt, since the values themselves did not change.
            _noticesShown++;
            Show(result.Problem);
            return;
        }

        Notices = new NoticeSettingsResponse(planned, voted, statements);
        Info = L["Follows.Saved"];
    });
}
