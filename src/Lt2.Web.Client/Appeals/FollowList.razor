@using Lt2.Api.Contracts.Follows
@using Lt2.Api.Contracts.Me
@inherits InteractiveBase<AppealUi>
@inject IFollowsApi Follows

@* The account page's follows (design 8.11.2, 8.14.14): the followed bills with their planned date or last stage result,
   the followed MPs and organisations, "Nebesekti", and the email switches (MPs' responses, design 8.20.1; followed members, 8.25.5; comments under one's arguments, 8.23.9). The person's own data only; every follow
   email links here. *@
<section class="sheet stack" aria-labelledby="follows-title" id="sekami">
    <h3 id="follows-title">@L["Follows.Title"]</h3>
    <p>@L["Follows.Lead"]</p>
    @if (Mine is { } mine)
    {
        @if (mine.Bills.Count == 0 && mine.Mps.Count == 0 && mine.Organisations.Count == 0 && (mine.Members ?? []).Count == 0)
        {
            <p class="small" id="follows-none">@L["Follows.None"] <a href="/darbotvarke">@L["Follows.ToAgenda"]</a></p>
        }
        @if (mine.Bills.Count > 0)
        {
            <h4>@L["Follows.Bills"]</h4>
            <ul class="rows" id="follows-bills">
                @foreach (var b in mine.Bills)
                {
                    <li>
                        <div class="rows__main">
                            <a href="/seimas/@Uri.EscapeDataString(b.Number)"><span class="num">@b.Number</span> · @b.Title</a>
                            <span class="small num">
                                @if (b.Planned is { } plan)
                                {
                                    @L.Format("Follows.Planned", Display.Day(plan.Date))
                                }
                                else if (b.LastStageResult is { } vote)
                                {
                                    @L.Format("Follows.Voted", Display.Day(vote.HeldAt))
                                    @(vote.IsConsensus ? " " + L["Follows.Consensus"] : " " + L.Format("Follows.Result", Display.Number(vote.For), Display.Number(vote.Against), Display.Number(vote.Abstain)))
                                }
                                else
                                {
                                    @L["Follows.NothingYet"]
                                }
                            </span>
                            @if (b.New is { } news)
                            {
                                @* Design 8.11.8: what was written since the member last opened the bill's page. *@
                                <span class="small num" id="follows-new-@b.Number">@NewsLine.Of(L, news)</span>
                            }
                        </div>
                        <div class="rows__side">
                            <button type="button" class="btn btn--plain btn--compact" disabled="@Locked" @onclick="() => UnfollowBillAsync(b.Number)">@L["Follow.Unfollow"]</button>
                        </div>
                    </li>
                }
            </ul>
        }
        @if (mine.Mps.Count > 0)
        {
            <h4>@L["Follows.Mps"]</h4>
            <ul class="rows" id="follows-mps">
                @foreach (var m in mine.Mps)
                {
                    <li>
                        <div class="rows__main"><a href="/p/@m.Slug">@m.FirstName @m.LastName</a></div>
                        <div class="rows__side">
                            <button type="button" class="btn btn--plain btn--compact" disabled="@Locked" @onclick="() => UnfollowMpAsync(m.Slug)">@L["Follow.Unfollow"]</button>
                        </div>
                    </li>
                }
            </ul>
        }
        @if (mine.Organisations.Count > 0)
        {
            <h4>@L["Follows.Organisations"]</h4>
            <ul class="rows" id="follows-organisations">
                @foreach (var o in mine.Organisations)
                {
                    <li>
                        <div class="rows__main">
                            <a href="/o/@Uri.EscapeDataString(o.Slug)">@o.Name</a>
                            <span class="small">@OrganisationWords.LabelText(L, o.Label)@(o.Status != "active" ? " · " + L["Org.State." + o.Status] : "")</span>
                        </div>
                        <div class="rows__side">
                            <button type="button" class="btn btn--plain btn--compact" disabled="@Locked" @onclick="() => UnfollowOrganisationAsync(o.Slug)">@L["Follow.Unfollow"]</button>
                        </div>
                    </li>
                }
            </ul>
        }
        @if (mine.Members is { Count: > 0 } members)
        {
            @* Design 8.25.5: members with a public profile; one switched off is gone from this list, without a reason. *@
            <h4>@L["Follows.Members"]</h4>
            <ul class="rows" id="follows-members">
                @foreach (var m in members)
                {
                    <li @key="m.ProfileId">
                        <div class="rows__main"><a href="@ProfileRoutes.Page(m.ProfileId, m.DisplayName)">@m.DisplayName</a></div>
                        <div class="rows__side">
                            <button type="button" class="btn btn--plain btn--compact" disabled="@Locked" @onclick="() => UnfollowMemberAsync(m.ProfileId)">@L["Follow.Unfollow"]</button>
                        </div>
                    </li>
                }
            </ul>
        }
    }
    @if (Notices is { } notices)
    {
        <fieldset class="stack stack--tight" id="follow-notices" @key="_noticesShown">
            <legend class="label">@L["Follows.Emails"]</legend>
            <label class="check"><input type="checkbox" id="notice-planned" checked="@notices.Planned" disabled="@Locked" @onchange="e => SetAsync(notices with { Planned = e.Value is true })" /><span>@L["Follows.Email.planned"]</span></label>
            <label class="check"><input type="checkbox" id="notice-voted" checked="@notices.Voted" disabled="@Locked" @onchange="e => SetAsync(notices with { Voted = e.Value is true })" /><span>@L["Follows.Email.voted"]</span></label>
            <label class="check"><input type="checkbox" id="notice-statements" checked="@notices.Statements" disabled="@Locked" @onchange="e => SetAsync(notices with { Statements = e.Value is true })" /><span>@L["Follows.Email.statements"]</span></label>
            <label class="check"><input type="checkbox" id="notice-responses" checked="@notices.Responses" disabled="@Locked" @onchange="e => SetAsync(notices with { Responses = e.Value is true })" /><span>@L["Follows.Email.responses"]</span></label>
            <label class="check"><input type="checkbox" id="notice-members" checked="@notices.Members" disabled="@Locked" @onchange="e => SetAsync(notices with { Members = e.Value is true })" /><span>@L["Follows.Email.members"]</span></label>
            @* Design 8.23.9: the last switch, about the person's own arguments rather than what they follow. *@
            <label class="check"><input type="checkbox" id="notice-comments" checked="@notices.Comments" disabled="@Locked" @onchange="e => SetAsync(notices with { Comments = e.Value is true })" /><span>@L["Follows.Email.comments"]</span></label>
        </fieldset>
    }
    <Messages Message="@Message" Info="@Info" />
</section>

@code {
    private int _noticesShown;

    [PersistentState] public MyFollowsResponse? Mine { get; set; }

    [PersistentState] public NoticeSettingsResponse? Notices { get; set; }

    protected override async Task OnInitializedAsync()
    {
        Mine ??= (await Follows.GetMineAsync()).Value;
        Notices ??= (await Follows.GetNoticesAsync()).Value;
    }

    

    private Task UnfollowBillAsync(string number) => RunAsync(async () =>
    {
        var result = await Follows.UnfollowBillAsync(number);
        await AfterAsync(result);
    });

    private Task UnfollowMpAsync(string slug) => RunAsync(async () =>
    {
        var result = await Follows.UnfollowMpAsync(slug);
        await AfterAsync(result);
    });

    private async Task AfterAsync(ApiResult result)
    {
        if (!result.IsSuccess)
        {
            Show(result.Problem);
            return;
        }

        Mine = (await Follows.GetMineAsync()).Value;
    }

    private Task UnfollowOrganisationAsync(string slug) => RunAsync(async () =>
    {
        var result = await Follows.UnfollowOrganisationAsync(slug);
        await AfterAsync(result);
    });


    private Task UnfollowMemberAsync(string profileId) => RunAsync(async () =>
    {
        var result = await Follows.UnfollowMemberAsync(profileId);
        await AfterAsync(result);
    });

    private Task SetAsync(NoticeSettingsResponse wanted) => RunAsync(async () =>
    {
        var result = await Follows.SetNoticesAsync(new NoticeSettingsRequest
        {
            Planned = wanted.Planned, Voted = wanted.Voted, Statements = wanted.Statements, Responses = wanted.Responses, Members = wanted.Members,
            Comments = wanted.Comments,
        });
        if (!result.IsSuccess)
        {
            // The box the person clicked shows the saved state again: rebuilt, since the values themselves did not change.
            _noticesShown++;
            Show(result.Problem);
            return;
        }

        Notices = wanted;
        Info = L["Follows.Saved"];
    });
}
