@inherits InteractiveBase<AppealUi>

@* "Pranešti apie klaidą" beside a bill's description (design 8.3, 8.13): a member reports in the product, a visitor is
   told how to. *@
@if (_signedIn)
{
    <div class="stack stack--tight">
        <p><button type="button" class="linkish small" id="report-appeal" disabled="@Locked" @onclick="() => _open = !_open">@L["Report.AppealOpen"]</button></p>
        @if (_open)
        {
            <ReportForm TargetKind="record" TargetId="RecordId" OnClose="() => _open = false" />
        }
    </div>
}
else
{
    <VisitorReport Contact="@Contact" BillRecord="true" />
}

@code {
    private bool _signedIn;
    private bool _open;

    [Parameter, EditorRequired] public Guid RecordId { get; set; }

    [Parameter] public string? Contact { get; set; }

    protected override async Task OnInitializedAsync() =>
        _signedIn = await IsSignedInAsync();
}
