@using Lt2.Api.Contracts.Appeals
@inherits InteractiveBase<AppealUi>
@inject MyBillState Mine
@inject NavigationManager Navigation

@* "Moderavimas" on the bill's page (design 8.12.3), rendered only when the server found a moderator or an administrator
   in a staff-passkey session: the open reports about the description (8.13) and the actions on the bill, "Rašyti
   aprašymą" among them, on any active bill, with or without a record, and the bill's arguments that wait or are
   flagged, with the queue's actions. The state comes from the moderators' own answer, asked for once while the server
   prerenders the moderator's page (shared with the arguments' "Moderuoti" through MyBillState) and not again in the
   browser; for anyone else the server refuses it and nothing renders. After an action the page reloads, so it shows
   the result. *@
@if (State is { Status: "open" } state)
{
    <section class="sheet stack stack--tight" aria-labelledby="moderation-panel-title" id="moderation-panel">
        <h3 id="moderation-panel-title">@L["ModPanel.Title"]</h3>
        <p class="small">@L["ModPanel.Lead"] <a href="/moderavimas">@L["ModPanel.Queue"]</a></p>
        @* The open reports about the description, as the queue shows them, beside its actions (decided 2026-11-14). *@
        <Reports Items="state.DescriptionReports" Description="true" Id="panel-description-reports" />
        <ModerationActions Id="state.Id" Number="@state.Number" Kind="appeal" Status="@state.Status" Held="state.Held" Threshold="state.Threshold" Planned="state.Planned"
                           Description="@state.Description" DescriptionSource="@state.DescriptionSource" DescriptionUrl="@state.DescriptionUrl" ESeimasUrl="@ESeimasUrl"
                           HasOpenItems="state.HasOpenItems" IdPrefix="panel-" OnDone="Reload" />

        @* Arguments that wait or are flagged (decided 2026-11-14): other visitors do not see them; the same actions as the queue. *@
        @if (state.Reasons.Where(NeedsLook).ToList() is { Count: > 0 } waiting)
        {
            <h4 id="moderation-panel-reasons">@L["ModPanel.Reasons"]</h4>
            @foreach (var reason in waiting)
            {
                <QueueReasonItem @key="reason.Id" Reason="reason" Panel="true" OnDone="Reload" OnRestricted="() => Reload(string.Empty)" />
            }
        }
    </section>
}

@code {
    [Parameter, EditorRequired] public string Number { get; set; } = "";

    /// <summary>The bill's text on e-seimas, for the field of pasted official text (design 8.11.4).</summary>
    [Parameter] public string? ESeimasUrl { get; set; }

    [PersistentState] public ModerationBillResponse? State { get; set; }

    /// <summary>Set once the server has asked, so the browser does not ask again.</summary>
    [PersistentState] public bool? Asked { get; set; }

    protected override async Task OnInitializedAsync()
    {
        if (Asked == true)
        {
            // In the browser: hand the answer the server brought to the arguments' "Moderuoti".
            if (State is { } known)
            {
                Mine.Remember(Number, known);
            }

            return;
        }

        Asked = true;
        if (await IsSignedInAsync())
        {
            State = await Mine.ModerationAsync(Number);
        }
    }

    private void Reload(string _) => Navigation.NavigateTo(Navigation.Uri, forceLoad: true);

    /// <summary>Waits for a moderator, carries a pre-screening flag, or has an open report.</summary>
    private static bool NeedsLook(QueueReasonResponse reason) => reason.Status == "pending" || reason.Flags.Count > 0 || reason.Reports.Count > 0;
}
