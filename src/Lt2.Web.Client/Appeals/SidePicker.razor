@using Lt2.Api.Contracts.Appeals
@inherits InteractiveBase<AppealUi>
@implements IDisposable
@inject IAppealsApi Appeals
@inject IMeApi MeApi
@inject NavigationManager Navigation
@inject MyBillState State
@inject MyAccountState Account

@* Taking a side (design 8.12.1): the two buttons under the counts, on any active bill, the first side creating the bill's
   record. A visitor gets links to sign in, which also work without JavaScript. The side shown is only ever the visitor's
   own. The share line (8.11.5) follows right below, with the threshold. The MP's own account takes no side (design 8.5.4,
   owner 2026-11-17): once the island runs it shows one line pointing to the MP's response instead. *@
<div class="stack stack--tight" id="side-picker">
    @if (!_signedIn)
    {
        <div class="pair">
            <a class="btn btn--for btn--wide" href="@SignInHref">@L["Side.for"]</a>
            <a class="btn btn--against btn--wide" href="@SignInHref">@L["Side.against"]</a>
        </div>
        <p class="small">@L["Side.SignIn"]</p>
    }
    else if (_mpAccount)
    {
        <p class="small" id="side-mp-account">@L["Side.MpAccount"] <a href="@($"/seimas/{Uri.EscapeDataString(Number)}#atsakymai")">@L["Side.MpAccount.Respond"]</a></p>
    }
    else if (_consentFor is { } wanted)
    {
        <PositionConsentForm Side="@wanted" Locked="Locked" OnConfirm="() => ConsentAndTakeAsync(wanted)" OnCancel="() => _consentFor = null" />
    }
    else
    {
        @* Owner, 2026-11-18: the pressed button takes the side back when pressed again (no "Atsiimti"); the other one changes
           it. aria-pressed says the state and the line under the buttons, which the pressed one is described by, whose side
           it is; how to take it back is only the pressed button's title (owner, 2026-11-19: the line saying so went; a later
           onboarding is to explain it).
           Until the island has started, and while a press is sent, the pair is busy: the buttons stay disabled but keep their
           colour (owner, 2026-11-18; lt2.css, "Waiting"). *@
        <div class="pair sides" aria-busy="@(Locked ? "true" : null)">
            @foreach (var side in Sides.All)
            {
                var chosen = Mine?.Side == side;
                <button type="button" class="btn btn--@side btn--wide" id="side-@side" aria-pressed="@(chosen ? "true" : "false")"
                        aria-describedby="@(chosen ? "my-side" : null)" title="@(chosen ? L["Side.PressAgain"].Value : null)"
                        disabled="@(Locked || Mine is null)" @onclick="e => ChooseAsync(side, e)">@if (chosen)
                {
                    <span class="sides__check" aria-hidden="true">✓</span>
                }@L["Side." + side]</button>
            }
        </div>
        @if (Mine?.Side is { } mySide)
        {
            <p class="small" id="my-side">@L["Side.Yours." + mySide]</p>
        }
        else
        {
            <p class="small">@L["Side.Private"]</p>
        }
    }
    <Messages Message="@Message" Info="@Info" />
</div>

@code {
    /// <summary>The sign-in page that brings the visitor back to this page when it is a bill's (design 6.9).</summary>
    private string SignInHref => LandingPath.SignInLink(LandingPath.PathOf(Navigation.Uri, Navigation.BaseUri));

    private bool _signedIn;
    private bool _mpAccount;
    private string? _consentFor;

    [Parameter, EditorRequired] public string Number { get; set; } = "";

    [PersistentState] public MyBillRecordResponse? Mine { get; set; }

    protected override async Task OnInitializedAsync()
    {
        _signedIn = await IsSignedInAsync();
        if (_signedIn && Mine is null)
        {
            Mine = await State.MineAsync(Number);
        }

        _mpAccount = _signedIn && await Account.IsMpAccountAsync(RendererInfo.IsInteractive);
        if (_signedIn && RendererInfo.IsInteractive)
        {
            State.Changed += OnChanged;
        }
    }

    public void Dispose() => State.Changed -= OnChanged;

    /// <summary>
    /// Another island acted (owner, 2026-11-18: a first "Man svarbu" may give the positions consent): the person's own answer
    /// is read again, so a side pressed next does not ask for a consent already given.
    /// </summary>
    private void OnChanged(BillChange change)
    {
        if (!change.Concerns(Number, this) || change.ByModerator)
        {
            return;
        }

        _ = InvokeAsync(async () =>
        {
            try
            {
                Mine = await State.MineAsync(Number) ?? Mine;
                StateHasChanged();
            }
            catch (HttpRequestException)
            {
                // The answer shown stays; the next press reads again through the server's answer.
            }
        });
    }

    /// <summary>
    /// A press on a side's button (owner, 2026-11-18): on the side one has, it takes the side back; on the other, it takes or
    /// changes it. The buttons are disabled while a request runs, and the second click of a double click
    /// (<see cref="SidePresses.Ignored"/>) does nothing, so a side just taken is not taken back by the same gesture.
    /// </summary>
    private Task ChooseAsync(string side, MouseEventArgs press)
    {
        if (Busy || SidePresses.Ignored(press.Detail))
        {
            return Task.CompletedTask;
        }

        return RunAsync(async () =>
        {
            if (Mine?.Side == side)
            {
                await WithdrawAsync(side);
                return;
            }

            if (Mine is { HasPositionConsent: false })
            {
                _consentFor = side;
                return;
            }

            await TakeAsync(side);
        });
    }

    private Task ConsentAndTakeAsync(string side) => RunAsync(async () =>
    {
        var consent = await MeApi.GivePositionConsentAsync(new PositionConsentRequest { TextVersion = PositionConsentText.Version });
        if (!consent.IsSuccess)
        {
            Show(consent.Problem);
            return;
        }

        _consentFor = null;
        await TakeAsync(side);
    });

    private async Task TakeAsync(string side)
    {
        if (Mine?.Side == side)
        {
            return;
        }

        var result = await Appeals.TakePositionAsync(Number, new PositionRequest { Side = side });
        if (result.Problem?.Code == "consent.required")
        {
            // The consent was withdrawn since the page was read: ask for it again.
            _consentFor = side;
            return;
        }

        if (!result.IsSuccess)
        {
            Show(result.Problem);
            return;
        }

        await ChangedAsync();
    }

    /// <summary>
    /// Takes the side back, naming it: the server changes nothing when the person no longer has it (another tab changed it,
    /// a request arriving late). The person's "Man svarbu" marks stay and stop counting.
    /// </summary>
    private async Task WithdrawAsync(string side)
    {
        var result = await Appeals.ClearPositionAsync(Number, new PositionRequest { Side = side });
        if (!result.IsSuccess)
        {
            Show(result.Problem);
            return;
        }

        await ChangedAsync();
    }

    /// <summary>
    /// Without reloading the page (owner, 2026-11-17): the other islands read their part again, the counts and the threshold
    /// the bill's live numbers, the arguments the marks a changed side dropped, the follow button the follow a first side
    /// made (design 8.11.2), the date flag whether there is a side; this one the person's own answer.
    /// </summary>
    private async Task ChangedAsync()
    {
        State.Announce(Number, this);
        Mine = await State.MineAsync(Number) ?? Mine;
    }
}
