@inherits LiveRecordBase
@inject IMeApi MeApi

@* Sharing towards the threshold (design 8.11.5), for a signed-in member only: how many are still missing (nothing once it is
   reached: the threshold's line says so), the link to share and a copy button. The link is this page's own address, so a link preview shows
   the bill (owner, 2026-11-17), with the member's invitation code after the "#"; the same whichever side the member took:
   nothing about a side is in it. A code switched off or used up: the plain address, and one line saying why there is no code.
   Visitors get nothing here and the server is not asked. What is still missing follows a side taken on the page
   (LiveRecordBase). *@
@if (_member && Invitation is { } mine)
{
    <div class="stack stack--tight share" id="share-line">
        @* Once the threshold is reached the threshold's own line above says so (design 8.12.2, owner 2026-11-18); not twice. *@
        @if (Missing > 0)
        {
            <p class="small num"><b>@L.Format("Share.ToGo", Display.Number(Missing))</b></p>
        }
        <p class="small">@L["Share.Lead"]</p>
        <CopyLink Link="@LandingPath.ShareLink(mine.Usable ? mine.Code : null, Path)" LinkId="share-link" ButtonId="share-copy" />
        @if (!mine.Usable)
        {
            <p class="small" id="share-no-link">@L["Share.NoLink"]</p>
        }
    </div>
}

@code {
    private bool _member;

    /// <summary>The page the link leads to: the bill's page, for example <c>/seimas/XVP-0412</c>.</summary>
    [Parameter, EditorRequired] public string Path { get; set; } = "";

    /// <summary>Participants still missing to the threshold (0 = reached).</summary>
    [Parameter] public int ToGo { get; set; }

    private int Missing => Live is { Threshold: var t } ? MissingOf(t) : ToGo;

    /// <summary>
    /// Participants still missing to the threshold: none once it is reached, which a bill that has been in a summary really
    /// sent to MPs is, whatever its participants now (design 8.12.2, <c>first_summarised_at</c>).
    /// </summary>
    public static int MissingOf(ThresholdResponse threshold) =>
        threshold.Reached ? 0 : Math.Max(0, threshold.Value - threshold.Participants);

    private MyInvitationResponse? Invitation { get; set; }

    protected override async Task OnInitializedAsync()
    {
        // Asked only once the island runs in the browser: the line needs script anyway (copying), and while the server
        // prerenders, other islands of the page use the same request's account context.
        _member = await IsSignedInAsync();
        if (_member && RendererInfo.IsInteractive)
        {
            Invitation = (await MeApi.GetInvitationAsync()).Value;
        }
    }
}
