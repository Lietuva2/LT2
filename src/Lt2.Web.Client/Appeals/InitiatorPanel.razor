@using Lt2.Api.Contracts.Appeals
@inherits InteractiveBase
@inject IAppealsApi Appeals
@inject NavigationManager Navigation

@* For the initiator only: a returned appeal is corrected and sent again; the threshold is changed until the appeal
   first enters a summary or a moderator changed it (design 8.4). Renders nothing for anyone else. The page places the
   two parts apart: the description under the text, the threshold in the threshold panel (Part). *@
@if (Mine is { IsInitiator: true } mine)
{
    @if (Part != "threshold" && Status is "pending" or "returned" && Restriction is { Restricted: true } restriction)
    {
        <WritingRestricted Restriction="restriction" />
    }
    else if (Part != "threshold" && Status == "pending" && !_editing)
    {
        @* A waiting proposal is edited on request; a returned one shows the form at once, since it must be corrected. *@
        <div class="row">
            <button type="button" class="btn btn--plain" id="edit-open" disabled="@Locked" @onclick="() => _editing = true">@L["Change.Open"]</button>
        </div>
    }
    else if (Part != "threshold" && Status is "pending" or "returned")
    {
        <form class="sheet stack" @onsubmit="EditAsync" novalidate aria-labelledby="edit-title" id="edit-appeal">
            <h2 id="edit-title">@L[Status == "returned" ? "Edit.TitleReturned" : "Edit.Title"]</h2>
            <div class="field @(Errors.ContainsKey("description") ? "field--error" : "")">
                <label for="edit-description">@L["Open.Description"]</label>
                <textarea class="textarea" id="edit-description" maxlength="@AppealLimits.DescriptionMaxLength" @bind="_description" disabled="@Locked"></textarea>
                <FieldError Errors="Errors" Field="description" />
            </div>

            <button type="submit" class="btn" disabled="@Locked">@L["Edit.Submit"]</button>
        </form>
    }

    @if (Part != "description" && mine.MayChangeThreshold)
    {
        <form class="stack stack--tight" @onsubmit="ChangeThresholdAsync" novalidate aria-labelledby="threshold-title" id="change-threshold">
            <h3 id="threshold-title">@L["Threshold.Change"]</h3>
            <div class="field @(Errors.ContainsKey("threshold") ? "field--error" : "")">
                <label for="threshold-value">@L["Threshold.Label"]</label>
                <input class="input num" type="number" id="threshold-value" min="1" step="1" @bind="_threshold" disabled="@Locked" />
                <FieldError Errors="Errors" Field="threshold" />
            </div>
            <button type="submit" class="btn btn--plain" disabled="@Locked">@L["Threshold.Save"]</button>
        </form>
    }

    <Messages Message="@Message" Info="@Info" />
}

@code {
    private string _description = "";
    private int _threshold;
    private bool _editing;

    [Parameter, EditorRequired] public string Number { get; set; } = "";

    [Parameter, EditorRequired] public string Status { get; set; } = "";

    [Parameter] public string Description { get; set; } = "";

    [Parameter] public int Threshold { get; set; }

    /// <summary><c>description</c>, <c>threshold</c>, or empty for both.</summary>
    [Parameter] public string Part { get; set; } = "";

    [CascadingParameter] private Task<AuthenticationState>? AuthState { get; set; }

    [PersistentState] public MyAppealResponse? Mine { get; set; }

    /// <summary>The person's own writing restriction (design 8.3): editing the description or first argument is writing.</summary>
    [PersistentState] public MyRestrictionResponse? Restriction { get; set; }

    protected override async Task OnInitializedAsync()
    {
        if (AuthState is null || (await AuthState).User.Identity?.IsAuthenticated != true)
        {
            return;
        }

        Mine ??= (await Appeals.GetMineAsync(Number)).Value;
        if (Mine?.IsInitiator == true)
        {
            Restriction ??= (await Appeals.GetMyRestrictionAsync()).Value;
        }

        _description = Description;
        _threshold = Threshold;
    }

    private Task EditAsync() => RunAsync(async () =>
    {
        var result = await Appeals.EditAsync(Number, new EditAppealRequest { Description = _description });
        if (!result.IsSuccess)
        {
            Show(result.Problem, "description");
            return;
        }

        Navigation.NavigateTo(Navigation.Uri, forceLoad: true);
    });

    private Task ChangeThresholdAsync() => RunAsync(async () =>
    {
        var result = await Appeals.ChangeThresholdAsync(Number, new ThresholdRequest { Threshold = _threshold });
        if (!result.IsSuccess)
        {
            Show(result.Problem, "threshold");
            return;
        }

        Navigation.NavigateTo(Navigation.Uri, forceLoad: true);
    });
}
