@inherits InteractiveBase<AppealUi>
@implements IDisposable
@inject MyAgendaState State

@* A member's own mark under a title in the timeline, on the front page and the agenda page (design 8.7, 8.11.1): "Sekate",
   their own side and, on a followed bill, what is new there since they last opened its page as a small link to it, the
   same line as "Jūsų projektai" (design 8.11.8; owner, 2026-11-19: "the same like start page"). Filled only in
   the browser from the member's own answer (MyAgendaState, one request for the whole page), and read again when the member
   acts in a row (a first side also follows the bill, design 8.11.2): while the server prerenders, the mark is empty, so
   the page's HTML is the same for every member. *@
@if (_mine is { } mine)
{
    <p class="mine small" id="home-mine-@Place">
        @if (mine.Following)
        {
            <span class="tag tag--people">@L["Mine.Following"]</span>
        }
        @if (mine.Side is { } side)
        {
            @L["Mine.Side"]@(" ")<span class="choice choice--@side">@L["Mine.Side." + side]</span>
        }
        else
        {
            @L["Mine.NoSide"]
        }
        @if (mine is { Following: true, New: { } news })
        {
            <a class="num" href="@("/seimas/" + Uri.EscapeDataString(Number))" id="home-new-@Place">@NewsLine.Of(L, news)</a>
        }
    </p>
}

@code {
    private MyBillResponse? _mine;

    [Parameter, EditorRequired] public string Number { get; set; } = "";

    /// <summary>Every bill the page shows, so all the islands share one request.</summary>
    [Parameter, EditorRequired] public IReadOnlyList<string> Numbers { get; set; } = [];

    /// <summary>
    /// Where the row is, for the element ids: a bill may be planned on two days and voted in the same week, so its number
    /// alone would repeat an id. The planned rows pass <c>{yyyy-MM-dd}-{number}</c>, the voted ones <c>voted-{vote id}</c>.
    /// </summary>
    [Parameter, EditorRequired] public string Place { get; set; } = "";

    protected override async Task OnInitializedAsync()
    {
        // Only in the browser: the server never asks, so nothing of the member's own is in the page's HTML.
        if (RendererInfo.IsInteractive && await IsSignedInAsync())
        {
            State.Changed += OnChanged;
            await ReadAsync();
        }
    }

    public void Dispose() => State.Changed -= OnChanged;

    private async Task ReadAsync() => _mine = (await State.MineAsync(Numbers))?.Bills.GetValueOrDefault(Number);

    private void OnChanged() => _ = InvokeAsync(async () =>
    {
        await ReadAsync();
        StateHasChanged();
    });
}
