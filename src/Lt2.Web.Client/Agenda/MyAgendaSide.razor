@using Lt2.Api.Contracts.Agenda
@using Lt2.Api.Contracts.Digests
@inherits InteractiveBase<AppealUi>
@implements IDisposable
@inject MyAgendaState State
@inject IAppealsApi Appeals
@inject IMeApi MeApi
@inject IDigestsApi Digests

@* A member's side column in a row of the timeline, on the front page and the agenda page alike (design 8.7, "Taking a side
   in the row"; 8.11.1, owner 2026-11-19), for a bill whose record is open. Under the bill's numbers a coming bill offers
   "Prašau balsuoti" with "už" and "prieš": one press saves the side with the same request and rules as the bill's page;
   the pressed button shows the member's side and, pressed again, takes it back (owner, 2026-11-18: no "Atsiimti"); the
   other one changes it; aria-pressed says the state and the pressed button's title how to take it back, with no line
   under the buttons (owner, 2026-11-19: a later onboarding is to explain it). Beside the buttons no line says nobody took
   part yet, and no link leads to the
   arguments: the title is the way to the bill (owner, 2026-11-19: "minimise non-essential texts"); a row without buttons
   (a vote's, the MP's own account) keeps "nobody yet". The first side ever asks
   for the positions consent across the row's whole width (PositionConsentForm, the bill page's form); nothing is saved
   before it. A first side also follows the bill (design 8.11.2, on the server); "Sekate" then shows in the row's mark and
   the panel, which read the shared answer again (MyAgendaState.Changed), and no line under the buttons says so (owner,
   2026-11-19: "No need, if the label 'Sekate' lights up anyway"). After the member's own action the row shows the
   bill's live numbers from its public answer, not the page's copy that may be a minute old; so does it once on start when
   that copy says nobody took part but the member's own answer has a side. A row of the last week's
   votes (VoteId) offers no sides, only "Kaip balsavo Seimo nariai"; nor does a row for an MP's own account (design 8.5.4,
   known from the browser's answer), which keeps the numbers only.

   Rendered straight into the row (the side column and, while asked, the consent as the row's last part). While the server
   prerenders and before the island has started the numbers are the page's and the buttons are disabled: the same HTML
   for every member, nothing of the member's own in it. *@
<div class="tl-item__side" id="home-side-@Place">
    <RecordFigures Record="Shown" HideNobody="@(Asks || _mine?.Side is not null)" Id="@Place" />
    @if (VoteId is { } vote)
    {
        <a class="btn btn--plain cta" href="/seimas/balsavimai/@vote">@L["Agenda.Action.Votes"]</a>
    }
    else if (_answer is { MpAccount: true })
    {
        @* Design 8.5.4 (owner, 2026-11-17): the MP's own account takes no side; the row keeps the numbers only. *@
    }
    else
    {
        <div class="tl-ask">
            <span class="small">@L["Agenda.Ask"]</span>
            <div class="tl-ask__sides sides" aria-busy="@(Waiting ? "true" : null)">
                @foreach (var side in Sides.All)
                {
                    var chosen = _mine?.Side == side;
                    <button type="button" class="btn btn--@side cta" id="home-@side-@Place" aria-pressed="@(chosen ? "true" : "false")"
                            aria-label="@L.Format("Agenda.Ask." + side, Number)" title="@(chosen ? L["Side.PressAgain"].Value : null)"
                            disabled="@(Locked || _answer is null)"
                            @onclick="e => ChooseAsync(side, e)">@if (chosen)
                        {
                            <span class="sides__check" aria-hidden="true">✓</span>
                        }@L[side == Sides.For ? "Agenda.For" : "Agenda.Against"]</button>
                }
            </div>
        </div>
        <Messages Message="@Message" />
    }
</div>
@if (_consentFor is { } wanted)
{
    <div class="tl-item__consent" id="home-consent-@Place">
        <PositionConsentForm Side="@wanted" Locked="Locked" IdPrefix="@($"home-{Place}-")"
                             OnConfirm="() => ConsentAndTakeAsync(wanted)" OnCancel="() => _consentFor = null" />
    </div>
}

@code {
    private MyAgendaAnswer? _answer;
    private MyBillResponse? _mine;
    private AgendaRecordResponse? _live;
    private string? _consentFor;

    [Parameter, EditorRequired] public string Number { get; set; } = "";

    /// <summary>Every bill the page shows, so all the islands share one request.</summary>
    [Parameter, EditorRequired] public IReadOnlyList<string> Numbers { get; set; } = [];

    /// <summary>The row's place, for the element ids (see MyAgendaMark).</summary>
    [Parameter, EditorRequired] public string Place { get; set; } = "";

    /// <summary>The bill's public numbers as the page has them (public, the same for everyone; up to a minute old).</summary>
    [Parameter, EditorRequired] public AgendaRecordResponse Record { get; set; } = default!;

    /// <summary>A row of the last week's votes: no sides to take, the link to the vote instead.</summary>
    [Parameter] public long? VoteId { get; set; }

    private AgendaRecordResponse Shown => _live ?? Record;

    /// <summary>The member's answer is being read: from the server's render until the island's first read ends.</summary>
    private bool _reading = true;

    /// <summary>
    /// Before the island has started and read the member's answer, and while a press is sent, the buttons are disabled but
    /// keep their colour (owner, 2026-11-18; lt2.css, "Waiting"). An answer that could not be read leaves them disabled
    /// and dimmed, not waiting.
    /// </summary>
    private bool Waiting => Locked || (_answer is null && _reading);

    /// <summary>
    /// The row offers the sides (a coming bill, not the MP's own account): no "nobody yet" beside them (owner, 2026-11-19).
    /// Before the answer is read it is a member's row like any other.
    /// </summary>
    private bool Asks => VoteId is null && _answer is not { MpAccount: true };

    protected override async Task OnInitializedAsync()
    {
        // Only in the browser: the server never asks, so nothing of the member's own is in the page's HTML.
        if (RendererInfo.IsInteractive && await IsSignedInAsync())
        {
            State.Changed += OnChanged;
            try
            {
                await ReadAsync();
            }
            finally
            {
                _reading = false;
            }

            // The page's copy is up to a minute old: when it says nobody took part but the member's own answer has a side,
            // the bill's live numbers are read once (the same answer as after an action). No request in any other case.
            if (_mine?.Side is not null && Record.Counts.For + Record.Counts.Against == 0)
            {
                await ReadLiveAsync();
            }
        }
    }

    public void Dispose() => State.Changed -= OnChanged;

    private async Task ReadAsync()
    {
        _answer = await State.MineAsync(Numbers);
        _mine = _answer?.Bills.GetValueOrDefault(Number);
    }

    private void OnChanged() => _ = InvokeAsync(async () =>
    {
        await ReadAsync();
        StateHasChanged();
    });

    /// <summary>
    /// A press on a side's button (design 8.7, owner 2026-11-18): the side one has is taken back, the other taken or changed.
    /// Disabled while a request runs; the second click of a double click does nothing (<see cref="SidePresses"/>).
    /// </summary>
    private Task ChooseAsync(string side, MouseEventArgs press)
    {
        if (Busy || SidePresses.Ignored(press.Detail))
        {
            return Task.CompletedTask;
        }

        return RunAsync(async () =>
        {
            if (_mine?.Side == side)
            {
                await WithdrawAsync(side);
                return;
            }

            if (_answer is { HasPositionConsent: false })
            {
                _consentFor = side;
                return;
            }

            await TakeAsync(side);
        });
    }

    private Task ConsentAndTakeAsync(string side) => RunAsync(async () =>
    {
        var consent = await MeApi.GivePositionConsentAsync(new PositionConsentRequest { TextVersion = PositionConsentText.Version });
        if (!consent.IsSuccess)
        {
            Show(consent.Problem);
            return;
        }

        State.SetConsent(true);
        _consentFor = null;
        await TakeAsync(side);
    });

    private async Task TakeAsync(string side)
    {
        var result = await Appeals.TakePositionAsync(Number, new PositionRequest { Side = side });
        if (result.Problem?.Code == "consent.required")
        {
            // The consent was withdrawn since the page was read: ask for it here, as for a first side.
            State.SetConsent(false);
            await ReadAsync();
            _consentFor = side;
            return;
        }

        if (!result.IsSuccess)
        {
            Show(result.Problem);
            return;
        }

        // A first side also follows the bill (design 8.11.2): the row's mark shows "Sekate" once the shared answer is read
        // again, and nothing else says so (owner, 2026-11-19: no "Dabar sekate šį projektą.").
        await AfterChangeAsync();
    }

    /// <summary>Takes the side back, naming it: nothing changes on the server when the member no longer has it.</summary>
    private async Task WithdrawAsync(string side)
    {
        var result = await Appeals.ClearPositionAsync(Number, new PositionRequest { Side = side });
        if (!result.IsSuccess)
        {
            Show(result.Problem);
            return;
        }

        await AfterChangeAsync();
    }

    /// <summary>The bill's live numbers from its public answer, and the member's own answer read again for every island.</summary>
    private async Task AfterChangeAsync()
    {
        await ReadLiveAsync();
        await State.RefreshAsync();
        await ReadAsync();
    }

    /// <summary>The bill's live numbers from its public answer; a failed read keeps the numbers shown.</summary>
    private async Task ReadLiveAsync()
    {
        try
        {
            if ((await Appeals.GetRecordAsync(Number)).Value is { } live)
            {
                _live = new AgendaRecordResponse(live.Id, live.Status, live.Counts, live.Threshold) { Summary = await SummaryAsync(live) };
            }
        }
        catch (HttpRequestException)
        {
            // The page's copy stays; the next action reads again.
        }
    }

    /// <summary>
    /// The summary the row names once the threshold is reached (design 8.12.2, owner 2026-11-21). A side changes the numbers,
    /// not the summaries' days, so the row keeps the one the page has; only a threshold first reached by the member's own
    /// action asks the day of the next summary, as the bill's page does (one request, then never again for this row).
    /// </summary>
    private async Task<RecordSummaryResponse?> SummaryAsync(BillRecordResponse live)
    {
        var known = _live?.Summary ?? Record.Summary;
        if (known is not null || !live.Threshold.Reached || Record.Threshold.Reached || _live is { Threshold.Reached: true } || live.Status != BillRecordStatuses.Open)
        {
            return known;
        }

        return RowSummaryRules.Of(live.Status, reached: true, (await Digests.GetRecordNextDigestAsync(Number)).Value?.Day, lastSent: null);
    }
}
