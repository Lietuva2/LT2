@inherits InteractiveBase<AppealUi>
@implements IDisposable
@inject MyAgendaState State

@* "Jūsų projektai" at the top of the front page for a member (design 8.7, from variant C): the bills on the agenda or voted
   in the last week that the member follows (owner, 2026-11-17: "followed only"; a side alone puts no bill here, it shows in
   the bill's own row), whichever of them the timeline shows (owner, 2026-11-18: the timeline shows a few rows a day), each
   with its planned date, their own side or "Dar nenurodėte, ko prašote", the last vote's result, and the share link when
   they have taken a side. Everything comes from the member's own answers (their follows, with each bill's planned date and
   last vote, and their sides), asked only in the browser, so nothing shows until they have loaded and nothing of them is
   in the page's HTML. When the member takes, changes or withdraws a side in a row of the timeline, the panel follows
   without a reload (MyAgendaState.Changed). *@
@if (_rows is { } rows)
{
    <section class="sheet stack stack--tight my-agenda" aria-labelledby="h-my-agenda" id="my-agenda">
        <h2 id="h-my-agenda">@L["Mine.Title"]</h2>
        @if (rows.Count == 0)
        {
            <p class="small" id="my-agenda-none">@L["Mine.None"]</p>
        }
        else
        {
            <ul class="my-agenda__list">
                @foreach (var (bill, ownSide) in rows)
                {
                    <li id="my-agenda-@bill.Number" @key="bill.Number">
                        <span class="row">
                            <a class="tag tag--ink num" href="@BillPath(bill.Number)">@bill.Number</a>
                            @if (bill.Planned is { } planned)
                            {
                                <span class="tag num">@L.Format("Mine.Planned", Display.Day(planned.Date))</span>
                            }
                        </span>
                        <a class="my-agenda__title" href="@BillPath(bill.Number)">@bill.Title</a>
                        <span class="small">
                            @if (ownSide is { } side)
                            {
                                @L["Mine.Side"]@(" ")<span class="choice choice--@side">@L["Mine.Side." + side]</span>
                            }
                            else
                            {
                                <a href="@BillPath(bill.Number)">@L["Mine.NoSideAction"]</a>
                            }
                        </span>
                        @if (bill.LastStageResult is { } vote && vote.HeldAt >= Since)
                        {
                            @* The last week's vote, as the account's list of followed bills says it (design 8.11.2). *@
                            <span class="small num">@L.Format("Follows.Voted", Display.Day(vote.HeldAt)) @(vote.IsConsensus ? L["Follows.Consensus"] : L.Format("Follows.Result", Display.Number(vote.For), Display.Number(vote.Against), Display.Number(vote.Abstain)))</span>
                        }
                        @if (bill.New is { } news)
                        {
                            @* Design 8.11.8: what was written on a followed bill since the member last opened its page. *@
                            <a class="small num" href="@BillPath(bill.Number)" id="my-agenda-new-@bill.Number">@NewsLine.Of(L, news)</a>
                        }
                        @if (ownSide is not null && _shareCode is { } shareCode)
                        {
                            <div class="stack stack--tight">
                                <span class="small">@L["Mine.Share"]</span>
                                <CopyLink Link="@LandingPath.ShareLink(shareCode, BillPath(bill.Number))" ButtonId="@($"my-agenda-share-{bill.Number}")" />
                            </div>
                        }
                    </li>
                }
            </ul>
        }
        <p class="small"><a href="@AccountScreens.FollowsList">@L["Mine.All"]</a></p>
    </section>
}
else if (Message is not null)
{
    @* The member's own answer did not come: say so, so the panel is not silently missing. *@
    <section class="sheet stack stack--tight my-agenda" aria-labelledby="h-my-agenda" id="my-agenda-failed">
        <h2 id="h-my-agenda">@L["Mine.Title"]</h2>
        <Messages Message="@Message" />
    </section>
}

@code {
    private IReadOnlyList<MyAgendaRow>? _rows;
    /// <summary>The member's invitation code while it lets a registration through (design 8.11.5: the share link is the bill's address with it after the "#").</summary>
    private string? _shareCode;

    /// <summary>When the panel was read: a vote since then less the agenda's week is "the last week's".</summary>
    private DateTimeOffset Since { get; set; }

    /// <summary>Every bill the page shows (the timeline's marks ask with the same list, so the page asks once).</summary>
    [Parameter, EditorRequired] public IReadOnlyList<string> Numbers { get; set; } = [];

    [Inject] private TimeProvider Clock { get; set; } = default!;

    private static string BillPath(string number) => "/seimas/" + Uri.EscapeDataString(number);

    protected override async Task OnInitializedAsync()
    {
        // Only in the browser: while the server prerenders, the panel is not there at all.
        if (!RendererInfo.IsInteractive || !await IsSignedInAsync())
        {
            return;
        }

        State.Changed += OnChanged;
        await ReadAsync();
    }

    public void Dispose() => State.Changed -= OnChanged;

    private async Task ReadAsync()
    {
        if (await State.PanelAsync(Numbers) is not { } rows)
        {
            Message = L["Error.Generic"];
            return;
        }

        Message = null;
        Since = Clock.GetUtcNow().AddDays(-MyAgendaState.RecentDays);
        _rows = rows;
        if (_shareCode is null && rows.Any(r => r.Side is not null) && await State.InvitationAsync() is { Usable: true } invitation)
        {
            _shareCode = invitation.Code;
        }
    }

    private void OnChanged() => _ = InvokeAsync(async () =>
    {
        await ReadAsync();
        StateHasChanged();
    });
}
