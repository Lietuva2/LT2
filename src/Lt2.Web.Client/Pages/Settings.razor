@page "/administravimas/nustatymai"
@attribute [Authorize]
@rendermode InteractiveWebAssembly
@using System.Text.Json
@using Lt2.Api.Contracts.Admin
@using Lt2.Api.Contracts.Appeals
@using Lt2.Api.Contracts.Auth
@using Lt2.Api.Contracts.Me
@using Lt2.Web.Client.Appeals
@inherits InteractiveBase<AppealUi>
@inject IAdminApi Admin
@inject IAuthApi Auth
@inject IMeApi Me
@inject Passkeys PasskeyBrowser

@* The administrator's settings screen (design 5.6, decided 2026-11-13): grouped under headings, each setting with a plain
   label, one sentence on what it does and when to change it, its unit, the default and the key in small type; the
   rarely changed security limits in their own group, which says so. Each change is audited by the server. Needs the
   active administrator role of a staff-passkey session, and saving asks for the staff passkey again unless it was
   confirmed in the last ten minutes (design 6.9: the server's ten-minute rule, the same as for changing roles). *@
<PageTitle>@L["Admin.PageTitle"]</PageTitle>

<div class="stack">
    <p class="label">Lietuva 2.0</p>
    <h1>@L["Admin.Title"]</h1>
    <NeedsScript />
    <p class="lead">@L["Admin.Lead"]</p>
    <p class="small" id="admin-passkey-note">@L["Admin.PasskeyNote"]</p>
</div>

<Messages Message="@Message" Info="@Info" />

@if (_refused)
{
    <p class="note" role="alert">@L["Admin.Refused"]</p>
}
else if (Items is null)
{
    <p class="small">@L["Loading"]</p>
}
else
{
    @foreach (var (group, keys) in Groups(Items))
    {
        <section class="sheet stack" aria-labelledby="h-@group" id="group-@group">
            <h2 id="h-@group">@L["Admin.Group." + group]</h2>
            @if (L["Admin.GroupNote." + group] is { ResourceNotFound: false } note)
            {
                <p class="note note--quiet">@note</p>
            }
            @if (group == "summaries")
            {
                @* Design 8.19.5, 8.19.6: the letter that must go first, and the addresses never written to again. *@
                <p class="row small" id="summaries-links">
                    <a href="@Lt2.Api.Contracts.Digests.MpSendingAdminRoutes.IntroductionPage" id="link-introduction">@L["Intro.Title"]</a>
                    <a href="@Lt2.Api.Contracts.Digests.MpSendingAdminRoutes.SuppressionPage" id="link-suppression">@L["Supp.Title"]</a>
                </p>
            }
            <ul class="rows settings">
                @foreach (var setting in keys)
                {
                    var id = "setting-" + setting.Key.Replace(':', '-');
                    <li id="row-@id">
                        <div class="rows__main stack stack--tight">
                            <label for="@id"><b>@Name(setting.Key)</b></label>
                            @if (Help(setting.Key) is { } help)
                            {
                                <span class="small" id="help-@id">@help</span>
                            }
                            @if (setting.Key == "Digest:ThresholdMinimum")
                            {
                                <span class="note note--quiet" id="placeholder-minimum">@L["Admin.MinimumPlaceholder"]</span>
                            }
                            <span class="fine">
                                @L.Format("Admin.DefaultIs", Shown(setting.Default)) ·
                                @(setting.ChangedAt is { } at ? L.Format("Admin.Changed", Display.DayTime(at)) : L["Admin.NotChanged"]) ·
                                <code>@setting.Key</code>
                            </span>
                        </div>
                        <div class="rows__side row">
                            <input class="input num settings__value" id="@id" aria-describedby="@DescribedFor(setting.Key, id)"
                                   value="@(_drafts.GetValueOrDefault(setting.Key) ?? Shown(setting.Value))"
                                   @onchange="e => _drafts[setting.Key] = e.Value?.ToString()" disabled="@Locked" />
                            @if (Unit(setting.Key) is { Length: > 0 } unit)
                            {
                                <span class="small" id="unit-@id">@unit</span>
                            }
                            <button type="button" class="btn btn--plain" disabled="@Locked" @onclick="() => SaveAsync(setting.Key)">@L["Admin.Save"]</button>
                        </div>
                    </li>
                }
            </ul>
        </section>
    }
}

@code {
    /// <summary>The groups in the order the screen shows them, each with its settings in order (design 5.6).</summary>
    private static readonly (string Group, string[] Keys)[] Layout =
    [
        ("registration", ["Registration:RequireInvitation", "Registration:OfficialAddressesWithoutInvitation", "Registration:PersonalCodeUses", "Registration:OrganisationCodeUses"]),
        ("appeals", ["Digest:ThresholdDefault", "Digest:ThresholdMinimum", "Appeals:ReasonsPerPerson", "Appeals:EndorsementsPerPerson"]),
        ("organisations", ["Organisations:PerAccount"]),
        ("ai", ["Ai:DraftModel", "Ai:SummariesPerDay"]),
        ("summaries", ["Digest:Sending", "Digest:ApprovalHours", "Digest:Weekly", "Digest:BeforeVote", "Digest:MaxPerWeek", "Digest:NotableChange"]),
        ("follows", ["Follows:ResponsesAt"]),
        ("surge", ["Surge:MinimumShare", "Surge:MinimumAccounts", "Surge:WindowHours"]),
        ("feedback", ["Feedback:KeepMonths"]),
        ("security", ["SignIn:CodesPerHour", "SignIn:CodesPerDay", "Registration:PendingAccountDays"]),
    ];

    /// <summary>The server's answer when the staff passkey must be confirmed again.</summary>
    private const string ConfirmationRequired = "passkey.confirmation-required";

    private readonly Dictionary<string, string?> _drafts = [];
    private bool _refused;

    [PersistentState] public List<SettingResponse>? Items { get; set; }

    protected override async Task OnInitializedAsync()
    {
        if (Items is null)
        {
            var settings = await Admin.GetSettingsAsync();
            _refused = settings.Problem?.Status is 401 or 403;
            Items = settings.Value?.ToList();
            if (!settings.IsSuccess && !_refused)
            {
                Show(settings.Problem);
            }
        }
    }

    /// <summary>The help and the unit beside a value, only those the setting has.</summary>
    private string? DescribedFor(string key, string id)
    {
        var ids = new List<string>();
        if (Help(key) is not null)
        {
            ids.Add("help-" + id);
        }

        if (Unit(key).Length > 0)
        {
            ids.Add("unit-" + id);
        }

        return ids.Count == 0 ? null : string.Join(" ", ids);
    }

    /// <summary>The settings by group; one the screen does not know yet goes into "other", so nothing is hidden.</summary>
    private static IEnumerable<(string Group, List<SettingResponse> Settings)> Groups(List<SettingResponse> items)
    {
        foreach (var (group, keys) in Layout)
        {
            var settings = keys.Select(k => items.FirstOrDefault(i => i.Key == k)).OfType<SettingResponse>().ToList();
            if (settings.Count > 0)
            {
                yield return (group, settings);
            }
        }

        var known = Layout.SelectMany(g => g.Keys).ToHashSet();
        var others = items.Where(i => !known.Contains(i.Key)).OrderBy(i => i.Key, StringComparer.Ordinal).ToList();
        if (others.Count > 0)
        {
            yield return ("other", others);
        }
    }

    /// <summary>Reads the settings again; a failure is said in the note and the screen stays as it was.</summary>
    private async Task LoadAsync()
    {
        var settings = await Admin.GetSettingsAsync();
        if (Succeeded(settings))
        {
            Items = settings.Value!.ToList();
        }
    }

    private Task SaveAsync(string key) => RunAsync(async () =>
    {
        // Nothing typed: the value shown is the one saved again, never an empty text.
        var draft = (_drafts.GetValueOrDefault(key) ?? Shown(Items?.FirstOrDefault(s => s.Key == key)?.Value)).Trim();
        var request = new UpdateSettingRequest { Value = Read(draft) };
        var saved = await Admin.UpdateSettingAsync(key, request);
        if (saved.Problem?.Code == ConfirmationRequired)
        {
            // The server asks for the staff passkey again (design 6.9): confirm it, then save once more.
            if (!await ConfirmPasskeyAsync())
            {
                return;
            }

            saved = await Admin.UpdateSettingAsync(key, request);
        }

        if (!Succeeded(saved))
        {
            return;
        }

        _drafts.Remove(key);
        await LoadAsync();
        Info ??= L.Format("Admin.SavedOne", Name(key));
    });

    /// <summary>
    /// The staff passkey once more, in this session (design 6.2's ten-minute rule): the browser's passkey prompt, then the
    /// server's check. False, with the message set, when the browser cannot, the person cancels or the server refuses.
    /// </summary>
    private async Task<bool> ConfirmPasskeyAsync()
    {
        if (!await PasskeyBrowser.IsSupportedAsync())
        {
            Message = L["Admin.Passkey.Unsupported"];
            return false;
        }

        var options = await Auth.GetPasskeyRequestOptionsAsync();
        if (!Succeeded(options))
        {
            return false;
        }

        var credential = await PasskeyBrowser.GetAsync(options.Value!);
        if (credential is null)
        {
            Message = L["Admin.Passkey.Cancelled"];
            return false;
        }

        return Succeeded(await Me.ConfirmPasskeyAsync(new PasskeyCredentialRequest { Credential = credential }));
    }

    /// <summary>What was typed, as the server expects it: a number, true or false ("taip"/"ne" too), or a text.</summary>
    private static JsonElement Read(string draft)
    {
        var plain = draft.Trim('"');
        if (plain.Equals("taip", StringComparison.OrdinalIgnoreCase))
        {
            return JsonSerializer.SerializeToElement(true);
        }

        if (plain.Equals("ne", StringComparison.OrdinalIgnoreCase))
        {
            return JsonSerializer.SerializeToElement(false);
        }

        try
        {
            return JsonDocument.Parse(draft.Replace(',', '.')).RootElement.Clone();
        }
        catch (JsonException)
        {
            // A time setting is a string: "07:00" or "off" may be typed without quotes.
            return JsonSerializer.SerializeToElement(plain);
        }
    }

    /// <summary>A value as the screen shows it: taip/ne for yes and no, a text without quotes, a number as it is.</summary>
    private string Shown(JsonElement? value) => value switch
    {
        null => "–",
        { ValueKind: JsonValueKind.True } => L["Admin.Yes"],
        { ValueKind: JsonValueKind.False } => L["Admin.No"],
        { ValueKind: JsonValueKind.String } v => v.GetString() ?? "",
        { } v => v.GetRawText(),
    };

    private string Name(string key) => L["Admin.Setting." + key] is { ResourceNotFound: false } name ? name.Value : key;

    private string? Help(string key) => L["Admin.Help." + key] is { ResourceNotFound: false } help ? help.Value : null;

    private string Unit(string key) => L["Admin.Unit." + key] is { ResourceNotFound: false } unit ? unit.Value : "";
}
