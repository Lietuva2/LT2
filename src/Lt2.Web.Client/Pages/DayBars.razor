@* Numbers per day as bars (registrations, design 6.2; visitors and members, design 8.27), drawn on the server without a
   script library and readable without JavaScript. Owner, 2026-11-17 ("Lankomumas" stretched huge): our own size, a fixed
   height and a readable width; every column is one day, an SVG bar scaled by its attributes (the content security policy
   allows no inline styles) with a <title>, and a label with the day and number that shows at once on hover or keyboard
   focus (CSS only). Some days are named under the axis: the last, then every seventh before it, and the first when it has
   room. The numbers are also in a table beside it. *@
@if (Days.Count > 0)
{
    var max = Math.Max(1, Days.Max(d => d.Value));
    var step = Days.Count <= 14 ? 1 : 7;
    <figure class="daybars" role="group" aria-label="@Label">
        <ol class="daybars__days">
            @for (var i = 0; i < Days.Count; i++)
            {
                var day = Days[i];
                var text = $"{Display.Day(day.Day)}: {Display.Number(day.Value)}";
                var height = day.Value == 0 ? 0 : Math.Max(1.0, 100.0 * day.Value / max);
                var end = i >= Days.Count / 2;
                <li class="daybars__day @(end ? "daybars__day--end" : "")" tabindex="0" aria-label="@text">
                    <svg class="daybars__bar" viewBox="0 0 10 100" preserveAspectRatio="none" aria-hidden="true" focusable="false">
                        <title>@text</title>
                        <rect x="1" y="@F(100 - height)" width="8" height="@F(height)" />
                    </svg>
                    <span class="daybars__value" aria-hidden="true">@text</span>
                    @if (Named(i, step))
                    {
                        <span class="daybars__label @(i == 0 ? "daybars__label--first" : i == Days.Count - 1 ? "daybars__label--last" : "")" aria-hidden="true">@Short(day.Day)</span>
                    }
                </li>
            }
        </ol>
    </figure>
}

@code {
    [Parameter, EditorRequired] public IReadOnlyList<(DateOnly Day, int Value)> Days { get; set; } = [];

    [Parameter, EditorRequired] public string Label { get; set; } = "";

    private static string F(double value) => value.ToString("0.#", System.Globalization.CultureInfo.InvariantCulture);

    /// <summary>The last day and every <paramref name="step"/>-th before it; the first only when it is not next to one of those.</summary>
    private bool Named(int i, int step)
    {
        var fromLast = Days.Count - 1 - i;
        if (fromLast % step == 0)
        {
            return true;
        }

        return i == 0 && fromLast % step >= Math.Min(4, step);
    }

    /// <summary>The month and day under the axis ("11-16"); the full date is in the label and the title.</summary>
    private static string Short(DateOnly day) => day.ToString("MM-dd", System.Globalization.CultureInfo.InvariantCulture);
}
