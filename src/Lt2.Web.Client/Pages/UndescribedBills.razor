@page "/moderavimas/be-aprasymo"
@attribute [Authorize]
@rendermode InteractiveWebAssembly
@inherits InteractiveBase<AppealUi>

@* "Projektai be aprašymo" (design 8.3, owner 2026-11-25): the page only hosts the list (Appeals/UndescribedList) with its
   title and lead. Moderators only, in a staff-passkey session; the server refuses anything else, and the page then says
   so with the staff passkey step. *@
<PageTitle>@L["Undescribed.PageTitle"]</PageTitle>

<div class="stack">
    <ol class="crumbs">
        <li><a href="/moderavimas">@L["Mod.Title"]</a></li>
        <li>@L["Undescribed.Title"]</li>
    </ol>
    <h1>@L["Undescribed.Title"]</h1>
    <NeedsScript />
    <p class="lead">@L["Undescribed.Lead"]</p>
</div>

@if (_refused)
{
    <p class="note" role="alert">@L["Mod.Refused"]</p>
    <PasskeyStep Staff="true" />
}
else
{
    <UndescribedList Refused="() => _refused = true" />
}

@code {
    private bool _refused;
}
