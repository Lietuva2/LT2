@page "/moderavimas/paslepti"
@attribute [Authorize]
@rendermode InteractiveWebAssembly
@using Lt2.Api.Contracts.Appeals
@using Lt2.Web.Client.Appeals
@inherits InteractiveBase<AppealUi>
@inject IModerationApi ModerationApi

@* Hidden bills and reasons (design 8.3, 8.12.3): what was hidden, by whom, when and why, and "Atkurti". A hidden bill has
   taking part closed; restoring it brings its sides and arguments back. Moderators only, in a staff-passkey session; the
   server refuses anything else. Nothing here shows who took which side. *@
<PageTitle>@L["Hidden.PageTitle"]</PageTitle>

<div class="stack">
    <ol class="crumbs">
        <li><a href="/moderavimas">@L["Mod.Title"]</a></li>
        <li>@L["Hidden.Title"]</li>
    </ol>
    <h1>@L["Hidden.Title"]</h1>
    <NeedsScript />
    <p class="lead">@L["Hidden.Lead"]</p>
</div>

<Messages Message="@Message" Info="@Info" />

@if (_refused)
{
    <p class="note" role="alert">@L["Mod.Refused"]</p>
}
else if (Items is null)
{
    <p class="small">@L["Loading"]</p>
}
else
{
    <section class="stack" aria-labelledby="h-hidden-appeals">
        <h2 id="h-hidden-appeals">@L["Hidden.Appeals"]</h2>
        @if (Items.Records.Count == 0)
        {
            <p class="small">@L["Hidden.None"]</p>
        }
        @foreach (var record in Items.Records)
        {
            <article class="sheet stack stack--tight" id="hidden-appeal-@record.Id" aria-labelledby="ha-@record.Id" @key="record.Id">
                <div class="row">
                    <span class="tag tag--ink num">@record.Bill.Number</span>
                    <span class="tag">@L["Hidden.RestoresAs." + record.RestoresAs]</span>
                </div>
                <h3 id="ha-@record.Id">@record.Bill.Title</h3>

                <p class="small num">@ModerationWords.Hidden(L, record.HiddenAt, record.HiddenBy)</p>
                @if (record.Statement is { } statement)
                {
                    <p class="small">@L.Format("Hidden.Why", statement)</p>
                }
                @if (record.Description.Length > 0)
                {
                    <details class="more stack stack--tight">
                        <summary class="linkish small">@L["Mod.Description"]</summary>
                        <p class="voice">@record.Description</p>
                    </details>
                }
                <RestoreForm Id="record.Id" IdPrefix="restore" Sentence="@L["Hidden.RestoreAppeal.Sentence." + (record.RestoresAs ?? "open")]"
                             StatementLabel="@L["Hidden.Statement"]" Restore="request => ModerationApi.RestoreRecordAsync(record.Id, request)" />
            </article>
        }
    </section>

    <section class="stack" aria-labelledby="h-hidden-reasons">
        <h2 id="h-hidden-reasons">@L["Hidden.Reasons"]</h2>
        @if (Items.Reasons.Count == 0)
        {
            <p class="small">@L["Hidden.None"]</p>
        }
        @foreach (var reason in Items.Reasons)
        {
            <article class="sheet stack stack--tight" id="hidden-reason-@reason.Id" aria-label="@L["Mod.Reason"]" @key="reason.Id">
                <div class="row">
                    <span class="tag tag--ink num">@reason.Bill.Number</span>
                    <span class="choice choice--@reason.Side">@L["Reasons." + reason.Side]</span>
                </div>
                <div class="said">
                    <p class="bubble bubble--people voice">@reason.Text</p>
                    <div class="said__by"><b>@(reason.AuthorName ?? L["Reasons.Anonymous"])</b></div>
                </div>
                <p class="small num">@ModerationWords.Hidden(L, reason.HiddenAt, reason.HiddenBy)</p>
                @if (reason.Statement is { } statement)
                {
                    <p class="small">@L.Format("Hidden.Why", statement)</p>
                }
                @if (!reason.Restorable)
                {
                    <p class="note note--quiet">@L["Hidden.ReasonNotOpen"]</p>
                }
                <RestoreForm Id="reason.Id" IdPrefix="restore" Sentence="@L["Hidden.RestoreReason.Sentence"]" StatementLabel="@L["Hidden.Statement"]"
                             Allowed="reason.Restorable" Restore="request => ModerationApi.RestoreReasonAsync(reason.Id, request)" />
            </article>
        }
    </section>

    @* Design 8.14.14: blocked organisations and hidden statements. *@
    <HiddenOrganisationsView />

    @* Design 8.5.5: hidden MPs' responses, restored while the bill is open. *@
    <Lt2.Web.Client.Mps.ResponseModerationView Hidden="true" />
        <Lt2.Web.Client.Appeals.ProfileModerationView Hidden="true" />
}

@code {
    private bool _refused;

    [PersistentState] public HiddenItemsResponse? Items { get; set; }

    protected override async Task OnInitializedAsync()
    {
        if (Items is null)
        {
            var items = await ModerationApi.GetHiddenAsync();
            _refused = items.Problem?.Status is 401 or 403;
            Items = items.Value;
            if (!items.IsSuccess && !_refused)
            {
                Show(items.Problem);
            }
        }
    }
}
