@page "/prisijungti"
@rendermode InteractiveWebAssembly
@inject IStringLocalizer<UiText> T

@* Layout and wording follow design/ui/prisijungimas.html; the steps themselves are SignInFlow, shared with the front page. *@
<PageTitle>@T["SignIn.PageTitle"]</PageTitle>

<div class="welcome">
    <div class="stack">
        <lt2-logo-spin period="14"></lt2-logo-spin>
        <h1>@T["Welcome.Title"]</h1>
        <p class="lead">@T["Welcome.Lead"]</p>
    </div>

    <div class="welcome__form"><SignInFlow /></div>
</div>
