@page "/moderavimas/atsiliepimai"
@attribute [Authorize]
@rendermode InteractiveWebAssembly
@using Lt2.Api.Contracts.Feedback
@using Lt2.Web.Client.Appeals
@inherits InteractiveBase
@inject IFeedbackApi FeedbackApi

@* Design 8.10: feedback from members, for moderators and administrators in a staff-passkey session. Filter by kind and
   status, an internal note per item, and a reply for linked items, sent by the system to the member's address, which
   staff never see. Unlinked items have no author and no reply. *@
<PageTitle>@L["Fb.PageTitle"]</PageTitle>

<div class="stack">
    <p class="label">Lietuva 2.0</p>
    <h1>@L["Fb.Title"]</h1>
    <NeedsScript />
    <p class="lead">@L["Fb.Lead"]</p>
</div>

<Messages Message="@Message" Info="@Info" />

@if (_refused)
{
    <p class="note" role="alert">@L["Mod.Refused"]</p>
}
else if (Items is null)
{
    <p class="small">@L["Loading"]</p>
}
else
{
    <form class="row" @onsubmit="LoadAsync" id="fb-filter">
        <label class="small" for="fb-kind">@L["Fb.Kind"]</label>
        <select class="input" id="fb-kind" @bind="_kind" disabled="@Locked">
            <option value="">@L["Fb.All"]</option>
            @foreach (var kind in FeedbackLimits.Kinds)
            {
                <option value="@kind">@L["Fb.Kind." + kind]</option>
            }
        </select>
        <label class="small" for="fb-status">@L["Fb.Status"]</label>
        <select class="input" id="fb-status" @bind="_status" disabled="@Locked">
            <option value="">@L["Fb.All"]</option>
            @foreach (var status in FeedbackLimits.Statuses)
            {
                <option value="@status">@L["Fb.Status." + status]</option>
            }
        </select>
        <button class="btn btn--plain" type="submit" disabled="@Locked">@L["Fb.Filter"]</button>
    </form>

    @if (Items.Count == 0)
    {
        <p class="small">@L["Mod.Empty"]</p>
    }
    @foreach (var item in Items)
    {
        <article class="sheet stack stack--tight" id="fb-item-@item.Id" aria-label="@L["Fb.Item"]">
            <div class="row">
                <span class="tag num">@Lt2.Web.Client.Appeals.Dates.Day(item.CreatedOn)</span>
                @if (item.Kind is { } k)
                {
                    <span class="tag">@L["Fb.Kind." + k]</span>
                }
                <span class="tag">@L["Fb.Status." + item.Status]</span>
                <span class="small">@(item.Linked ? Text("Fb.From", item.DisplayName ?? L["Reasons.Anonymous"]) : L["Fb.Unlinked"])</span>
            </div>
            <p class="voice">@item.Text</p>
            @if (item.PagePath is not null || item.Browser is not null)
            {
                <p class="small"><code>@item.PagePath</code> @item.Browser</p>
            }
            @foreach (var reply in item.Replies)
            {
                <p class="small">@Text("Fb.Replied", Lt2.Web.Client.Appeals.Dates.DayTime(reply.At)) @reply.Text</p>
            }
            <div class="row">
                <select class="input" aria-label="@L["Fb.Status"]" id="fb-set-status-@item.Id" @onchange="e => _statuses[item.Id] = e.Value?.ToString()" disabled="@Locked">
                    @foreach (var status in FeedbackLimits.Statuses)
                    {
                        <option value="@status" selected="@((_statuses.GetValueOrDefault(item.Id) ?? item.Status) == status)">@L["Fb.Status." + status]</option>
                    }
                </select>
                <input class="input" id="fb-note-@item.Id" placeholder="@L["Fb.Note"]" aria-label="@L["Fb.Note"]" value="@(_notes.GetValueOrDefault(item.Id) ?? item.Note)"
                       @onchange="e => _notes[item.Id] = e.Value?.ToString()" disabled="@Locked" />
                <button class="btn btn--plain" type="button" id="fb-save-@item.Id" disabled="@Locked" @onclick="() => SaveAsync(item)">@L["Fb.Save"]</button>
            </div>
            @if (item.Linked)
            {
                <div class="field">
                    <label for="fb-reply-@item.Id">@L["Fb.Reply"]</label>
                    <textarea class="textarea" id="fb-reply-@item.Id" maxlength="@FeedbackLimits.TextMaxLength" @onchange="e => _replies[item.Id] = e.Value?.ToString()" disabled="@Locked"></textarea>
                    <p class="field__hint">@L["Fb.ReplyHint"]</p>
                    <button class="btn" type="button" id="fb-send-@item.Id" disabled="@Locked" @onclick="() => ReplyAsync(item.Id)">@L["Fb.Send"]</button>
                </div>
            }
        </article>
    }
}

@code {
    private readonly Dictionary<Guid, string?> _statuses = [];
    private readonly Dictionary<Guid, string?> _notes = [];
    private readonly Dictionary<Guid, string?> _replies = [];
    private bool _refused;
    private string _kind = "";
    private string _status = "";

    [PersistentState] public List<FeedbackItemResponse>? Items { get; set; }

    protected override async Task OnInitializedAsync()
    {
        if (Items is null)
        {
            await LoadAsync();
        }
    }

    private async Task LoadAsync()
    {
        var items = await FeedbackApi.ListAsync(_kind.Length == 0 ? null : _kind, _status.Length == 0 ? null : _status);
        _refused = !items.IsSuccess;
        Items = items.Value?.ToList();
    }

    private Task SaveAsync(FeedbackItemResponse item) => RunAsync(async () =>
    {
        var result = await FeedbackApi.UpdateAsync(item.Id, new FeedbackUpdateRequest
        {
            Status = _statuses.GetValueOrDefault(item.Id) ?? item.Status,
            Note = _notes.GetValueOrDefault(item.Id) ?? item.Note,
        });
        if (!result.IsSuccess)
        {
            Show(result.Problem);
            return;
        }

        await LoadAsync();
        Info = L["Fb.Saved"];
    });

    private Task ReplyAsync(Guid id) => RunAsync(async () =>
    {
        var result = await FeedbackApi.ReplyAsync(id, new FeedbackReplyRequest { Text = _replies.GetValueOrDefault(id) ?? "" });
        if (!result.IsSuccess)
        {
            Show(result.Problem);
            return;
        }

        _replies.Remove(id);
        await LoadAsync();
        Info = L["Fb.Sent"];
    });
}
