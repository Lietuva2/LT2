@page "/moderavimas/suvestines"
@attribute [Authorize]
@rendermode InteractiveWebAssembly
@using Lt2.Api.Contracts.Digests
@inherits InteractiveBase<AppealUi>
@inject IDigestsApi Digests
@inject IModerationApi Moderation
@inject Lt2.Api.Contracts.Organisations.IOrganisationModerationApi Organisations

@* Design 8.19.2 (owner, 2026-11-17): the moderators' summaries screen. A weekly or before-vote summary is prepared a day ahead
   and goes at its time unless declined; nobody has to approve it. Each summary's common text is shown once, as MPs read it: the
   bills with their numbers now (a prepared one) or as it went, the chosen arguments with "Paslėpti" (the next of its side comes
   in, marked), the organisations named under the bill with "Neįtraukti į suvestines" (8.14.9), and the bill's "Sulaikyti
   siuntimą". A prepared one offers "Patvirtinti" (reviewed; it still goes at its time) and
   "Nesiųsti" (a statement of at least 20 characters, public on the copy). Moderators in a staff-passkey session; the server
   refuses anything else and audits each action. *@
<PageTitle>@L["DigMod.PageTitle"]</PageTitle>

<div class="stack">
    <ol class="crumbs">
        <li><a href="/moderavimas">@L["Mod.Title"]</a></li>
        <li>@L["DigMod.Title"]</li>
    </ol>
    <h1>@L["DigMod.Title"]</h1>
    <NeedsScript />
    <p class="lead">@L["DigMod.Lead"]</p>
    @if (Data is { } data)
    {
        <p class="note @(data.Sending == "off" ? "" : "note--quiet")" id="digmod-sending">
            @L["DigMod.Sending." + data.Sending]
            @if (data.Lock is { } locked)
            {
                @(" " + L["DigMod.Lock." + locked])
            }
        </p>
    }
</div>

<Messages Message="@Message" Info="@Info" />

@if (_refused)
{
    <p class="note" role="alert">@L["Mod.Refused"]</p>
    <PasskeyStep Staff="true" />
}
else if (Data is null)
{
    <p class="small">@L["Loading"]</p>
}
else if (Data.Runs.Count == 0)
{
    <p class="small" id="digmod-none">@L["DigMod.None"]</p>
}
else
{
    @foreach (var run in Data.Runs)
    {
        var prepared = run.Status == DigestRunStatuses.Prepared;
        <section class="sheet stack" aria-labelledby="digmod-h-@run.Id" id="digmod-run-@run.Id" @key="run.Id">
            <h2 id="digmod-h-@run.Id">@L["DigMod.Kind." + run.Kind] · <span class="num">@Display.Day(run.RunDate)</span></h2>
            <p class="small num" id="digmod-status-@run.Id">@StatusLine(run)</p>
            @if (run.Status == DigestRunStatuses.Cancelled && run.Statement is { } statement)
            {
                <p class="small">@L.Format("DigMod.Statement", statement)</p>
            }
            <p class="small" id="digmod-per-mp-@run.Id">@L["DigMod.PerMp"]</p>

            @foreach (var item in run.Items)
            {
                <section class="stack stack--tight" aria-labelledby="digmod-bill-@run.Id-@item.RecordId" id="digmod-item-@run.Id-@item.RecordId" @key="item.RecordId">
                    <h3 id="digmod-bill-@run.Id-@item.RecordId"><a href="/seimas/@Uri.EscapeDataString(item.BillNumber)" class="num">@item.BillNumber</a> · @item.BillTitle</h3>
                    <div class="row">
                        @if (item.PlannedDate is { } planned)
                        {
                            <span class="tag num">@L.Format("DigMod.Planned", Display.Day(planned))</span>
                        }
                        @if (prepared && item.Held)
                        {
                            <span class="tag" id="digmod-held-@run.Id-@item.RecordId">@L["DigMod.Held"]</span>
                        }
                        @if (prepared && item.Gone)
                        {
                            <span class="tag">@L["DigMod.Gone"]</span>
                        }
                    </div>
                    <p class="small num" id="digmod-numbers-@run.Id-@item.RecordId">
                        @L.Format("DigMod.For", Display.Number(item.For), Display.Number(item.ForOlderThan30Days))<br />
                        @L.Format("DigMod.Against", Display.Number(item.Against), Display.Number(item.AgainstOlderThan30Days))
                    </p>
                    @if (item.SurgeSharePercent is { } share)
                    {
                        <p class="note">@L.Format("Surge.Note", Display.Number(item.SurgeWindowHours), Display.Number(share))</p>
                    }
                    @foreach (var side in Sides.All)
                    {
                        var reasons = item.Reasons.Where(r => r.Side == side).ToList();
                        <div class="stack stack--tight">
                            <h4><span class="choice choice--@side">@L["DigMod.Reasons." + side]</span>@if ((side == Sides.For ? item.ForReasonsOf : item.AgainstReasonsOf) is { } of) { <text> </text><span class="small num">@L.Format("DigMod.OfSide", Display.Number(of))</span> }</h4>
                            @if (reasons.Count == 0)
                            {
                                <p class="small">@L["DigMod.NoReasons"]</p>
                            }
                            @foreach (var reason in reasons)
                            {
                                <div class="said" id="@(reason.Id is { } rid ? "digmod-reason-" + rid : null)">
                                    <p class="bubble bubble--people bubble--nameless voice">@reason.Text</p>
                                    <div class="said__by small num">
                                        @L.Format("DigMod.Endorsed", Display.Number(reason.Endorsements))
                                        @if (reason.Replacement)
                                        {
                                            <span class="tag" id="@(reason.Id is { } rep ? "digmod-replacement-" + rep : null)">@L["DigMod.Replacement"]</span>
                                        }
                                    </div>
                                    @if (prepared && reason.Id is { } reasonId)
                                    {
                                        @if (_open == ("hide", reasonId))
                                        {
                                            @StatementForm(reasonId, L["Mod.Statement.Author"], null, L["DigMod.HideHint"], L["Mod.Action.hide"], () => HideAsync(reasonId))
                                        }
                                        else
                                        {
                                            <p><button type="button" class="btn btn--plain" id="digmod-hide-@reasonId" disabled="@Locked" @onclick='() => Open("hide", reasonId)'>@L["Mod.Action.hide"]</button></p>
                                        }
                                    }
                                </div>
                            }
                        </div>
                    }
                    @* Design 8.14.4, 8.14.9: the organisations named under the bill; on a prepared summary as it would go now, each
                       with "Neįtraukti į suvestines" (the organisation drops out of every summary; on the site it stays). *@
                    <Lt2.Web.Client.Organisations.DigestOrganisationLine BillNumber="@item.BillNumber" Organisations="item.Organisations" Id="@($"digmod-orgs-{run.Id:N}-{item.BillNumber}")" />
                    @if (prepared && item.Organisations is { Count: > 0 } named)
                    {
                        <ul class="rows" id="digmod-orgs-actions-@run.Id-@item.RecordId">
                            @foreach (var org in named)
                            {
                                <li @key="org.StatementId">
                                    <div class="rows__main"><span class="small">@org.Name</span></div>
                                    <div class="rows__side">
                                        @if (_open != ("keep-out", org.StatementId))
                                        {
                                            <button type="button" class="btn btn--plain" id="digmod-keep-out-@org.StatementId" disabled="@Locked" @onclick='() => Open("keep-out", org.StatementId)'>@L["OrgMod.Action.keep-out"]</button>
                                        }
                                    </div>
                                </li>
                                @if (_open == ("keep-out", org.StatementId))
                                {
                                    <li>@StatementForm(org.StatementId, L["OrgMod.Statement"], null, L["DigMod.KeepOutHint"], L["OrgMod.Action.keep-out"], () => KeepOutAsync(org.OrganisationId))</li>
                                }
                            }
                        </ul>
                    }
                    @if (prepared && !item.Gone)
                    {
                        var action = item.Held ? "release" : "hold";
                        @if (_open == (action, item.RecordId))
                        {
                            @StatementForm(item.RecordId, L["Mod.Statement.Staff"], L["Mod.Statement.Staff.Hint"], L[item.Held ? "DigMod.ReleaseHint" : "DigMod.HoldHint"], L["Mod.Action." + action], () => HoldAsync(item.RecordId, item.Held))
                        }
                        else
                        {
                            <p><button type="button" class="btn btn--plain" id="digmod-@action-@run.Id-@item.RecordId" disabled="@Locked" @onclick="() => Open(action, item.RecordId)">@L["Mod.Action." + action]</button></p>
                        }
                    }
                </section>
            }

            @if (prepared)
            {
                <div class="row">
                    @if (run.ApprovedAt is null)
                    {
                        <button type="button" class="btn" id="digmod-approve-@run.Id" disabled="@Locked" @onclick="() => ApproveAsync(run.Id)">@L["DigMod.Approve"]</button>
                    }
                    @if (_open != ("cancel", run.Id))
                    {
                        <button type="button" class="btn btn--plain" id="digmod-cancel-open-@run.Id" disabled="@Locked" @onclick='() => Open("cancel", run.Id)'>@L["DigMod.Cancel"]</button>
                    }
                </div>
                <p class="field__hint">@L["DigMod.ApproveHint"]</p>
                @if (_open == ("cancel", run.Id))
                {
                    <div class="sheet--quiet stack stack--tight" id="digmod-cancel-@run.Id">
                        <label for="digmod-statement-@run.Id">@L["DigMod.CancelLabel"]</label>
                        <textarea class="textarea @ErrorClass("statement")" id="digmod-statement-@run.Id" rows="2" maxlength="1000"
                                  aria-describedby="@DescribedBy("statement", "digmod-statement-" + run.Id, "digmod-statement-hint-" + run.Id)" aria-invalid="@Invalid("statement")"
                                  @bind="_statement" @bind:event="oninput" disabled="@Locked"></textarea>
                        <p class="field__hint" id="digmod-statement-hint-@run.Id">@L["DigMod.CancelHint"]</p>
                        <FieldError Errors="Errors" Field="statement" For="@("digmod-statement-" + run.Id)" />
                        <div class="row">
                            <button type="button" class="btn" id="digmod-cancel-button-@run.Id" disabled="@Locked" @onclick="() => CancelAsync(run.Id)">@L["DigMod.Cancel"]</button>
                            <button type="button" class="btn btn--plain" disabled="@Locked" @onclick="Close">@L["DigMod.Back"]</button>
                        </div>
                    </div>
                }
            }
        </section>
    }
}

@code {
    private (string Action, Guid Id)? _open;
    private string _statement = "";
    private bool _refused;

    [PersistentState] public DigestModerationResponse? Data { get; set; }

    protected override async Task OnInitializedAsync()
    {
        if (Data is null)
        {
            var data = await Digests.GetModerationAsync();
            _refused = data.Problem?.Status is 401 or 403;
            Data = data.Value;
            if (!data.IsSuccess && !_refused)
            {
                Show(data.Problem);
            }
        }
    }

    /// <summary>
    /// One statement form at a time (design 8.3: one action open per item), its label saying who reads the statement (owner,
    /// 2026-11-22): the argument's author, the organisation's representatives, or staff only with <paramref name="reader"/>
    /// saying so under the label.
    /// </summary>
    private RenderFragment StatementForm(Guid id, string statementLabel, string? reader, string hint, string label, Func<Task> act) =>
        @<div class="sheet--quiet stack stack--tight" id="digmod-form-@id">
            <label for="digmod-act-@id">@statementLabel</label>
            @if (reader is not null)
            {
                <p class="field__hint" id="digmod-act-reader-@id">@reader</p>
            }
            <textarea class="textarea @ErrorClass("statement")" id="digmod-act-@id" rows="2" maxlength="@AppealLimits.StatementMaxLength"
                      aria-describedby="@DescribedBy("statement", "digmod-act-" + id, reader is null ? "" : "digmod-act-reader-" + id, "digmod-act-hint-" + id)" aria-invalid="@Invalid("statement")"
                      @bind="_statement" @bind:event="oninput" disabled="@Locked"></textarea>
            <p class="field__hint" id="digmod-act-hint-@id">@hint</p>
            <FieldError Errors="Errors" Field="statement" For="@("digmod-act-" + id)" />
            <div class="row">
                <button type="button" class="btn" id="digmod-act-button-@id" disabled="@Locked" @onclick="act">@label</button>
                <button type="button" class="btn btn--plain" disabled="@Locked" @onclick="Close">@L["DigMod.Back"]</button>
            </div>
        </div>;

    private string StatusLine(DigestReviewRunResponse run) => run.Status switch
    {
        DigestRunStatuses.Prepared => L.Format("DigMod.Line.prepared", run.DueAt is { } due ? Display.DayTime(due) : "", Display.Number(run.MpCount))
            + (run.ApprovedAt is { } approved ? " · " + L.Format("DigMod.Approved", Display.DayTime(approved)) : ""),
        DigestRunStatuses.Sent => L.Format("DigMod.Line.sent", Display.Number(run.MpCount), run.SentAt is { } at ? Display.DayTime(at) : ""),
        DigestRunStatuses.Cancelled => L["DigMod.Line.cancelled"],
        DigestRunStatuses.Dropped => L["DigMod.Line.dropped"],
        _ => L.Format("DigMod.Line.dry-run", Display.Number(run.MpCount)),
    };

    private void Open(string action, Guid id)
    {
        _open = (action, id);
        _statement = "";
        Message = null;
        Info = null;
    }

    private void Close() => _open = null;

    private Task HideAsync(Guid reasonId) => RunAsync(async () =>
    {
        if (!Succeeded(await Moderation.HideReasonAsync(reasonId, new StatementRequest { Statement = _statement }), "statement"))
        {
            return;
        }

        _open = null;
        await ReloadAsync();
        Info ??= L["DigMod.Hidden"];
    });

    /// <summary>"Neįtraukti į suvestines" (design 8.14.9): audited, the representatives told; the line is read again.</summary>
    private Task KeepOutAsync(Guid organisationId) => RunAsync(async () =>
    {
        if (!Succeeded(await Organisations.KeepOutOfSummariesAsync(organisationId, new StatementRequest { Statement = _statement }), "statement"))
        {
            return;
        }

        _open = null;
        await ReloadAsync();
        Info ??= L["DigMod.KeptOut"];
    });

    private Task HoldAsync(Guid recordId, bool held) => RunAsync(async () =>
    {
        var request = new StatementRequest { Statement = _statement };
        if (!Succeeded(held ? await Moderation.ReleaseAsync(recordId, request) : await Moderation.HoldAsync(recordId, request), "statement"))
        {
            return;
        }

        _open = null;
        await ReloadAsync();
        Info ??= L[held ? "Mod.Done.release" : "Mod.Done.hold"];
    });

    private Task ApproveAsync(Guid runId) => RunAsync(async () =>
    {
        var approved = await Digests.ApproveAsync(runId);
        await ReloadAsync();
        if (Succeeded(approved))
        {
            Info ??= L["DigMod.ApprovedDone"];
        }
    });

    private Task CancelAsync(Guid runId) => RunAsync(async () =>
    {
        if (!Succeeded(await Digests.CancelAsync(runId, new CancelDigestRequest { Statement = _statement }), "statement"))
        {
            return;
        }

        _open = null;
        await ReloadAsync();
        Info ??= L["DigMod.Cancelled"];
    });

    private async Task ReloadAsync()
    {
        var data = await Digests.GetModerationAsync();
        if (data.IsSuccess)
        {
            Data = data.Value;
        }
    }
}
