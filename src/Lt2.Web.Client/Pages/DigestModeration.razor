@page "/moderavimas/suvestines"
@attribute [Authorize]
@rendermode InteractiveWebAssembly
@using Lt2.Api.Contracts.Digests
@inherits InteractiveBase<AppealUi>
@inject IDigestsApi Digests
@inject IAuthApi Auth
@inject IMeApi Me
@inject Passkeys PasskeyBrowser

@* Design 8.19.2: the moderators' summaries screen. Sending as it is now and why a lock keeps it off; the summaries, waiting ones
   first, each with the bills as frozen, how many MPs it would go to, the text one MP would read, and for a waiting one
   "Siųsti" (the number of MPs in the confirmation) and "Nesiųsti" (a statement of at least 20 characters, shown on the public
   copy). Moderators in a staff-passkey session; the server refuses anything else and audits each decision. *@
<PageTitle>@L["DigMod.PageTitle"]</PageTitle>

<div class="stack">
    <ol class="crumbs">
        <li><a href="/moderavimas">@L["Mod.Title"]</a></li>
        <li>@L["DigMod.Title"]</li>
    </ol>
    <h1>@L["DigMod.Title"]</h1>
    <NeedsScript />
    <p class="lead">@L["DigMod.Lead"]</p>
    @if (Data is { } data)
    {
        <p class="note @(data.Sending == "off" ? "" : "note--quiet")" id="digmod-sending">
            @L["DigMod.Sending." + data.Sending]
            @if (data.Lock is { } locked)
            {
                @(" " + L["DigMod.Lock." + locked])
            }
        </p>
    }
</div>

<Messages Message="@Message" Info="@Info" />

@if (_refused)
{
    <p class="note" role="alert">@L["Mod.Refused"]</p>
}
else if (Data is null)
{
    <p class="small">@L["Loading"]</p>
}
else if (Data.Runs.Count == 0)
{
    <p class="small" id="digmod-none">@L["DigMod.None"]</p>
}
else
{
    @foreach (var run in Data.Runs)
    {
        <section class="sheet stack" aria-labelledby="digmod-h-@run.Id" id="digmod-run-@run.Id" @key="run.Id">
            <h2 id="digmod-h-@run.Id">@L["DigMod.Kind." + run.Kind] · <span class="num">@Display.Day(run.RunDate)</span></h2>
            <p class="small num" id="digmod-status-@run.Id">@StatusLine(run)</p>
            @if (run.Status == "cancelled" && run.Statement is { } statement)
            {
                <p class="small">@L.Format("DigMod.Statement", statement)</p>
            }
            <ul class="rows" id="digmod-bills-@run.Id">
                @foreach (var item in run.Items)
                {
                    <li>
                        <div class="rows__main">
                            <a href="/seimas/@Uri.EscapeDataString(item.BillNumber)" class="num">@item.BillNumber</a>
                            <span>@item.BillTitle</span>
                        </div>
                        <div class="rows__side small num">
                            @L.Format("DigMod.Sides", Display.Number(item.For), Display.Number(item.Against))
                        </div>
                    </li>
                }
            </ul>

            <details class="more stack stack--tight" id="digmod-preview-@run.Id">
                <summary class="linkish small">@L["DigMod.Preview"]</summary>
                <div class="row">
                    <label for="digmod-mp-@run.Id" class="small">@L["DigMod.PreviewMp"]</label>
                    <select class="input" id="digmod-mp-@run.Id" disabled="@Locked" @onchange="e => _mp[run.Id] = e.Value?.ToString()" @onfocus="() => MpsAsync(run.Id)">
                        <option value="">@L["DigMod.PreviewChoose"]</option>
                        @foreach (var mp in _mps.GetValueOrDefault(run.Id) ?? [])
                        {
                            <option value="@mp.Slug" selected="@(_mp.GetValueOrDefault(run.Id) == mp.Slug)">@((mp.FirstName + " " + mp.LastName).Trim()) · @L["DigMod.Delivery." + mp.Status]</option>
                        }
                    </select>
                    <button type="button" class="btn btn--plain" id="digmod-show-@run.Id" disabled="@Locked" @onclick="() => PreviewAsync(run.Id)">@L["DigMod.PreviewShow"]</button>
                </div>
                @if (_preview.GetValueOrDefault(run.Id) is { } preview)
                {
                    <div class="sheet--quiet stack stack--tight">
                        <p><b>@preview.Subject</b></p>
                        <pre class="preview" id="digmod-text-@run.Id">@preview.Text</pre>
                    </div>
                }
            </details>

            @if (run.Status == "waiting")
            {
                <p class="small num" id="digmod-expires-@run.Id">@L.Format("DigMod.Expires", run.ExpiresAt is { } at ? Display.DayTime(at) : "")</p>
                @if (_confirm == run.Id)
                {
                    <div class="sheet--quiet stack stack--tight" id="digmod-confirm-@run.Id">
                        <p role="alert">@L.Format("DigMod.SendConfirm", Display.Number(run.MpCount))</p>
                        <div class="row">
                            <button type="button" class="btn" id="digmod-send-confirm-@run.Id" disabled="@Locked" @onclick="() => SendAsync(run.Id)">@L["DigMod.SendYes"]</button>
                            <button type="button" class="btn btn--plain" disabled="@Locked" @onclick="() => _confirm = null">@L["DigMod.Back"]</button>
                        </div>
                    </div>
                }
                else
                {
                    <div class="row">
                        <button type="button" class="btn" id="digmod-send-@run.Id" disabled="@Locked" @onclick="() => _confirm = run.Id">@L.Format("DigMod.Send", Display.Number(run.MpCount))</button>
                    </div>
                }

                <div class="stack stack--tight" id="digmod-cancel-@run.Id">
                    <label for="digmod-statement-@run.Id">@L["DigMod.CancelLabel"]</label>
                    <textarea class="textarea @ErrorClass("statement")" id="digmod-statement-@run.Id" rows="2" maxlength="1000"
                              aria-describedby="@DescribedBy("statement", "digmod-statement-" + run.Id, "digmod-statement-hint-" + run.Id)" aria-invalid="@Invalid("statement")"
                              value="@_statements.GetValueOrDefault(run.Id)" @onchange="e => _statements[run.Id] = e.Value?.ToString()" disabled="@Locked"></textarea>
                    <p class="field__hint" id="digmod-statement-hint-@run.Id">@L["DigMod.CancelHint"]</p>
                    <FieldError Errors="Errors" Field="statement" For="@("digmod-statement-" + run.Id)" />
                    <p><button type="button" class="btn btn--plain" id="digmod-cancel-button-@run.Id" disabled="@Locked" @onclick="() => CancelAsync(run.Id)">@L["DigMod.Cancel"]</button></p>
                </div>
            }
        </section>
    }
}

@code {
    private readonly Dictionary<Guid, IReadOnlyList<DigestMpResponse>> _mps = [];
    private readonly Dictionary<Guid, string?> _mp = [];
    private readonly Dictionary<Guid, DigestPreviewResponse> _preview = [];
    private readonly Dictionary<Guid, string?> _statements = [];
    private Guid? _confirm;
    private bool _refused;

    [PersistentState] public DigestModerationResponse? Data { get; set; }

    protected override async Task OnInitializedAsync()
    {
        if (Data is null)
        {
            var data = await Digests.GetModerationAsync();
            _refused = data.Problem?.Status is 401 or 403;
            Data = data.Value;
            if (!data.IsSuccess && !_refused)
            {
                Show(data.Problem);
            }
        }
    }

    private string StatusLine(DigestRunResponse run) => run.Status switch
    {
        "waiting" => L.Format("DigMod.Line.waiting", Display.Number(run.MpCount)),
        "sent" => L.Format("DigMod.Line.sent", Display.Number(run.SentCount), run.DecidedAt is { } at ? Display.DayTime(at) : ""),
        "cancelled" => L["DigMod.Line.cancelled"],
        "expired" => L["DigMod.Line.expired"],
        _ => L.Format("DigMod.Line.dry-run", Display.Number(run.MpCount)),
    };

    private async Task MpsAsync(Guid runId)
    {
        if (_mps.ContainsKey(runId) || !RendererInfo.IsInteractive)
        {
            return;
        }

        var mps = await Digests.GetMpsAsync(runId);
        if (mps.IsSuccess)
        {
            _mps[runId] = mps.Value!;
        }
    }

    private Task PreviewAsync(Guid runId) => RunAsync(async () =>
    {
        await MpsAsync(runId);
        var slug = _mp.GetValueOrDefault(runId) ?? _mps.GetValueOrDefault(runId)?.FirstOrDefault()?.Slug;
        if (slug is null)
        {
            return;
        }

        _mp[runId] = slug;
        var preview = await Digests.GetPreviewAsync(runId, slug);
        if (Succeeded(preview))
        {
            _preview[runId] = preview.Value!;
        }
    });

    private Task SendAsync(Guid runId) => RunAsync(async () =>
    {
        var sent = await Digests.SendAsync(runId);
        if (sent.Problem?.Code == "passkey.confirmation-required")
        {
            // Design 6.2, 8.19.2: approving a send asks for the staff passkey again, then the same press once more.
            if (!await ConfirmPasskeyAsync())
            {
                return;
            }

            sent = await Digests.SendAsync(runId);
        }

        _confirm = null;
        if (!Succeeded(sent))
        {
            await ReloadAsync();
            return;
        }

        await ReloadAsync();
        Info ??= L.Format("DigMod.Sent", Display.Number(sent.Value!.SentCount));
    });

    private Task CancelAsync(Guid runId) => RunAsync(async () =>
    {
        var cancelled = await Digests.CancelAsync(runId, new CancelDigestRequest { Statement = _statements.GetValueOrDefault(runId) ?? "" });
        if (!Succeeded(cancelled, "statement"))
        {
            return;
        }

        _statements.Remove(runId);
        await ReloadAsync();
        Info ??= L["DigMod.Cancelled"];
    });

    private async Task<bool> ConfirmPasskeyAsync()
    {
        if (!await PasskeyBrowser.IsSupportedAsync())
        {
            Message = L["Admin.Passkey.Unsupported"];
            return false;
        }

        var options = await Auth.GetPasskeyRequestOptionsAsync();
        if (!Succeeded(options))
        {
            return false;
        }

        var credential = await PasskeyBrowser.GetAsync(options.Value!);
        if (credential is null)
        {
            Message = L["Admin.Passkey.Cancelled"];
            return false;
        }

        return Succeeded(await Me.ConfirmPasskeyAsync(new PasskeyCredentialRequest { Credential = credential }));
    }

    private async Task ReloadAsync()
    {
        var data = await Digests.GetModerationAsync();
        if (data.IsSuccess)
        {
            Data = data.Value;
        }
    }
}
