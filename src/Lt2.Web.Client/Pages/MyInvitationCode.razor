@inherits InteractiveBase<UiText>
@inject IMeApi MeApi

@* Design 6.2: the member's own invitation code, as a link to the registration form with the code filled in and as a
   short code, and how many completed registration with it. No names, dates or list. Server-rendered first, so it reads
   without JavaScript; only the copy button and replacing the code need it. *@
<section class="sheet stack" aria-labelledby="invite-title" id="my-invitation">
    <h3 id="invite-title">@L["MyInvitation.Title"]</h3>
    @if (Invitation is { } mine)
    {
        @if (mine.On)
        {
            <p>@L["MyInvitation.Lead"]</p>
            <CopyLink Link="@mine.Link" LinkId="invite-link" ButtonId="invite-copy">
                <p class="num">@L["MyInvitation.Code"] <b id="invite-code">@mine.Code</b></p>
            </CopyLink>
        }
        else
        {
            <p class="note" id="invite-off">@L["MyInvitation.Off"] @if (mine.Contact is { } contact) {<a href="mailto:@contact">@contact</a>}</p>
        }

        <p class="num" id="invite-count">@L.Format("MyInvitation.Count", Display.Number(mine.Completed))</p>
        <p class="small">@L["MyInvitation.Private"]</p>
        @if (mine.On)
        {
            @if (_confirmReplace)
            {
                <div class="row" role="group">
                    <p class="small">@L["MyInvitation.ReplaceConfirm"]</p>
                    <button class="btn" type="button" id="invite-replace-yes" disabled="@Locked" @onclick="ReplaceAsync">@L["MyInvitation.ReplaceYes"]</button>
                    <button class="btn btn--plain" type="button" disabled="@Locked" @onclick="() => _confirmReplace = false">@L["MyInvitation.Cancel"]</button>
                </div>
            }
            else
            {
                <p><button class="linkish small" type="button" id="invite-replace" disabled="@Locked" @onclick="() => _confirmReplace = true">@L["MyInvitation.Replace"]</button></p>
            }
        }
        <Messages Message="@Message" Info="@Info" />
    }
</section>

@code {
    private bool _confirmReplace;

    [PersistentState] public MyInvitationResponse? Invitation { get; set; }

    protected override async Task OnInitializedAsync() =>
        Invitation ??= (await MeApi.GetInvitationAsync()).Value;

    private Task ReplaceAsync() => RunAsync(async () =>
    {
        var replaced = await MeApi.ReplaceInvitationAsync();
        if (!Succeeded(replaced))
        {
            return;
        }

        Invitation = replaced.Value;
        _confirmReplace = false;
    });
}
