@page "/paskyra/dalyvavimas"
@attribute [Authorize]
@rendermode InteractiveWebAssembly
@inherits AccountScreenBase

@* "Dalyvavimas" (design 8.21): the MP part (design 8.5), the organisations the person represents (design 8.14.14), the personal
   invitation code (design 6.2, #my-invitation) and the staff part: a granted role's activation and, for a staff account whose
   session is not a staff session, the way to the staff passkey (design 6.2), which comes back to this screen. The staff
   screens ("Moderavimas", "Nustatymai") are reached from the account item only (owner, 2026-11-19). *@
@if (Me is null)
{
    <p class="small">@L["Loading"]</p>
}
else
{
    <AccountHeader Me="Me" Current="@AccountScreens.Taking" />

    <section class="stack" aria-labelledby="dalyvavimas-title" id="dalyvavimas">
        <h2 id="dalyvavimas-title">@L["Parts.Taking"]</h2>

        @* Design 8.5.1 to 8.5.4: the offer to take over an MP's profile, or the link; filled in the browser only. *@
        <MyMp />

        @* Design 8.14.14: the organisations the person represents. *@
        <MyOrganisations />

        <MyInvitationCode />

        @if (Me.AwaitingActivation)
        {
            @* A granted staff role waits for the one-time code the administrator passed on (design 6.2). *@
            <section class="sheet sheet--cut stack" aria-labelledby="activation-title">
                <h3 id="activation-title">@L["Activation.Title"]</h3>
                <p>@L["Activation.Text"]</p>
                <form class="stack" @onsubmit="ActivateAsync" novalidate>
                    <div class="field">
                        <label for="activation-code">@L["Activation.Label"]</label>
                        <input class="input num" id="activation-code" autocomplete="off" autocapitalize="characters" spellcheck="false"
                               @bind="_activationCode" @bind:event="oninput" disabled="@Locked" />
                    </div>
                    <button class="btn" type="submit" disabled="@Locked">@L["Activation.Submit"]</button>
                </form>
            </section>
        }

        @if (Me.StaffAccount && Me.ActiveStaffRoles.Count == 0)
        {
            @* Design 6.2 (owner, 2026-11-16): the way to a staff session without signing out, in place (owner, 2026-11-17). *@
            <p class="note note--quiet" id="staff-key-note"><span>@L["Staff.KeyText"]</span></p>
            <PasskeyStep Staff="true" Account="Me" IdPrefix="staff-key-" />
        }
    </section>
}

<Messages Message="@Message" Info="@Info" />

@code {
    private string _activationCode = "";

    protected override async Task OnInitializedAsync() => await LoadMeAsync();

    private Task ActivateAsync() => RunAsync(async () =>
    {
        if (!Succeeded(await MeApi.ActivateRoleAsync(new RoleActivationRequest { Code = _activationCode.Trim() })))
        {
            return;
        }

        _activationCode = "";
        Info = L["Activation.Done"];
        await ReloadMeAsync();
    });
}
