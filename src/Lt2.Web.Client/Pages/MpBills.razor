@page "/seimo-narys/projektai"
@attribute [Authorize]
@rendermode InteractiveWebAssembly
@using Lt2.Api.Contracts.Mps
@using Lt2.Web.Client.Appeals
@inherits InteractiveBase<AppealUi>
@inject IMpResponsesApi Responses

@* "Projektai, dėl kurių į jus kreipiamasi" (design 8.5.7): for an account linked to an MP (the MP's or an office member's; a
   code session may read it), reached from the account page. The summaries' list on a page, live: the open bills that
   reached the threshold and are not held, in the summaries' order, each with its number, title, stage, "Planuojama …", both
   sides' numbers (one each, and no notes under the list: owner, 2026-11-21), and the MP's own response or a link to answer
   on the bill's page; then (owner, 2026-11-17) the bills the MP answered that are in no summary now, newest answer first,
   without the numbers. Nothing about other MPs. Asked for only in the browser. *@
<PageTitle>@L["MpBills.PageTitle"]</PageTitle>

@* Design 8.16.5 (owner, 2026-11-21): the list's sheet has no visible heading, so the page's title stays at the top of the
   screen while the list scrolls past; the way back above it and the lead scroll away. *@
<ol class="crumbs">
    <li><a href="@AccountScreens.Taking">@L["MpBills.Account"]</a></li>
    <li>@L["MpBills.Title"]</li>
</ol>
<div class="page-head" id="page-head">
    <h1>@L["MpBills.Title"]</h1>
</div>
<div class="stack page-head__rest">
    <NeedsScript />
    <p class="lead">@L["MpBills.Lead"]</p>
</div>

@if (_refused)
{
    <p class="note" role="alert" id="mp-bills-refused">@L["MpBills.NotLinked"]</p>
}
else if (_bills is null)
{
    <p class="small">@L["Loading"]</p>
}
else
{
    <p class="small" id="mp-bills-for">@L.Format("MpBills.Mp", _bills.Mp.FirstName + " " + _bills.Mp.LastName)</p>
    <section class="sheet stack" aria-labelledby="h-mp-bills" id="mp-bills">
        <h2 id="h-mp-bills" class="visually-hidden">@L["MpBills.Title"]</h2>
        @if (_bills.Items.Count == 0)
        {
            <p id="mp-bills-none">@L["MpBills.None"]</p>
        }
        else
        {
            <ul class="rows" id="mp-bills-list">
                @foreach (var b in _bills.Items)
                {
                    <li id="mp-bill-@b.Number" @key="b.Number">
                        <div class="rows__main">
                            <a href="/seimas/@Uri.EscapeDataString(b.Number)"><span class="num">@b.Number</span> · @b.Title</a>
                            @if (b.Planned is { } plan)
                            {
                                <span class="row small">
                                    @if (plan.Stage is { } stage)
                                    {
                                        <span class="tag">@L["Mod.Stage." + stage]</span>
                                    }
                                    <span class="num">@L.Format("MpBills.Planned", Display.Day(plan.Date))</span>
                                </span>
                            }
                            @if (b is { For: { } forCount, Against: { } againstCount })
                            {
                                @* Owner, 2026-11-21: one number a side, as every list of bills; the bill's page and the summary
                                   carry the count for accounts older than 30 days. *@
                                <span class="small num" id="mp-bill-counts-@b.Number">
                                    <span class="choice choice--for">@L["MpBills.ForSide"]</span> @Display.Number(forCount)
                                    · <span class="choice choice--against">@L["MpBills.AgainstSide"]</span> @Display.Number(againstCount)
                                </span>
                            }
                            else
                            {
                                @* Owner, 2026-11-17: a bill the MP answered that is in no summary now. *@
                                <span class="small" id="mp-bill-not-in-summary-@b.Number">@L["MpBills.NotInSummary"]</span>
                            }
                        </div>
                        <div class="rows__side">
                            @if (b.Response is { Status: ResponseStatuses.Published } r)
                            {
                                <span class="small" id="mp-bill-response-@b.Number">@L.Format("MpBills.Answered", L["MpResponse.Will." + r.Stance])</span>
                            }
                            else if (b.Response is { Status: ResponseStatuses.Hidden })
                            {
                                <span class="small" id="mp-bill-response-@b.Number">@L["MpBills.Hidden"]</span>
                            }
                            else
                            {
                                @if (b.Response is { Status: ResponseStatuses.Withdrawn })
                                {
                                    <span class="small" id="mp-bill-response-@b.Number">@L["MpBills.Withdrawn"]</span>
                                }
                                @if (b.Open)
                                {
                                    <a class="btn btn--plain" href="/seimas/@Uri.EscapeDataString(b.Number)#responses" id="mp-bill-answer-@b.Number">@L["MpBills.Answer"]</a>
                                }
                            }
                        </div>
                    </li>
                }
            </ul>
        }
    </section>
}

@code {
    private MpBillsResponse? _bills;
    private bool _refused;

    protected override async Task OnInitializedAsync()
    {
        // Only in the browser: the page the server renders holds nothing of the link.
        if (!RendererInfo.IsInteractive)
        {
            return;
        }

        var result = await Responses.GetMyBillsAsync();
        _refused = !result.IsSuccess;
        _bills = result.Value;
    }
}
