@page "/moderavimas"
@attribute [Authorize]
@rendermode InteractiveWebAssembly
@using Lt2.Api.Contracts.Appeals
@using Lt2.Web.Client.Appeals
@inherits InteractiveBase<AppealUi>
@inject IModerationApi ModerationApi

@* The moderators' queue (design 8.12.3), moderation after the fact: bills that need a look (a reported description, date
   flags, a surge, held, or under the threshold on the agenda with participants), and arguments flagged, reported or not
   yet seen. Every action needs the active moderator role of a staff-passkey session; the server refuses anything else.
   Nothing here shows who took which side. *@
<PageTitle>@L["Mod.PageTitle"]</PageTitle>

<div class="stack">
    <p class="label">Lietuva 2.0</p>
    <h1>@L["Mod.Title"]</h1>
    <NeedsScript />
    <p class="lead">@L["Mod.Lead"]</p>
    <p class="row"><a href="/moderavimas" id="queue-refresh">@L["Mod.Refresh"]</a> <a href="/moderavimas/paslepti" id="hidden-link">@L["Mod.HiddenLink"]</a></p>
</div>

<Messages Message="@Message" Info="@Info" />

@if (_refused)
{
    <p class="note" role="alert">@L["Mod.Refused"]</p>
}
else if (Queue is null)
{
    <p class="small">@L["Loading"]</p>
}
else
{
    <section class="stack" aria-labelledby="h-appeals">
        <h2 id="h-appeals">@L["Mod.Appeals"]</h2>
        @if (Queue.Appeals.Count == 0)
        {
            <p class="small">@L["Mod.Empty"]</p>
        }
        @foreach (var appeal in Queue.Appeals)
        {
            <article class="sheet stack" id="queue-appeal-@appeal.Id" aria-labelledby="qa-@appeal.Id" @key="appeal.Id">
                <div class="row">
                    <a class="tag tag--ink num" href="/seimas/@Uri.EscapeDataString(appeal.Bill.Number)">@appeal.Bill.Number</a>
                </div>
                <h3 id="qa-@appeal.Id">@appeal.Bill.Title</h3>
                @if (appeal.Planned is { } plan)
                {
                    <p class="small num">@L.Format("Mod.Planned", Display.Day(plan.Date), plan.Stage is { } s ? " · " + L["Mod.Stage." + s] : "")</p>
                }
                @if (appeal.Held)
                {
                    <p class="note note--quiet" id="held-@appeal.Id">@L["Mod.Held"]</p>
                }
                @if (appeal.UnderThresholdOnAgenda)
                {
                    <p class="note note--quiet" id="under-threshold-@appeal.Id">@L.Format("Mod.UnderThreshold",
                        appeal.Planned is { } onAgenda ? Display.Day(onAgenda.Date) : "–",
                        Display.Number(appeal.Participants), Display.Number(appeal.Threshold))</p>
                }
                @if (appeal.DateFlags.Count > 0)
                {
                    <p class="note note--quiet num" id="date-flags-@appeal.Id">@L.Format("Mod.DateFlags", Display.Number(appeal.DateFlags.Count))</p>
                    <ul class="rows">
                        @foreach (var flag in appeal.DateFlags)
                        {
                            <li><div class="rows__main"><b>@L["Flag." + flag.Kind]</b><a href="@flag.Link" rel="external noreferrer">@flag.Link</a>@if (flag.Note is { } note) {<span class="small">@note</span>}</div></li>
                        }
                    </ul>
                }
                @if (appeal.Surge is { } surge)
                {
                    <p class="note" id="surge-@appeal.Id">@L.Format("Mod.Surge", Display.Number(surge.WindowHours), Display.Number(surge.SharePercent))</p>
                }
                @if (appeal.Description.Length > 0)
                {
                    <p class="row">
                        <span class="label">@L["Mod.Description"]</span>
                        @if (appeal.DescriptionSource == "ai")
                        {
                            <span class="tag" id="queue-ai-label-@appeal.Id">@L["Mod.Source.ai"]</span>
                        }
                    </p>
                    <p class="voice">@appeal.Description</p>
                }

                <Reports Items="appeal.Reports" Description="true" />
                <ModerationActions Id="appeal.Id" Number="@appeal.Bill.Number" Kind="appeal" Status="open" Held="appeal.Held" Threshold="appeal.Threshold" Planned="appeal.Planned"
                                   Description="@appeal.Description" DescriptionSource="@appeal.DescriptionSource" DescriptionUrl="@appeal.DescriptionUrl"
                                   HasOpenItems="@(appeal.Reports.Count > 0 || appeal.DateFlags.Count > 0)" />
            </article>
        }
    </section>

    <section class="stack" aria-labelledby="h-reasons">
        <h2 id="h-reasons">@L["Mod.Reasons"]</h2>
        @if (Queue.Reasons.Count == 0)
        {
            <p class="small">@L["Mod.Empty"]</p>
        }
        @foreach (var reason in Queue.Reasons)
        {
            <QueueReasonItem @key="reason.Id" Reason="reason" OnRestricted="RestrictedAsync" />
        }
    </section>

    @* Design 8.14.14: new and changed organisations, and statements that wait, are flagged, reported or not yet seen. *@
    <OrganisationQueueView />

    <RestrictionList @ref="_restrictions" />
}

@code {
    private bool _refused;
    private RestrictionList? _restrictions;

    [PersistentState] public ModerationQueueResponse? Queue { get; set; }

    protected override async Task OnInitializedAsync()
    {
        if (Queue is null)
        {
            var queue = await ModerationApi.GetQueueAsync();
            _refused = queue.Problem?.Status is 401 or 403;
            Queue = queue.Value;
            if (!queue.IsSuccess && !_refused)
            {
                Show(queue.Problem);
            }
        }
    }

    private async Task RestrictedAsync()
    {
        if (_restrictions is not null)
        {
            await _restrictions.ReloadAsync();
        }
    }
}
