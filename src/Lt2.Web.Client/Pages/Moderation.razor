@page "/moderavimas"
@attribute [Authorize]
@rendermode InteractiveWebAssembly
@inherits InteractiveBase<AppealUi>
@inject IModerationApi ModerationApi
@inject IJSRuntime JS

@* The moderators' page (design 8.3, owner 2026-11-25): one page of tabs, the tab in ?skiltis=. The work lists first (the
   bills' records, arguments, organisations, statements, MPs' responses, profiles, comments), each with a small neutral chip
   saying how many wait, only when some do; then, set apart, the reference lists ("Be aprašymo", "Paslėpti", "Apribojimai")
   with their counts in brackets. The counts come first (GET /moderation/counts); only the open tab's list is read. Without a
   tab asked for, the page opens on the first work tab with something waiting (ModerationTabs.Open). In the running island a
   tab is opened in place and the address is replaced, so a refresh, Back to this page and a copied link keep it; before the
   island runs the tabs are plain links. An action on a list's item reads the counts again (QueueChanges). Every action
   needs the active moderator role of a staff-passkey session; the server refuses anything else. Nothing here shows who
   took which side. *@
<PageTitle>@L["Mod.PageTitle"]</PageTitle>

<div class="stack">
    <p class="label">Lietuva 2.0</p>
    <h1>@L["Mod.Title"]</h1>
    <NeedsScript />
    <p class="lead">@L["Mod.Lead"]</p>
    <p class="row"><a href="@Lt2.Api.Contracts.Digests.DigestRoutes.ModerationPage" id="digests-link">@L["DigMod.Title"]</a> <a href="/moderavimas/atsiliepimai" id="feedback-link">@L["Fb.Title"]</a></p>
</div>

<Messages Message="@Message" Info="@Info" />

@if (_refused)
{
    <p class="note" role="alert">@L["Mod.Refused"]</p>
    <PasskeyStep Staff="true" />
}
else if (Counts is null)
{
    <p class="small">@L["Loading"]</p>
}
else
{
    <nav class="project-tabs mod-tabs" aria-label="@L["Mod.Tabs.Label"]" id="moderation-tabs">
        <div class="mod-tabs__group" id="moderation-tabs-work">
            @foreach (var tab in ModerationTabs.Work)
            {
                var count = ModerationTabs.Count(Counts, tab);
                <a href="@ModerationTabs.Link(tab)" id="tab-@tab" aria-current="@(tab == Tab ? "page" : null)"
                   data-enhance-nav="@(RendererInfo.IsInteractive ? "false" : null)" @onclick="() => OpenAsync(tab)" @onclick:preventDefault="RendererInfo.IsInteractive">@Label(tab)@if (count > 0)
                    {<span class="tag mod-tabs__chip num" id="tab-count-@tab">@Display.Number(count)</span>}</a>
            }
        </div>
        <div class="mod-tabs__group" id="moderation-tabs-reference">
            @foreach (var tab in ModerationTabs.Reference)
            {
                <a href="@ModerationTabs.Link(tab)" id="tab-@tab" aria-current="@(tab == Tab ? "page" : null)"
                   data-enhance-nav="@(RendererInfo.IsInteractive ? "false" : null)" @onclick="() => OpenAsync(tab)" @onclick:preventDefault="RendererInfo.IsInteractive">@Label(tab) <span class="mod-tabs__count num" id="tab-count-@tab">(@Display.Number(ModerationTabs.Count(Counts, tab)))</span></a>
            }
        </div>
    </nav>

    <CascadingValue Value="_changes" IsFixed="true">
        <div class="stack" id="moderation-tab" @key="Tab">
            @switch (Tab)
            {
                case ModerationTabs.Reasons:
                    <ReasonQueueList />
                    break;
                case ModerationTabs.Organisations:
                    @* Design 8.14.14: new and changed organisations. *@
                    <OrganisationQueueView />
                    break;
                case ModerationTabs.Statements:
                    @* Design 8.14.14: statements that wait, are flagged, reported or not yet seen. *@
                    <OrganisationQueueView Statements="true" />
                    break;
                case ModerationTabs.Responses:
                    @* Design 8.5.5: MPs' responses flagged by pre-screening or reported. *@
                    <Lt2.Web.Client.Mps.ResponseModerationView />
                    break;
                case ModerationTabs.Profiles:
                    @* Design 8.25.6: reported public profiles. *@
                    <ProfileModerationView />
                    break;
                case ModerationTabs.Comments:
                    @* Design 8.23.8: comments, only when reported. *@
                    <Lt2.Web.Client.Comments.CommentModerationView />
                    break;
                case ModerationTabs.Undescribed:
                    <UndescribedList />
                    break;
                case ModerationTabs.Hidden:
                    <HiddenList />
                    break;
                case ModerationTabs.Restrictions:
                    <RestrictionList />
                    break;
                default:
                    <RecordQueueList />
                    break;
            }
        </div>
    </CascadingValue>
}

@code {
    private bool _refused;
    private QueueChanges _changes = default!;

    /// <summary>The tab asked for in the address (<c>?skiltis=</c>), if any.</summary>
    [SupplyParameterFromQuery(Name = ModerationTabs.Parameter)] public string? Asked { get; set; }

    [PersistentState] public ModerationCountsResponse? Counts { get; set; }

    /// <summary>The open tab: the one asked for, or the one <see cref="ModerationTabs.Open"/> picks; set in place afterwards.</summary>
    private string Tab { get; set; } = ModerationTabs.Records;

    protected override async Task OnInitializedAsync()
    {
        _changes = new QueueChanges(ReadCountsAsync);
        if (Counts is null)
        {
            var counts = await ModerationApi.GetCountsAsync();
            _refused = counts.Problem?.Status is 401 or 403;
            Counts = counts.Value;
            if (!counts.IsSuccess && !_refused)
            {
                Show(counts.Problem);
            }
        }

        Tab = ModerationTabs.Open(Asked, Counts);
    }

    private string Label(string tab) => tab switch
    {
        ModerationTabs.Reasons => L["Mod.Tab.Reasons"],
        ModerationTabs.Organisations => L["Mod.Tab.Organisations"],
        ModerationTabs.Statements => L["Mod.Tab.Statements"],
        ModerationTabs.Responses => L["Mod.Tab.Responses"],
        ModerationTabs.Profiles => L["Mod.Tab.Profiles"],
        ModerationTabs.Comments => L["Mod.Tab.Comments"],
        ModerationTabs.Undescribed => L["Mod.Tab.Undescribed"],
        ModerationTabs.Hidden => L["Mod.Tab.Hidden"],
        ModerationTabs.Restrictions => L["Mod.Tab.Restrictions"],
        _ => L["Mod.Tab.Records"],
    };

    /// <summary>
    /// Opens a tab in place (design 8.3): its list is read when it is shown, and the address is replaced with the tab's, so a
    /// refresh, Back to this page and a copied link keep it; the island's state stays (no enhanced navigation).
    /// </summary>
    private async Task OpenAsync(string tab)
    {
        if (!RendererInfo.IsInteractive)
        {
            return;
        }

        Tab = tab;
        await JS.InvokeVoidAsync("history.replaceState", null, "", ModerationTabs.Link(tab));
    }

    /// <summary>An action took an item out of a list (or changed what a list holds): the counts are read again.</summary>
    private async Task ReadCountsAsync()
    {
        if ((await ModerationApi.GetCountsAsync()).Value is { } counts)
        {
            Counts = counts;
            StateHasChanged();
        }
    }
}
