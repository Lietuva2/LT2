@using Lt2.Api.Contracts.Admin

@* Design 8.27: the most viewed pages, or the referring sites, of the chosen range, with their views or visitors. *@
@if (Items.Count == 0)
{
    <p class="small" id="@(Id)-none">@Empty</p>
}
else
{
    <div class="table-wrap">
        <table class="table" id="@Id">
            <thead><tr><th scope="col">@First</th><th scope="col" class="num">@Second</th></tr></thead>
            <tbody>
                @foreach (var item in Items)
                {
                    <tr @key="item.Name"><td class="usage-name"><code>@item.Name</code></td><td class="num nowrap">@Display.Number(item.Views)</td></tr>
                }
            </tbody>
        </table>
    </div>
}

@code {
    [Parameter, EditorRequired] public IReadOnlyList<UsageItemResponse> Items { get; set; } = [];

    [Parameter, EditorRequired] public string Id { get; set; } = "";

    [Parameter, EditorRequired] public string First { get; set; } = "";

    [Parameter, EditorRequired] public string Second { get; set; } = "";

    [Parameter, EditorRequired] public string Empty { get; set; } = "";
}
