@page "/seimo-narys/biuras"
@rendermode InteractiveWebAssembly
@using Lt2.Api.Contracts.Mps
@inherits InteractiveBase<UiText>
@inject IMpApi MpApi
@inject NavigationManager Navigation

@* Design 8.5.3: an office member's one-time link, made by the MP's account and passed on by its own means. A member who
   opens it in a passkey session and accepts becomes an office member of that MP. Design 6.8: the token is after the "#",
   read in the browser and sent in the request body. *@
<PageTitle>@L["MpOffice.PageTitle"]</PageTitle>

<div class="stack">
    <h1>@L["MpOffice.Title"]</h1>
    <NeedsScript />
    @if (_read && _token is null)
    {
        <p class="note" role="alert" id="office-missing">@L["MpLink.Missing"]</p>
    }
    else if (_read && !_signedIn)
    {
        <p class="note" id="office-sign-in">@L["MpOffice.SignInFirst"] <a href="/prisijungti">@L["MpLink.SignIn"]</a></p>
    }
    else if (Joined is { } joined)
    {
        <p class="note note--quiet" role="status" id="office-joined">
            @L.Format("Mp.OfficeOf", joined.FirstName + " " + joined.LastName) <a href="/sveiki">@L["MpOffice.ToAccount"]</a>
        </p>
    }
    else
    {
        <section class="sheet stack" aria-labelledby="office-what" id="office-invitation">
            <h2 id="office-what" class="visually-hidden">@L["MpOffice.What"]</h2>
            <p>@L["MpOffice.Lead"]</p>
            <p class="small">@L["MpOffice.PasskeyFirst"]</p>
            <p><button type="button" class="btn" id="office-accept" disabled="@(Locked || !_read)" @onclick="AcceptAsync">@L["MpOffice.Accept"]</button></p>
        </section>
    }
    <Messages Message="@Message" Info="@Info" />
</div>

@code {
    private bool _read;
    private bool _signedIn;
    private string? _token;

    private MpLinkResponse? Joined { get; set; }

    protected override async Task OnInitializedAsync()
    {
        if (!RendererInfo.IsInteractive)
        {
            return;
        }

        _token = InvitationLink.Fragment(Navigation.Uri);
        _signedIn = await IsSignedInAsync();
        _read = true;
    }

    private Task AcceptAsync() => RunAsync(async () =>
    {
        var accepted = await MpApi.AcceptOfficeInvitationAsync(new MpOfficeAcceptanceRequest { Token = _token ?? "" });
        if (!accepted.IsSuccess)
        {
            Show(accepted.Problem);
            return;
        }

        Joined = accepted.Value;
    });
}
