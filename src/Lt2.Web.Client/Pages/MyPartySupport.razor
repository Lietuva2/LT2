@inherits InteractiveBase<UiText>
@inject IMeApi MeApi

@* Design 5.2: the party the person supports, private and optional, with its own explicit consent; used only for group
   numbers in summaries to MPs, from the setting Digest:PartyGroupMinimum (8.4; 0 and 1 both mean any group of one or
   more, said in words), which the text states as it holds now. Design 8.25.9 (owner, 2026-11-17): while the profile is public, the box
   "Rodyti viešame profilyje" shows it on the public page, with its own consent (party-public) said inline before it is given;
   removing or changing the party, unticking the box or switching the profile off stops showing it at once. *@
@if (Party is { } party)
{
    <section class="sheet stack" aria-labelledby="party-title" id="party-support">
        <h3 id="party-title">@L["Party.Title"]</h3>
        <p id="party-text">@(party.GroupMinimum <= 1 ? L["Party.TextAny"] : L.Format("Party.Text", Display.Number(party.GroupMinimum)))</p>
        <div class="field">
            <label for="party-choice">@L["Party.Label"]</label>
            <select class="input" id="party-choice" @bind="_partyChoice" disabled="@Locked">
                <option value="">@L["Party.None"]</option>
                @foreach (var choice in party.Choices)
                {
                    <option value="@choice">@choice</option>
                }
            </select>
        </div>
        @if (!string.IsNullOrEmpty(_partyChoice) && _partyChoice != party.Party)
        {
            <label class="check">
                <input type="checkbox" id="party-consent" @bind="_partyConsent" disabled="@Locked" />
                <span>@L["Party.Consent"]</span>
            </label>
        }
        @if (!string.IsNullOrEmpty(_partyChoice))
        {
            @if (party.ProfilePublic)
            {
                <label class="check">
                    <input type="checkbox" id="party-public" @bind="_show" disabled="@Locked" />
                    <span>@L["Party.Public"]</span>
                </label>
                @if (_show && !(party.Public && _partyChoice == party.Party))
                {
                    @* What the consent covers, said before it is given (design 8.25.9, 8.15). *@
                    <p class="note" id="party-public-text">@L["Party.PublicText"]</p>
                }
            }
            else
            {
                <p class="small" id="party-public-needs-profile">@L["Party.PublicNeedsProfile"]</p>
            }
        }
        <p><button type="button" class="btn btn--plain" id="party-save" disabled="@(Locked || (!string.IsNullOrEmpty(_partyChoice) && _partyChoice != party.Party && !_partyConsent))" @onclick="SaveAsync">@L["Party.Save"]</button></p>
        <Messages Message="@Message" Info="@Info" />
    </section>
}

@code {
    private string _partyChoice = "";
    private bool _partyConsent;
    private bool _show;

    [PersistentState]
    public PartySupportResponse? Party { get; set; }

    protected override async Task OnInitializedAsync()
    {
        Party ??= (await MeApi.GetPartySupportAsync()).Value;
        Take();
    }

    /// <summary>Reads the state again: "Viešas profilis" was switched on or off on the same screen (switching off stops showing the party).</summary>
    public Task ReloadAsync() => RunAsync(async () =>
    {
        Party = (await MeApi.GetPartySupportAsync()).Value;
        Take();
    });

    private void Take()
    {
        _partyChoice = Party?.Party ?? "";
        _show = Party?.Public ?? false;
    }

    private Task SaveAsync() => RunAsync(async () =>
    {
        var party = string.IsNullOrEmpty(_partyChoice) ? null : _partyChoice;
        var was = Party!;
        if (party != was.Party)
        {
            // A removed or changed party stops being shown on the server (design 8.25.9); the box below gives it again.
            if (!Succeeded(await MeApi.SetPartySupportAsync(new PartySupportRequest { Party = party, Consent = _partyConsent })))
            {
                return;
            }
        }

        var shownBefore = was.Public && party == was.Party;
        var show = party is not null && was.ProfilePublic && _show;
        if (show != shownBefore)
        {
            if (!Succeeded(await MeApi.SetPartyPublicAsync(show)))
            {
                Party = (await MeApi.GetPartySupportAsync()).Value;
                return;
            }
        }

        Info = L[party is null ? "Party.Removed" : "Party.Saved"];
        _partyConsent = false;
        Party = (await MeApi.GetPartySupportAsync()).Value;
        Take();
    });
}
