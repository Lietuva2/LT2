@page "/paskyra"
@attribute [Authorize]
@rendermode InteractiveWebAssembly
@inherits AccountScreenBase

@* "Profilis", the first account screen (design 8.21; the owner, 2026-11-16: "Starting with name, about me and probably a
   party"): what others may see of the person and what they say of themself. Its one form (design 8.28.5): the display name
   (design 6.2), "Apie mane" with "Viešas profilis" (design 8.25), party support (design 5.2, private) with "Rodyti viešame
   profilyje" (design 8.25.9), one "Išsaugoti". Above it, not part of it: the level and roles, and for an MP's official
   address one line about the MP (design 8.5.1, owner 2026-11-17). The other screens are reached from the row under the
   title. *@
@if (Me is null)
{
    <p class="small">@L["Loading"]</p>
}
else
{
    <AccountHeader Me="Me" Current="@AccountScreens.Profile" />

    <section class="stack" aria-labelledby="profilis-title" id="profilis">
        <h2 id="profilis-title">@L["Parts.Profile"]</h2>
        <p class="row" id="account-level">
            <span class="tag @(Me.VerificationLevel == "email" ? "tag--people" : "")">@L["Level." + Me.VerificationLevel]</span>
            @foreach (var role in Me.Roles)
            {
                <span class="tag tag--brand">@L["Role." + role]</span>
            }
        </p>

        @* Design 8.5.1, 8.5.4 (owner, 2026-11-17): the MP whose official address this is, filled in the browser only. *@
        <MyMpLine />

        @* Design 8.28.5: the name, "Apie mane", "Viešas profilis", the party and its box, one form saved whole. *@
        <MyProfile NameChanged="NameChanged" ConsentOutdated="Me.PublicProfileConsentOutdated" ConsentAccepted="ReloadMeAsync" />
    </section>
}

<Messages Message="@Message" Info="@Info" />

@code {
    protected override async Task OnInitializedAsync() => await LoadMeAsync();

    /// <summary>The greeting follows a changed display name (the email when it was removed).</summary>
    private void NameChanged(string? name) => Me = Me! with { DisplayName = name };
}
