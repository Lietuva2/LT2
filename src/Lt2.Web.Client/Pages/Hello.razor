@page "/sveiki"
@attribute [Authorize]
@rendermode InteractiveWebAssembly
@inject IMeApi MeApi
@inject IAuthApi Auth
@inject IStringLocalizer<UiText> T
@inject NavigationManager Navigation
@inject Passkeys PasskeyBrowser

<PageTitle>@T["Hello.PageTitle"]</PageTitle>

@if (Me is null)
{
    <p class="small">@T["Loading"]</p>
}
else
{
    <section class="stack" aria-labelledby="hello-title">
        <p class="label">Lietuva 2.0</p>
        <h1 id="hello-title">@T["Hello.Greeting", Me.DisplayName ?? Me.Email]</h1>
        <p class="lead">@T["Hello.SignedIn"]</p>
        <p class="row">
            <span class="tag @(Me.VerificationLevel == "email" ? "tag--people" : "")">@T["Level." + Me.VerificationLevel]</span>
            @foreach (var role in Me.Roles)
            {
                <span class="tag tag--brand">@T["Role." + role]</span>
            }
        </p>
    </section>

    @if (Me.AwaitingActivation)
    {
        @* A granted staff role waits for the one-time code the administrator passed on (design 6.2). *@
        <section class="sheet sheet--cut stack" aria-labelledby="activation-title">
            <h2 id="activation-title">@T["Activation.Title"]</h2>
            <p>@T["Activation.Text"]</p>
            <form class="stack" @onsubmit="ActivateAsync" novalidate>
                <div class="field">
                    <label for="activation-code">@T["Activation.Label"]</label>
                    <input class="input num" id="activation-code" autocomplete="off" autocapitalize="characters" spellcheck="false"
                           @bind="_activationCode" @bind:event="oninput" disabled="@Locked" />
                </div>
                <button class="btn" type="submit" disabled="@Locked">@T["Activation.Submit"]</button>
            </form>
        </section>
    }

    <div class="pair">
        <section class="sheet sheet--cut stack" aria-labelledby="passkeys-title">
            <h2 id="passkeys-title">@T["Passkeys.Title"]</h2>
            <p>@T["Passkeys.Text"]</p>
            <p class="small num">@T["Passkeys.Count", Me.PasskeyCount]</p>
            <button type="button" class="btn" disabled="@Locked" @onclick="AddPasskeyAsync">@T["Passkeys.Add"]</button>
        </section>

        <section class="sheet stack" aria-labelledby="sessions-title">
            <h2 id="sessions-title">@T["Sessions.Title"]</h2>
            <p>@T["Sessions.Text"]</p>
            <ul class="rows">
                @foreach (var session in Sessions ?? [])
                {
                    <li>
                        <div class="rows__main">
                            <b>@(session.Device ?? T["Sessions.UnknownDevice"])</b>
                            <span class="small">
                                @T["Sessions.Method." + (string.IsNullOrEmpty(session.Method) ? "unknown" : session.Method)] ·
                                <span class="num">@T["Sessions.LastSeen", Format(session.LastSeenAt)]</span>
                            </span>
                        </div>
                        <div class="rows__side">
                            @if (session.IsCurrent)
                            {
                                <span class="tag tag--people">@T["Sessions.Current"]</span>
                            }
                            else
                            {
                                <button type="button" class="btn btn--plain" disabled="@Locked" @onclick="() => EndSessionAsync(session.Id)">@T["Sessions.End"]</button>
                            }
                        </div>
                    </li>
                }
            </ul>
        </section>
    </div>

    @if (Me.ActiveStaffRoles.Count > 0)
    {
        <nav class="row" aria-label="@T["Staff.Nav"]">
            <a class="btn btn--plain" href="/moderavimas">@T["Staff.Moderation"]</a>
            @if (Me.ActiveStaffRoles.Contains("administrator"))
            {
                <a class="btn btn--plain" href="/administravimas/nustatymai">@T["Staff.Settings"]</a>
            }
        </nav>
    }

    @if (Me.HasPositionConsent)
    {
        @* Withdrawing the consent deletes every position (design 6.5). *@
        <section class="sheet stack" aria-labelledby="consent-title">
            <h2 id="consent-title">@T["PositionConsent.Title"]</h2>
            <p>@T["PositionConsent.Text"]</p>
            <p><button type="button" class="btn btn--plain" id="withdraw-consent" disabled="@Locked" @onclick="WithdrawConsentAsync">@T["PositionConsent.Withdraw"]</button></p>
        </section>
    }

    <p><button type="button" class="btn btn--plain" disabled="@Locked" @onclick="SignOutAsync">@T["SignOut"]</button></p>
}

<Messages Message="@_message" Info="@_info" />

@code {
    private static readonly TimeZoneInfo Vilnius = FindVilnius();
    private bool _busy;
    private string? _message;
    private string? _info;
    private string _activationCode = "";

    /// <summary>
    /// Controls stay disabled until WebAssembly has taken over the server-rendered page: the prerendered form cannot
    /// act, and anything typed into it would be lost when the interactive component replaces it.
    /// </summary>
    private bool Locked => _busy || !RendererInfo.IsInteractive;

    [PersistentState]
    public MeResponse? Me { get; set; }

    [PersistentState]
    public List<SessionResponse>? Sessions { get; set; }

    protected override async Task OnInitializedAsync()
    {
        if (Me is null)
        {
            var me = await MeApi.GetAsync();
            if (!me.IsSuccess)
            {
                Navigation.NavigateTo("/prisijungti", forceLoad: true);
                return;
            }

            Me = me.Value;
        }

        // A pending account finishes its registration first (design 6.2).
        if (!Me!.RegistrationComplete)
        {
            Navigation.NavigateTo("/prisijungti", forceLoad: true);
            return;
        }

        Sessions ??= await LoadSessionsAsync();
    }

    private async Task<List<SessionResponse>> LoadSessionsAsync()
    {
        var sessions = await MeApi.GetSessionsAsync();
        return sessions.IsSuccess ? sessions.Value!.ToList() : [];
    }

    private async Task AddPasskeyAsync()
    {
        await RunAsync(async () =>
        {
            if (!await PasskeyBrowser.IsSupportedAsync())
            {
                _message = T["Passkey.Unsupported"];
                return;
            }

            var options = await Auth.GetPasskeyCreationOptionsAsync();
            if (!options.IsSuccess)
            {
                _message = options.Problem!.Detail ?? T["Error.Generic"];
                return;
            }

            var credential = await PasskeyBrowser.CreateAsync(options.Value!);
            if (credential is null)
            {
                _message = T["Passkey.Cancelled"];
                return;
            }

            var result = await Auth.AddPasskeyAsync(new PasskeyCredentialRequest { Credential = credential });
            if (!result.IsSuccess)
            {
                _message = result.Problem!.Detail ?? T["Error.Generic"];
                return;
            }

            _info = T["Passkeys.Added"];
            var me = await MeApi.GetAsync();
            if (me.IsSuccess)
            {
                Me = me.Value;
            }
        });
    }

    private async Task ActivateAsync()
    {
        await RunAsync(async () =>
        {
            var result = await MeApi.ActivateRoleAsync(new RoleActivationRequest { Code = _activationCode.Trim() });
            if (!result.IsSuccess)
            {
                _message = result.Problem!.Errors?.Values.FirstOrDefault()?.FirstOrDefault()
                    ?? result.Problem.Detail
                    ?? T["Error.Generic"];
                return;
            }

            _activationCode = "";
            _info = T["Activation.Done"];
            var me = await MeApi.GetAsync();
            if (me.IsSuccess)
            {
                Me = me.Value;
            }
        });
    }

    private async Task EndSessionAsync(Guid id)
    {
        await RunAsync(async () =>
        {
            var result = await MeApi.EndSessionAsync(id);
            if (!result.IsSuccess)
            {
                _message = result.Problem!.Detail ?? T["Error.Generic"];
            }

            Sessions = await LoadSessionsAsync();
        });
    }

    private async Task WithdrawConsentAsync()
    {
        await RunAsync(async () =>
        {
            var result = await MeApi.WithdrawPositionConsentAsync();
            if (!result.IsSuccess)
            {
                _message = result.Problem!.Detail ?? T["Error.Generic"];
                return;
            }

            _info = T["PositionConsent.Withdrawn"];
            var me = await MeApi.GetAsync();
            if (me.IsSuccess)
            {
                Me = me.Value;
            }
        });
    }

    private async Task SignOutAsync()
    {
        await RunAsync(async () =>
        {
            var result = await Auth.SignOutAsync();
            if (!result.IsSuccess)
            {
                _message = result.Problem!.Detail ?? T["Error.Generic"];
                return;
            }

            Navigation.NavigateTo("/", forceLoad: true);
        });
    }

    private async Task RunAsync(Func<Task> action)
    {
        _message = null;
        _info = null;
        _busy = true;
        try
        {
            await action();
        }
        catch (HttpRequestException)
        {
            _message = T["Error.Network"];
        }
        catch (Exception ex) when (ex is System.Text.Json.JsonException or NotSupportedException)
        {
            // An answer the client could not read: say so rather than leave the page silent.
            _message = T["Error.Generic"];
        }
        finally
        {
            _busy = false;
        }
    }

    private static string Format(DateTimeOffset value) =>
        TimeZoneInfo.ConvertTime(value, Vilnius).ToString("yyyy-MM-dd HH:mm", System.Globalization.CultureInfo.InvariantCulture);

    private static TimeZoneInfo FindVilnius()
    {
        try
        {
            return TimeZoneInfo.FindSystemTimeZoneById("Europe/Vilnius");
        }
        catch (TimeZoneNotFoundException)
        {
            return TimeZoneInfo.Utc;
        }
    }
}
