@using FluentValidation
@inherits InteractiveBase<UiText>
@inject IMeApi MeApi
@inject IValidator<DisplayNameRequest> Validator

@* Design 6.2: the display name, shown beside what the person writes in public, read live wherever it shows. The same rule as
   at registration (at most 60 characters, empty allowed); the server also refuses it under a writing restriction, and the
   refusal is said here. *@
<section class="sheet stack" aria-labelledby="name-title" id="vardas">
    <h3 id="name-title">@L["Name.Title"]</h3>
    <form class="stack" @onsubmit="SaveAsync" novalidate>
        <div class="field @ErrorClass("displayName")">
            <label for="display-name">@L["DisplayName.Label"]</label>
            <input class="input" id="display-name" autocomplete="nickname" placeholder="@L["DisplayName.Placeholder"]"
                   @bind="_name" @bind:event="oninput" disabled="@Locked"
                   aria-invalid="@Invalid("displayName")" aria-describedby="@DescribedBy("displayName", "display-name", "display-name-hint")" />
            <p class="field__hint" id="display-name-hint">@L["Name.Hint"]</p>
            <FieldError Errors="Errors" Field="displayName" For="display-name" />
        </div>
        <p><button class="btn btn--plain" type="submit" id="display-name-save" disabled="@Locked">@L["Name.Save"]</button></p>
        <Messages Message="@Message" Info="@Info" />
    </form>
</section>

@code {
    private string? _name;
    private string? _shown;

    /// <summary>The name the account has now (null without one).</summary>
    [Parameter] public string? Name { get; set; }

    /// <summary>Told the stored name after a change, so the page's greeting follows.</summary>
    [Parameter] public EventCallback<string?> Changed { get; set; }

    protected override void OnParametersSet()
    {
        // Typing is not overwritten by a re-render; a changed name from the parent is taken.
        if (_shown != Name)
        {
            _shown = Name;
            _name = Name;
        }
    }

    private Task SaveAsync()
    {
        var request = new DisplayNameRequest { DisplayName = string.IsNullOrWhiteSpace(_name) ? null : _name.Trim() };
        ClearMessages();
        return !Valid(Validator.Validate(request)) ? Task.CompletedTask : RunAsync(async () =>
        {
            if (!Succeeded(await MeApi.ChangeDisplayNameAsync(request), "displayName"))
            {
                return;
            }

            Info = L[request.DisplayName is null ? "Name.Removed" : "Name.Saved"];
            _shown = request.DisplayName;
            _name = request.DisplayName;
            await Changed.InvokeAsync(request.DisplayName);
        });
    }
}
