@page "/organizacijos/nauja"
@attribute [Authorize]
@rendermode InteractiveWebAssembly
@using Lt2.Api.Contracts.Organisations
@inherits InteractiveBase<AppealUi>
@inject IAppealsApi Appeals
@inject NavigationManager Navigation
@inject MyAccountState Account

@* Registering an organisation (design 8.14.14): a signed-in member, shown at once, with nobody approving it; the member
   becomes its first representative, and representatives are not public. A person under a writing restriction sees the
   notice in place of the form, and the MP's own account, which registers none (design 8.5.4, owner 2026-11-17), one line
   once the island runs. *@
<PageTitle>@L["Org.Register.PageTitle"]</PageTitle>

<div class="stack">
    <ol class="crumbs">
        <li><a href="/organizacijos">@L["Org.List.Title"]</a></li>
        <li>@L["Org.Register.Title"]</li>
    </ol>
    <h1>@L["Org.Register.Title"]</h1>
    <NeedsScript />
    @* Design 8.15: one sentence before the form (what becomes public, at once); how it works one click away, a <details>
       that opens without JavaScript and before the island starts. *@
    <p class="lead" id="register-lead">@L["Org.Register.Lead"]</p>
    <details class="more stack stack--tight" id="register-more">
        <summary class="linkish small">@L["Org.Register.More"]</summary>
        <ul class="small stack stack--tight" id="register-what">
            <li>@L["Org.Register.Point1"]</li>
            <li>@L["Org.Register.Point2"]</li>
            <li>@L["Org.Register.Point3"]</li>
        </ul>
        <p class="fine"><a href="/metodika#organisations">@L["Org.Register.Method"]</a></p>
    </details>
</div>

@if (_mpAccount)
{
    <p class="note note--quiet" id="register-mp-account">@L["Org.Register.MpAccount"]</p>
}
else if (Restriction is { Restricted: true } restriction)
{
    <WritingRestricted Restriction="restriction" />
}
else
{
    <section class="sheet stack" aria-label="@L["Org.Register.Title"]">
        <OrganisationForm OnRegistered="Registered" />
    </section>
}

@code {
    [PersistentState] public MyRestrictionResponse? Restriction { get; set; }

    private bool _mpAccount;

    protected override async Task OnInitializedAsync()
    {
        Restriction ??= (await Appeals.GetMyRestrictionAsync()).Value;
        _mpAccount = await Account.IsMpAccountAsync(RendererInfo.IsInteractive);
    }

    private void Registered(string slug) => Navigation.NavigateTo(OrganisationWords.ProfilePath(slug), forceLoad: true);
}
