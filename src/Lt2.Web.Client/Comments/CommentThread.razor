@using Lt2.Api.Contracts.Appeals
@using Lt2.Api.Contracts.Comments
@using Lt2.Api.Contracts.Me
@using Lt2.Web.Client.Appeals
@inherits InteractiveBase<AppealUi>
@implements IDisposable
@inject ICommentsApi Comments
@inject CommentState State
@inject MyBillState BillState
@inject IAppealsApi Appeals

@* "Aptarimas (n)" under one argument, statement or response (design 8.23.6): the browser's own <details>, so it opens with
   JavaScript off; since the action row (design 8.16.1, the designer's proposal of 2026-11-17) the <details> holds only its
   summary, which stands in the row beside "Man svarbu" and "⋯", and the discussion is the panel right after it
   (.discuss__panel), which the stylesheet shows only while the <details> is open (`.discuss:not([open]) + .discuss__panel`)
   and lays below the whole row at its full width. Inside, the shown comments oldest first, each with its name (a person's
   display name; an organisation's name with "Organizacija"; an MP's name with "Seimo narys arba jo biuras"), its time, its
   text (an https address as a link, nothing fetched from it), who agreed ("Sutinka: …"), then its own action row:
   "Sutinku" and "⋯" ("Pranešti", for whoever may "Ištrinti", for a moderator "Moderuoti"); then "Rodyti daugiau komentarų"
   by the page's address and the writing box. The list is the same for every reader: what the caller may delete, wrote and
   agreed with comes from the never-cached answer (CommentState), read in the browser only. Inside an island (the arguments,
   the statements) this renders with it; on the server-rendered responses part it is an island of its own. *@
<details class="discuss" id="aptarimas-@Key" open="@(Open || ShowsNew)" @ontoggle="ToggledAsync">
    <summary class="act__item discuss__toggle" id="aptarimas-summary-@Key" aria-controls="aptarimas-panel-@Key"><Icon Name="chat" /><span class="discuss__word">@L["Comments.Title"]</span>@if (ShownCount > 0) {@(" ")<span class="num">(@Display.Number(ShownCount))</span>}</summary>
</details>
<div class="discuss__panel comments stack stack--tight" id="aptarimas-panel-@Key">
    @if (_thread is { } thread)
    {
        @* Design 8.25.4: the card of each public profile among this thread's names, once per thread, for js/lt2-cards.js. *@
        @foreach (var card in thread.Cards ?? [])
        {
            <template id="@CardId(card.ProfileId)" @key="card.ProfileId"><p><b>@card.Name</b></p>@if (card.About is { } about) {<p class="small">@TextExcerpt.Of(about, CardShown).Shown</p>}<p class="small"><a href="@ProfileRoutes.Page(card.ProfileId, card.Name)">@L["Card.Open"]</a></p></template>
        }
        @if (thread.Items.Count > 0)
        {
            <ol class="stack stack--tight comments__list" id="comments-@Key">
                @for (var position = 1; position <= thread.Items.Count; position++)
                {
                    var c = thread.Items[position - 1];
                    var id = CommentLimits.ElementId(c.Id);
                    var moderated = Moderated(c.Id);
                    var deletable = _signedIn && _mine?.Deletable.Contains(c.Id) == true && thread.BillOpen;
                    var editable = MayEdit(thread, c.Id);
                    <li class="comment stack stack--tight @(Marked == c.Id ? "comment--linked" : null)" id="@id" @key="c.Id">
                        <p class="row comment__who" id="@CommentPaging.PositionAnchor(TargetId, position)">
                            @Name(c.Author)
                            <span class="small num">@Display.DayTime(c.CreatedAt)</span>
                            <NewMark Number="@Number" Id="c.Id" />
                        </p>
                        <LongText Text="@c.Text" BubbleClass="bubble bubble--people voice comment__text" Links="true" Id="@($"{id}-more")" />
                        @if (c.AgreedBy.Count > 0)
                        {
                            @* "Sutinka: A, B ir dar 5" (owner, 2026-11-17): "ir dar 5" opens the full list, oldest agreement first. *@
                            <div class="small comment__agreed agreed" id="@id-agreed">
                                <span>@Agreed(c)</span>
                                @if (c.AgreedBy.Count > 2)
                                {
                                    <details class="more" id="@id-all-agreed">
                                        <summary class="linkish" aria-controls="@id-all-agreed-list">@L.Format("Comments.Agreed.Rest", Display.Number(c.AgreedBy.Count - 2))</summary>
                                    </details>
                                    <p class="agreed__all" id="@id-all-agreed-list">@for (var i = 0; i < c.AgreedBy.Count; i++) { @(i > 0 ? ", " : "")@Person(c.AgreedBy[i]) }</p>
                                }
                            </div>
                        }
                        @* The action row (design 8.16.1): "Sutinku", then "⋯" with the rarer actions; a chosen one opens below it.
                           "Sutinku" is a toggle like "Man svarbu" (owner, 2026-11-17): the same words in both states, its icon
                           filled while agreed. *@
                        <div class="act" id="@id-actions">
                            @if (_signedIn && MayAgree(c, out var agreed))
                            {
                                <button class="mark act__item" type="button" id="@id-agree" aria-pressed="@(agreed ? "true" : "false")" disabled="@Locked"
                                        title="@(agreed ? null : L["Comments.Agree.Hint"].Value)" @onclick="() => AgreeAsync(c.Id, agreed)"><Icon Name="agree" /><span>@L["Comments.Agree"]</span></button>
                            }
                            <MoreMenu Id="@($"{id}-more-actions")">
                                @if (_signedIn)
                                {
                                    <button class="menu__item" type="button" id="@id-report" disabled="@Locked" popovertarget="@MoreMenu.MenuOf($"{id}-more-actions")" popovertargetaction="hide"
                                            @onclick="() => _reporting = _reporting == c.Id ? null : c.Id">@L["Report.Open"]</button>
                                    @if (editable)
                                    {
                                        @* Owner, 2026-11-17: only while nobody said "Sutinku", from the never-cached answer; not shown otherwise. *@
                                        <button class="menu__item" type="button" id="@id-edit" disabled="@Locked" popovertarget="@MoreMenu.MenuOf($"{id}-more-actions")" popovertargetaction="hide"
                                                @onclick="() => StartEditingAsync(c)">@L["Comments.Edit"]</button>
                                    }
                                    @if (deletable)
                                    {
                                        <button class="menu__item" type="button" id="@id-delete" disabled="@Locked" popovertarget="@MoreMenu.MenuOf($"{id}-more-actions")" popovertargetaction="hide"
                                                @onclick="() => _deleting = _deleting == c.Id ? null : c.Id">@L["Comments.Delete"]</button>
                                    }
                                    @if (moderated is not null)
                                    {
                                        <button class="menu__item" type="button" id="@id-moderate" disabled="@Locked" popovertarget="@MoreMenu.MenuOf($"{id}-more-actions")" popovertargetaction="hide"
                                                @onclick="() => _moderating = _moderating == c.Id ? null : c.Id">@L["ModReason.Open"]</button>
                                    }
                                }
                                else
                                {
                                    <VisitorReport Contact="@Contact" />
                                }
                            </MoreMenu>
                            @if (_confirming == c.Id)
                            {
                                @* Design 8.23.10, 8.15: what becomes public and under whose name is said inline, before the first "Sutinku". *@
                                <div class="act__panel row note note--quiet" role="group" aria-label="@L["Comments.Agree"]" id="@id-confirm">
                                    <p class="small">@L["Comments.Agree.Confirm"]</p>
                                    <button class="btn" type="button" id="@id-confirm-yes" disabled="@Locked" @onclick="() => AgreeConfirmedAsync(c.Id)">@L["Comments.Agree"]</button>
                                    <button class="btn btn--plain" type="button" disabled="@Locked" @onclick="() => _confirming = null">@L["Cancel"]</button>
                                </div>
                            }
                            @if (_editingComment == c.Id)
                            {
                                <form class="act__panel sheet sheet--quiet stack stack--tight" @onsubmit="() => SaveEditAsync(c.Id)" novalidate aria-labelledby="@id-edit-title" id="@id-edit-form">
                                    <h4 id="@id-edit-title">@L["Comments.EditTitle"]</h4>
                                    <div class="field @ErrorClass("text")">
                                        <label for="@id-edit-text">@L["Comments.Label"]</label>
                                        <textarea class="textarea" id="@id-edit-text" rows="4" maxlength="@MemberTextLimits.Allowed(_maxLength ?? 0)" aria-invalid="@Invalid("text")"
                                                  aria-describedby="@DescribedBy("text", $"{id}-edit-text", $"{id}-edit-hint")" @bind="_editText" @bind:event="oninput" disabled="@Locked"></textarea>
                                        <p class="field__hint num" id="@id-edit-hint">@(_maxLength is > 0 and var max ? L.Format("Comments.Hint", Display.Number(_editText.Length), Display.Number(max)) : L["Comments.HintNoLimit"].Value)</p>
                                    </div>
                                    <div class="row">
                                        <button type="submit" class="btn" id="@id-edit-save" disabled="@(Locked || string.IsNullOrWhiteSpace(_editText))">@L["Comments.Save"]</button>
                                        <button type="button" class="btn btn--plain" disabled="@Locked" @onclick="CancelEditing">@L["Cancel"]</button>
                                    </div>
                                </form>
                            }
                            @if (_deleting == c.Id)
                            {
                                <div class="act__panel row sheet sheet--quiet" role="group" aria-label="@L["Comments.Delete"]">
                                    <p class="small">@L["Comments.DeleteConfirm"]</p>
                                    <button class="btn" type="button" id="@id-delete-yes" disabled="@Locked" @onclick="() => DeleteAsync(c.Id)">@L["Comments.DeleteYes"]</button>
                                    <button class="btn btn--plain" type="button" disabled="@Locked" @onclick="() => _deleting = null">@L["Cancel"]</button>
                                </div>
                            }
                            @if (_reporting == c.Id)
                            {
                                <div class="act__panel"><ReportForm TargetKind="comment" TargetId="c.Id" OnClose="() => _reporting = null" /></div>
                            }
                            @if (moderated is not null && _moderating == c.Id)
                            {
                                <div class="act__panel sheet sheet--quiet moderate" id="@id-moderation">
                                    <CommentModerationActions Id="c.Id" Status="@moderated.Status" Reported="moderated.Reports.Count > 0" IdPrefix="page-" OnDone="ReloadAsync" />
                                </div>
                            }
                        </div>
                    </li>
                }
            </ol>
        }
        else
        {
            <p class="small" id="comments-none-@Key">@L["Comments.None"]</p>
        }
        @if (thread.Count > thread.Items.Count && CommentPaging.More(thread.Items.Count, thread.Count) is { } more)
        {
            <div class="row">
                <p class="small num" role="status">@L.Format("Comments.Shown", Display.Number(thread.Items.Count), Display.Number(thread.Count))</p>
                <a class="btn btn--plain" id="comments-more-@Key" href="@CommentPaging.Address(PagePath, TargetId, more, CommentPaging.PositionAnchor(TargetId, thread.Items.Count + 1))">@L["Comments.More"]</a>
            </div>
        }
        @if (!thread.BillOpen)
        {
            <p class="fine" id="comments-frozen-@Key">@L["Comments.Frozen"]</p>
        }
        else if (thread.Open)
        {
            @Box(thread)
        }
    }
    else if (_loading)
    {
        <p class="small">@L["Loading"]</p>
    }
    <Messages Message="@Message" Info="@Info" />
</div>

@code {
    private bool _signedIn;
    private bool _loading;
    private bool _writing;
    private string _text = "";
    private int? _maxLength;
    private Guid? _reporting;
    private Guid? _deleting;
    private Guid? _confirming;

    /// <summary>The comment whose moderator's actions are open below its row ("⋯" → "Moderuoti").</summary>
    private Guid? _moderating;
    private CommentThreadResponse? _thread;
    private MyCommentsResponse? _mine;
    private MyRestrictionResponse? _restriction;
    private IReadOnlyList<QueueCommentResponse>? _moderation;

    /// <summary><c>reason</c>, <c>statement</c> or <c>response</c>.</summary>
    [Parameter, EditorRequired] public string Kind { get; set; } = "";

    [Parameter, EditorRequired] public Guid TargetId { get; set; }

    /// <summary>The bill's number, for the caller's own answer.</summary>
    [Parameter, EditorRequired] public string Number { get; set; } = "";

    /// <summary>The comments as the server read them; null for a target whose comments are read when "Aptarimas" first opens.</summary>
    [Parameter] public CommentThreadResponse? Thread { get; set; }

    /// <summary>How many comments the target shows, for the summary before the comments are read.</summary>
    [Parameter] public int Count { get; set; }

    /// <summary>Rendered open: the page's address asked for more of this target's comments (design 8.23.6).</summary>
    [Parameter] public bool Open { get; set; }

    /// <summary>How many comments the page's address asks for (design 8.23.14); a thread read on first opening reads as many.</summary>
    [Parameter] public int? Asked { get; set; }

    /// <summary>The comment a link on the page's address leads to (design 8.23.6): marked, so the reader sees which one it is.</summary>
    [Parameter] public Guid? Marked { get; set; }

    /// <summary>The page's path (with its other parameters), for "Rodyti daugiau komentarų" and the sign-in link.</summary>
    [Parameter, EditorRequired] public string PagePath { get; set; } = "";

    [Parameter] public string? Contact { get; set; }

    /// <summary>The server found a moderator in a staff-passkey session; the server still refuses everyone else.</summary>
    [Parameter] public bool Moderator { get; set; }

    private string Key => TargetId.ToString("N");

    /// <summary>"Aptarimas (n)": the shown comments, from the thread once it is read.</summary>
    private int ShownCount => _thread?.Count ?? Count;

    protected override async Task OnInitializedAsync()
    {
        _thread = Thread;
        // The list the server renders is the same for everyone (design 8.23.6): a member's own controls come once the island
        // runs in the browser.
        _signedIn = RendererInfo.IsInteractive && await IsSignedInAsync();
        State.Changed += OnChanged;
        if (RendererInfo.IsInteractive)
        {
            BillState.NewsChanged += OnNewsChanged;
        }

        // The caller's own answer and the moderators' one only in the browser: the server-rendered list is the same for all.
        if (_signedIn && RendererInfo.IsInteractive)
        {
            _mine = await State.MineAsync(Number);
            if (_mine is { Restricted: true })
            {
                _restriction = await BillState.RestrictionAsync();
            }

            if (Moderator)
            {
                _moderation = await State.ModerationAsync(Number);
            }
        }
    }

    public void Dispose()
    {
        State.Changed -= OnChanged;
        BillState.NewsChanged -= OnNewsChanged;
    }

    /// <summary>
    /// "Rodyti tik naujus" is on and this discussion holds a comment new to the reader (design 8.11.8): it is rendered open, as a
    /// linked comment's is, by the person's own switch.
    /// </summary>
    private bool ShowsNew => BillState.OnlyNew(Number) && BillState.News(Number)?.HasNewComments(TargetId) == true;

    /// <summary>
    /// What is new arrived, or "Rodyti tik naujus" was switched: the marks are drawn again, and a discussion opened by the switch
    /// reads its comments through the last new one (new comments come last, and may stand beyond the first ten).
    /// </summary>
    private void OnNewsChanged(string number)
    {
        if (!string.Equals(number, Number, StringComparison.OrdinalIgnoreCase))
        {
            return;
        }

        _ = InvokeAsync(async () =>
        {
            var wanted = ShowsNew ? BillState.News(Number)?.CommentsByTarget.GetValueOrDefault(TargetId) : null;
            var missing = wanted is not null && (_thread is not { } shown || wanted.Any(id => shown.Items.All(i => i.Id != id)));
            if (missing && !_loading)
            {
                _loading = true;
                StateHasChanged();
                try
                {
                    var all = Math.Max(_thread?.Count ?? Count, Asked ?? 0);
                    _thread = (await Comments.GetThreadAsync(Kind, TargetId, all > 0 ? all : null)).Value ?? _thread;
                }
                catch (HttpRequestException)
                {
                    // The discussion shows what it has.
                }

                _loading = false;
            }

            StateHasChanged();
        });
    }

    private void OnChanged(string number)
    {
        if (!string.Equals(number, Number, StringComparison.OrdinalIgnoreCase) || !RendererInfo.IsInteractive)
        {
            return;
        }

        _ = InvokeAsync(async () =>
        {
            _mine = await State.MineAsync(Number);
            StateHasChanged();
        });
    }

    /// <summary>
    /// A target whose comments were not rendered (an argument revealed by "show all") reads them when the person first opens its
    /// "Aptarimas" (design 8.23.6); the island never opens one from code.
    /// </summary>
    private async Task ToggledAsync()
    {
        if (_thread is not null || _loading || !RendererInfo.IsInteractive)
        {
            return;
        }

        _loading = true;
        await RunAsync(async () => _thread = (await Comments.GetThreadAsync(Kind, TargetId, Asked)).Value);
        _loading = false;
    }

    private QueueCommentResponse? Moderated(Guid id) => _moderation?.FirstOrDefault(q => q.Id == id);

    private string PersonName(string? name) => name ?? L["Comments.NoName"].Value;

    /// <summary>About this many characters of "Apie mane" in a card (design 8.25.4: "the first lines"), as beside arguments.</summary>
    private const int CardShown = 200;

    /// <summary>A card's template id: per thread, so two threads on one page never share an id.</summary>
    private string CardId(string profileId) => $"card-{Key}-{profileId}";

    /// <summary>
    /// "Sutinka: Rūta Mockutė, Tomas" (design 8.23.10): the first two names; how many more ("ir dar 3") is the summary beside
    /// it that opens the full list. A name of a member with a public profile is a link to it with its card (design 8.25.4).
    /// </summary>
    private RenderFragment Agreed(CommentResponse c) => __builder =>
    {
        var words = c.AgreedBy.Count switch
        {
            0 => "",
            1 => L.Format("Comments.Agreed.One", "\u0001"),
            _ => L.Format("Comments.Agreed.Two", "\u0001", "\u0002"),
        };
        foreach (var piece in System.Text.RegularExpressions.Regex.Split(words, "([\u0001\u0002])"))
        {
            switch (piece)
            {
                case "\u0001":
                    @Person(c.AgreedBy[0])
                    break;
                case "\u0002":
                    @Person(c.AgreedBy[1])
                    break;
                default:
                    @piece
                    break;
            }
        }
    };

    /// <summary>One who agreed: a link with its card for a member with a public profile, the plain name otherwise.</summary>
    private RenderFragment Person(CommentAgreerResponse a) => __builder =>
    {
        if (a.ProfileId is { } profileId)
        {
            <a href="@ProfileRoutes.Page(profileId, a.Name)" data-card="@CardId(profileId)">@PersonName(a.Name)</a>
        }
        else
        {
            @PersonName(a.Name)
        }
    };

    /// <summary>"Sutinku" for a member, not on one's own comment, not for an MP's own account, only while the bill is open.</summary>
    private bool MayAgree(CommentResponse c, out bool agreed)
    {
        agreed = _mine?.Agreed.Contains(c.Id) == true;
        return _thread is { BillOpen: true } && _mine is { MpAccount: false } mine && !mine.Written.Contains(c.Id);
    }

    private RenderFragment Name(CommentAuthorResponse a) => __builder =>
    {
        switch (a.Voice)
        {
            case "organisation":
                if (a.OrganisationSlug is { } slug)
                {
                    <a class="comment__name" href="@Lt2.Web.Client.Organisations.OrganisationWords.ProfilePath(slug)">@a.Name</a>
                }
                else
                {
                    <b class="comment__name">@a.Name</b>
                }
                <span class="tag">@L["Comments.Mark.Organisation"]</span>
                @if (a.Label is { } label)
                {
                    @* Design 8.23.2: the organisation's label (8.14.3) beside its name. *@
                    <span class="small comment__label">@Lt2.Web.Client.Organisations.OrganisationWords.LabelText(L, label)</span>
                }
                break;
            case "mp":
                if (a.Mp is { Slug.Length: > 0 } mp)
                {
                    <a class="comment__name" href="/p/@mp.Slug">@mp.FirstName @mp.LastName</a>
                }
                else
                {
                    <b class="comment__name">@(a.Mp is { } m ? $"{m.FirstName} {m.LastName}".Trim() : "")</b>
                }
                <span class="tag">@L["Comments.Mark.Mp"]</span>
                break;
            default:
                if (a.ProfileId is { } profileId)
                {
                    @* Design 8.25.4: a member with a public profile: the name leads to their page, with a card. *@
                    <a class="comment__name" href="@ProfileRoutes.Page(profileId, a.Name)" data-card="@CardId(profileId)">@PersonName(a.Name)</a>
                }
                else
                {
                    <b class="comment__name">@PersonName(a.Name)</b>
                }

                break;
        }
    };

    /// <summary>The writing box (design 8.23.2, 8.23.6), or what stands in its place.</summary>
    private RenderFragment Box(CommentThreadResponse thread) => __builder =>
    {
        if (!_signedIn)
        {
            <p class="small" id="comments-sign-in-@Key"><a href="@LandingPath.SignInLink(PathOnly)">@L["Comments.SignIn"]</a></p>
            return;
        }

        if (_restriction is { Restricted: true } restriction)
        {
            <WritingRestricted Restriction="restriction" />
            return;
        }

        var voice = _mine?.Voices.FirstOrDefault(v => v.Kind == Kind && v.TargetId == TargetId);
        if (voice?.Refusal is "mp.passkey-required")
        {
            @* Owner, 2026-11-17: the MP's voice needs a passkey session; it is made here, and the box opens. *@
            <PasskeyStep IdPrefix="@($"comments-{Key}-")" Confirmed="() => ReloadCoreAsync(all: false)" />
            return;
        }

        if (voice?.Refusal is { } refusal)
        {
            <p class="note note--quiet" id="comments-refusal-@Key">@L.OrElse("Comments.Refusal." + refusal, L["Comments.Refusal.mp.passkey-required"].Value)</p>
            return;
        }

        if (_mine is { MpAccount: true } && voice is null)
        {
            // Design 8.5.4: the MP's own account comments only under its own response.
            return;
        }

        if (_mine is { PerTargetLimit: > 0 } limited && limited.WrittenPerTarget.GetValueOrDefault(TargetId) >= limited.PerTargetLimit)
        {
            <p class="small" id="comments-limit-@Key">@L.Format("Comments.LimitReached", Display.Number(limited.PerTargetLimit))</p>
            return;
        }

        if (!_writing)
        {
            <p><button class="btn btn--plain" type="button" id="comments-write-@Key" disabled="@Locked" @onclick="StartAsync">@L["Comments.Write"]</button></p>
            return;
        }

        <form class="sheet sheet--quiet stack stack--tight" @onsubmit="SubmitAsync" novalidate aria-labelledby="comment-form-title-@Key" id="comment-form-@Key">
            <h4 id="comment-form-title-@Key">@L["Comments.Write"]</h4>
            @* What becomes public and under whose name (design 8.15, 8.23.2): said above the box, decided by the server. *@
            <p class="small" id="comment-voice-@Key">@(voice?.Voice switch
            {
                "organisation" => L["Comments.Voice.organisation"],
                "mp" => L["Comments.Voice.mp"],
                _ => L["Comments.Voice.person"],
            })</p>
            <div class="field @ErrorClass("text")">
                <label for="comment-text-@Key">@L["Comments.Label"]</label>
                <textarea class="textarea" id="comment-text-@Key" rows="4" maxlength="@MemberTextLimits.Allowed(_maxLength ?? 0)" aria-invalid="@Invalid("text")"
                          aria-describedby="@DescribedBy("text", $"comment-text-{Key}", $"comment-hint-{Key}", $"comment-layout-{Key}")" @bind="_text" @bind:event="oninput" disabled="@Locked"></textarea>
                <p class="field__hint num" id="comment-hint-@Key">@(_maxLength is > 0 and var max ? L.Format("Comments.Hint", Display.Number(_text.Length), Display.Number(max)) : L["Comments.HintNoLimit"].Value)</p>
                <TextLayoutHint Id="@($"comment-layout-{Key}")" />
            </div>
            <div class="row">
                <button type="submit" class="btn" id="comment-submit-@Key" disabled="@(Locked || string.IsNullOrWhiteSpace(_text))">@L["Comments.Submit"]</button>
                <button type="button" class="btn btn--plain" disabled="@Locked" @onclick="Cancel">@L["Cancel"]</button>
            </div>
        </form>
    };

    /// <summary>The page's path without its query, for the sign-in link (which carries only a bill's path, design 6.9).</summary>
    private string PathOnly => PagePath.Split('?', '#')[0];

    private Task StartAsync() => RunAsync(async () =>
    {
        // The length a comment may have is the members' texts setting (design 8.23.3): read once, when writing starts.
        _maxLength ??= (await Appeals.GetRulesAsync()).Value?.TextMaxLength;
        _writing = true;
    });

    private void Cancel()
    {
        _writing = false;
        _text = "";
        Errors = NoErrors();
    }

    private Task SubmitAsync() => RunAsync(async () =>
    {
        var written = await Comments.WriteAsync(Kind, TargetId, new CommentRequest { Text = _text });
        if (!Succeeded(written, "text"))
        {
            return;
        }

        Cancel();
        Info = L["Comments.Published"];
        await ReloadCoreAsync(all: true);
    });

    /// <summary>The comment whose edit form is open below its row ("⋯" → "Redaguoti").</summary>
    private Guid? _editingComment;
    private string _editText = "";

    /// <summary>
    /// "Redaguoti" on one's own comment (design 8.23.3, owner 2026-11-17): only while the server says it may be edited (nobody said
    /// "Sutinku", the voice it was written in, the bill and the discussion open), from the never-cached answer. Not shown otherwise.
    /// </summary>
    private bool MayEdit(CommentThreadResponse thread, Guid commentId) =>
        _signedIn && thread.Open && _mine is { Restricted: false } mine && mine.Editable.Contains(commentId);

    private Task StartEditingAsync(CommentResponse comment) => RunAsync(async () =>
    {
        _maxLength ??= (await Appeals.GetRulesAsync()).Value?.TextMaxLength;
        _editingComment = comment.Id;
        _editText = comment.Text;
        _deleting = null;
        _reporting = null;
        Errors = NoErrors();
    });

    private void CancelEditing()
    {
        _editingComment = null;
        _editText = "";
        Errors = NoErrors();
    }

    private Task SaveEditAsync(Guid id) => RunAsync(async () =>
    {
        var saved = await Comments.EditAsync(id, new CommentRequest { Text = _editText });
        if (!Succeeded(saved, "text"))
        {
            if (saved.Problem?.Code == "comment.reacted")
            {
                // Someone agreed meanwhile: the message says so, the form closes and "Redaguoti" goes.
                _editingComment = null;
                await ReloadCoreAsync(all: false);
            }

            return;
        }

        CancelEditing();
        Info = L["Comments.Edited"];
        await ReloadCoreAsync(all: false);
    });

    private Task AgreeAsync(Guid id, bool agreed)
    {
        // The first "Sutinku" anywhere asks first that the name will be visible (design 8.23.10).
        if (!agreed && _mine is { AgreedBefore: false })
        {
            _confirming = id;
            return Task.CompletedTask;
        }

        return RunAsync(async () =>
        {
            if (Succeeded(agreed ? await Comments.RemoveAgreementAsync(id) : await Comments.AgreeAsync(id)))
            {
                await ReloadCoreAsync(all: false);
            }
        });
    }

    private Task AgreeConfirmedAsync(Guid id) => RunAsync(async () =>
    {
        if (Succeeded(await Comments.AgreeAsync(id)))
        {
            _confirming = null;
            await ReloadCoreAsync(all: false);
        }
    });

    private Task DeleteAsync(Guid id) => RunAsync(async () =>
    {
        if (!Succeeded(await Comments.DeleteAsync(id)))
        {
            return;
        }

        _deleting = null;
        Info = L["Comments.Deleted"];
        await ReloadCoreAsync(all: false);
    });

    /// <summary>After a moderator's action: the thread and the answers again.</summary>
    private Task ReloadAsync(string? done) => ReloadCoreAsync(all: false);

    /// <summary>Reads the thread and the caller's answer again, keeping as many comments shown (all, after writing one).</summary>
    private async Task ReloadCoreAsync(bool all)
    {
        var shown = all ? (_thread?.Count ?? 0) + 1 : _thread?.Items.Count;
        State.Forget(Number);
        _thread = (await Comments.GetThreadAsync(Kind, TargetId, shown is > 0 ? shown : null)).Value ?? _thread;
        if (_signedIn)
        {
            _mine = await State.MineAsync(Number);
        }

        if (Moderator)
        {
            _moderation = await State.ModerationAsync(Number);
        }
    }
}
