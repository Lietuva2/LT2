@using Lt2.Api.Contracts.Admin
@using Lt2.Api.Contracts.Appeals
@using Lt2.Api.Contracts.Comments
@inherits InteractiveBase<AppealUi>
@inject ICommentModerationApi Moderation
@inject MyAccountState Account

@* A moderator's actions on one comment (design 8.23.8), in the shared ModerationMenu (design 8.3, owner 2026-11-17), each
   opening its own form with one sentence on what it does: on a shown
   comment "Paslėpti" (a statement, sent to the author), "Palikti" when it has open reports (an optional note; nobody is told)
   and "Riboti autoriaus rašymą" (the writer is reached through the comment); on a hidden one "Atkurti" (a statement, told as a
   hide is). The same component in the list (CommentQueueItem) and on the bill's page; IdPrefix keeps the ids apart. *@
<div class="stack stack--tight" id="comment-actions-@Key">
    @if (!_finished)
    {
        @if (_open is null)
        {
            <ModerationMenu Id="@($"comment-more-{Key}")" Choices="Choices" Primary="@Primary" Locked="Locked" OnChoose="Open" />
        }
        else if (_open == "restrict")
        {
            <RestrictAuthor Id="Id" Comment="true" IdPrefix="@($"{IdPrefix}c-")" OnCancel="() => _open = null" OnDone="RestrictedAsync" />
        }
        else if (_open == "lock")
        {
            <LockAuthor Kind="@LockTargets.Comment" Id="Id" IdPrefix="@($"{IdPrefix}c-")" OnCancel="() => _open = null" OnDone="LockedAsync" />
        }
        else
        {
            <form class="sheet sheet--quiet stack stack--tight" @onsubmit="SubmitAsync" novalidate aria-labelledby="comment-action-title-@Key" id="comment-action-form-@Key">
                <ActionHeading Id="@($"comment-action-title-{Key}")">@L["Comments.Mod.Action." + _open]</ActionHeading>
                <p class="small">@L["Comments.Mod.Sentence." + _open]</p>
                <div class="field @ErrorClass("statement")">
                    @* Design 8.3 (owner, 2026-11-22): hiding and restoring email the statement to the comment's author. *@
                    <label for="comment-statement-@Key">@(_open == "keep" ? L["Mod.Note.Reporters"] : L["Mod.Statement.Author"])</label>
                    @if (_open == "keep")
                    {
                        <p class="field__hint">@L["Mod.Note.Reporters.Hint"]</p>
                    }
                    <textarea class="textarea" id="comment-statement-@Key" maxlength="@AppealLimits.StatementMaxLength" @bind="_statement" @bind:event="oninput" disabled="@Locked"
                              aria-invalid="@Invalid("statement")" aria-describedby="@DescribedBy("statement", $"comment-statement-{Key}")"></textarea>
                    <FieldError Errors="Errors" Field="statement" For="@($"comment-statement-{Key}")" />
                </div>
                <div class="row">
                    <button type="submit" class="btn" id="comment-action-submit-@Key" disabled="@Locked">@L["Comments.Mod.Action." + _open]</button>
                    <button type="button" class="btn btn--plain" disabled="@Locked" @onclick="() => _open = null">@L["Cancel"]</button>
                </div>
            </form>
        }
    }
    <Messages Message="@Message" Info="@(Info ?? _done)" />
</div>

@code {
    private string? _open;
    private string? _done;
    private bool _finished;
    private bool _administrator;
    private string _statement = "";

    [Parameter, EditorRequired] public Guid Id { get; set; }

    /// <summary><c>published</c> or <c>hidden</c>.</summary>
    [Parameter, EditorRequired] public string Status { get; set; } = "";

    /// <summary>The comment has open reports, so "Palikti" means something.</summary>
    [Parameter] public bool Reported { get; set; }

    [Parameter] public string IdPrefix { get; set; } = "";

    /// <summary>After an action, with its confirmation: the page or the list reloads.</summary>
    [Parameter] public EventCallback<string> OnDone { get; set; }

    private string Key => IdPrefix + Id.ToString("N");

    /// <summary>In the order shown: the main one first, hiding set apart at the end (owner, 2026-11-17).</summary>
    private IReadOnlyList<string> Offered => Status == CommentStatuses.Hidden
        ? ["restore", "restrict"]
        : [.. (Reported ? new[] { "keep" } : []), "restrict", "hide"];

    /// <summary>The filled button: "Atkurti" on a hidden comment, "Palikti" on a reported one; otherwise none.</summary>
    private string? Primary => Offered[0] is "keep" or "restore" ? Offered[0] : null;

    /// <summary>Design 8.3: an administrator also locks the writer's account, last after hiding; offered where the writer can be restricted.</summary>
    private IReadOnlyList<ModerationChoice> Choices =>
        [.. Offered.Concat(_administrator ? ["lock"] : []).Select(a => new ModerationChoice(a, $"comment-action-{a}-{Key}", L["Comments.Mod.Action." + a], Apart: a is "hide" or "lock"))];

    private void Open(string action)
    {
        _open = action;
        _statement = "";
        _done = null;
        Errors = NoErrors();
    }

    protected override async Task OnInitializedAsync() => _administrator = await Account.IsAdministratorAsync(RendererInfo.IsInteractive);

    private void LockedAsync()
    {
        _open = null;
        _done = L["Lock.Done"];
    }

    private async Task RestrictedAsync()
    {
        _open = null;
        _done = L["Restrict.Done"];
        await OnDone.InvokeAsync(_done);
    }

    private Task SubmitAsync() => RunAsync(async () =>
    {
        var action = _open!;
        var statement = new StatementRequest { Statement = _statement };
        var result = action switch
        {
            "hide" => await Moderation.HideAsync(Id, statement),
            "restore" => await Moderation.RestoreAsync(Id, statement),
            _ => await Moderation.KeepAsync(Id, new ModerationRequest { Statement = string.IsNullOrWhiteSpace(_statement) ? null : _statement }),
        };
        if (!Succeeded(result, "statement"))
        {
            return;
        }

        _open = null;
        _finished = true;
        _done = L["Comments.Mod.Done." + action];
        await OnDone.InvokeAsync(_done);
    });
}
