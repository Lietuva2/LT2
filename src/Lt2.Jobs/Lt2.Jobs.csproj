<Project Sdk="Microsoft.NET.Sdk">
  <!-- The Hangfire jobs. The worker runs them; the web host only loads their types, so the administrators' dashboard
       (/administravimas/darbai) can trigger a recurring job (Hangfire reads the job's type to enqueue it). No module
       references it. -->
  <PropertyGroup>
    <RootNamespace>Lt2.Jobs</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="Hangfire.Core" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Lt2.SharedKernel\Lt2.SharedKernel.csproj" />
    <ProjectReference Include="..\Modules\Lt2.Notifications\Lt2.Notifications.csproj" />
    <ProjectReference Include="..\Modules\Lt2.Identity\Lt2.Identity.csproj" />
    <ProjectReference Include="..\Modules\Lt2.Parliament\Lt2.Parliament.csproj" />
    <ProjectReference Include="..\Modules\Lt2.Appeals\Lt2.Appeals.csproj" />
  </ItemGroup>
</Project>
