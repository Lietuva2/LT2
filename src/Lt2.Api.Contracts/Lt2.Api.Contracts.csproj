<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>Lt2.Api.Contracts</RootNamespace>
    <IsTrimmable>true</IsTrimmable>
    <DefineConstants>$(DefineConstants);LT2_CONTRACTS</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <!-- One slug for every public address (MPs' /p/, members' /nariai/), also in Lt2.SharedKernel. -->
    <Compile Include="..\Lt2.SharedKernel\AddressSlugs.cs" Link="AddressSlugs.cs" />
    <!-- Every link to a comment or an argument on a bill's page (design 8.23.6), also in Lt2.SharedKernel. -->
    <Compile Include="..\Lt2.SharedKernel\BillTextLinks.cs" Link="Comments\BillTextLinks.cs" />
    <!-- How every long list grows by "Rodyti daugiau" (design 8.16.4), also in Lt2.SharedKernel for the modules' pages. -->
    <Compile Include="..\Lt2.SharedKernel\ListPaging.cs" Link="ListPaging.cs" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="FluentValidation" />
    <PackageReference Include="Microsoft.Extensions.Localization.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
  </ItemGroup>
</Project>
