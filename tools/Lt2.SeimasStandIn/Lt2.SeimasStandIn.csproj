<Project Sdk="Microsoft.NET.Sdk.Web">
  <!--
    A stand-in for the Seimas open-data service (https://apps.lrs.lt/sip/).
    It answers the same paths and query strings with synthetic canned responses. Local and test use only:
    no project under src/ may reference it, deploy/Dockerfile does not build it, and compose runs it only in the
    "local" profile (tests/Lt2.ArchitectureTests/StandInIsolationTests.cs checks all three).
  -->
  <PropertyGroup>
    <RootNamespace>Lt2.SeimasStandIn</RootNamespace>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <Content Include="..\..\tests\Lt2.Parliament.ImportTests\Seimas\Synthetic\*.xml"
             Link="Responses\%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\..\tests\Lt2.Parliament.ImportTests\Seimas\Synthetic\agenda\*.html"
             Link="Responses\agenda\%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest" />
    <Content Include="Recent\**\*.*" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Lt2.Parliament.ImportTests" />
    <InternalsVisibleTo Include="Lt2.IntegrationTests" />
  </ItemGroup>
</Project>
