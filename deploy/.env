# Local defaults for deploy/compose.yaml. No secrets here: those are files in deploy/secrets/.
# Production overrides every value below (see README.md).
COMPOSE_PROFILES=local
LT2_SITE_ADDRESS=lt2.localhost
LT2_TLS=internal
LT2_HTTP_PORT=8080
LT2_HTTPS_PORT=8443
LT2_MAILPIT_PORT=8025
LT2_SMTP_HOST=mailpit
LT2_SMTP_PORT=1025
LT2_SMTP_SECURITY=None
LT2_MAIL_FROM=prisijungimas@lt2.localhost
# A trial invitation for local runs (fictional code, 50 uses).
LT2_MIGRATOR_ARGS=--seed-invitation BANDYMAS-2026:50 --local-code-limits
# Local only: the worker imports parliament data from the stand-in, whose answers are INVENTED, while the Seimas
# open-data service is closed. Production leaves both empty (README.md).
LT2_SEIMAS_BASE_ADDRESS=http://seimas-standin:8080/sip/
LT2_OUTBOUND_EXTRA_HOST=seimas-standin
# Local only: allows the migrator's --demo-appeal (invented participants on XVP-0412). Production leaves it unset.
LT2_DEMO_DATA=true
# Local placeholder for the moderators' contact address shown to visitors who want to report (not a real mailbox).
LT2_MODERATION_CONTACT=moderatoriai@lt2.localhost
# Local only: the agenda watcher reads the stand-in's INVENTED agenda page. Production sets the lrs.lt address (and allows its host).
LT2_AGENDA_BASE_ADDRESS=http://seimas-standin:8080/
# Local only (design 6.2): per-address request limits high enough for hand testing and end-to-end runs on one machine.
# Production leaves these unset, so the defaults in code apply.
LT2_RATE_CODE_REQUESTS=1000
LT2_RATE_REGISTRATIONS=1000
LT2_RATE_SIGN_INS=1000
# Feedback (design 8.10): the GitHub issues linked from the panel, and the team's address for the daily notice (a local
# placeholder; it lands in Mailpit).
LT2_FEEDBACK_ISSUES_URL=https://github.com/Lietuva2/LT2/issues
LT2_FEEDBACK_TEAM_ADDRESS=komanda@lt2.localhost
