# Optional overrides for a separate stack with invented data, including the end-to-end tests.
# Load after deploy/.env. Use a different Compose project from the live-data stack.
COMPOSE_PROFILES=local
LT2_SEIMAS_BASE_ADDRESS=http://seimas-standin:8080/sip/
LT2_OUTBOUND_EXTRA_HOST=seimas-standin
LT2_AGENDA_BASE_ADDRESS=http://seimas-standin:8080/
LT2_DEMO_DATA=true
LT2_MIGRATOR_ARGS=--seed-invitation BANDYMAS-2026:50 --local-code-limits --official-addresses-without-invitation
